        V_bot.m_flow_nominal*V_bot.dp/V_bot.dp_nominal);
    elseif ( not V_bot.allowFlowReversal) then 
      V_bot.m_flow = homotopy(V_bot.relativeFlowCoefficient*V_bot.Av*sqrt(
        Modelica.Media.Water.WaterIF97_ph.density_Unique5(
        V_bot.state_a))*Modelica.Fluid.Utilities.regRoot(V_bot.dp, 
