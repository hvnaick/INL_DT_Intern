      V_top.m_flow_nominal = V_top.valveCharacteristic_Unique43(V_top.opening_nominal)
        *V_top.Av*sqrt(V_top.rho_nominal)*Modelica.Fluid.Utilities.regRoot(
        V_top.dp_nominal, V_top.dp_small);
