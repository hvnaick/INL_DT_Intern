       0, 0)) "Nominal dynamic viscosity (e.g., mu_liquidWater = 1e-3, mu_air = 1.8e-5)";
  parameter Modelica.Units.SI.AbsolutePressure DistanceAfterHeaters.flowModel.dp_nominal
    (fixed = false) = 1 "Nominal pressure loss (only for nominal models)";
  parameter Modelica.Units.SI.MassFlowRate DistanceAfterHeaters.flowModel.m_flow_nominal
     = (if DistanceAfterHeaters.flowModel.system.use_eps_Re then 
    DistanceAfterHeaters.flowModel.system.m_flow_nominal else 100.0*
    DistanceAfterHeaters.flowModel.m_flow_small) "Nominal mass flow rate";
  parameter Modelica.Units.SI.MassFlowRate DistanceAfterHeaters.flowModel.m_flow_small
     = (if DistanceAfterHeaters.flowModel.system.use_eps_Re then 
    DistanceAfterHeaters.flowModel.system.eps_m_flow*DistanceAfterHeaters.flowModel.m_flow_nominal
     else DistanceAfterHeaters.flowModel.system.m_flow_small) "Within regularization if |m_flows| < m_flow_small (may be wider for large discontinuities in static head)";
  parameter Modelica.Units.SI.AbsolutePressure DistanceAfterHeaters.flowModel.dp_small
    (fixed = false) = 1 "Within regularization if |dp| < dp_small (may be wider for large discontinuities in static head)";
  parameter Boolean DistanceAfterHeaters.flowModel.constantPressureLossCoefficient
     = DistanceAfterHeaters.flowModel.use_rho_nominal and (DistanceAfterHeaters.flowModel.use_mu_nominal
     or false) "= true, if the pressure loss does not depend on fluid states";
  parameter Boolean DistanceAfterHeaters.flowModel.continuousFlowReversal = 
     not DistanceAfterHeaters.flowModel.useUpstreamScheme or DistanceAfterHeaters.flowModel.constantPressureLossCoefficient
     or  not DistanceAfterHeaters.flowModel.allowFlowReversal "= true, if the pressure loss is continuous around zero flow";
  parameter Real heater3.bruh = 10;
  parameter Modelica.Units.SI.Length heater3.HeaterLength = data.Heater_Length;
  parameter Modelica.Units.SI.Length heater3.HeaterRadius = data.Heater_radius;
  parameter Modelica.Units.SI.Pressure heater3.Init_P = 101325;
  parameter Modelica.Units.SI.Power heater3.HeaterPower = data.Heater_Power;
  constant Boolean heater3.allowFlowReversal = false;
  parameter Modelica.Units.SI.AbsolutePressure heater3.Heater.systemTF.p_ambient
     = 101325 "Default ambient pressure";
  parameter Modelica.Units.SI.Temperature heater3.Heater.systemTF.T_ambient = 
    293.15 "Default ambient temperature";
  parameter Modelica.Units.SI.Acceleration heater3.Heater.systemTF.g = 9.80665 
    "Constant gravity acceleration";
  parameter Boolean heater3.Heater.systemTF.allowFlowReversal = true 
    "= true to allow flow reversal, false restricts to design direction (port_a -> port_b)";
  parameter TRANSFORM.Types.Dynamics heater3.Heater.systemTF.energyDynamics = 
    TRANSFORM.Types.Dynamics.DynamicFreeInitial "Formulation of energy balances";
  parameter TRANSFORM.Types.Dynamics heater3.Heater.systemTF.massDynamics = 
    heater3.Heater.systemTF.energyDynamics "Formulation of mass balances";
  parameter TRANSFORM.Types.Dynamics heater3.Heater.systemTF.substanceDynamics
     = heater3.Heater.systemTF.massDynamics "Formulation of substance balances";
  parameter TRANSFORM.Types.Dynamics heater3.Heater.systemTF.traceDynamics = 
    heater3.Heater.systemTF.massDynamics "Formulation of trace substance balances";
  parameter TRANSFORM.Types.Dynamics heater3.Heater.systemTF.momentumDynamics = 
    TRANSFORM.Types.Dynamics.SteadyState "Formulation of momentum balances";
  parameter Modelica.Units.SI.AbsolutePressure heater3.Heater.systemTF.p_start
     = 101325 "Pressure";
  parameter Boolean heater3.Heater.systemTF.use_T_start = true "Use T_start if true, otherwise h_start";
  parameter Modelica.Units.SI.Temperature heater3.Heater.systemTF.T_start = 
    293.15 "Temperature";
  parameter Modelica.Units.SI.SpecificEnthalpy heater3.Heater.systemTF.h_start
     = Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_pTX_Unique18(
    heater3.Heater.systemTF.p_start, heater3.Heater.systemTF.T_start, 
    heater3.Heater.systemTF.X_start, 0) "Specific enthalpy";
  parameter Modelica.Units.SI.MassFraction heater3.Heater.systemTF.X_start[1] = 
    {1.0} "Mass fraction";
  parameter TRANSFORM.Units.ExtraProperty heater3.Heater.systemTF.C_start[0] = 
    fill(0, 0) "Mass-Specific value";
  parameter Modelica.Units.SI.MassFlowRate heater3.Heater.systemTF.m_flow_start
     = 0 "Mass flow rate";
  parameter Boolean heater3.Heater.systemTF.showName = true;
  parameter Boolean heater3.Heater.systemTF.showDesignFlowDirection = true;
  parameter Boolean heater3.Heater.systemTF.showColors = false "Toggle dynamic color display";
  constant Boolean heater3.Heater.allowFlowReversal = false "= true to allow flow reversal, false restricts to design direction (port_a -> port_b)";
  parameter Real heater3.Heater.nParallel = 1 "Number of parallel components";
  constant Integer heater3.Heater.nV(min = 1.0) = 1 "Number of discrete volumes";
  parameter Modelica.Fluid.Types.Dynamics heater3.Heater.energyDynamics = 
    Modelica.Fluid.Types.Dynamics.DynamicFreeInitial "Formulation of energy balances";
  parameter Modelica.Fluid.Types.Dynamics heater3.Heater.massDynamics = 
    heater3.Heater.energyDynamics "Formulation of mass balances";
  parameter Modelica.Fluid.Types.Dynamics heater3.Heater.substanceDynamics = 
    heater3.Heater.massDynamics "Formulation of substance balances";
  parameter Modelica.Fluid.Types.Dynamics heater3.Heater.traceDynamics = 
    heater3.Heater.massDynamics "Formulation of trace substance balances";
  parameter Modelica.Units.SI.AbsolutePressure heater3.Heater.ps_start[
    heater3.Heater.nV] = TRANSFORM.Math.linspace_1D(heater3.Heater.p_a_start, 
    heater3.Heater.p_b_start, heater3.Heater.nV) "Pressure";
  parameter Boolean heater3.Heater.use_Ts_start = true "Use T_start if true, otherwise h_start";
  parameter Modelica.Units.SI.Temperature heater3.Heater.Ts_start[
    heater3.Heater.nV](start = fill(288.15, size(heater3.Heater.Ts_start, 1)))
     = TRANSFORM.Math.linspace_1D(heater3.Heater.T_a_start, heater3.Heater.T_b_start,
     heater3.Heater.nV) "Temperature";
  parameter Modelica.Units.SI.SpecificEnthalpy heater3.Heater.hs_start[
    heater3.Heater.nV] = (if  not heater3.Heater.use_Ts_start then 
    TRANSFORM.Math.linspace_1D(heater3.Heater.h_a_start, heater3.Heater.h_b_start,
     heater3.Heater.nV) else array(Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_pTX_Unique24
    (heater3.Heater.ps_start[i], heater3.Heater.Ts_start[i], heater3.Heater.Xs_start
    [i, 1:1], 0) for i in 1:heater3.Heater.nV)) "Specific enthalpy";
  parameter Modelica.Units.SI.MassFraction heater3.Heater.Xs_start[
    heater3.Heater.nV, 1] = TRANSFORM.Math.linspaceRepeat_1D(heater3.Heater.X_a_start,
     heater3.Heater.X_b_start, heater3.Heater.nV) "Mass fraction";
  parameter TRANSFORM.Units.ExtraProperty heater3.Heater.Cs_start[
    heater3.Heater.nV, 0] = TRANSFORM.Math.linspaceRepeat_1D(heater3.Heater.C_a_start,
     heater3.Heater.C_b_start, heater3.Heater.nV) "Mass-Specific value";
  parameter Boolean heater3.Heater.initialize_p = true "= true to set up initial equations for pressure";
  parameter Modelica.Units.SI.AbsolutePressure heater3.Heater.p_a_start = 101325
     "Pressure at port a";
  parameter Modelica.Units.SI.AbsolutePressure heater3.Heater.p_b_start = 
    heater3.Heater.p_a_start+(if heater3.Heater.m_flow_a_start > 0 then -1000.0
     else (if heater3.Heater.m_flow_a_start < 0 then 1000.0 else 0)) 
    "Pressure at port b";
  parameter Modelica.Units.SI.Temperature heater3.Heater.T_a_start = 293.15 
    "Temperature at port a";
  parameter Modelica.Units.SI.Temperature heater3.Heater.T_b_start = 
    heater3.Heater.T_a_start "Temperature at port b";
  parameter Modelica.Units.SI.SpecificEnthalpy heater3.Heater.h_a_start = 
    Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_pTX_Unique24(
    heater3.Heater.p_a_start, heater3.Heater.T_a_start, heater3.Heater.X_a_start,
     0) "Specific enthalpy at port a";
  parameter Modelica.Units.SI.SpecificEnthalpy heater3.Heater.h_b_start = 
    Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_pTX_Unique24(
    heater3.Heater.p_b_start, heater3.Heater.T_b_start, heater3.Heater.X_b_start,
     0) "Specific enthalpy at port b";
  parameter Modelica.Units.SI.MassFraction heater3.Heater.X_a_start[1] = {1.0} 
    "Mass fraction at port a";
  parameter Modelica.Units.SI.MassFraction heater3.Heater.X_b_start[1] = 
    heater3.Heater.X_a_start "Mass fraction at port b";
  parameter TRANSFORM.Units.ExtraProperty heater3.Heater.C_a_start[0] = fill(0, 0)
     "Mass-Specific value at port a";
  parameter TRANSFORM.Units.ExtraProperty heater3.Heater.C_b_start[0] = 
    heater3.Heater.C_a_start "Mass-Specific value at port b";
  parameter Modelica.Units.SI.MassFlowRate heater3.Heater.m_flow_a_start = 20 
    "Mass flow rate at port_a";
  parameter Modelica.Units.SI.MassFlowRate heater3.Heater.m_flow_b_start =  -
    heater3.Heater.m_flow_a_start "Mass flow rate at port_b";
  parameter Modelica.Units.SI.MassFlowRate heater3.Heater.m_flows_start[
    heater3.Heater.nV+1] = linspace(heater3.Heater.m_flow_a_start,  -
    heater3.Heater.m_flow_b_start, heater3.Heater.nV+1) "Mass flow rates";
  constant Integer heater3.Heater.geometry.figure = 1 "Index for Icon figure";
  constant Integer heater3.Heater.geometry.nV(min = 1.0) = 1 "Number of volume nodes";
  constant Integer heater3.Heater.geometry.nSurfaces = 1 "Number of transfer (heat/mass) surfaces";
  constant Integer heater3.Heater.flowModel.nFM(min = 1.0) = 1 "Number of discrete flow models";
  constant Modelica.Fluid.Types.Dynamics heater3.Heater.flowModel.momentumDynamics
     = Modelica.Fluid.Types.Dynamics.SteadyState "Formulation of momentum balance";
  parameter Modelica.Units.SI.PressureDifference heater3.Heater.flowModel.dps_start
    [heater3.Heater.flowModel.nFM] = heater3.Heater.dps_start "Pressure changes {p[2]-p[1],...,p[n+1]-p[n]}";
  parameter Modelica.Units.SI.MassFlowRate heater3.Heater.flowModel.m_flows_start
    [heater3.Heater.flowModel.nFM] = heater3.Heater.m_flowsFM_start 
    "Mass flow rates";
  constant Boolean heater3.Heater.flowModel.allowFlowReversal = false 
    "= true to allow flow reversal, false restricts to design direction (m_flows >= zeros(m))";
  constant Modelica.Units.SI.ReynoldsNumber heater3.Heater.flowModel.Re_lam(
    max = 4000.0) = 2300 "Laminar transition Reynolds number";
  constant Modelica.Units.SI.ReynoldsNumber heater3.Heater.flowModel.Re_turb(
    min = 2300.0) = 4000 "Turbulent transition Reynolds number";
  parameter Boolean heater3.Heater.flowModel.from_dp = heater3.Heater.flowModel.momentumDynamics
     >= Modelica.Fluid.Types.Dynamics.SteadyStateInitial "= true, use m_flow = f(dp), otherwise dp = f(m_flow)";
  parameter Modelica.Units.SI.MassFlowRate heater3.Heater.flowModel.m_flow_small
     = 15 "Within regularization if |m_flows| < m_flow_small (may be wider for large discontinuities in static head)";
  parameter Modelica.Units.SI.AbsolutePressure heater3.Heater.flowModel.dp_small
     = 1 "Within regularization if |dp| < dp_small (may be wider for large discontinuities in static head)";
  parameter Modelica.Units.SI.ReynoldsNumber heater3.Heater.flowModel.Re_center
     = 0.5*(heater3.Heater.flowModel.Re_lam+heater3.Heater.flowModel.Re_turb) 
    "Re smoothing transition center";
  parameter Modelica.Units.SI.ReynoldsNumber heater3.Heater.flowModel.Re_width
     = heater3.Heater.flowModel.Re_turb-heater3.Heater.flowModel.Re_center 
    "Re smoothing transition width";
  parameter Boolean heater3.Heater.flowModel.use_I_flows = heater3.Heater.flowModel.momentumDynamics
     <> Modelica.Fluid.Types.Dynamics.SteadyState "= true to consider differences in flow of momentum through boundaries";
  parameter Modelica.Units.SI.Time heater3.Heater.flowModel.taus[2] = {0.01, 
    0.01} "Time Constant for first order delay of {dps_K,dps_add}";
  parameter Modelica.Units.SI.AbsolutePressure heater3.Heater.flowModel.dp_nominal
    (fixed = false) = 1 "Nominal pressure loss (only for nominal models)";
  parameter Modelica.Units.SI.MassFlowRate heater3.Heater.flowModel.m_flow_nominal
     = 100.0*heater3.Heater.flowModel.m_flow_small "Nominal mass flow rate";
  parameter Boolean heater3.Heater.flowModel.use_d_nominal = false 
    "= true, if d_nominal is used, otherwise computed from medium";
  parameter Modelica.Units.SI.Density heater3.Heater.flowModel.d_nominal = 
    Modelica.Media.Water.WaterIF97_ph.density_phX_Unique26(101325, 
    84013.0581525969, {1.0}, 0) "Nominal density (e.g., rho_liquidWater = 995, rho_air = 1.2)";
  parameter Boolean heater3.Heater.flowModel.use_mu_nominal = false 
    "= true, if mu_nominal is used, otherwise computed from medium";
  parameter Modelica.Units.SI.DynamicViscosity heater3.Heater.flowModel.mu_nominal
     = Modelica.Media.Water.WaterIF97_ph.dynamicViscosity_Unique6(
    Modelica.Media.Water.WaterIF97_ph.setState_phX_Unique1(101325, 
      84013.0581525969, {1.0}, 0, 0)) "Nominal dynamic viscosity (e.g., mu_liquidWater = 1e-3, mu_air = 1.8e-5)";
  parameter Boolean heater3.Heater.flowModel.continuousFlowReversal = (if 
    heater3.Heater.flowModel.use_d_nominal and heater3.Heater.flowModel.use_mu_nominal
     then true else false) "= true if the pressure loss is continuous around zero flow";
  parameter Real heater3.Heater.flowModel.firstOrder_dps_K[1].k(unit = "1") = 1 
    "Gain";
  parameter Modelica.Units.SI.Time heater3.Heater.flowModel.firstOrder_dps_K[1].T
    (start = 1) = heater3.Heater.flowModel.taus[1] "Time Constant";
  parameter Modelica.Blocks.Types.Init heater3.Heater.flowModel.firstOrder_dps_K[1].initType
     = Modelica.Blocks.Types.Init.InitialOutput "Type of initialization (1: no init, 2: steady state, 3/4: initial output)";
  parameter Real heater3.Heater.flowModel.firstOrder_dps_K[1].y_start = 0 
    "Initial or guess value of output (= state)";
  constant Boolean heater3.Heater.use_HeatTransfer = true "= true to use the HeatTransfer model";
  parameter Real heater3.Heater.heatTransfer.nParallel = heater3.Heater.nParallel
     "Number of parallel components";
  constant Integer heater3.Heater.heatTransfer.nHT = 1 "Number of heat transfer segments";
  constant Integer heater3.Heater.heatTransfer.nSurfaces = 1 "Number of heat transfer surfaces";
  parameter Integer heater3.Heater.heatTransfer.flagIdeal = 1 "Flag for models to handle ideal boundary";
  parameter Modelica.Units.SI.Temperature heater3.Heater.heatTransfer.Ts_start[
    heater3.Heater.heatTransfer.nHT](start = fill(288.15, size(heater3.Heater.heatTransfer.Ts_start,
     1))) = heater3.Heater.Ts_start;
  constant Modelica.Units.SI.ReynoldsNumber heater3.Heater.heatTransfer.Re_lam(
    max = 4000.0) = 2300 "Laminar transition Reynolds number";
  constant Modelica.Units.SI.ReynoldsNumber heater3.Heater.heatTransfer.Re_turb(
    min = 2300.0) = 4000 "Turbulent transition Reynolds number";
  parameter Modelica.Units.SI.ReynoldsNumber heater3.Heater.heatTransfer.Re_center
     = 0.5*(heater3.Heater.heatTransfer.Re_lam+heater3.Heater.heatTransfer.Re_turb)
     "Re smoothing transition center";
  parameter Modelica.Units.SI.ReynoldsNumber heater3.Heater.heatTransfer.Re_width
     = heater3.Heater.heatTransfer.Re_turb-heater3.Heater.heatTransfer.Re_center
     "Re smoothing transition width";
  constant Integer heater3.Heater.internalHeatGen.nV(min = 1.0) = 1 
    "Number of discrete volumes";
  constant Boolean heater3.Heater.use_TraceMassTransfer = false "= true to use the TraceMassTransfer model";
  parameter Real heater3.Heater.traceMassTransfer.nParallel = heater3.Heater.nParallel
     "Number of parallel components";
  constant Integer heater3.Heater.traceMassTransfer.nMT = 1 "Number of mass transfer segments";
  constant Integer heater3.Heater.traceMassTransfer.nSurfaces = 1 
    "Number of mass transfer surfaces";
  parameter Integer heater3.Heater.traceMassTransfer.flagIdeal = 1 
    "Flag for models to handle ideal boundary";
  parameter TRANSFORM.Units.ExtraProperty heater3.Heater.traceMassTransfer.CsM_start
    [heater3.Heater.traceMassTransfer.nMT, 0] = heater3.Heater.Cs_start 
    "Initial Trace substance mass-specific value";
  parameter Integer heater3.Heater.traceMassTransfer.iC[:] = array(i for i in 1:0)
     "Fluid index of transfered substances from fluid to massPort. This sets nC in traceMassTransfer.";
  parameter Integer heater3.Heater.traceMassTransfer.nC = size(heater3.Heater.traceMassTransfer.iC,
     1);
  parameter Real heater3.Heater.traceMassTransfer.MMs[heater3.Heater.traceMassTransfer.nC]
     = fill(1, heater3.Heater.traceMassTransfer.nC) "Conversion from fluid mass-specific value to moles (e.g., molar mass [kg/mol] or Avogadro's number [atoms/mol])";
  parameter Integer heater3.Heater.traceMassTransfer.diffusionCoeff[1].nC = 
    heater3.Heater.traceMassTransfer.nC "Number of substances";
  constant Modelica.Units.SI.ReynoldsNumber heater3.Heater.traceMassTransfer.Re_lam
    (max = 4000.0) = 2300 "Laminar transition Reynolds number";
  constant Modelica.Units.SI.ReynoldsNumber heater3.Heater.traceMassTransfer.Re_turb
    (min = 2300.0) = 4000 "Turbulent transition Reynolds number";
  parameter Integer heater3.Heater.traceMassTransfer.massPorts[1, 1].nC = 
    heater3.Heater.traceMassTransfer.nC "Number of substances";
  constant TRANSFORM.Units.Mole heater3.Heater.traceMassTransfer.toMole_unitConv
     = 1;
  parameter Modelica.Units.SI.ReynoldsNumber heater3.Heater.traceMassTransfer.Re_center
     = 0.5*(heater3.Heater.traceMassTransfer.Re_lam+heater3.Heater.traceMassTransfer.Re_turb)
     "Re smoothing transition center";
  parameter Modelica.Units.SI.ReynoldsNumber heater3.Heater.traceMassTransfer.Re_width
     = heater3.Heater.traceMassTransfer.Re_turb-heater3.Heater.traceMassTransfer.Re_center
     "Re smoothing transition width";
  parameter Integer heater3.Heater.traceMassTransfer.iC_fluid[0] = array(i for i
     in 1:0);
  parameter Integer heater3.Heater.traceMassTransfer.nC_noT = 0-heater3.Heater.traceMassTransfer.nC
     "# of species not transfered from fluid";
  parameter Integer heater3.Heater.traceMassTransfer.iC_noT[heater3.Heater.traceMassTransfer.nC_noT]
     = (if heater3.Heater.traceMassTransfer.nC_noT > 0 then TRANSFORM.Math.indexFilter
    (heater3.Heater.traceMassTransfer.iC_fluid, heater3.Heater.traceMassTransfer.iC,
     false) else fill(0, heater3.Heater.traceMassTransfer.nC_noT)) 
    "Index of species not transfered from fluid";
  constant Integer heater3.Heater.internalTraceGen.nV(min = 1.0) = 1 
    "Number of discrete volumes";
  constant Boolean heater3.Heater.exposeState_a = true "=true, p is calculated at port_a else m_flow";
  constant Boolean heater3.Heater.exposeState_b = false "=true, p is calculated at port_b else m_flow";
  constant Modelica.Fluid.Types.Dynamics heater3.Heater.momentumDynamics = 
    Modelica.Fluid.Types.Dynamics.SteadyState "Formulation of momentum balances";
  parameter Boolean heater3.Heater.useInnerPortProperties = false 
    "=true to take port properties for flow models from internal control volumes";
  constant Boolean heater3.Heater.useLumpedPressure = false "=true to lump pressure states together";
  parameter TRANSFORM.Fluid.Types.LumpedLocation heater3.Heater.lumpPressureAt
     = TRANSFORM.Fluid.Types.LumpedLocation.port_a "Location of pressure for flow calculations";
  constant Integer heater3.Heater.nFM = 1 "number of flow models in flowModel";
  constant Integer heater3.Heater.nFMDistributed = 1;
  parameter Integer heater3.Heater.nFMLumped = (if  not heater3.Heater.exposeState_a
     and  not heater3.Heater.exposeState_b then 2 else 1);
  parameter Integer heater3.Heater.iLumped = integer(heater3.Heater.nV/2)+1 
    "Index of control volume with representative state if useLumpedPressure";
  parameter Modelica.Units.SI.PressureDifference heater3.Heater.dp_start = 
    heater3.Heater.p_a_start-heater3.Heater.p_b_start;
  parameter Modelica.Units.SI.PressureDifference heater3.Heater.dps_start[
    heater3.Heater.nFM] = (if heater3.Heater.useLumpedPressure then (if  not 
    heater3.Heater.exposeState_a and  not heater3.Heater.exposeState_b then cat(1,
     {heater3.Heater.dp_start/2}, {heater3.Heater.dp_start/2}) else {
    heater3.Heater.dp_start}) else (if  not heater3.Heater.exposeState_a and 
     not heater3.Heater.exposeState_b then (if heater3.Heater.nV == 1 then cat(1,
     {heater3.Heater.dp_start/2}, {heater3.Heater.dp_start/2}) else cat(1, {
    heater3.Heater.dp_start/(heater3.Heater.nV+1)}, array(heater3.Heater.ps_start
    [i]-heater3.Heater.ps_start[i+1] for i in 1:heater3.Heater.nV-1), {
    heater3.Heater.dp_start/(heater3.Heater.nV+1)})) else (if  not 
    heater3.Heater.exposeState_a and heater3.Heater.exposeState_b then (if 
    heater3.Heater.nV == 1 then {heater3.Heater.dp_start} else cat(1, {
    heater3.Heater.dp_start/heater3.Heater.nV}, array(heater3.Heater.ps_start[i]
    -heater3.Heater.ps_start[i+1] for i in 1:heater3.Heater.nV-1))) else (if 
    heater3.Heater.exposeState_a and  not heater3.Heater.exposeState_b then (if 
    heater3.Heater.nV == 1 then {heater3.Heater.dp_start} else cat(1, array(
    heater3.Heater.ps_start[i]-heater3.Heater.ps_start[i+1] for i in 1:
    heater3.Heater.nV-1), {heater3.Heater.dp_start/heater3.Heater.nV})) else 
    array(heater3.Heater.ps_start[i]-heater3.Heater.ps_start[i+1] for i in 1:
    heater3.Heater.nV-1)))));
  parameter Modelica.Units.SI.MassFlowRate heater3.Heater.m_flowsFM_start[
    heater3.Heater.nFM] = (if heater3.Heater.useLumpedPressure then (if 
    heater3.Heater.lumpPressureAt == TRANSFORM.Fluid.Types.LumpedLocation.port_a
     then (if  not heater3.Heater.exposeState_a and  not heater3.Heater.exposeState_b
     then cat(1, {heater3.Heater.m_flows_start[1]}, {heater3.Heater.m_flows_start
    [1]})/heater3.Heater.nParallel else {heater3.Heater.m_flows_start[1]}/
    heater3.Heater.nParallel) else (if  not heater3.Heater.exposeState_a and 
     not heater3.Heater.exposeState_b then cat(1, {heater3.Heater.m_flows_start[
    heater3.Heater.nV+1]}, {heater3.Heater.m_flows_start[heater3.Heater.nV+1]})/
    heater3.Heater.nParallel else {heater3.Heater.m_flows_start[heater3.Heater.nV
    +1]}/heater3.Heater.nParallel)) else (if  not heater3.Heater.exposeState_a
     and  not heater3.Heater.exposeState_b then heater3.Heater.m_flows_start/
    heater3.Heater.nParallel else (if  not heater3.Heater.exposeState_a and 
    heater3.Heater.exposeState_b then (array(heater3.Heater.m_flows_start[i]
     for i in 1:heater3.Heater.nV))/heater3.Heater.nParallel else (if 
    heater3.Heater.exposeState_a and  not heater3.Heater.exposeState_b then (
    array(heater3.Heater.m_flows_start[i] for i in 2:heater3.Heater.nV+1))/
