     = 101325 "Default ambient pressure";
  parameter Modelica.Units.SI.Temperature JetPump.flowModel.system.T_ambient = 
    293.15 "Default ambient temperature";
  parameter Modelica.Units.SI.Acceleration JetPump.flowModel.system.g = 9.80665 
    "Constant gravity acceleration";
  parameter Boolean JetPump.flowModel.system.allowFlowReversal = true 
    "= false to restrict to design flow direction (port_a -> port_b)";
  parameter Modelica.Fluid.Types.Dynamics JetPump.flowModel.system.energyDynamics
     = Modelica.Fluid.Types.Dynamics.DynamicFreeInitial "Default formulation of energy balances";
  parameter Modelica.Fluid.Types.Dynamics JetPump.flowModel.system.massDynamics
     = JetPump.flowModel.system.energyDynamics "Default formulation of mass balances";
  parameter Modelica.Fluid.Types.Dynamics JetPump.flowModel.system.substanceDynamics
     = JetPump.flowModel.system.massDynamics "Default formulation of substance balances";
  parameter Modelica.Fluid.Types.Dynamics JetPump.flowModel.system.traceDynamics
     = JetPump.flowModel.system.massDynamics "Default formulation of trace substance balances";
  parameter Modelica.Fluid.Types.Dynamics JetPump.flowModel.system.momentumDynamics
     = Modelica.Fluid.Types.Dynamics.SteadyState "Default formulation of momentum balances, if options available";
  parameter Modelica.Units.SI.MassFlowRate JetPump.flowModel.system.m_flow_start
     = 0 "Default start value for mass flow rates";
  parameter Modelica.Units.SI.AbsolutePressure JetPump.flowModel.system.p_start
     = JetPump.flowModel.system.p_ambient "Default start value for pressures";
  parameter Modelica.Units.SI.Temperature JetPump.flowModel.system.T_start = 
    JetPump.flowModel.system.T_ambient "Default start value for temperatures";
  parameter Boolean JetPump.flowModel.system.use_eps_Re = false "= true to determine turbulent region automatically using Reynolds number";
  parameter Modelica.Units.SI.MassFlowRate JetPump.flowModel.system.m_flow_nominal
     = (if JetPump.flowModel.system.use_eps_Re then 1 else 100.0*
    JetPump.flowModel.system.m_flow_small) "Default nominal mass flow rate";
  parameter Real JetPump.flowModel.system.eps_m_flow(min = 0.0) = 0.0001 
    "Regularization of zero flow for |m_flow| < eps_m_flow*m_flow_nominal";
  parameter Modelica.Units.SI.AbsolutePressure JetPump.flowModel.system.dp_small
     = 1 "Default small pressure drop for regularization of laminar and zero flow";
  parameter Modelica.Units.SI.MassFlowRate JetPump.flowModel.system.m_flow_small
    (min = 0.0) = 0.01 "Default small mass flow rate for regularization of laminar and zero flow";
  parameter Integer JetPump.flowModel.m = JetPump.flowModel.n-1 "Number of flow segments";
  parameter Boolean JetPump.flowModel.useUpstreamScheme = true "= false to average upstream and downstream properties across flow segments";
  parameter Boolean JetPump.flowModel.use_Ib_flows = JetPump.flowModel.momentumDynamics
     <> Modelica.Fluid.Types.Dynamics.SteadyState "= true to consider differences in flow of momentum through boundaries";
  parameter Modelica.Units.SI.ReynoldsNumber JetPump.flowModel.Re_turbulent = 4000
     "Start of turbulent regime, depending on type of flow device";
  constant Boolean JetPump.flowModel.show_Res = false "= true, if Reynolds numbers are included for plotting";
  parameter Boolean JetPump.flowModel.use_rho_nominal = false "= true, if rho_nominal is used, otherwise computed from medium";
  parameter Modelica.Units.SI.Density JetPump.flowModel.rho_nominal = 
    Modelica.Media.Water.WaterIF97_ph.density_pTX_Unique7(101325, 293.15, {1.0})
     "Nominal density (e.g., rho_liquidWater = 995, rho_air = 1.2)";
  parameter Boolean JetPump.flowModel.use_mu_nominal = false "= true, if mu_nominal is used, otherwise computed from medium";
  parameter Modelica.Units.SI.DynamicViscosity JetPump.flowModel.mu_nominal = 
    Modelica.Media.Water.WaterIF97_ph.dynamicViscosity_Unique6(
    Modelica.Media.Water.WaterIF97_ph.setState_pTX_Unique8(101325, 293.15, {1.0},
       0, 0)) "Nominal dynamic viscosity (e.g., mu_liquidWater = 1e-3, mu_air = 1.8e-5)";
  parameter Modelica.Units.SI.AbsolutePressure JetPump.flowModel.dp_nominal(
    fixed = false) = 1 "Nominal pressure loss (only for nominal models)";
  parameter Modelica.Units.SI.MassFlowRate JetPump.flowModel.m_flow_nominal = (
    if JetPump.flowModel.system.use_eps_Re then JetPump.flowModel.system.m_flow_nominal
     else 100.0*JetPump.flowModel.m_flow_small) "Nominal mass flow rate";
  parameter Modelica.Units.SI.MassFlowRate JetPump.flowModel.m_flow_small = (if 
    JetPump.flowModel.system.use_eps_Re then JetPump.flowModel.system.eps_m_flow
    *JetPump.flowModel.m_flow_nominal else JetPump.flowModel.system.m_flow_small)
     "Within regularization if |m_flows| < m_flow_small (may be wider for large discontinuities in static head)";
  parameter Modelica.Units.SI.AbsolutePressure JetPump.flowModel.dp_small(
    fixed = false) = 1 "Within regularization if |dp| < dp_small (may be wider for large discontinuities in static head)";
  parameter Boolean JetPump.flowModel.constantPressureLossCoefficient = 
    JetPump.flowModel.use_rho_nominal and (JetPump.flowModel.use_mu_nominal or 
    false) "= true, if the pressure loss does not depend on fluid states";
  parameter Boolean JetPump.flowModel.continuousFlowReversal =  not 
    JetPump.flowModel.useUpstreamScheme or JetPump.flowModel.constantPressureLossCoefficient
     or  not JetPump.flowModel.allowFlowReversal "= true, if the pressure loss is continuous around zero flow";
  parameter Modelica.Units.SI.Length HX.HXLength = data.HX_L;
  parameter Modelica.Units.SI.Length HX.HXRadius = data.HX_radius;
  parameter Modelica.Units.SI.Pressure HX.Init_P = 101325;
  parameter Modelica.Units.SI.Power HX.HX_Transfer = -10000.0;
  parameter Real HX.Therm_cond = data.Thermal_Cond;
  constant Boolean HX.allowFlowReversal = false;
  parameter Modelica.Units.SI.AbsolutePressure HX.Shell.systemTF.p_ambient = 101325
     "Default ambient pressure";
  parameter Modelica.Units.SI.Temperature HX.Shell.systemTF.T_ambient = 293.15 
    "Default ambient temperature";
  parameter Modelica.Units.SI.Acceleration HX.Shell.systemTF.g = 9.80665 
    "Constant gravity acceleration";
  parameter Boolean HX.Shell.systemTF.allowFlowReversal = true "= true to allow flow reversal, false restricts to design direction (port_a -> port_b)";
  parameter TRANSFORM.Types.Dynamics HX.Shell.systemTF.energyDynamics = 
    TRANSFORM.Types.Dynamics.DynamicFreeInitial "Formulation of energy balances";
  parameter TRANSFORM.Types.Dynamics HX.Shell.systemTF.massDynamics = 
    HX.Shell.systemTF.energyDynamics "Formulation of mass balances";
  parameter TRANSFORM.Types.Dynamics HX.Shell.systemTF.substanceDynamics = 
    HX.Shell.systemTF.massDynamics "Formulation of substance balances";
  parameter TRANSFORM.Types.Dynamics HX.Shell.systemTF.traceDynamics = 
    HX.Shell.systemTF.massDynamics "Formulation of trace substance balances";
  parameter TRANSFORM.Types.Dynamics HX.Shell.systemTF.momentumDynamics = 
    TRANSFORM.Types.Dynamics.SteadyState "Formulation of momentum balances";
  parameter Modelica.Units.SI.AbsolutePressure HX.Shell.systemTF.p_start = 101325
     "Pressure";
  parameter Boolean HX.Shell.systemTF.use_T_start = true "Use T_start if true, otherwise h_start";
  parameter Modelica.Units.SI.Temperature HX.Shell.systemTF.T_start = 293.15 
    "Temperature";
  parameter Modelica.Units.SI.SpecificEnthalpy HX.Shell.systemTF.h_start = 
    Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_pTX_Unique18(
    HX.Shell.systemTF.p_start, HX.Shell.systemTF.T_start, HX.Shell.systemTF.X_start,
     0) "Specific enthalpy";
  parameter Modelica.Units.SI.MassFraction HX.Shell.systemTF.X_start[1] = {1.0} 
    "Mass fraction";
  parameter TRANSFORM.Units.ExtraProperty HX.Shell.systemTF.C_start[0] = fill(0,
     0) "Mass-Specific value";
  parameter Modelica.Units.SI.MassFlowRate HX.Shell.systemTF.m_flow_start = 0 
    "Mass flow rate";
  parameter Boolean HX.Shell.systemTF.showName = true;
  parameter Boolean HX.Shell.systemTF.showDesignFlowDirection = true;
  parameter Boolean HX.Shell.systemTF.showColors = false "Toggle dynamic color display";
  constant Boolean HX.Shell.allowFlowReversal = false "= true to allow flow reversal, false restricts to design direction (port_a -> port_b)";
  parameter Real HX.Shell.nParallel = 1 "Number of parallel components";
  constant Integer HX.Shell.nV(min = 1.0) = 1 "Number of discrete volumes";
  parameter Modelica.Fluid.Types.Dynamics HX.Shell.energyDynamics = 
    Modelica.Fluid.Types.Dynamics.DynamicFreeInitial "Formulation of energy balances";
  parameter Modelica.Fluid.Types.Dynamics HX.Shell.massDynamics = 
    HX.Shell.energyDynamics "Formulation of mass balances";
  parameter Modelica.Fluid.Types.Dynamics HX.Shell.substanceDynamics = 
    HX.Shell.massDynamics "Formulation of substance balances";
  parameter Modelica.Fluid.Types.Dynamics HX.Shell.traceDynamics = 
    HX.Shell.massDynamics "Formulation of trace substance balances";
  parameter Modelica.Units.SI.AbsolutePressure HX.Shell.ps_start[HX.Shell.nV] = 
    TRANSFORM.Math.linspace_1D(HX.Shell.p_a_start, HX.Shell.p_b_start, 
    HX.Shell.nV) "Pressure";
  parameter Boolean HX.Shell.use_Ts_start = true "Use T_start if true, otherwise h_start";
  parameter Modelica.Units.SI.Temperature HX.Shell.Ts_start[HX.Shell.nV](
    start = fill(288.15, size(HX.Shell.Ts_start, 1))) = TRANSFORM.Math.linspace_1D
    (HX.Shell.T_a_start, HX.Shell.T_b_start, HX.Shell.nV) "Temperature";
  parameter Modelica.Units.SI.SpecificEnthalpy HX.Shell.hs_start[HX.Shell.nV] = 
    (if  not HX.Shell.use_Ts_start then TRANSFORM.Math.linspace_1D(
    HX.Shell.h_a_start, HX.Shell.h_b_start, HX.Shell.nV) else array(
    Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_pTX_Unique24(
    HX.Shell.ps_start[i], HX.Shell.Ts_start[i], HX.Shell.Xs_start[i, 1:1], 0)
     for i in 1:HX.Shell.nV)) "Specific enthalpy";
  parameter Modelica.Units.SI.MassFraction HX.Shell.Xs_start[HX.Shell.nV, 1] = 
    TRANSFORM.Math.linspaceRepeat_1D(HX.Shell.X_a_start, HX.Shell.X_b_start, 
    HX.Shell.nV) "Mass fraction";
  parameter TRANSFORM.Units.ExtraProperty HX.Shell.Cs_start[HX.Shell.nV, 0] = 
    TRANSFORM.Math.linspaceRepeat_1D(HX.Shell.C_a_start, HX.Shell.C_b_start, 
    HX.Shell.nV) "Mass-Specific value";
  parameter Boolean HX.Shell.initialize_p = true "= true to set up initial equations for pressure";
  parameter Modelica.Units.SI.AbsolutePressure HX.Shell.p_a_start = 101325 
    "Pressure at port a";
  parameter Modelica.Units.SI.AbsolutePressure HX.Shell.p_b_start = 
    HX.Shell.p_a_start+(if HX.Shell.m_flow_a_start > 0 then -1000.0 else (if 
    HX.Shell.m_flow_a_start < 0 then 1000.0 else 0)) "Pressure at port b";
  parameter Modelica.Units.SI.Temperature HX.Shell.T_a_start = 293.15 
    "Temperature at port a";
  parameter Modelica.Units.SI.Temperature HX.Shell.T_b_start = HX.Shell.T_a_start
     "Temperature at port b";
  parameter Modelica.Units.SI.SpecificEnthalpy HX.Shell.h_a_start = 
    Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_pTX_Unique24(
    HX.Shell.p_a_start, HX.Shell.T_a_start, HX.Shell.X_a_start, 0) 
    "Specific enthalpy at port a";
  parameter Modelica.Units.SI.SpecificEnthalpy HX.Shell.h_b_start = 
    Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_pTX_Unique24(
    HX.Shell.p_b_start, HX.Shell.T_b_start, HX.Shell.X_b_start, 0) 
    "Specific enthalpy at port b";
  parameter Modelica.Units.SI.MassFraction HX.Shell.X_a_start[1] = {1.0} 
    "Mass fraction at port a";
  parameter Modelica.Units.SI.MassFraction HX.Shell.X_b_start[1] = 
    HX.Shell.X_a_start "Mass fraction at port b";
  parameter TRANSFORM.Units.ExtraProperty HX.Shell.C_a_start[0] = fill(0, 0) 
    "Mass-Specific value at port a";
  parameter TRANSFORM.Units.ExtraProperty HX.Shell.C_b_start[0] = 
    HX.Shell.C_a_start "Mass-Specific value at port b";
  parameter Modelica.Units.SI.MassFlowRate HX.Shell.m_flow_a_start = 0 
    "Mass flow rate at port_a";
  parameter Modelica.Units.SI.MassFlowRate HX.Shell.m_flow_b_start =  -
    HX.Shell.m_flow_a_start "Mass flow rate at port_b";
  parameter Modelica.Units.SI.MassFlowRate HX.Shell.m_flows_start[HX.Shell.nV+1]
     = linspace(HX.Shell.m_flow_a_start,  -HX.Shell.m_flow_b_start, HX.Shell.nV+1)
     "Mass flow rates";
  constant Integer HX.Shell.geometry.figure = 1 "Index for Icon figure";
  constant Integer HX.Shell.geometry.nV(min = 1.0) = 1 "Number of volume nodes";
  constant Integer HX.Shell.geometry.nSurfaces = 1 "Number of transfer (heat/mass) surfaces";
  constant Integer HX.Shell.flowModel.nFM(min = 1.0) = 1 "Number of discrete flow models";
  constant Modelica.Fluid.Types.Dynamics HX.Shell.flowModel.momentumDynamics = 
    Modelica.Fluid.Types.Dynamics.SteadyState "Formulation of momentum balance";
  parameter Modelica.Units.SI.PressureDifference HX.Shell.flowModel.dps_start[
    HX.Shell.flowModel.nFM] = HX.Shell.dps_start "Pressure changes {p[2]-p[1],...,p[n+1]-p[n]}";
  parameter Modelica.Units.SI.MassFlowRate HX.Shell.flowModel.m_flows_start[
    HX.Shell.flowModel.nFM] = HX.Shell.m_flowsFM_start "Mass flow rates";
  constant Boolean HX.Shell.flowModel.allowFlowReversal = false "= true to allow flow reversal, false restricts to design direction (m_flows >= zeros(m))";
  constant Modelica.Units.SI.ReynoldsNumber HX.Shell.flowModel.Re_lam(max = 
    4000.0) = 2300 "Laminar transition Reynolds number";
  constant Modelica.Units.SI.ReynoldsNumber HX.Shell.flowModel.Re_turb(min = 
    2300.0) = 4000 "Turbulent transition Reynolds number";
  parameter Boolean HX.Shell.flowModel.from_dp = HX.Shell.flowModel.momentumDynamics
     >= Modelica.Fluid.Types.Dynamics.SteadyStateInitial "= true, use m_flow = f(dp), otherwise dp = f(m_flow)";
  parameter Modelica.Units.SI.MassFlowRate HX.Shell.flowModel.m_flow_small = 
    0.001 "Within regularization if |m_flows| < m_flow_small (may be wider for large discontinuities in static head)";
  parameter Modelica.Units.SI.AbsolutePressure HX.Shell.flowModel.dp_small = 1 
    "Within regularization if |dp| < dp_small (may be wider for large discontinuities in static head)";
  parameter Modelica.Units.SI.ReynoldsNumber HX.Shell.flowModel.Re_center = 0.5*
    (HX.Shell.flowModel.Re_lam+HX.Shell.flowModel.Re_turb) "Re smoothing transition center";
  parameter Modelica.Units.SI.ReynoldsNumber HX.Shell.flowModel.Re_width = 
    HX.Shell.flowModel.Re_turb-HX.Shell.flowModel.Re_center "Re smoothing transition width";
  parameter Boolean HX.Shell.flowModel.use_I_flows = HX.Shell.flowModel.momentumDynamics
     <> Modelica.Fluid.Types.Dynamics.SteadyState "= true to consider differences in flow of momentum through boundaries";
  parameter Modelica.Units.SI.Time HX.Shell.flowModel.taus[2] = {0.01, 0.01} 
    "Time Constant for first order delay of {dps_K,dps_add}";
  parameter Modelica.Units.SI.AbsolutePressure HX.Shell.flowModel.dp_nominal(
    fixed = false) = 1 "Nominal pressure loss (only for nominal models)";
  parameter Modelica.Units.SI.MassFlowRate HX.Shell.flowModel.m_flow_nominal = 
    100.0*HX.Shell.flowModel.m_flow_small "Nominal mass flow rate";
  parameter Boolean HX.Shell.flowModel.use_d_nominal = false "= true, if d_nominal is used, otherwise computed from medium";
  parameter Modelica.Units.SI.Density HX.Shell.flowModel.d_nominal = 
    Modelica.Media.Water.WaterIF97_ph.density_phX_Unique26(101325, 
    84013.0581525969, {1.0}, 0) "Nominal density (e.g., rho_liquidWater = 995, rho_air = 1.2)";
  parameter Boolean HX.Shell.flowModel.use_mu_nominal = false "= true, if mu_nominal is used, otherwise computed from medium";
  parameter Modelica.Units.SI.DynamicViscosity HX.Shell.flowModel.mu_nominal = 
    Modelica.Media.Water.WaterIF97_ph.dynamicViscosity_Unique6(
    Modelica.Media.Water.WaterIF97_ph.setState_phX_Unique1(101325, 
      84013.0581525969, {1.0}, 0, 0)) "Nominal dynamic viscosity (e.g., mu_liquidWater = 1e-3, mu_air = 1.8e-5)";
  parameter Boolean HX.Shell.flowModel.continuousFlowReversal = (if 
    HX.Shell.flowModel.use_d_nominal and HX.Shell.flowModel.use_mu_nominal then 
    true else false) "= true if the pressure loss is continuous around zero flow";
  parameter Real HX.Shell.flowModel.firstOrder_dps_K[1].k(unit = "1") = 1 "Gain";
  parameter Modelica.Units.SI.Time HX.Shell.flowModel.firstOrder_dps_K[1].T(
    start = 1) = HX.Shell.flowModel.taus[1] "Time Constant";
  parameter Modelica.Blocks.Types.Init HX.Shell.flowModel.firstOrder_dps_K[1].initType
     = Modelica.Blocks.Types.Init.InitialOutput "Type of initialization (1: no init, 2: steady state, 3/4: initial output)";
  parameter Real HX.Shell.flowModel.firstOrder_dps_K[1].y_start = 0 
    "Initial or guess value of output (= state)";
  constant Boolean HX.Shell.use_HeatTransfer = true "= true to use the HeatTransfer model";
  parameter Real HX.Shell.heatTransfer.nParallel = HX.Shell.nParallel 
    "Number of parallel components";
  constant Integer HX.Shell.heatTransfer.nHT = 1 "Number of heat transfer segments";
  constant Integer HX.Shell.heatTransfer.nSurfaces = 1 "Number of heat transfer surfaces";
  parameter Integer HX.Shell.heatTransfer.flagIdeal = 1 "Flag for models to handle ideal boundary";
  parameter Modelica.Units.SI.Temperature HX.Shell.heatTransfer.Ts_start[
    HX.Shell.heatTransfer.nHT](start = fill(288.15, size(HX.Shell.heatTransfer.Ts_start,
     1))) = HX.Shell.Ts_start;
  constant Modelica.Units.SI.ReynoldsNumber HX.Shell.heatTransfer.Re_lam(max = 
    4000.0) = 2300 "Laminar transition Reynolds number";
  constant Modelica.Units.SI.ReynoldsNumber HX.Shell.heatTransfer.Re_turb(min = 
    2300.0) = 4000 "Turbulent transition Reynolds number";
  parameter Modelica.Units.SI.ReynoldsNumber HX.Shell.heatTransfer.Re_center = 
    0.5*(HX.Shell.heatTransfer.Re_lam+HX.Shell.heatTransfer.Re_turb) 
    "Re smoothing transition center";
  parameter Modelica.Units.SI.ReynoldsNumber HX.Shell.heatTransfer.Re_width = 
    HX.Shell.heatTransfer.Re_turb-HX.Shell.heatTransfer.Re_center 
    "Re smoothing transition width";
  constant Integer HX.Shell.internalHeatGen.nV(min = 1.0) = 1 "Number of discrete volumes";
  constant Boolean HX.Shell.use_TraceMassTransfer = false "= true to use the TraceMassTransfer model";
  parameter Real HX.Shell.traceMassTransfer.nParallel = HX.Shell.nParallel 
    "Number of parallel components";
  constant Integer HX.Shell.traceMassTransfer.nMT = 1 "Number of mass transfer segments";
  constant Integer HX.Shell.traceMassTransfer.nSurfaces = 1 "Number of mass transfer surfaces";
  parameter Integer HX.Shell.traceMassTransfer.flagIdeal = 1 "Flag for models to handle ideal boundary";
  parameter TRANSFORM.Units.ExtraProperty HX.Shell.traceMassTransfer.CsM_start[
    HX.Shell.traceMassTransfer.nMT, 0] = HX.Shell.Cs_start "Initial Trace substance mass-specific value";
  parameter Integer HX.Shell.traceMassTransfer.iC[:] = array(i for i in 1:0) 
    "Fluid index of transfered substances from fluid to massPort. This sets nC in traceMassTransfer.";
  parameter Integer HX.Shell.traceMassTransfer.nC = size(HX.Shell.traceMassTransfer.iC,
     1);
  parameter Real HX.Shell.traceMassTransfer.MMs[HX.Shell.traceMassTransfer.nC]
     = fill(1, HX.Shell.traceMassTransfer.nC) "Conversion from fluid mass-specific value to moles (e.g., molar mass [kg/mol] or Avogadro's number [atoms/mol])";
  parameter Integer HX.Shell.traceMassTransfer.diffusionCoeff[1].nC = 
    HX.Shell.traceMassTransfer.nC "Number of substances";
  constant Modelica.Units.SI.ReynoldsNumber HX.Shell.traceMassTransfer.Re_lam(
    max = 4000.0) = 2300 "Laminar transition Reynolds number";
  constant Modelica.Units.SI.ReynoldsNumber HX.Shell.traceMassTransfer.Re_turb(
    min = 2300.0) = 4000 "Turbulent transition Reynolds number";
  parameter Integer HX.Shell.traceMassTransfer.massPorts[1, 1].nC = 
    HX.Shell.traceMassTransfer.nC "Number of substances";
  constant TRANSFORM.Units.Mole HX.Shell.traceMassTransfer.toMole_unitConv = 1;
  parameter Modelica.Units.SI.ReynoldsNumber HX.Shell.traceMassTransfer.Re_center
     = 0.5*(HX.Shell.traceMassTransfer.Re_lam+HX.Shell.traceMassTransfer.Re_turb)
     "Re smoothing transition center";
  parameter Modelica.Units.SI.ReynoldsNumber HX.Shell.traceMassTransfer.Re_width
     = HX.Shell.traceMassTransfer.Re_turb-HX.Shell.traceMassTransfer.Re_center 
    "Re smoothing transition width";
  parameter Integer HX.Shell.traceMassTransfer.iC_fluid[0] = array(i for i in 1:0);
  parameter Integer HX.Shell.traceMassTransfer.nC_noT = 0-HX.Shell.traceMassTransfer.nC
     "# of species not transfered from fluid";
  parameter Integer HX.Shell.traceMassTransfer.iC_noT[HX.Shell.traceMassTransfer.nC_noT]
     = (if HX.Shell.traceMassTransfer.nC_noT > 0 then TRANSFORM.Math.indexFilter
    (HX.Shell.traceMassTransfer.iC_fluid, HX.Shell.traceMassTransfer.iC, false)
     else fill(0, HX.Shell.traceMassTransfer.nC_noT)) "Index of species not transfered from fluid";
  constant Integer HX.Shell.internalTraceGen.nV(min = 1.0) = 1 "Number of discrete volumes";
  constant Boolean HX.Shell.exposeState_a = true "=true, p is calculated at port_a else m_flow";
  constant Boolean HX.Shell.exposeState_b = false "=true, p is calculated at port_b else m_flow";
  constant Modelica.Fluid.Types.Dynamics HX.Shell.momentumDynamics = 
    Modelica.Fluid.Types.Dynamics.SteadyState "Formulation of momentum balances";
  parameter Boolean HX.Shell.useInnerPortProperties = false "=true to take port properties for flow models from internal control volumes";
  constant Boolean HX.Shell.useLumpedPressure = false "=true to lump pressure states together";
  parameter TRANSFORM.Fluid.Types.LumpedLocation HX.Shell.lumpPressureAt = 
    TRANSFORM.Fluid.Types.LumpedLocation.port_a "Location of pressure for flow calculations";
  constant Integer HX.Shell.nFM = 1 "number of flow models in flowModel";
  constant Integer HX.Shell.nFMDistributed = 1;
  parameter Integer HX.Shell.nFMLumped = (if  not HX.Shell.exposeState_a and 
     not HX.Shell.exposeState_b then 2 else 1);
  parameter Integer HX.Shell.iLumped = integer(HX.Shell.nV/2)+1 "Index of control volume with representative state if useLumpedPressure";
  parameter Modelica.Units.SI.PressureDifference HX.Shell.dp_start = 
    HX.Shell.p_a_start-HX.Shell.p_b_start;
  parameter Modelica.Units.SI.PressureDifference HX.Shell.dps_start[HX.Shell.nFM]
     = (if HX.Shell.useLumpedPressure then (if  not HX.Shell.exposeState_a and 
     not HX.Shell.exposeState_b then cat(1, {HX.Shell.dp_start/2}, {
    HX.Shell.dp_start/2}) else {HX.Shell.dp_start}) else (if  not 
    HX.Shell.exposeState_a and  not HX.Shell.exposeState_b then (if HX.Shell.nV
     == 1 then cat(1, {HX.Shell.dp_start/2}, {HX.Shell.dp_start/2}) else cat(1, 
    {HX.Shell.dp_start/(HX.Shell.nV+1)}, array(HX.Shell.ps_start[i]-
    HX.Shell.ps_start[i+1] for i in 1:HX.Shell.nV-1), {HX.Shell.dp_start/(
    HX.Shell.nV+1)})) else (if  not HX.Shell.exposeState_a and HX.Shell.exposeState_b
     then (if HX.Shell.nV == 1 then {HX.Shell.dp_start} else cat(1, {
    HX.Shell.dp_start/HX.Shell.nV}, array(HX.Shell.ps_start[i]-HX.Shell.ps_start
    [i+1] for i in 1:HX.Shell.nV-1))) else (if HX.Shell.exposeState_a and  not 
    HX.Shell.exposeState_b then (if HX.Shell.nV == 1 then {HX.Shell.dp_start}
     else cat(1, array(HX.Shell.ps_start[i]-HX.Shell.ps_start[i+1] for i in 1:
    HX.Shell.nV-1), {HX.Shell.dp_start/HX.Shell.nV})) else array(
    HX.Shell.ps_start[i]-HX.Shell.ps_start[i+1] for i in 1:HX.Shell.nV-1)))));
  parameter Modelica.Units.SI.MassFlowRate HX.Shell.m_flowsFM_start[HX.Shell.nFM]
     = (if HX.Shell.useLumpedPressure then (if HX.Shell.lumpPressureAt == 
    TRANSFORM.Fluid.Types.LumpedLocation.port_a then (if  not HX.Shell.exposeState_a
     and  not HX.Shell.exposeState_b then cat(1, {HX.Shell.m_flows_start[1]}, {
    HX.Shell.m_flows_start[1]})/HX.Shell.nParallel else {HX.Shell.m_flows_start[1]}
    /HX.Shell.nParallel) else (if  not HX.Shell.exposeState_a and  not 
    HX.Shell.exposeState_b then cat(1, {HX.Shell.m_flows_start[HX.Shell.nV+1]}, 
    {HX.Shell.m_flows_start[HX.Shell.nV+1]})/HX.Shell.nParallel else {
    HX.Shell.m_flows_start[HX.Shell.nV+1]}/HX.Shell.nParallel)) else (if  not 
    HX.Shell.exposeState_a and  not HX.Shell.exposeState_b then HX.Shell.m_flows_start
    /HX.Shell.nParallel else (if  not HX.Shell.exposeState_a and 
    HX.Shell.exposeState_b then (array(HX.Shell.m_flows_start[i] for i in 1:
    HX.Shell.nV))/HX.Shell.nParallel else (if HX.Shell.exposeState_a and  not 
    HX.Shell.exposeState_b then (array(HX.Shell.m_flows_start[i] for i in 2:
    HX.Shell.nV+1))/HX.Shell.nParallel else (array(HX.Shell.m_flows_start[i]
     for i in 2:HX.Shell.nV))/HX.Shell.nParallel))));
  parameter Modelica.Units.SI.Temperature HX.Shell.Ts_wallFM_start[HX.Shell.nFM+1]
    (start = fill(288.15, size(HX.Shell.Ts_wallFM_start, 1))) = (if 
    HX.Shell.useLumpedPressure then (if  not HX.Shell.exposeState_a and  not 
    HX.Shell.exposeState_b then cat(1, {HX.Shell.T_a_start}, {0.5*(
    HX.Shell.T_a_start+HX.Shell.T_b_start)}, {HX.Shell.T_b_start}) else cat(1, {
    HX.Shell.T_a_start}, {HX.Shell.T_b_start})) else (if  not HX.Shell.exposeState_a
     and  not HX.Shell.exposeState_b then (if HX.Shell.nV == 1 then cat(1, {
    HX.Shell.T_a_start}, {0.5*(HX.Shell.T_a_start+HX.Shell.T_b_start)}, {
    HX.Shell.T_b_start}) else cat(1, {HX.Shell.T_a_start}, array(
    HX.Shell.Ts_start[i] for i in 1:HX.Shell.nV), {HX.Shell.T_b_start})) else (
    if  not HX.Shell.exposeState_a and HX.Shell.exposeState_b then (if 
    HX.Shell.nV == 1 then cat(1, {HX.Shell.T_a_start}, {HX.Shell.T_b_start})
     else cat(1, {HX.Shell.T_a_start}, array(HX.Shell.Ts_start[i] for i in 1:
    HX.Shell.nV))) else (if HX.Shell.exposeState_a and  not HX.Shell.exposeState_b
     then (if HX.Shell.nV == 1 then cat(1, {HX.Shell.T_a_start}, {
    HX.Shell.T_b_start}) else cat(1, array(HX.Shell.Ts_start[i] for i in 1:
    HX.Shell.nV), {HX.Shell.T_b_start})) else array(HX.Shell.Ts_start[i] for i
     in 1:HX.Shell.nV)))));
  parameter Boolean HX.Shell.showName = true;
  parameter Boolean HX.Shell.showDesignFlowDirection = true;
  parameter Boolean HX.Shell.showColors = HX.Shell.systemTF.showColors 
