  // Component T_diff
  // class Modelica.Blocks.Math.Add
  equation
    T_diff.y = T_diff.k1*T_diff.u1+T_diff.k2*T_diff.u2;

  // Component JetInlet.flowModel
  // class Modelica.Fluid.Pipes.BaseClasses.PartialStraightPipe.FlowModel
    // extends Modelica.Fluid.Interfaces.PartialDistributedFlow
    equation
      JetInlet.flowModel.Is = array(JetInlet.flowModel.m_flows[i]*
        JetInlet.flowModel.pathLengths[i] for i in 1:JetInlet.flowModel.m);
      if (JetInlet.flowModel.momentumDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) then 
        zeros(JetInlet.flowModel.m) = JetInlet.flowModel.Ib_flows-
          JetInlet.flowModel.Fs_p-JetInlet.flowModel.Fs_fg;
      else
        der(JetInlet.flowModel.Is) = JetInlet.flowModel.Ib_flows-
          JetInlet.flowModel.Fs_p-JetInlet.flowModel.Fs_fg;
      end if;
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialStaggeredFlowModel
    equation
      if ( not JetInlet.flowModel.allowFlowReversal) then 
        JetInlet.flowModel.rhos_act = JetInlet.flowModel.rhos[1:JetInlet.flowModel.n
          -1];
        JetInlet.flowModel.mus_act = JetInlet.flowModel.mus[1:JetInlet.flowModel.n
          -1];
      elseif ( not JetInlet.flowModel.useUpstreamScheme) then 
        JetInlet.flowModel.rhos_act = 0.5*(JetInlet.flowModel.rhos[1:
          JetInlet.flowModel.n-1]+JetInlet.flowModel.rhos[2:JetInlet.flowModel.n]);
        JetInlet.flowModel.mus_act = 0.5*(JetInlet.flowModel.mus[1:
          JetInlet.flowModel.n-1]+JetInlet.flowModel.mus[2:JetInlet.flowModel.n]);
      else
        for i in (1:JetInlet.flowModel.n-1) loop
          JetInlet.flowModel.rhos_act[i] = noEvent((if JetInlet.flowModel.m_flows
            [i] > 0 then JetInlet.flowModel.rhos[i] else JetInlet.flowModel.rhos
            [i+1]));
          JetInlet.flowModel.mus_act[i] = noEvent((if JetInlet.flowModel.m_flows
            [i] > 0 then JetInlet.flowModel.mus[i] else JetInlet.flowModel.mus[i
            +1]));
        end for;
      end if;
      if (JetInlet.flowModel.use_Ib_flows) then 
        JetInlet.flowModel.Ib_flows = JetInlet.flowModel.nParallel*(array(
          JetInlet.flowModel.rhos[i]*JetInlet.flowModel.vs[i]*JetInlet.flowModel.vs
          [i]*JetInlet.flowModel.crossAreas[i]-JetInlet.flowModel.rhos[i+1]*
          JetInlet.flowModel.vs[i+1]*JetInlet.flowModel.vs[i+1]*JetInlet.flowModel.crossAreas
          [i+1] for i in 1:JetInlet.flowModel.n-1));
      else
        JetInlet.flowModel.Ib_flows = zeros(JetInlet.flowModel.n-1);
      end if;
      JetInlet.flowModel.Fs_p = JetInlet.flowModel.nParallel*(array(0.5*(
        JetInlet.flowModel.crossAreas[i]+JetInlet.flowModel.crossAreas[i+1])*(
        Modelica.Media.Water.WaterIF97_ph.pressure_Unique11(
        JetInlet.flowModel.states[i+1])-Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
        (
        JetInlet.flowModel.states[i])) for i in 1:JetInlet.flowModel.n-1));
      JetInlet.flowModel.dps_fg = array(JetInlet.flowModel.Fs_fg[i]/
        JetInlet.flowModel.nParallel*2/(JetInlet.flowModel.crossAreas[i]+
        JetInlet.flowModel.crossAreas[i+1]) for i in 1:JetInlet.flowModel.n-1);
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialGenericPipeFlow
    equation
      for i in (1:JetInlet.flowModel.n-1) loop
        assert(JetInlet.flowModel.m_flows[i] >  -JetInlet.flowModel.m_flow_small
           or JetInlet.flowModel.allowFlowReversal, "Reversing flow occurs even though allowFlowReversal is false");
      end for;
      if (JetInlet.flowModel.continuousFlowReversal) then 
        if (JetInlet.flowModel.from_dp and true) then 
          JetInlet.flowModel.m_flows = homotopy(massFlowRate_dp_Unique14(
            JetInlet.flowModel.dps_fg-(array(JetInlet.flowModel.g*
            JetInlet.flowModel.dheights[i]*JetInlet.flowModel.rhos_act[i] for i
             in 1:JetInlet.flowModel.n-1)), JetInlet.flowModel.rhos_act, 
            JetInlet.flowModel.rhos_act, JetInlet.flowModel.mus_act, 
            JetInlet.flowModel.mus_act, JetInlet.flowModel.pathLengths_internal,
             JetInlet.flowModel.diameters, (JetInlet.flowModel.crossAreas[1:
            JetInlet.flowModel.n-1]+JetInlet.flowModel.crossAreas[2:
            JetInlet.flowModel.n])/2, (JetInlet.flowModel.roughnesses[1:
            JetInlet.flowModel.n-1]+JetInlet.flowModel.roughnesses[2:
            JetInlet.flowModel.n])/2, JetInlet.flowModel.dp_small/(
            JetInlet.flowModel.n-1), JetInlet.flowModel.Res_turbulent_internal)*
            JetInlet.flowModel.nParallel, JetInlet.flowModel.m_flow_nominal/
            JetInlet.flowModel.dp_nominal*(JetInlet.flowModel.dps_fg-
            JetInlet.flowModel.g*JetInlet.flowModel.dheights*JetInlet.flowModel.rho_nominal));
        else
          JetInlet.flowModel.dps_fg = homotopy(pressureLoss_m_flow_Unique12(
            JetInlet.flowModel.m_flows/JetInlet.flowModel.nParallel, 
            JetInlet.flowModel.rhos_act, JetInlet.flowModel.rhos_act, 
            JetInlet.flowModel.mus_act, JetInlet.flowModel.mus_act, 
            JetInlet.flowModel.pathLengths_internal, JetInlet.flowModel.diameters,
             (JetInlet.flowModel.crossAreas[1:JetInlet.flowModel.n-1]+
            JetInlet.flowModel.crossAreas[2:JetInlet.flowModel.n])/2, (
            JetInlet.flowModel.roughnesses[1:JetInlet.flowModel.n-1]+
            JetInlet.flowModel.roughnesses[2:JetInlet.flowModel.n])/2, 
            JetInlet.flowModel.m_flow_small/JetInlet.flowModel.nParallel, 
            JetInlet.flowModel.Res_turbulent_internal)+(array(JetInlet.flowModel.g
            *JetInlet.flowModel.dheights[i]*JetInlet.flowModel.rhos_act[i] for i
             in 1:JetInlet.flowModel.n-1)), JetInlet.flowModel.dp_nominal/
            JetInlet.flowModel.m_flow_nominal*JetInlet.flowModel.m_flows+
            JetInlet.flowModel.g*JetInlet.flowModel.dheights*JetInlet.flowModel.rho_nominal);
        end if;
      else
        if (JetInlet.flowModel.from_dp and true) then 
          JetInlet.flowModel.m_flows = homotopy(massFlowRate_dp_staticHead_Unique16
            (JetInlet.flowModel.dps_fg, JetInlet.flowModel.rhos[1:
            JetInlet.flowModel.n-1], JetInlet.flowModel.rhos[2:JetInlet.flowModel.n],
             JetInlet.flowModel.mus[1:JetInlet.flowModel.n-1], JetInlet.flowModel.mus
            [2:JetInlet.flowModel.n], JetInlet.flowModel.pathLengths_internal, 
            JetInlet.flowModel.diameters, JetInlet.flowModel.g*JetInlet.flowModel.dheights,
             (JetInlet.flowModel.crossAreas[1:JetInlet.flowModel.n-1]+
            JetInlet.flowModel.crossAreas[2:JetInlet.flowModel.n])/2, (
            JetInlet.flowModel.roughnesses[1:JetInlet.flowModel.n-1]+
            JetInlet.flowModel.roughnesses[2:JetInlet.flowModel.n])/2, 
            JetInlet.flowModel.dp_small/(JetInlet.flowModel.n-1), 
            JetInlet.flowModel.Res_turbulent_internal)*JetInlet.flowModel.nParallel,
             JetInlet.flowModel.m_flow_nominal/JetInlet.flowModel.dp_nominal*(
            JetInlet.flowModel.dps_fg-JetInlet.flowModel.g*JetInlet.flowModel.dheights
            *JetInlet.flowModel.rho_nominal));
        else
          JetInlet.flowModel.dps_fg = homotopy(pressureLoss_m_flow_staticHead_Unique17
            (JetInlet.flowModel.m_flows/JetInlet.flowModel.nParallel, 
            JetInlet.flowModel.rhos[1:JetInlet.flowModel.n-1], JetInlet.flowModel.rhos
            [2:JetInlet.flowModel.n], JetInlet.flowModel.mus[1:JetInlet.flowModel.n
            -1], JetInlet.flowModel.mus[2:JetInlet.flowModel.n], 
            JetInlet.flowModel.pathLengths_internal, JetInlet.flowModel.diameters,
             JetInlet.flowModel.g*JetInlet.flowModel.dheights, (JetInlet.flowModel.crossAreas
            [1:JetInlet.flowModel.n-1]+JetInlet.flowModel.crossAreas[2:
            JetInlet.flowModel.n])/2, (JetInlet.flowModel.roughnesses[1:
            JetInlet.flowModel.n-1]+JetInlet.flowModel.roughnesses[2:
            JetInlet.flowModel.n])/2, JetInlet.flowModel.m_flow_small/
            JetInlet.flowModel.nParallel, JetInlet.flowModel.Res_turbulent_internal),
             JetInlet.flowModel.dp_nominal/JetInlet.flowModel.m_flow_nominal*
            JetInlet.flowModel.m_flows+JetInlet.flowModel.g*JetInlet.flowModel.dheights
            *JetInlet.flowModel.rho_nominal);
        end if;
      end if;
    // end of extends 

  // Component JetInlet
  // class Modelica.Fluid.Pipes.StaticPipe
    // extends Modelica.Fluid.Pipes.BaseClasses.PartialStraightPipe
    equation
      assert(JetInlet.length >= JetInlet.height_ab, "Parameter length must be greater or equal height_ab.");
    // end of extends 
  equation
    JetInlet.port_a.m_flow = JetInlet.flowModel.m_flows[1];
    0 = JetInlet.port_a.m_flow+JetInlet.port_b.m_flow;
    JetInlet.port_a.Xi_outflow = inStream(JetInlet.port_b.Xi_outflow);
    JetInlet.port_b.Xi_outflow = inStream(JetInlet.port_a.Xi_outflow);
    JetInlet.port_a.C_outflow = inStream(JetInlet.port_b.C_outflow);
    JetInlet.port_b.C_outflow = inStream(JetInlet.port_a.C_outflow);
    JetInlet.port_b.h_outflow = inStream(JetInlet.port_a.h_outflow)-
      JetInlet.system.g*JetInlet.height_ab;
    JetInlet.port_a.h_outflow = inStream(JetInlet.port_b.h_outflow)+
      JetInlet.system.g*JetInlet.height_ab;

  // Component DistanceAfterHeaters.flowModel
