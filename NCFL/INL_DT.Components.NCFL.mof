         then 
        heater3.Heater.m_flows[1:heater3.Heater.nV] = heater3.Heater.flowModel.m_flows
          [1:heater3.Heater.nV];
        heater3.Heater.port_b.p = heater3.Heater.mediums[heater3.Heater.nV].p;
