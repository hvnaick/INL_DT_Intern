  constant Integer heater1.Heater.nFM = 1 "number of flow models in flowModel";
  constant Integer heater1.Heater.nFMDistributed = 1;
  parameter Integer heater1.Heater.nFMLumped = (if  not heater1.Heater.exposeState_a
