        der(DistanceAfterHeaters.flowModel.Is) = DistanceAfterHeaters.flowModel.Ib_flows
          -DistanceAfterHeaters.flowModel.Fs_p-DistanceAfterHeaters.flowModel.Fs_fg;
      end if;
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialStaggeredFlowModel
    equation
      if ( not DistanceAfterHeaters.flowModel.allowFlowReversal) then 
        DistanceAfterHeaters.flowModel.rhos_act = DistanceAfterHeaters.flowModel.rhos
          [1:DistanceAfterHeaters.flowModel.n-1];
        DistanceAfterHeaters.flowModel.mus_act = DistanceAfterHeaters.flowModel.mus
          [1:DistanceAfterHeaters.flowModel.n-1];
      elseif ( not DistanceAfterHeaters.flowModel.useUpstreamScheme) then 
        DistanceAfterHeaters.flowModel.rhos_act = 0.5*(DistanceAfterHeaters.flowModel.rhos
          [1:DistanceAfterHeaters.flowModel.n-1]+DistanceAfterHeaters.flowModel.rhos
          [2:DistanceAfterHeaters.flowModel.n]);
        DistanceAfterHeaters.flowModel.mus_act = 0.5*(DistanceAfterHeaters.flowModel.mus
          [1:DistanceAfterHeaters.flowModel.n-1]+DistanceAfterHeaters.flowModel.mus
          [2:DistanceAfterHeaters.flowModel.n]);
      else
        for i in (1:DistanceAfterHeaters.flowModel.n-1) loop
          DistanceAfterHeaters.flowModel.rhos_act[i] = noEvent((if 
            DistanceAfterHeaters.flowModel.m_flows[i] > 0 then DistanceAfterHeaters.flowModel.rhos
            [i] else DistanceAfterHeaters.flowModel.rhos[i+1]));
          DistanceAfterHeaters.flowModel.mus_act[i] = noEvent((if 
            DistanceAfterHeaters.flowModel.m_flows[i] > 0 then DistanceAfterHeaters.flowModel.mus
            [i] else DistanceAfterHeaters.flowModel.mus[i+1]));
        end for;
      end if;
      if (DistanceAfterHeaters.flowModel.use_Ib_flows) then 
        DistanceAfterHeaters.flowModel.Ib_flows = DistanceAfterHeaters.flowModel.nParallel
          *(array(DistanceAfterHeaters.flowModel.rhos[i]*DistanceAfterHeaters.flowModel.vs
          [i]*DistanceAfterHeaters.flowModel.vs[i]*DistanceAfterHeaters.flowModel.crossAreas
          [i]-DistanceAfterHeaters.flowModel.rhos[i+1]*DistanceAfterHeaters.flowModel.vs
          [i+1]*DistanceAfterHeaters.flowModel.vs[i+1]*DistanceAfterHeaters.flowModel.crossAreas
          [i+1] for i in 1:DistanceAfterHeaters.flowModel.n-1));
      else
        DistanceAfterHeaters.flowModel.Ib_flows = zeros(DistanceAfterHeaters.flowModel.n
          -1);
      end if;
      DistanceAfterHeaters.flowModel.Fs_p = DistanceAfterHeaters.flowModel.nParallel
        *(array(0.5*(DistanceAfterHeaters.flowModel.crossAreas[i]+
        DistanceAfterHeaters.flowModel.crossAreas[i+1])*(Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
        (
        DistanceAfterHeaters.flowModel.states[i+1])-Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
        (
        DistanceAfterHeaters.flowModel.states[i])) for i in 1:DistanceAfterHeaters.flowModel.n
        -1));
      DistanceAfterHeaters.flowModel.dps_fg = array(DistanceAfterHeaters.flowModel.Fs_fg
        [i]/DistanceAfterHeaters.flowModel.nParallel*2/(DistanceAfterHeaters.flowModel.crossAreas
        [i]+DistanceAfterHeaters.flowModel.crossAreas[i+1]) for i in 1:
        DistanceAfterHeaters.flowModel.n-1);
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialGenericPipeFlow
    equation
      for i in (1:DistanceAfterHeaters.flowModel.n-1) loop
        assert(DistanceAfterHeaters.flowModel.m_flows[i] >  -DistanceAfterHeaters.flowModel.m_flow_small
           or DistanceAfterHeaters.flowModel.allowFlowReversal, "Reversing flow occurs even though allowFlowReversal is false");
      end for;
      if (DistanceAfterHeaters.flowModel.continuousFlowReversal) then 
        if (DistanceAfterHeaters.flowModel.from_dp and true) then 
          DistanceAfterHeaters.flowModel.m_flows = homotopy(massFlowRate_dp_Unique14
            (DistanceAfterHeaters.flowModel.dps_fg-(array(DistanceAfterHeaters.flowModel.g
            *DistanceAfterHeaters.flowModel.dheights[i]*DistanceAfterHeaters.flowModel.rhos_act
            [i] for i in 1:DistanceAfterHeaters.flowModel.n-1)), 
            DistanceAfterHeaters.flowModel.rhos_act, DistanceAfterHeaters.flowModel.rhos_act,
             DistanceAfterHeaters.flowModel.mus_act, DistanceAfterHeaters.flowModel.mus_act,
             DistanceAfterHeaters.flowModel.pathLengths_internal, 
            DistanceAfterHeaters.flowModel.diameters, (DistanceAfterHeaters.flowModel.crossAreas
            [1:DistanceAfterHeaters.flowModel.n-1]+DistanceAfterHeaters.flowModel.crossAreas
            [2:DistanceAfterHeaters.flowModel.n])/2, (DistanceAfterHeaters.flowModel.roughnesses
            [1:DistanceAfterHeaters.flowModel.n-1]+DistanceAfterHeaters.flowModel.roughnesses
            [2:DistanceAfterHeaters.flowModel.n])/2, DistanceAfterHeaters.flowModel.dp_small
            /(DistanceAfterHeaters.flowModel.n-1), DistanceAfterHeaters.flowModel.Res_turbulent_internal)
            *DistanceAfterHeaters.flowModel.nParallel, DistanceAfterHeaters.flowModel.m_flow_nominal
            /DistanceAfterHeaters.flowModel.dp_nominal*(DistanceAfterHeaters.flowModel.dps_fg
            -DistanceAfterHeaters.flowModel.g*DistanceAfterHeaters.flowModel.dheights
            *DistanceAfterHeaters.flowModel.rho_nominal));
        else
          DistanceAfterHeaters.flowModel.dps_fg = homotopy(pressureLoss_m_flow_Unique12
            (DistanceAfterHeaters.flowModel.m_flows/DistanceAfterHeaters.flowModel.nParallel,
             DistanceAfterHeaters.flowModel.rhos_act, DistanceAfterHeaters.flowModel.rhos_act,
             DistanceAfterHeaters.flowModel.mus_act, DistanceAfterHeaters.flowModel.mus_act,
             DistanceAfterHeaters.flowModel.pathLengths_internal, 
            DistanceAfterHeaters.flowModel.diameters, (DistanceAfterHeaters.flowModel.crossAreas
            [1:DistanceAfterHeaters.flowModel.n-1]+DistanceAfterHeaters.flowModel.crossAreas
            [2:DistanceAfterHeaters.flowModel.n])/2, (DistanceAfterHeaters.flowModel.roughnesses
            [1:DistanceAfterHeaters.flowModel.n-1]+DistanceAfterHeaters.flowModel.roughnesses
            [2:DistanceAfterHeaters.flowModel.n])/2, DistanceAfterHeaters.flowModel.m_flow_small
            /DistanceAfterHeaters.flowModel.nParallel, DistanceAfterHeaters.flowModel.Res_turbulent_internal)
            +(array(DistanceAfterHeaters.flowModel.g*DistanceAfterHeaters.flowModel.dheights
            [i]*DistanceAfterHeaters.flowModel.rhos_act[i] for i in 1:
            DistanceAfterHeaters.flowModel.n-1)), DistanceAfterHeaters.flowModel.dp_nominal
            /DistanceAfterHeaters.flowModel.m_flow_nominal*DistanceAfterHeaters.flowModel.m_flows
            +DistanceAfterHeaters.flowModel.g*DistanceAfterHeaters.flowModel.dheights
            *DistanceAfterHeaters.flowModel.rho_nominal);
        end if;
      else
        if (DistanceAfterHeaters.flowModel.from_dp and true) then 
          DistanceAfterHeaters.flowModel.m_flows = homotopy(massFlowRate_dp_staticHead_Unique16
            (DistanceAfterHeaters.flowModel.dps_fg, DistanceAfterHeaters.flowModel.rhos
            [1:DistanceAfterHeaters.flowModel.n-1], DistanceAfterHeaters.flowModel.rhos
            [2:DistanceAfterHeaters.flowModel.n], DistanceAfterHeaters.flowModel.mus
            [1:DistanceAfterHeaters.flowModel.n-1], DistanceAfterHeaters.flowModel.mus
            [2:DistanceAfterHeaters.flowModel.n], DistanceAfterHeaters.flowModel.pathLengths_internal,
             DistanceAfterHeaters.flowModel.diameters, DistanceAfterHeaters.flowModel.g
            *DistanceAfterHeaters.flowModel.dheights, (DistanceAfterHeaters.flowModel.crossAreas
            [1:DistanceAfterHeaters.flowModel.n-1]+DistanceAfterHeaters.flowModel.crossAreas
            [2:DistanceAfterHeaters.flowModel.n])/2, (DistanceAfterHeaters.flowModel.roughnesses
            [1:DistanceAfterHeaters.flowModel.n-1]+DistanceAfterHeaters.flowModel.roughnesses
            [2:DistanceAfterHeaters.flowModel.n])/2, DistanceAfterHeaters.flowModel.dp_small
            /(DistanceAfterHeaters.flowModel.n-1), DistanceAfterHeaters.flowModel.Res_turbulent_internal)
            *DistanceAfterHeaters.flowModel.nParallel, DistanceAfterHeaters.flowModel.m_flow_nominal
            /DistanceAfterHeaters.flowModel.dp_nominal*(DistanceAfterHeaters.flowModel.dps_fg
            -DistanceAfterHeaters.flowModel.g*DistanceAfterHeaters.flowModel.dheights
            *DistanceAfterHeaters.flowModel.rho_nominal));
        else
          DistanceAfterHeaters.flowModel.dps_fg = homotopy(pressureLoss_m_flow_staticHead_Unique17
            (DistanceAfterHeaters.flowModel.m_flows/DistanceAfterHeaters.flowModel.nParallel,
             DistanceAfterHeaters.flowModel.rhos[1:DistanceAfterHeaters.flowModel.n
            -1], DistanceAfterHeaters.flowModel.rhos[2:DistanceAfterHeaters.flowModel.n],
             DistanceAfterHeaters.flowModel.mus[1:DistanceAfterHeaters.flowModel.n
            -1], DistanceAfterHeaters.flowModel.mus[2:DistanceAfterHeaters.flowModel.n],
             DistanceAfterHeaters.flowModel.pathLengths_internal, 
            DistanceAfterHeaters.flowModel.diameters, DistanceAfterHeaters.flowModel.g
            *DistanceAfterHeaters.flowModel.dheights, (DistanceAfterHeaters.flowModel.crossAreas
            [1:DistanceAfterHeaters.flowModel.n-1]+DistanceAfterHeaters.flowModel.crossAreas
            [2:DistanceAfterHeaters.flowModel.n])/2, (DistanceAfterHeaters.flowModel.roughnesses
            [1:DistanceAfterHeaters.flowModel.n-1]+DistanceAfterHeaters.flowModel.roughnesses
            [2:DistanceAfterHeaters.flowModel.n])/2, DistanceAfterHeaters.flowModel.m_flow_small
            /DistanceAfterHeaters.flowModel.nParallel, DistanceAfterHeaters.flowModel.Res_turbulent_internal),
             DistanceAfterHeaters.flowModel.dp_nominal/DistanceAfterHeaters.flowModel.m_flow_nominal
            *DistanceAfterHeaters.flowModel.m_flows+DistanceAfterHeaters.flowModel.g
            *DistanceAfterHeaters.flowModel.dheights*DistanceAfterHeaters.flowModel.rho_nominal);
        end if;
      end if;
    // end of extends 

  // Component DistanceAfterHeaters
  // class Modelica.Fluid.Pipes.StaticPipe
    // extends Modelica.Fluid.Pipes.BaseClasses.PartialStraightPipe
    equation
      assert(DistanceAfterHeaters.length >= DistanceAfterHeaters.height_ab, 
        "Parameter length must be greater or equal height_ab.");
    // end of extends 
  equation
    DistanceAfterHeaters.port_a.m_flow = DistanceAfterHeaters.flowModel.m_flows[1];
    0 = DistanceAfterHeaters.port_a.m_flow+DistanceAfterHeaters.port_b.m_flow;
    DistanceAfterHeaters.port_a.Xi_outflow = inStream(DistanceAfterHeaters.port_b.Xi_outflow);
    DistanceAfterHeaters.port_b.Xi_outflow = inStream(DistanceAfterHeaters.port_a.Xi_outflow);
    DistanceAfterHeaters.port_a.C_outflow = inStream(DistanceAfterHeaters.port_b.C_outflow);
    DistanceAfterHeaters.port_b.C_outflow = inStream(DistanceAfterHeaters.port_a.C_outflow);
    DistanceAfterHeaters.port_b.h_outflow = inStream(DistanceAfterHeaters.port_a.h_outflow)
      -DistanceAfterHeaters.system.g*DistanceAfterHeaters.height_ab;
    DistanceAfterHeaters.port_a.h_outflow = inStream(DistanceAfterHeaters.port_b.h_outflow)
      +DistanceAfterHeaters.system.g*DistanceAfterHeaters.height_ab;

  // Component heater3.Heater.geometry
  // class INL_DT.Components.Heater.Geometry
    // extends TRANSFORM.Fluid.ClosureRelations.Geometry.Models.DistributedVolume_1D.GenericPipe
    equation
      for i in (1:heater3.Heater.geometry.nV) loop
        assert(heater3.Heater.geometry.dimensions[i] > 0, "Characteristic dimension must be > 0");
        assert(heater3.Heater.geometry.dlengths[i] >= abs(heater3.Heater.geometry.dheights
          [i]), "Geometry dlengths must be greater or equal to abs(dheights)");
      end for;
    // end of extends 

  // Component heater3.Heater.flowModel.firstOrder_dps_K[1]
  // class Modelica.Blocks.Continuous.FirstOrder
  equation
    der(heater3.Heater.flowModel.firstOrder_dps_K[1].y) = (heater3.Heater.flowModel.firstOrder_dps_K[1].k
      *heater3.Heater.flowModel.firstOrder_dps_K[1].u-heater3.Heater.flowModel.firstOrder_dps_K[1].y)
      /heater3.Heater.flowModel.firstOrder_dps_K[1].T;

  // Component heater3.Heater.flowModel.mediaProps[1]
  // class TRANSFORM.Media.BaseProperties1Phase
  equation
    heater3.Heater.flowModel.mediaProps[1].h = Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_Unique25
      (
      heater3.Heater.flowModel.mediaProps[1].state);
    heater3.Heater.flowModel.mediaProps[1].d = Modelica.Media.Water.WaterIF97_ph.density_Unique5
      (
      heater3.Heater.flowModel.mediaProps[1].state);
    heater3.Heater.flowModel.mediaProps[1].T = Modelica.Media.Water.WaterIF97_ph.temperature_Unique28
      (
      heater3.Heater.flowModel.mediaProps[1].state);
    heater3.Heater.flowModel.mediaProps[1].p = Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
      (
      heater3.Heater.flowModel.mediaProps[1].state);
    heater3.Heater.flowModel.mediaProps[1].mu = Modelica.Media.Water.WaterIF97_ph.dynamicViscosity_Unique6
      (
      heater3.Heater.flowModel.mediaProps[1].state);
    heater3.Heater.flowModel.mediaProps[1].lambda = Modelica.Media.Water.WaterIF97_ph.thermalConductivity_Unique45
      (
      heater3.Heater.flowModel.mediaProps[1].state);
    heater3.Heater.flowModel.mediaProps[1].cp = Modelica.Media.Water.WaterIF97_ph.specificHeatCapacityCp_Unique46
      (
      heater3.Heater.flowModel.mediaProps[1].state);

  // Component heater3.Heater.flowModel.mediaProps[2]
  // class TRANSFORM.Media.BaseProperties1Phase
  equation
    heater3.Heater.flowModel.mediaProps[2].h = Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_Unique25
      (
      heater3.Heater.flowModel.mediaProps[2].state);
    heater3.Heater.flowModel.mediaProps[2].d = Modelica.Media.Water.WaterIF97_ph.density_Unique5
      (
      heater3.Heater.flowModel.mediaProps[2].state);
    heater3.Heater.flowModel.mediaProps[2].T = Modelica.Media.Water.WaterIF97_ph.temperature_Unique28
      (
      heater3.Heater.flowModel.mediaProps[2].state);
    heater3.Heater.flowModel.mediaProps[2].p = Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
      (
      heater3.Heater.flowModel.mediaProps[2].state);
    heater3.Heater.flowModel.mediaProps[2].mu = Modelica.Media.Water.WaterIF97_ph.dynamicViscosity_Unique6
      (
      heater3.Heater.flowModel.mediaProps[2].state);
    heater3.Heater.flowModel.mediaProps[2].lambda = Modelica.Media.Water.WaterIF97_ph.thermalConductivity_Unique45
      (
      heater3.Heater.flowModel.mediaProps[2].state);
    heater3.Heater.flowModel.mediaProps[2].cp = Modelica.Media.Water.WaterIF97_ph.specificHeatCapacityCp_Unique46
      (
      heater3.Heater.flowModel.mediaProps[2].state);

  // Component heater3.Heater.flowModel
  // class INL_DT.Components.Heater.FlowModel
    // extends TRANSFORM.Fluid.ClosureRelations.PressureLoss.Models.DistributedPipe_1D.PartialDistributedStaggeredFlow
    equation
      for i in (1:heater3.Heater.flowModel.nFM) loop
        assert(heater3.Heater.flowModel.m_flows[i] >  -heater3.Heater.flowModel.m_flow_small
           or heater3.Heater.flowModel.allowFlowReversal, "Reverting flow occurs in flowModel even though allowFlowReversal is false");
      end for;
      heater3.Heater.flowModel.Is = array(heater3.Heater.flowModel.m_flows[i]*
        heater3.Heater.flowModel.dlengths[i] for i in 1:heater3.Heater.flowModel.nFM);
      if (heater3.Heater.flowModel.momentumDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) then 
        for i in (1:heater3.Heater.flowModel.nFM) loop
          0 = heater3.Heater.flowModel.Ibs[i];
        end for;
      else
        for i in (1:heater3.Heater.flowModel.nFM) loop
          der(heater3.Heater.flowModel.Is[i]) = heater3.Heater.flowModel.Ibs[i];
        end for;
      end if;
    // extends TRANSFORM.Fluid.ClosureRelations.PressureLoss.Models.DistributedPipe_1D.PartialMomentumBalance
    equation
      heater3.Heater.flowModel.Ibs = heater3.Heater.flowModel.I_flows-
        heater3.Heater.flowModel.Fs_p-heater3.Heater.flowModel.Fs_fg;
      if (heater3.Heater.flowModel.use_I_flows) then 
        heater3.Heater.flowModel.I_flows = array(heater3.Heater.flowModel.crossAreas
          [i]*Modelica.Media.Water.WaterIF97_ph.density_Unique5(
          heater3.Heater.flowModel.states[i])*heater3.Heater.flowModel.vs[i]*
          heater3.Heater.flowModel.vs[i]-heater3.Heater.flowModel.crossAreas[i+1]
          *Modelica.Media.Water.WaterIF97_ph.density_Unique5(
          heater3.Heater.flowModel.states[i+1])*heater3.Heater.flowModel.vs[i+1]
          *heater3.Heater.flowModel.vs[i+1] for i in 1:heater3.Heater.flowModel.nFM);
      else
        heater3.Heater.flowModel.I_flows = zeros(heater3.Heater.flowModel.nFM);
      end if;
      heater3.Heater.flowModel.Fs_p = array(0.5*(heater3.Heater.flowModel.crossAreas
        [i]+heater3.Heater.flowModel.crossAreas[i+1])*(Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
        (
        heater3.Heater.flowModel.states[i+1])-Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
        (
        heater3.Heater.flowModel.states[i])) for i in 1:heater3.Heater.flowModel.nFM);
      heater3.Heater.flowModel.Fs_fg = array((heater3.Heater.flowModel.dps_fg[i]
        +heater3.Heater.flowModel.firstOrder_dps_K[i].y)*0.5*(heater3.Heater.flowModel.crossAreas
        [i]+heater3.Heater.flowModel.crossAreas[i+1]) for i in 1:
        heater3.Heater.flowModel.nFM);
      heater3.Heater.flowModel.dps_K = array(noEvent((if heater3.Heater.flowModel.m_flows
        [i] > 0 then 0.5*heater3.Heater.flowModel.Ks_ab[i]*Modelica.Media.Water.WaterIF97_ph.density_Unique5
        (
        heater3.Heater.flowModel.states[i])*heater3.Heater.flowModel.vs[i]*
        heater3.Heater.flowModel.vs[i] else  -0.5*heater3.Heater.flowModel.Ks_ba
        [i]*Modelica.Media.Water.WaterIF97_ph.density_Unique5(
        heater3.Heater.flowModel.states[i+1])*heater3.Heater.flowModel.vs[i+1]*
        heater3.Heater.flowModel.vs[i+1])) for i in 1:heater3.Heater.flowModel.nFM);
      heater3.Heater.flowModel.firstOrder_dps_K[:].u = heater3.Heater.flowModel.dps_K;
    // extends TRANSFORM.Fluid.ClosureRelations.PressureLoss.Models.DistributedPipe_1D.PartialSinglePhase
    equation
      for i in (1:heater3.Heater.flowModel.nFM) loop
        heater3.Heater.flowModel.Res[i] = 0.5*((heater3.Heater.flowModel.dimensions
          [i]+heater3.Heater.flowModel.dimensions[i+1])*abs(heater3.Heater.flowModel.m_flows
          [i]))/(0.25*((heater3.Heater.flowModel.crossAreas[i]+heater3.Heater.flowModel.crossAreas
          [i+1])*(heater3.Heater.flowModel.mediaProps[i].mu+heater3.Heater.flowModel.mediaProps
          [i+1].mu)));
      end for;
    // extends TRANSFORM.Fluid.ClosureRelations.PressureLoss.Models.DistributedPipe_1D.SinglePhase_Developed_2Region_NumStable
    equation
      for i in (1:heater3.Heater.flowModel.nFM) loop
        heater3.Heater.flowModel.ds[i] = TRANSFORM.Math.spliceTanh(
          heater3.Heater.flowModel.ds_a[i], heater3.Heater.flowModel.ds_b[i], 
          heater3.Heater.flowModel.m_flows[i], heater3.Heater.flowModel.m_flow_small);
        heater3.Heater.flowModel.mus[i] = TRANSFORM.Math.spliceTanh(
          heater3.Heater.flowModel.mus_a[i], heater3.Heater.flowModel.mus_b[i], 
          heater3.Heater.flowModel.m_flows[i], heater3.Heater.flowModel.m_flow_small);
      end for;
      if (heater3.Heater.flowModel.continuousFlowReversal) then 
        if (heater3.Heater.flowModel.from_dp) then 
          heater3.Heater.flowModel.m_flows = homotopy(TRANSFORM.Fluid.ClosureRelations.PressureLoss.Functions.TubesAndConduits.SinglePhase.LaminarTurbulent_MSLDetailed.dp_MFLOW
            (
            heater3.Heater.flowModel.IN_con, 
            heater3.Heater.flowModel.IN_var, 
            heater3.Heater.flowModel.dps_fg-(array(heater3.Heater.flowModel.g_n*
              heater3.Heater.flowModel.dheights[i]*heater3.Heater.flowModel.ds_a
              [i] for i in 1:heater3.Heater.flowModel.nFM)), 
            heater3.Heater.flowModel.dp_small/heater3.Heater.flowModel.nFM), 
            heater3.Heater.flowModel.m_flow_nominal/heater3.Heater.flowModel.dp_nominal
            *(heater3.Heater.flowModel.dps_fg-heater3.Heater.flowModel.g_n*
            heater3.Heater.flowModel.dheights*heater3.Heater.flowModel.d_nominal));
        else
          heater3.Heater.flowModel.dps_fg = homotopy(TRANSFORM.Fluid.ClosureRelations.PressureLoss.Functions.TubesAndConduits.SinglePhase.LaminarTurbulent_MSLDetailed.dp_DP
            (
            heater3.Heater.flowModel.IN_con, 
            heater3.Heater.flowModel.IN_var, 
            heater3.Heater.flowModel.m_flows, 
            heater3.Heater.flowModel.m_flow_small)+(array(heater3.Heater.flowModel.g_n
            *heater3.Heater.flowModel.dheights[i]*heater3.Heater.flowModel.ds_a[
            i] for i in 1:heater3.Heater.flowModel.nFM)), heater3.Heater.flowModel.dp_nominal
            /heater3.Heater.flowModel.m_flow_nominal*heater3.Heater.flowModel.m_flows
            +heater3.Heater.flowModel.g_n*heater3.Heater.flowModel.dheights*
            heater3.Heater.flowModel.d_nominal);
        end if;
      else
        if (heater3.Heater.flowModel.from_dp) then 
          heater3.Heater.flowModel.m_flows = homotopy(TRANSFORM.Fluid.ClosureRelations.PressureLoss.Functions.TubesAndConduits.SinglePhase.LaminarTurbulent_MSLDetailed.dp_MFLOW_staticHead
            (
            heater3.Heater.flowModel.IN_con, 
            heater3.Heater.flowModel.IN_var, 
            heater3.Heater.flowModel.dps_fg, 
            heater3.Heater.flowModel.dp_small/heater3.Heater.flowModel.nFM, 
            heater3.Heater.flowModel.g_n*heater3.Heater.flowModel.dheights), 
            heater3.Heater.flowModel.m_flow_nominal/heater3.Heater.flowModel.dp_nominal
            *(heater3.Heater.flowModel.dps_fg-heater3.Heater.flowModel.g_n*
            heater3.Heater.flowModel.dheights*heater3.Heater.flowModel.d_nominal));
        else
          heater3.Heater.flowModel.dps_fg = homotopy(TRANSFORM.Fluid.ClosureRelations.PressureLoss.Functions.TubesAndConduits.SinglePhase.LaminarTurbulent_MSLDetailed.dp_DP_staticHead
            (
            heater3.Heater.flowModel.IN_con, 
            heater3.Heater.flowModel.IN_var, 
            heater3.Heater.flowModel.m_flows, 
            heater3.Heater.flowModel.m_flow_small, 
            heater3.Heater.flowModel.g_n*heater3.Heater.flowModel.dheights), 
            heater3.Heater.flowModel.dp_nominal/heater3.Heater.flowModel.m_flow_nominal
            *heater3.Heater.flowModel.m_flows+heater3.Heater.flowModel.g_n*
            heater3.Heater.flowModel.dheights*heater3.Heater.flowModel.d_nominal);
        end if;
      end if;
    // end of extends 

  // Component heater3.Heater.heatTransfer.mediums[1]
  // class TRANSFORM.Media.BaseProperties1Phase
  equation
    heater3.Heater.heatTransfer.mediums[1].h = Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_Unique25
      (
      heater3.Heater.heatTransfer.mediums[1].state);
    heater3.Heater.heatTransfer.mediums[1].d = Modelica.Media.Water.WaterIF97_ph.density_Unique5
      (
      heater3.Heater.heatTransfer.mediums[1].state);
    heater3.Heater.heatTransfer.mediums[1].T = Modelica.Media.Water.WaterIF97_ph.temperature_Unique28
      (
      heater3.Heater.heatTransfer.mediums[1].state);
    heater3.Heater.heatTransfer.mediums[1].p = Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
      (
