            [2:PumpPipe.flowModel.n], PumpPipe.flowModel.mus[1:PumpPipe.flowModel.n
            -1], PumpPipe.flowModel.mus[2:PumpPipe.flowModel.n], 
            PumpPipe.flowModel.pathLengths_internal, PumpPipe.flowModel.diameters,
             PumpPipe.flowModel.g*PumpPipe.flowModel.dheights, (PumpPipe.flowModel.crossAreas
            [1:PumpPipe.flowModel.n-1]+PumpPipe.flowModel.crossAreas[2:
            PumpPipe.flowModel.n])/2, (PumpPipe.flowModel.roughnesses[1:
            PumpPipe.flowModel.n-1]+PumpPipe.flowModel.roughnesses[2:
            PumpPipe.flowModel.n])/2, PumpPipe.flowModel.m_flow_small/
            PumpPipe.flowModel.nParallel, PumpPipe.flowModel.Res_turbulent_internal),
             PumpPipe.flowModel.dp_nominal/PumpPipe.flowModel.m_flow_nominal*
            PumpPipe.flowModel.m_flows+PumpPipe.flowModel.g*PumpPipe.flowModel.dheights
            *PumpPipe.flowModel.rho_nominal);
        end if;
      end if;
    // end of extends 

  // Component PumpPipe
  // class Modelica.Fluid.Pipes.StaticPipe
    // extends Modelica.Fluid.Pipes.BaseClasses.PartialStraightPipe
    equation
      assert(PumpPipe.length >= PumpPipe.height_ab, "Parameter length must be greater or equal height_ab.");
    // end of extends 
  equation
    PumpPipe.port_a.m_flow = PumpPipe.flowModel.m_flows[1];
    0 = PumpPipe.port_a.m_flow+PumpPipe.port_b.m_flow;
    PumpPipe.port_a.Xi_outflow = inStream(PumpPipe.port_b.Xi_outflow);
    PumpPipe.port_b.Xi_outflow = inStream(PumpPipe.port_a.Xi_outflow);
    PumpPipe.port_a.C_outflow = inStream(PumpPipe.port_b.C_outflow);
    PumpPipe.port_b.C_outflow = inStream(PumpPipe.port_a.C_outflow);
    PumpPipe.port_b.h_outflow = inStream(PumpPipe.port_a.h_outflow)-
      PumpPipe.system.g*PumpPipe.height_ab;
    PumpPipe.port_a.h_outflow = inStream(PumpPipe.port_b.h_outflow)+
      PumpPipe.system.g*PumpPipe.height_ab;

  // Component pump
  // class TRANSFORM.Fluid.Machines.Pump_SimpleMassFlow
  equation
    if ( not pump.use_input) then 
      pump.m_flow_internal = pump.m_flow_nominal;
    end if;
    pump.m_flow = pump.m_flow_internal;
    pump.port_a.m_flow+pump.port_b.m_flow = 0;
    pump.port_a.m_flow = pump.m_flow;
    pump.port_a.h_outflow = inStream(pump.port_b.h_outflow);
    pump.port_b.h_outflow = inStream(pump.port_a.h_outflow);
    pump.port_a.Xi_outflow = inStream(pump.port_b.Xi_outflow);
    pump.port_b.Xi_outflow = inStream(pump.port_a.Xi_outflow);
    pump.port_a.C_outflow = inStream(pump.port_b.C_outflow);
    pump.port_b.C_outflow = inStream(pump.port_a.C_outflow);

  // Component DistanceAfterHX.flowModel
  // class INL_DT.Components.NCFL.FlowModel
    // extends Modelica.Fluid.Interfaces.PartialDistributedFlow
    equation
      DistanceAfterHX.flowModel.Is = array(DistanceAfterHX.flowModel.m_flows[i]*
        DistanceAfterHX.flowModel.pathLengths[i] for i in 1:DistanceAfterHX.flowModel.m);
      if (DistanceAfterHX.flowModel.momentumDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) then 
        zeros(DistanceAfterHX.flowModel.m) = DistanceAfterHX.flowModel.Ib_flows-
          DistanceAfterHX.flowModel.Fs_p-DistanceAfterHX.flowModel.Fs_fg;
      else
        der(DistanceAfterHX.flowModel.Is) = DistanceAfterHX.flowModel.Ib_flows-
          DistanceAfterHX.flowModel.Fs_p-DistanceAfterHX.flowModel.Fs_fg;
      end if;
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialStaggeredFlowModel
    equation
      if ( not DistanceAfterHX.flowModel.allowFlowReversal) then 
        DistanceAfterHX.flowModel.rhos_act = DistanceAfterHX.flowModel.rhos[1:
          DistanceAfterHX.flowModel.n-1];
        DistanceAfterHX.flowModel.mus_act = DistanceAfterHX.flowModel.mus[1:
          DistanceAfterHX.flowModel.n-1];
      elseif ( not DistanceAfterHX.flowModel.useUpstreamScheme) then 
        DistanceAfterHX.flowModel.rhos_act = 0.5*(DistanceAfterHX.flowModel.rhos
          [1:DistanceAfterHX.flowModel.n-1]+DistanceAfterHX.flowModel.rhos[2:
          DistanceAfterHX.flowModel.n]);
        DistanceAfterHX.flowModel.mus_act = 0.5*(DistanceAfterHX.flowModel.mus[1
          :DistanceAfterHX.flowModel.n-1]+DistanceAfterHX.flowModel.mus[2:
          DistanceAfterHX.flowModel.n]);
      else
        for i in (1:DistanceAfterHX.flowModel.n-1) loop
          DistanceAfterHX.flowModel.rhos_act[i] = noEvent((if DistanceAfterHX.flowModel.m_flows
            [i] > 0 then DistanceAfterHX.flowModel.rhos[i] else DistanceAfterHX.flowModel.rhos
            [i+1]));
          DistanceAfterHX.flowModel.mus_act[i] = noEvent((if DistanceAfterHX.flowModel.m_flows
            [i] > 0 then DistanceAfterHX.flowModel.mus[i] else DistanceAfterHX.flowModel.mus
            [i+1]));
        end for;
      end if;
      if (DistanceAfterHX.flowModel.use_Ib_flows) then 
        DistanceAfterHX.flowModel.Ib_flows = DistanceAfterHX.flowModel.nParallel
          *(array(DistanceAfterHX.flowModel.rhos[i]*DistanceAfterHX.flowModel.vs
          [i]*DistanceAfterHX.flowModel.vs[i]*DistanceAfterHX.flowModel.crossAreas
          [i]-DistanceAfterHX.flowModel.rhos[i+1]*DistanceAfterHX.flowModel.vs[i
          +1]*DistanceAfterHX.flowModel.vs[i+1]*DistanceAfterHX.flowModel.crossAreas
          [i+1] for i in 1:DistanceAfterHX.flowModel.n-1));
      else
        DistanceAfterHX.flowModel.Ib_flows = zeros(DistanceAfterHX.flowModel.n-1);
      end if;
      DistanceAfterHX.flowModel.Fs_p = DistanceAfterHX.flowModel.nParallel*(
        array(0.5*(DistanceAfterHX.flowModel.crossAreas[i]+DistanceAfterHX.flowModel.crossAreas
        [i+1])*(Modelica.Media.Water.WaterIF97_ph.pressure_Unique11(
        DistanceAfterHX.flowModel.states[i+1])-Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
        (
        DistanceAfterHX.flowModel.states[i])) for i in 1:DistanceAfterHX.flowModel.n
        -1));
      DistanceAfterHX.flowModel.dps_fg = array(DistanceAfterHX.flowModel.Fs_fg[i]
        /DistanceAfterHX.flowModel.nParallel*2/(DistanceAfterHX.flowModel.crossAreas
        [i]+DistanceAfterHX.flowModel.crossAreas[i+1]) for i in 1:
        DistanceAfterHX.flowModel.n-1);
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialGenericPipeFlow
    equation
      for i in (1:DistanceAfterHX.flowModel.n-1) loop
        assert(DistanceAfterHX.flowModel.m_flows[i] >  -DistanceAfterHX.flowModel.m_flow_small
           or DistanceAfterHX.flowModel.allowFlowReversal, "Reversing flow occurs even though allowFlowReversal is false");
      end for;
      if (DistanceAfterHX.flowModel.continuousFlowReversal) then 
        if (DistanceAfterHX.flowModel.from_dp and true) then 
          DistanceAfterHX.flowModel.m_flows = homotopy(massFlowRate_dp_Unique14(
            DistanceAfterHX.flowModel.dps_fg-(array(DistanceAfterHX.flowModel.g*
            DistanceAfterHX.flowModel.dheights[i]*DistanceAfterHX.flowModel.rhos_act
            [i] for i in 1:DistanceAfterHX.flowModel.n-1)), DistanceAfterHX.flowModel.rhos_act,
             DistanceAfterHX.flowModel.rhos_act, DistanceAfterHX.flowModel.mus_act,
             DistanceAfterHX.flowModel.mus_act, DistanceAfterHX.flowModel.pathLengths_internal,
             DistanceAfterHX.flowModel.diameters, (DistanceAfterHX.flowModel.crossAreas
            [1:DistanceAfterHX.flowModel.n-1]+DistanceAfterHX.flowModel.crossAreas
            [2:DistanceAfterHX.flowModel.n])/2, (DistanceAfterHX.flowModel.roughnesses
            [1:DistanceAfterHX.flowModel.n-1]+DistanceAfterHX.flowModel.roughnesses
            [2:DistanceAfterHX.flowModel.n])/2, DistanceAfterHX.flowModel.dp_small
            /(DistanceAfterHX.flowModel.n-1), DistanceAfterHX.flowModel.Res_turbulent_internal)
            *DistanceAfterHX.flowModel.nParallel, DistanceAfterHX.flowModel.m_flow_nominal
            /DistanceAfterHX.flowModel.dp_nominal*(DistanceAfterHX.flowModel.dps_fg
            -DistanceAfterHX.flowModel.g*DistanceAfterHX.flowModel.dheights*
            DistanceAfterHX.flowModel.rho_nominal));
        else
          DistanceAfterHX.flowModel.dps_fg = homotopy(pressureLoss_m_flow_Unique12
            (DistanceAfterHX.flowModel.m_flows/DistanceAfterHX.flowModel.nParallel,
             DistanceAfterHX.flowModel.rhos_act, DistanceAfterHX.flowModel.rhos_act,
             DistanceAfterHX.flowModel.mus_act, DistanceAfterHX.flowModel.mus_act,
             DistanceAfterHX.flowModel.pathLengths_internal, DistanceAfterHX.flowModel.diameters,
             (DistanceAfterHX.flowModel.crossAreas[1:DistanceAfterHX.flowModel.n
            -1]+DistanceAfterHX.flowModel.crossAreas[2:DistanceAfterHX.flowModel.n])
            /2, (DistanceAfterHX.flowModel.roughnesses[1:DistanceAfterHX.flowModel.n
            -1]+DistanceAfterHX.flowModel.roughnesses[2:DistanceAfterHX.flowModel.n])
            /2, DistanceAfterHX.flowModel.m_flow_small/DistanceAfterHX.flowModel.nParallel,
             DistanceAfterHX.flowModel.Res_turbulent_internal)+(array(
            DistanceAfterHX.flowModel.g*DistanceAfterHX.flowModel.dheights[i]*
            DistanceAfterHX.flowModel.rhos_act[i] for i in 1:DistanceAfterHX.flowModel.n
            -1)), DistanceAfterHX.flowModel.dp_nominal/DistanceAfterHX.flowModel.m_flow_nominal
            *DistanceAfterHX.flowModel.m_flows+DistanceAfterHX.flowModel.g*
            DistanceAfterHX.flowModel.dheights*DistanceAfterHX.flowModel.rho_nominal);
        end if;
      else
        if (DistanceAfterHX.flowModel.from_dp and true) then 
          DistanceAfterHX.flowModel.m_flows = homotopy(massFlowRate_dp_staticHead_Unique16
            (DistanceAfterHX.flowModel.dps_fg, DistanceAfterHX.flowModel.rhos[1:
            DistanceAfterHX.flowModel.n-1], DistanceAfterHX.flowModel.rhos[2:
            DistanceAfterHX.flowModel.n], DistanceAfterHX.flowModel.mus[1:
            DistanceAfterHX.flowModel.n-1], DistanceAfterHX.flowModel.mus[2:
            DistanceAfterHX.flowModel.n], DistanceAfterHX.flowModel.pathLengths_internal,
             DistanceAfterHX.flowModel.diameters, DistanceAfterHX.flowModel.g*
            DistanceAfterHX.flowModel.dheights, (DistanceAfterHX.flowModel.crossAreas
            [1:DistanceAfterHX.flowModel.n-1]+DistanceAfterHX.flowModel.crossAreas
            [2:DistanceAfterHX.flowModel.n])/2, (DistanceAfterHX.flowModel.roughnesses
            [1:DistanceAfterHX.flowModel.n-1]+DistanceAfterHX.flowModel.roughnesses
            [2:DistanceAfterHX.flowModel.n])/2, DistanceAfterHX.flowModel.dp_small
            /(DistanceAfterHX.flowModel.n-1), DistanceAfterHX.flowModel.Res_turbulent_internal)
            *DistanceAfterHX.flowModel.nParallel, DistanceAfterHX.flowModel.m_flow_nominal
            /DistanceAfterHX.flowModel.dp_nominal*(DistanceAfterHX.flowModel.dps_fg
            -DistanceAfterHX.flowModel.g*DistanceAfterHX.flowModel.dheights*
            DistanceAfterHX.flowModel.rho_nominal));
        else
          DistanceAfterHX.flowModel.dps_fg = homotopy(pressureLoss_m_flow_staticHead_Unique17
            (DistanceAfterHX.flowModel.m_flows/DistanceAfterHX.flowModel.nParallel,
             DistanceAfterHX.flowModel.rhos[1:DistanceAfterHX.flowModel.n-1], 
            DistanceAfterHX.flowModel.rhos[2:DistanceAfterHX.flowModel.n], 
            DistanceAfterHX.flowModel.mus[1:DistanceAfterHX.flowModel.n-1], 
            DistanceAfterHX.flowModel.mus[2:DistanceAfterHX.flowModel.n], 
            DistanceAfterHX.flowModel.pathLengths_internal, DistanceAfterHX.flowModel.diameters,
             DistanceAfterHX.flowModel.g*DistanceAfterHX.flowModel.dheights, (
            DistanceAfterHX.flowModel.crossAreas[1:DistanceAfterHX.flowModel.n-1]
            +DistanceAfterHX.flowModel.crossAreas[2:DistanceAfterHX.flowModel.n])
            /2, (DistanceAfterHX.flowModel.roughnesses[1:DistanceAfterHX.flowModel.n
            -1]+DistanceAfterHX.flowModel.roughnesses[2:DistanceAfterHX.flowModel.n])
            /2, DistanceAfterHX.flowModel.m_flow_small/DistanceAfterHX.flowModel.nParallel,
             DistanceAfterHX.flowModel.Res_turbulent_internal), DistanceAfterHX.flowModel.dp_nominal
            /DistanceAfterHX.flowModel.m_flow_nominal*DistanceAfterHX.flowModel.m_flows
            +DistanceAfterHX.flowModel.g*DistanceAfterHX.flowModel.dheights*
            DistanceAfterHX.flowModel.rho_nominal);
        end if;
      end if;
    // end of extends 

  // Component DistanceAfterHX
  // class Modelica.Fluid.Pipes.StaticPipe
    // extends Modelica.Fluid.Pipes.BaseClasses.PartialStraightPipe
    equation
      assert(DistanceAfterHX.length >= DistanceAfterHX.height_ab, 
        "Parameter length must be greater or equal height_ab.");
    // end of extends 
  equation
    DistanceAfterHX.port_a.m_flow = DistanceAfterHX.flowModel.m_flows[1];
    0 = DistanceAfterHX.port_a.m_flow+DistanceAfterHX.port_b.m_flow;
    DistanceAfterHX.port_a.Xi_outflow = inStream(DistanceAfterHX.port_b.Xi_outflow);
    DistanceAfterHX.port_b.Xi_outflow = inStream(DistanceAfterHX.port_a.Xi_outflow);
    DistanceAfterHX.port_a.C_outflow = inStream(DistanceAfterHX.port_b.C_outflow);
    DistanceAfterHX.port_b.C_outflow = inStream(DistanceAfterHX.port_a.C_outflow);
    DistanceAfterHX.port_b.h_outflow = inStream(DistanceAfterHX.port_a.h_outflow)
      -DistanceAfterHX.system.g*DistanceAfterHX.height_ab;
    DistanceAfterHX.port_a.h_outflow = inStream(DistanceAfterHX.port_b.h_outflow)
      +DistanceAfterHX.system.g*DistanceAfterHX.height_ab;

  // Component volume.medium
  // class Modelica.Media.Water.WaterIF97_base.BaseProperties
    // extends Modelica.Media.Interfaces.PartialMedium.BaseProperties_D1
    equation
      if (volume.medium.standardOrderComponents) then 
        volume.medium.Xi = volume.medium.X[1:0];
        volume.medium.X = {1.0};
        for i in (1:1) loop
          assert(volume.medium.X[i] >= -1E-05 and volume.medium.X[i] <= 1.00001,
             "Mass fraction X["+       String(i, true, 0)+"] = "+       String(
            volume.medium.X[i], true, 0)+"of substance "+({"water"})[i]+
            "\nof medium "+"WaterIF97"+" is not in the range 0..1");
        end for;
      end if;
      assert(volume.medium.p >= 0.0, "Pressure (= "+       String(
        volume.medium.p, true, 0)+" Pa) of medium \""+"WaterIF97"+
        "\" is negative\n(Temperature = "+       String(volume.medium.T, true, 0)
        +" K)");
    // end of extends 
  equation
    volume.medium.MM = _GlobalScope.Modelica.Media.Water.WaterIF97_ph.fluidConstants[1]
      .molarMass;
    volume.medium.phase = (if volume.medium.h < Modelica.Media.Water.WaterIF97_ph.bubbleEnthalpy_Unique29
      (
      volume.medium.sat) or volume.medium.h > Modelica.Media.Water.WaterIF97_ph.dewEnthalpy_Unique30
      (
      volume.medium.sat) or volume.medium.p > _GlobalScope.Modelica.Media.Water.WaterIF97_ph.fluidConstants[1]
      .criticalPressure then 1 else 2);
    volume.medium.d = Modelica.Media.Water.WaterIF97_ph.density_ph_Unique3(
      volume.medium.p, volume.medium.h, volume.medium.phase, 0);
    volume.medium.T = Modelica.Media.Water.WaterIF97_ph.temperature_ph_Unique4(
      volume.medium.p, volume.medium.h, volume.medium.phase, 0);
    volume.medium.sat.Tsat = Modelica.Media.Water.WaterIF97_ph.saturationTemperature_Unique37
      (volume.medium.p);
    volume.medium.sat.psat = volume.medium.p;
    volume.medium.u = volume.medium.h-volume.medium.p/volume.medium.d;
    volume.medium.R_s = 8.31446261815324/_GlobalScope.Modelica.Media.Water.WaterIF97_ph.fluidConstants[1]
      .molarMass;
    volume.medium.h = volume.medium.state.h;
    volume.medium.p = volume.medium.state.p;
    volume.medium.T = volume.medium.state.T;
    volume.medium.d = volume.medium.state.d;
    volume.medium.phase = volume.medium.state.phase;

  // Component volume
  // class TRANSFORM.Fluid.Volumes.MixingVolume
    // extends TRANSFORM.Fluid.Volumes.BaseClasses.PartialVolume
    equation
      assert( not (volume.energyDynamics <> Modelica.Fluid.Types.Dynamics.
        SteadyState and volume.massDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) or false, "If 'massDynamics == Modelica.Fluid.Types.Dynamics.SteadyState', then it is
         required that 'energyDynamics==Modelica.Fluid.Types.Dynamics.SteadyState' or Medium not conserving mass if volume is fixed.");
      volume.m = volume.V*volume.medium.d;
      volume.U = volume.m*volume.medium.u;
      volume.mXi = volume.m*volume.medium.Xi;
      volume.mC = volume.m*volume.C;
      if (volume.massDynamics == Modelica.Fluid.Types.Dynamics.SteadyState)
         then 
        0 = volume.mb;
      else
        der(volume.m) = volume.mb;
      end if;
      if (volume.energyDynamics == Modelica.Fluid.Types.Dynamics.SteadyState)
         then 
        0 = volume.Ub;
      else
        der(volume.U) = volume.Ub;
      end if;
      if (volume.substanceDynamics == Modelica.Fluid.Types.Dynamics.SteadyState)
         then 
        zeros(0) = volume.mXib;
      else
        der(volume.mXi) = volume.mXib;
      end if;
      if (volume.traceDynamics == Modelica.Fluid.Types.Dynamics.SteadyState)
         then 
        zeros(0) = volume.mCb;
      else
        der(volume.mC_scaled) = volume.mCb./{};
        volume.mC = volume.mC_scaled.*{};
      end if;
    // end of extends 
  equation
    if ( not volume.use_HeatPort) then 
      volume.Q_flow_internal = 0;
    end if;
    if ( not volume.use_TraceMassPort) then 
      volume.mC_flow_internal = zeros(0);
    end if;
    volume.port_a.p = fill(volume.medium.p+volume.medium.d*volume.g_n*0.5*
      volume.geometry.dheight, volume.nPorts_a);
    volume.port_b.p = fill(volume.medium.p-volume.medium.d*volume.g_n*0.5*
      volume.geometry.dheight, volume.nPorts_b);
    volume.port_a.h_outflow = fill(volume.medium.h, volume.nPorts_a);
    volume.port_b.h_outflow = fill(volume.medium.h, volume.nPorts_b);
    volume.port_a.Xi_outflow = fill(volume.medium.Xi, volume.nPorts_a);
    volume.port_b.Xi_outflow = fill(volume.medium.Xi, volume.nPorts_b);
    volume.port_a.C_outflow = fill(volume.C, volume.nPorts_a);
    volume.port_b.C_outflow = fill(volume.C, volume.nPorts_b);
    for i in (1:volume.nPorts_a) loop
      volume.H_flows_a[i] = volume.port_a[i].m_flow*actualStream(volume.port_a[i]
        .h_outflow);
      volume.mXi_flows_a[i, :] = volume.port_a[i].m_flow*actualStream(
        volume.port_a[i].Xi_outflow);
      volume.mC_flows_a[i, :] = volume.port_a[i].m_flow*actualStream(
        volume.port_a[i].C_outflow);
    end for;
    for i in (1:volume.nPorts_b) loop
      volume.H_flows_b[i] = volume.port_b[i].m_flow*actualStream(volume.port_b[i]
        .h_outflow);
      volume.mXi_flows_b[i, :] = volume.port_b[i].m_flow*actualStream(
        volume.port_b[i].Xi_outflow);
      volume.mC_flows_b[i, :] = volume.port_b[i].m_flow*actualStream(
        volume.port_b[i].C_outflow);
    end for;

  // Component s1.pressure
  // class Modelica.Fluid.Sensors.Pressure
    // extends Modelica.Fluid.Sensors.BaseClasses.PartialAbsoluteSensor
    equation
      s1.pressure.port.m_flow = 0;
      s1.pressure.port.h_outflow = 84013.0581525969;
      s1.pressure.port.Xi_outflow = {};
      s1.pressure.port.C_outflow = zeros(0);
    // end of extends 
  equation
    s1.pressure.p = s1.pressure.port.p;

  // Component s1.temperature
  // class Modelica.Fluid.Sensors.Temperature
    // extends Modelica.Fluid.Sensors.BaseClasses.PartialAbsoluteSensor
    equation
      s1.temperature.port.m_flow = 0;
      s1.temperature.port.h_outflow = 84013.0581525969;
      s1.temperature.port.Xi_outflow = {};
      s1.temperature.port.C_outflow = zeros(0);
    // end of extends 
  equation
    s1.temperature.T = Modelica.Media.Water.WaterIF97_ph.temperature_Unique39(
      Modelica.Media.Water.WaterIF97_ph.setState_phX_Unique40(s1.temperature.port.p,
         inStream(s1.temperature.port.h_outflow), inStream(s1.temperature.port.Xi_outflow),
         0, 0));

  // Component s1.massFlowRate
  // class Modelica.Fluid.Sensors.MassFlowRate
    // extends Modelica.Fluid.Sensors.BaseClasses.PartialFlowSensor
    equation
      0 = s1.massFlowRate.port_a.m_flow+s1.massFlowRate.port_b.m_flow;
      s1.massFlowRate.port_a.p = s1.massFlowRate.port_b.p;
      s1.massFlowRate.port_a.h_outflow = inStream(s1.massFlowRate.port_b.h_outflow);
      s1.massFlowRate.port_b.h_outflow = inStream(s1.massFlowRate.port_a.h_outflow);
      s1.massFlowRate.port_a.Xi_outflow = inStream(s1.massFlowRate.port_b.Xi_outflow);
      s1.massFlowRate.port_b.Xi_outflow = inStream(s1.massFlowRate.port_a.Xi_outflow);
      s1.massFlowRate.port_a.C_outflow = inStream(s1.massFlowRate.port_b.C_outflow);
      s1.massFlowRate.port_b.C_outflow = inStream(s1.massFlowRate.port_a.C_outflow);
    // end of extends 
  equation
    s1.massFlowRate.m_flow = s1.massFlowRate.port_a.m_flow;

  // Component s1.specificEnthalpy
  // class Modelica.Fluid.Sensors.SpecificEnthalpy
    // extends Modelica.Fluid.Sensors.BaseClasses.PartialAbsoluteSensor
    equation
      s1.specificEnthalpy.port.m_flow = 0;
      s1.specificEnthalpy.port.h_outflow = 84013.0581525969;
      s1.specificEnthalpy.port.Xi_outflow = {};
      s1.specificEnthalpy.port.C_outflow = zeros(0);
    // end of extends 
  equation
    s1.specificEnthalpy.h_out = inStream(s1.specificEnthalpy.port.h_outflow);

  // Component s1
  // class NHES.Fluid.Sensors.stateSensor
  equation
    s1.statePort.p = s1.pressure.p;
    s1.statePort.T = s1.temperature.T;
    s1.statePort.m_flow = s1.massFlowRate.m_flow;
    s1.statePort.h_out = s1.specificEnthalpy.h_out;
    s1.port_a.m_flow-s1.massFlowRate.port_a.m_flow-s1.pressure.port.m_flow-
      s1.specificEnthalpy.port.m_flow-s1.temperature.port.m_flow = 0.0;
    s1.port_a.p = s1.massFlowRate.port_a.p;
    s1.pressure.port.p = s1.massFlowRate.port_a.p;
    s1.specificEnthalpy.port.p = s1.massFlowRate.port_a.p;
