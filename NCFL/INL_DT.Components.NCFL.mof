  parameter Modelica.Units.SI.PressureDifference heater1.Heater.dp_start = 
    heater1.Heater.p_a_start-heater1.Heater.p_b_start;
  parameter Modelica.Units.SI.PressureDifference heater1.Heater.dps_start[
    heater1.Heater.nFM] = (if heater1.Heater.useLumpedPressure then (if  not 
    heater1.Heater.exposeState_a and  not heater1.Heater.exposeState_b then cat(1,
     {heater1.Heater.dp_start/2}, {heater1.Heater.dp_start/2}) else {
    heater1.Heater.dp_start}) else (if  not heater1.Heater.exposeState_a and 
     not heater1.Heater.exposeState_b then (if heater1.Heater.nV == 1 then cat(1,
     {heater1.Heater.dp_start/2}, {heater1.Heater.dp_start/2}) else cat(1, {
    heater1.Heater.dp_start/(heater1.Heater.nV+1)}, array(heater1.Heater.ps_start
    [i]-heater1.Heater.ps_start[i+1] for i in 1:heater1.Heater.nV-1), {
    heater1.Heater.dp_start/(heater1.Heater.nV+1)})) else (if  not 
    heater1.Heater.exposeState_a and heater1.Heater.exposeState_b then (if 
    heater1.Heater.nV == 1 then {heater1.Heater.dp_start} else cat(1, {
    heater1.Heater.dp_start/heater1.Heater.nV}, array(heater1.Heater.ps_start[i]
    -heater1.Heater.ps_start[i+1] for i in 1:heater1.Heater.nV-1))) else (if 
    heater1.Heater.exposeState_a and  not heater1.Heater.exposeState_b then (if 
    heater1.Heater.nV == 1 then {heater1.Heater.dp_start} else cat(1, array(
    heater1.Heater.ps_start[i]-heater1.Heater.ps_start[i+1] for i in 1:
    heater1.Heater.nV-1), {heater1.Heater.dp_start/heater1.Heater.nV})) else 
    array(heater1.Heater.ps_start[i]-heater1.Heater.ps_start[i+1] for i in 1:
