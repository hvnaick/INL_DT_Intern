      elseif (heater2.Heater.nV > 2) then 
        fill(heater2.Heater.mediums[1].p, heater2.Heater.iLumped-2) = 
          heater2.Heater.mediums[2:heater2.Heater.iLumped-1].p;
        fill(heater2.Heater.mediums[heater2.Heater.nV].p, heater2.Heater.nV-
          heater2.Heater.iLumped) = heater2.Heater.mediums[heater2.Heater.iLumped
          :heater2.Heater.nV-1].p;
      end if;
      if (heater2.Heater.exposeState_a and heater2.Heater.exposeState_b) then 
        heater2.Heater.m_flows[heater2.Heater.iLumped] = heater2.Heater.flowModel.m_flows
          [1];
        heater2.Heater.port_a.p = heater2.Heater.mediums[1].p;
        heater2.Heater.port_b.p = heater2.Heater.mediums[heater2.Heater.nV].p;
