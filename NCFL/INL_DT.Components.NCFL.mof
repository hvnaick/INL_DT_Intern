        -1);
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialGenericPipeFlow
    equation
      for i in (1:ValveOutlet.flowModel.n-1) loop
        assert(ValveOutlet.flowModel.m_flows[i] >  -ValveOutlet.flowModel.m_flow_small
           or ValveOutlet.flowModel.allowFlowReversal, "Reversing flow occurs even though allowFlowReversal is false");
      end for;
      if (ValveOutlet.flowModel.continuousFlowReversal) then 
        if (ValveOutlet.flowModel.from_dp and true) then 
          ValveOutlet.flowModel.m_flows = homotopy(massFlowRate_dp_Unique14(
            ValveOutlet.flowModel.dps_fg-(array(ValveOutlet.flowModel.g*
            ValveOutlet.flowModel.dheights[i]*ValveOutlet.flowModel.rhos_act[i]
             for i in 1:ValveOutlet.flowModel.n-1)), ValveOutlet.flowModel.rhos_act,
             ValveOutlet.flowModel.rhos_act, ValveOutlet.flowModel.mus_act, 
            ValveOutlet.flowModel.mus_act, ValveOutlet.flowModel.pathLengths_internal,
             ValveOutlet.flowModel.diameters, (ValveOutlet.flowModel.crossAreas[1
            :ValveOutlet.flowModel.n-1]+ValveOutlet.flowModel.crossAreas[2:
            ValveOutlet.flowModel.n])/2, (ValveOutlet.flowModel.roughnesses[1:
            ValveOutlet.flowModel.n-1]+ValveOutlet.flowModel.roughnesses[2:
            ValveOutlet.flowModel.n])/2, ValveOutlet.flowModel.dp_small/(
            ValveOutlet.flowModel.n-1), ValveOutlet.flowModel.Res_turbulent_internal)
            *ValveOutlet.flowModel.nParallel, ValveOutlet.flowModel.m_flow_nominal
            /ValveOutlet.flowModel.dp_nominal*(ValveOutlet.flowModel.dps_fg-
            ValveOutlet.flowModel.g*ValveOutlet.flowModel.dheights*
            ValveOutlet.flowModel.rho_nominal));
        else
          ValveOutlet.flowModel.dps_fg = homotopy(pressureLoss_m_flow_Unique12(
            ValveOutlet.flowModel.m_flows/ValveOutlet.flowModel.nParallel, 
            ValveOutlet.flowModel.rhos_act, ValveOutlet.flowModel.rhos_act, 
            ValveOutlet.flowModel.mus_act, ValveOutlet.flowModel.mus_act, 
