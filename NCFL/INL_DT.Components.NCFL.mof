     "Start value of pressure at port b";
  parameter Modelica.Media.Interfaces.PartialMedium.MassFlowRate 
    HX.HXTube.m_flow_start = 0.01 "Start value for mass flow rate";
  parameter Boolean HX.HXTube.flowModel.from_dp = HX.HXTube.flowModel.momentumDynamics
     >= Modelica.Fluid.Types.Dynamics.SteadyStateInitial "= true, use m_flow = f(dp), otherwise dp = f(m_flow)";
  constant Integer HX.HXTube.flowModel.n = 2 "Number of discrete flow volumes";
  parameter Real HX.HXTube.flowModel.nParallel = HX.HXTube.nParallel 
    "Number of identical parallel flow devices";
  parameter Modelica.Units.SI.Acceleration HX.HXTube.flowModel.g = 
    HX.HXTube.system.g "Constant gravity acceleration";
  constant Boolean HX.HXTube.flowModel.allowFlowReversal = true "= true, if flow reversal is enabled, otherwise restrict flow to design direction (states[1] -> states[n+1])";
  constant Modelica.Fluid.Types.Dynamics HX.HXTube.flowModel.momentumDynamics = 
    Modelica.Fluid.Types.Dynamics.SteadyState "Formulation of momentum balance";
  parameter Modelica.Media.Interfaces.PartialMedium.MassFlowRate 
    HX.HXTube.flowModel.m_flow_start = HX.HXTube.m_flow_start "Start value of mass flow rates";
  parameter Modelica.Media.Interfaces.Types.AbsolutePressure HX.HXTube.flowModel.p_a_start
    (start = 5000000.0, nominal = 1000000.0, min = 611.657) = HX.HXTube.p_a_start
     "Start value for p[1] at design inflow";
  parameter Modelica.Media.Interfaces.Types.AbsolutePressure HX.HXTube.flowModel.p_b_start
    (start = 5000000.0, nominal = 1000000.0, min = 611.657) = HX.HXTube.p_b_start
     "Start value for p[n+1] at design outflow";
  parameter Modelica.Units.SI.AbsolutePressure HX.HXTube.flowModel.system.p_ambient
