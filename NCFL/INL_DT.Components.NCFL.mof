    "Guess value of dp = port_a.p - port_b.p";
  parameter Modelica.Media.Interfaces.PartialMedium.MassFlowRate 
    V_bot.m_flow_start = V_bot.m_flow_nominal "Guess value of m_flow = port_a.m_flow";
  parameter Modelica.Media.Interfaces.PartialMedium.MassFlowRate 
    V_bot.m_flow_small = (if V_bot.system.use_eps_Re then V_bot.system.eps_m_flow
    *V_bot.m_flow_nominal else V_bot.system.m_flow_small) "Small mass flow rate for regularization of zero flow";
  constant Boolean V_bot.show_T = true "= true, if temperatures at port_a and port_b are computed";
  constant Boolean V_bot.show_V_flow = true "= true, if volume flow rate at inflowing port is computed";
  constant Modelica.Fluid.Types.CvTypes V_bot.CvData = Modelica.Fluid.Types.CvTypes.
    OpPoint "Selection of flow coefficient";
  parameter Modelica.Units.SI.Area V_bot.Av(fixed = false) = V_bot.m_flow_nominal
    /sqrt(V_bot.rho_nominal*V_bot.dp_nominal)*V_bot.valveCharacteristic_Unique44
    (V_bot.opening_nominal) "Av (metric) flow coefficient";
  parameter Real V_bot.Kv = 0 "Kv (metric) flow coefficient [m3/h]";
  parameter Real V_bot.Cv = 0 "Cv (US) flow coefficient [USG/min]";
