  parameter Modelica.Units.SI.AbsolutePressure PumpPipe.system.p_ambient = 101325
     "Default ambient pressure";
  parameter Modelica.Units.SI.Temperature PumpPipe.system.T_ambient = 293.15 
    "Default ambient temperature";
  parameter Modelica.Units.SI.Acceleration PumpPipe.system.g = 9.80665 
    "Constant gravity acceleration";
  constant Boolean PumpPipe.system.allowFlowReversal = true "= false to restrict to design flow direction (port_a -> port_b)";
  parameter Modelica.Fluid.Types.Dynamics PumpPipe.system.energyDynamics = 
    Modelica.Fluid.Types.Dynamics.DynamicFreeInitial "Default formulation of energy balances";
  parameter Modelica.Fluid.Types.Dynamics PumpPipe.system.massDynamics = 
    PumpPipe.system.energyDynamics "Default formulation of mass balances";
