// Equations and algorithms

  // Component Slant.flowModel
  // class INL_DT.Components.NCFL.FlowModel
    // extends Modelica.Fluid.Interfaces.PartialDistributedFlow
    equation
      Slant.flowModel.Is = array(Slant.flowModel.m_flows[i]*Slant.flowModel.pathLengths
        [i] for i in 1:Slant.flowModel.m);
      if (Slant.flowModel.momentumDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) then 
        zeros(Slant.flowModel.m) = Slant.flowModel.Ib_flows-Slant.flowModel.Fs_p
          -Slant.flowModel.Fs_fg;
      else
        der(Slant.flowModel.Is) = Slant.flowModel.Ib_flows-Slant.flowModel.Fs_p-
          Slant.flowModel.Fs_fg;
      end if;
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialStaggeredFlowModel
    equation
      if ( not Slant.flowModel.allowFlowReversal) then 
        Slant.flowModel.rhos_act = Slant.flowModel.rhos[1:Slant.flowModel.n-1];
        Slant.flowModel.mus_act = Slant.flowModel.mus[1:Slant.flowModel.n-1];
      elseif ( not Slant.flowModel.useUpstreamScheme) then 
        Slant.flowModel.rhos_act = 0.5*(Slant.flowModel.rhos[1:Slant.flowModel.n
          -1]+Slant.flowModel.rhos[2:Slant.flowModel.n]);
        Slant.flowModel.mus_act = 0.5*(Slant.flowModel.mus[1:Slant.flowModel.n-1]
          +Slant.flowModel.mus[2:Slant.flowModel.n]);
      else
        for i in (1:Slant.flowModel.n-1) loop
          Slant.flowModel.rhos_act[i] = noEvent((if Slant.flowModel.m_flows[i]
             > 0 then Slant.flowModel.rhos[i] else Slant.flowModel.rhos[i+1]));
          Slant.flowModel.mus_act[i] = noEvent((if Slant.flowModel.m_flows[i] > 0
             then Slant.flowModel.mus[i] else Slant.flowModel.mus[i+1]));
        end for;
      end if;
      if (Slant.flowModel.use_Ib_flows) then 
        Slant.flowModel.Ib_flows = Slant.flowModel.nParallel*(array(
          Slant.flowModel.rhos[i]*Slant.flowModel.vs[i]*Slant.flowModel.vs[i]*
          Slant.flowModel.crossAreas[i]-Slant.flowModel.rhos[i+1]*
          Slant.flowModel.vs[i+1]*Slant.flowModel.vs[i+1]*Slant.flowModel.crossAreas
          [i+1] for i in 1:Slant.flowModel.n-1));
      else
        Slant.flowModel.Ib_flows = zeros(Slant.flowModel.n-1);
      end if;
      Slant.flowModel.Fs_p = Slant.flowModel.nParallel*(array(0.5*(
        Slant.flowModel.crossAreas[i]+Slant.flowModel.crossAreas[i+1])*(
        Modelica.Media.Water.WaterIF97_ph.pressure_Unique11(
        Slant.flowModel.states[i+1])-Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
        (
        Slant.flowModel.states[i])) for i in 1:Slant.flowModel.n-1));
      Slant.flowModel.dps_fg = array(Slant.flowModel.Fs_fg[i]/Slant.flowModel.nParallel
        *2/(Slant.flowModel.crossAreas[i]+Slant.flowModel.crossAreas[i+1]) for i
         in 1:Slant.flowModel.n-1);
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialGenericPipeFlow
    equation
      for i in (1:Slant.flowModel.n-1) loop
        assert(Slant.flowModel.m_flows[i] >  -Slant.flowModel.m_flow_small or 
          Slant.flowModel.allowFlowReversal, "Reversing flow occurs even though allowFlowReversal is false");
      end for;
      if (Slant.flowModel.continuousFlowReversal) then 
        if (Slant.flowModel.from_dp and true) then 
          Slant.flowModel.m_flows = homotopy(massFlowRate_dp_Unique14(
            Slant.flowModel.dps_fg-(array(Slant.flowModel.g*Slant.flowModel.dheights
            [i]*Slant.flowModel.rhos_act[i] for i in 1:Slant.flowModel.n-1)), 
            Slant.flowModel.rhos_act, Slant.flowModel.rhos_act, Slant.flowModel.mus_act,
             Slant.flowModel.mus_act, Slant.flowModel.pathLengths_internal, 
            Slant.flowModel.diameters, (Slant.flowModel.crossAreas[1:
            Slant.flowModel.n-1]+Slant.flowModel.crossAreas[2:Slant.flowModel.n])
            /2, (Slant.flowModel.roughnesses[1:Slant.flowModel.n-1]+
            Slant.flowModel.roughnesses[2:Slant.flowModel.n])/2, 
            Slant.flowModel.dp_small/(Slant.flowModel.n-1), Slant.flowModel.Res_turbulent_internal)
            *Slant.flowModel.nParallel, Slant.flowModel.m_flow_nominal/
            Slant.flowModel.dp_nominal*(Slant.flowModel.dps_fg-Slant.flowModel.g
            *Slant.flowModel.dheights*Slant.flowModel.rho_nominal));
        else
          Slant.flowModel.dps_fg = homotopy(pressureLoss_m_flow_Unique12(
            Slant.flowModel.m_flows/Slant.flowModel.nParallel, Slant.flowModel.rhos_act,
             Slant.flowModel.rhos_act, Slant.flowModel.mus_act, Slant.flowModel.mus_act,
             Slant.flowModel.pathLengths_internal, Slant.flowModel.diameters, (
            Slant.flowModel.crossAreas[1:Slant.flowModel.n-1]+Slant.flowModel.crossAreas
            [2:Slant.flowModel.n])/2, (Slant.flowModel.roughnesses[1:
