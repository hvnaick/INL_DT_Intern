    heater2.HeatSRC.port.Q_flow =  -heater2.HeatSRC.Q_flow_int;

  // Component heater2.HeaterPipe.flowModel
  // class Modelica.Fluid.Pipes.BaseClasses.PartialStraightPipe.FlowModel
    // extends Modelica.Fluid.Interfaces.PartialDistributedFlow
    equation
      heater2.HeaterPipe.flowModel.Is = array(heater2.HeaterPipe.flowModel.m_flows
        [i]*heater2.HeaterPipe.flowModel.pathLengths[i] for i in 1:
        heater2.HeaterPipe.flowModel.m);
      if (heater2.HeaterPipe.flowModel.momentumDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) then 
        zeros(heater2.HeaterPipe.flowModel.m) = heater2.HeaterPipe.flowModel.Ib_flows
          -heater2.HeaterPipe.flowModel.Fs_p-heater2.HeaterPipe.flowModel.Fs_fg;
      else
        der(heater2.HeaterPipe.flowModel.Is) = heater2.HeaterPipe.flowModel.Ib_flows
          -heater2.HeaterPipe.flowModel.Fs_p-heater2.HeaterPipe.flowModel.Fs_fg;
      end if;
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialStaggeredFlowModel
    equation
      if ( not heater2.HeaterPipe.flowModel.allowFlowReversal) then 
        heater2.HeaterPipe.flowModel.rhos_act = heater2.HeaterPipe.flowModel.rhos
          [1:heater2.HeaterPipe.flowModel.n-1];
        heater2.HeaterPipe.flowModel.mus_act = heater2.HeaterPipe.flowModel.mus[1
          :heater2.HeaterPipe.flowModel.n-1];
      elseif ( not heater2.HeaterPipe.flowModel.useUpstreamScheme) then 
        heater2.HeaterPipe.flowModel.rhos_act = 0.5*(heater2.HeaterPipe.flowModel.rhos
          [1:heater2.HeaterPipe.flowModel.n-1]+heater2.HeaterPipe.flowModel.rhos
          [2:heater2.HeaterPipe.flowModel.n]);
        heater2.HeaterPipe.flowModel.mus_act = 0.5*(heater2.HeaterPipe.flowModel.mus
          [1:heater2.HeaterPipe.flowModel.n-1]+heater2.HeaterPipe.flowModel.mus[2
          :heater2.HeaterPipe.flowModel.n]);
      else
        for i in (1:heater2.HeaterPipe.flowModel.n-1) loop
          heater2.HeaterPipe.flowModel.rhos_act[i] = noEvent((if 
            heater2.HeaterPipe.flowModel.m_flows[i] > 0 then heater2.HeaterPipe.flowModel.rhos
            [i] else heater2.HeaterPipe.flowModel.rhos[i+1]));
          heater2.HeaterPipe.flowModel.mus_act[i] = noEvent((if heater2.HeaterPipe.flowModel.m_flows
            [i] > 0 then heater2.HeaterPipe.flowModel.mus[i] else 
            heater2.HeaterPipe.flowModel.mus[i+1]));
        end for;
      end if;
      if (heater2.HeaterPipe.flowModel.use_Ib_flows) then 
        heater2.HeaterPipe.flowModel.Ib_flows = heater2.HeaterPipe.flowModel.nParallel
          *(array(heater2.HeaterPipe.flowModel.rhos[i]*heater2.HeaterPipe.flowModel.vs
          [i]*heater2.HeaterPipe.flowModel.vs[i]*heater2.HeaterPipe.flowModel.crossAreas
          [i]-heater2.HeaterPipe.flowModel.rhos[i+1]*heater2.HeaterPipe.flowModel.vs
          [i+1]*heater2.HeaterPipe.flowModel.vs[i+1]*heater2.HeaterPipe.flowModel.crossAreas
          [i+1] for i in 1:heater2.HeaterPipe.flowModel.n-1));
      else
        heater2.HeaterPipe.flowModel.Ib_flows = zeros(heater2.HeaterPipe.flowModel.n
          -1);
      end if;
      heater2.HeaterPipe.flowModel.Fs_p = heater2.HeaterPipe.flowModel.nParallel
        *(array(0.5*(heater2.HeaterPipe.flowModel.crossAreas[i]+heater2.HeaterPipe.flowModel.crossAreas
        [i+1])*(Modelica.Media.Water.WaterIF97_ph.pressure_Unique11(
        heater2.HeaterPipe.flowModel.states[i+1])-Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
        (
        heater2.HeaterPipe.flowModel.states[i])) for i in 1:heater2.HeaterPipe.flowModel.n
        -1));
      heater2.HeaterPipe.flowModel.dps_fg = array(heater2.HeaterPipe.flowModel.Fs_fg
        [i]/heater2.HeaterPipe.flowModel.nParallel*2/(heater2.HeaterPipe.flowModel.crossAreas
        [i]+heater2.HeaterPipe.flowModel.crossAreas[i+1]) for i in 1:
        heater2.HeaterPipe.flowModel.n-1);
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialGenericPipeFlow
    equation
      for i in (1:heater2.HeaterPipe.flowModel.n-1) loop
        assert(heater2.HeaterPipe.flowModel.m_flows[i] >  -heater2.HeaterPipe.flowModel.m_flow_small
           or heater2.HeaterPipe.flowModel.allowFlowReversal, "Reversing flow occurs even though allowFlowReversal is false");
      end for;
      if (heater2.HeaterPipe.flowModel.continuousFlowReversal) then 
        if (heater2.HeaterPipe.flowModel.from_dp and true) then 
          heater2.HeaterPipe.flowModel.m_flows = homotopy(massFlowRate_dp_Unique14
            (heater2.HeaterPipe.flowModel.dps_fg-(array(heater2.HeaterPipe.flowModel.g
            *heater2.HeaterPipe.flowModel.dheights[i]*heater2.HeaterPipe.flowModel.rhos_act
            [i] for i in 1:heater2.HeaterPipe.flowModel.n-1)), heater2.HeaterPipe.flowModel.rhos_act,
             heater2.HeaterPipe.flowModel.rhos_act, heater2.HeaterPipe.flowModel.mus_act,
             heater2.HeaterPipe.flowModel.mus_act, heater2.HeaterPipe.flowModel.pathLengths_internal,
             heater2.HeaterPipe.flowModel.diameters, (heater2.HeaterPipe.flowModel.crossAreas
            [1:heater2.HeaterPipe.flowModel.n-1]+heater2.HeaterPipe.flowModel.crossAreas
            [2:heater2.HeaterPipe.flowModel.n])/2, (heater2.HeaterPipe.flowModel.roughnesses
            [1:heater2.HeaterPipe.flowModel.n-1]+heater2.HeaterPipe.flowModel.roughnesses
            [2:heater2.HeaterPipe.flowModel.n])/2, heater2.HeaterPipe.flowModel.dp_small
            /(heater2.HeaterPipe.flowModel.n-1), heater2.HeaterPipe.flowModel.Res_turbulent_internal)
            *heater2.HeaterPipe.flowModel.nParallel, heater2.HeaterPipe.flowModel.m_flow_nominal
            /heater2.HeaterPipe.flowModel.dp_nominal*(heater2.HeaterPipe.flowModel.dps_fg
            -heater2.HeaterPipe.flowModel.g*heater2.HeaterPipe.flowModel.dheights
            *heater2.HeaterPipe.flowModel.rho_nominal));
        else
          heater2.HeaterPipe.flowModel.dps_fg = homotopy(pressureLoss_m_flow_Unique12
            (heater2.HeaterPipe.flowModel.m_flows/heater2.HeaterPipe.flowModel.nParallel,
             heater2.HeaterPipe.flowModel.rhos_act, heater2.HeaterPipe.flowModel.rhos_act,
             heater2.HeaterPipe.flowModel.mus_act, heater2.HeaterPipe.flowModel.mus_act,
             heater2.HeaterPipe.flowModel.pathLengths_internal, heater2.HeaterPipe.flowModel.diameters,
             (heater2.HeaterPipe.flowModel.crossAreas[1:heater2.HeaterPipe.flowModel.n
            -1]+heater2.HeaterPipe.flowModel.crossAreas[2:heater2.HeaterPipe.flowModel.n])
            /2, (heater2.HeaterPipe.flowModel.roughnesses[1:heater2.HeaterPipe.flowModel.n
            -1]+heater2.HeaterPipe.flowModel.roughnesses[2:heater2.HeaterPipe.flowModel.n])
            /2, heater2.HeaterPipe.flowModel.m_flow_small/heater2.HeaterPipe.flowModel.nParallel,
             heater2.HeaterPipe.flowModel.Res_turbulent_internal)+(array(
            heater2.HeaterPipe.flowModel.g*heater2.HeaterPipe.flowModel.dheights
            [i]*heater2.HeaterPipe.flowModel.rhos_act[i] for i in 1:
            heater2.HeaterPipe.flowModel.n-1)), heater2.HeaterPipe.flowModel.dp_nominal
            /heater2.HeaterPipe.flowModel.m_flow_nominal*heater2.HeaterPipe.flowModel.m_flows
            +heater2.HeaterPipe.flowModel.g*heater2.HeaterPipe.flowModel.dheights
            *heater2.HeaterPipe.flowModel.rho_nominal);
        end if;
      else
        if (heater2.HeaterPipe.flowModel.from_dp and true) then 
          heater2.HeaterPipe.flowModel.m_flows = homotopy(massFlowRate_dp_staticHead_Unique16
            (heater2.HeaterPipe.flowModel.dps_fg, heater2.HeaterPipe.flowModel.rhos
            [1:heater2.HeaterPipe.flowModel.n-1], heater2.HeaterPipe.flowModel.rhos
            [2:heater2.HeaterPipe.flowModel.n], heater2.HeaterPipe.flowModel.mus
            [1:heater2.HeaterPipe.flowModel.n-1], heater2.HeaterPipe.flowModel.mus
            [2:heater2.HeaterPipe.flowModel.n], heater2.HeaterPipe.flowModel.pathLengths_internal,
             heater2.HeaterPipe.flowModel.diameters, heater2.HeaterPipe.flowModel.g
            *heater2.HeaterPipe.flowModel.dheights, (heater2.HeaterPipe.flowModel.crossAreas
            [1:heater2.HeaterPipe.flowModel.n-1]+heater2.HeaterPipe.flowModel.crossAreas
            [2:heater2.HeaterPipe.flowModel.n])/2, (heater2.HeaterPipe.flowModel.roughnesses
            [1:heater2.HeaterPipe.flowModel.n-1]+heater2.HeaterPipe.flowModel.roughnesses
            [2:heater2.HeaterPipe.flowModel.n])/2, heater2.HeaterPipe.flowModel.dp_small
            /(heater2.HeaterPipe.flowModel.n-1), heater2.HeaterPipe.flowModel.Res_turbulent_internal)
            *heater2.HeaterPipe.flowModel.nParallel, heater2.HeaterPipe.flowModel.m_flow_nominal
            /heater2.HeaterPipe.flowModel.dp_nominal*(heater2.HeaterPipe.flowModel.dps_fg
            -heater2.HeaterPipe.flowModel.g*heater2.HeaterPipe.flowModel.dheights
            *heater2.HeaterPipe.flowModel.rho_nominal));
        else
          heater2.HeaterPipe.flowModel.dps_fg = homotopy(pressureLoss_m_flow_staticHead_Unique17
            (heater2.HeaterPipe.flowModel.m_flows/heater2.HeaterPipe.flowModel.nParallel,
             heater2.HeaterPipe.flowModel.rhos[1:heater2.HeaterPipe.flowModel.n-1],
             heater2.HeaterPipe.flowModel.rhos[2:heater2.HeaterPipe.flowModel.n],
             heater2.HeaterPipe.flowModel.mus[1:heater2.HeaterPipe.flowModel.n-1],
             heater2.HeaterPipe.flowModel.mus[2:heater2.HeaterPipe.flowModel.n],
             heater2.HeaterPipe.flowModel.pathLengths_internal, heater2.HeaterPipe.flowModel.diameters,
             heater2.HeaterPipe.flowModel.g*heater2.HeaterPipe.flowModel.dheights,
             (heater2.HeaterPipe.flowModel.crossAreas[1:heater2.HeaterPipe.flowModel.n
            -1]+heater2.HeaterPipe.flowModel.crossAreas[2:heater2.HeaterPipe.flowModel.n])
            /2, (heater2.HeaterPipe.flowModel.roughnesses[1:heater2.HeaterPipe.flowModel.n
            -1]+heater2.HeaterPipe.flowModel.roughnesses[2:heater2.HeaterPipe.flowModel.n])
            /2, heater2.HeaterPipe.flowModel.m_flow_small/heater2.HeaterPipe.flowModel.nParallel,
             heater2.HeaterPipe.flowModel.Res_turbulent_internal), 
            heater2.HeaterPipe.flowModel.dp_nominal/heater2.HeaterPipe.flowModel.m_flow_nominal
            *heater2.HeaterPipe.flowModel.m_flows+heater2.HeaterPipe.flowModel.g
            *heater2.HeaterPipe.flowModel.dheights*heater2.HeaterPipe.flowModel.rho_nominal);
        end if;
      end if;
    // end of extends 

  // Component heater2.HeaterPipe
  // class Modelica.Fluid.Pipes.StaticPipe
    // extends Modelica.Fluid.Pipes.BaseClasses.PartialStraightPipe
    equation
      assert(heater2.HeaterPipe.length >= heater2.HeaterPipe.height_ab, 
        "Parameter length must be greater or equal height_ab.");
    // end of extends 
  equation
    heater2.HeaterPipe.port_a.m_flow = heater2.HeaterPipe.flowModel.m_flows[1];
    0 = heater2.HeaterPipe.port_a.m_flow+heater2.HeaterPipe.port_b.m_flow;
    heater2.HeaterPipe.port_a.Xi_outflow = inStream(heater2.HeaterPipe.port_b.Xi_outflow);
    heater2.HeaterPipe.port_b.Xi_outflow = inStream(heater2.HeaterPipe.port_a.Xi_outflow);
    heater2.HeaterPipe.port_a.C_outflow = inStream(heater2.HeaterPipe.port_b.C_outflow);
    heater2.HeaterPipe.port_b.C_outflow = inStream(heater2.HeaterPipe.port_a.C_outflow);
    heater2.HeaterPipe.port_b.h_outflow = inStream(heater2.HeaterPipe.port_a.h_outflow)
      -heater2.HeaterPipe.system.g*heater2.HeaterPipe.height_ab;
    heater2.HeaterPipe.port_a.h_outflow = inStream(heater2.HeaterPipe.port_b.h_outflow)
      +heater2.HeaterPipe.system.g*heater2.HeaterPipe.height_ab;

  // Component heater2
  // class INL_DT.Components.Heater
  equation
    heater2.HeatSRC.port.Q_flow+heater2.Heater.heatPorts[1, 1].Q_flow = 0.0;
    heater2.Heater.heatPorts[1, 1].T = heater2.HeatSRC.port.T;
    heater2.Heater.heatPorts_int[1, 1].Q_flow = 0.0;
    heater2.Heater.port_a.m_flow+heater2.HeaterPipe.port_b.m_flow = 0.0;
    heater2.HeaterPipe.port_b.p = heater2.Heater.port_a.p;
    heater2.port_b.m_flow-heater2.Heater.port_b.m_flow = 0.0;
    heater2.port_b.p = heater2.Heater.port_b.p;
    heater2.port_a.m_flow-heater2.HeaterPipe.port_a.m_flow = 0.0;
    heater2.port_a.p = heater2.HeaterPipe.port_a.p;

  // Component heater1.Heater.geometry
  // class INL_DT.Components.Heater.Geometry
    // extends TRANSFORM.Fluid.ClosureRelations.Geometry.Models.DistributedVolume_1D.GenericPipe
    equation
      for i in (1:heater1.Heater.geometry.nV) loop
        assert(heater1.Heater.geometry.dimensions[i] > 0, "Characteristic dimension must be > 0");
        assert(heater1.Heater.geometry.dlengths[i] >= abs(heater1.Heater.geometry.dheights
          [i]), "Geometry dlengths must be greater or equal to abs(dheights)");
      end for;
    // end of extends 

  // Component heater1.Heater.flowModel.firstOrder_dps_K[1]
  // class Modelica.Blocks.Continuous.FirstOrder
  equation
    der(heater1.Heater.flowModel.firstOrder_dps_K[1].y) = (heater1.Heater.flowModel.firstOrder_dps_K[1].k
      *heater1.Heater.flowModel.firstOrder_dps_K[1].u-heater1.Heater.flowModel.firstOrder_dps_K[1].y)
      /heater1.Heater.flowModel.firstOrder_dps_K[1].T;

  // Component heater1.Heater.flowModel.mediaProps[1]
  // class TRANSFORM.Media.BaseProperties1Phase
  equation
    heater1.Heater.flowModel.mediaProps[1].h = Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_Unique25
      (
      heater1.Heater.flowModel.mediaProps[1].state);
    heater1.Heater.flowModel.mediaProps[1].d = Modelica.Media.Water.WaterIF97_ph.density_Unique5
      (
      heater1.Heater.flowModel.mediaProps[1].state);
    heater1.Heater.flowModel.mediaProps[1].T = Modelica.Media.Water.WaterIF97_ph.temperature_Unique28
      (
      heater1.Heater.flowModel.mediaProps[1].state);
    heater1.Heater.flowModel.mediaProps[1].p = Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
      (
      heater1.Heater.flowModel.mediaProps[1].state);
    heater1.Heater.flowModel.mediaProps[1].mu = Modelica.Media.Water.WaterIF97_ph.dynamicViscosity_Unique6
      (
      heater1.Heater.flowModel.mediaProps[1].state);
    heater1.Heater.flowModel.mediaProps[1].lambda = Modelica.Media.Water.WaterIF97_ph.thermalConductivity_Unique45
      (
      heater1.Heater.flowModel.mediaProps[1].state);
    heater1.Heater.flowModel.mediaProps[1].cp = Modelica.Media.Water.WaterIF97_ph.specificHeatCapacityCp_Unique46
      (
      heater1.Heater.flowModel.mediaProps[1].state);

  // Component heater1.Heater.flowModel.mediaProps[2]
  // class TRANSFORM.Media.BaseProperties1Phase
  equation
    heater1.Heater.flowModel.mediaProps[2].h = Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_Unique25
      (
      heater1.Heater.flowModel.mediaProps[2].state);
    heater1.Heater.flowModel.mediaProps[2].d = Modelica.Media.Water.WaterIF97_ph.density_Unique5
      (
      heater1.Heater.flowModel.mediaProps[2].state);
    heater1.Heater.flowModel.mediaProps[2].T = Modelica.Media.Water.WaterIF97_ph.temperature_Unique28
      (
      heater1.Heater.flowModel.mediaProps[2].state);
    heater1.Heater.flowModel.mediaProps[2].p = Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
      (
      heater1.Heater.flowModel.mediaProps[2].state);
    heater1.Heater.flowModel.mediaProps[2].mu = Modelica.Media.Water.WaterIF97_ph.dynamicViscosity_Unique6
      (
      heater1.Heater.flowModel.mediaProps[2].state);
    heater1.Heater.flowModel.mediaProps[2].lambda = Modelica.Media.Water.WaterIF97_ph.thermalConductivity_Unique45
      (
      heater1.Heater.flowModel.mediaProps[2].state);
    heater1.Heater.flowModel.mediaProps[2].cp = Modelica.Media.Water.WaterIF97_ph.specificHeatCapacityCp_Unique46
      (
      heater1.Heater.flowModel.mediaProps[2].state);

  // Component heater1.Heater.flowModel
  // class INL_DT.Components.Heater.FlowModel
    // extends TRANSFORM.Fluid.ClosureRelations.PressureLoss.Models.DistributedPipe_1D.PartialDistributedStaggeredFlow
    equation
      for i in (1:heater1.Heater.flowModel.nFM) loop
        assert(heater1.Heater.flowModel.m_flows[i] >  -heater1.Heater.flowModel.m_flow_small
           or heater1.Heater.flowModel.allowFlowReversal, "Reverting flow occurs in flowModel even though allowFlowReversal is false");
      end for;
      heater1.Heater.flowModel.Is = array(heater1.Heater.flowModel.m_flows[i]*
        heater1.Heater.flowModel.dlengths[i] for i in 1:heater1.Heater.flowModel.nFM);
      if (heater1.Heater.flowModel.momentumDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) then 
        for i in (1:heater1.Heater.flowModel.nFM) loop
          0 = heater1.Heater.flowModel.Ibs[i];
        end for;
      else
        for i in (1:heater1.Heater.flowModel.nFM) loop
          der(heater1.Heater.flowModel.Is[i]) = heater1.Heater.flowModel.Ibs[i];
        end for;
      end if;
    // extends TRANSFORM.Fluid.ClosureRelations.PressureLoss.Models.DistributedPipe_1D.PartialMomentumBalance
    equation
      heater1.Heater.flowModel.Ibs = heater1.Heater.flowModel.I_flows-
        heater1.Heater.flowModel.Fs_p-heater1.Heater.flowModel.Fs_fg;
      if (heater1.Heater.flowModel.use_I_flows) then 
        heater1.Heater.flowModel.I_flows = array(heater1.Heater.flowModel.crossAreas
          [i]*Modelica.Media.Water.WaterIF97_ph.density_Unique5(
          heater1.Heater.flowModel.states[i])*heater1.Heater.flowModel.vs[i]*
          heater1.Heater.flowModel.vs[i]-heater1.Heater.flowModel.crossAreas[i+1]
          *Modelica.Media.Water.WaterIF97_ph.density_Unique5(
          heater1.Heater.flowModel.states[i+1])*heater1.Heater.flowModel.vs[i+1]
          *heater1.Heater.flowModel.vs[i+1] for i in 1:heater1.Heater.flowModel.nFM);
      else
        heater1.Heater.flowModel.I_flows = zeros(heater1.Heater.flowModel.nFM);
      end if;
      heater1.Heater.flowModel.Fs_p = array(0.5*(heater1.Heater.flowModel.crossAreas
        [i]+heater1.Heater.flowModel.crossAreas[i+1])*(Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
        (
        heater1.Heater.flowModel.states[i+1])-Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
        (
        heater1.Heater.flowModel.states[i])) for i in 1:heater1.Heater.flowModel.nFM);
      heater1.Heater.flowModel.Fs_fg = array((heater1.Heater.flowModel.dps_fg[i]
        +heater1.Heater.flowModel.firstOrder_dps_K[i].y)*0.5*(heater1.Heater.flowModel.crossAreas
        [i]+heater1.Heater.flowModel.crossAreas[i+1]) for i in 1:
        heater1.Heater.flowModel.nFM);
      heater1.Heater.flowModel.dps_K = array(noEvent((if heater1.Heater.flowModel.m_flows
        [i] > 0 then 0.5*heater1.Heater.flowModel.Ks_ab[i]*Modelica.Media.Water.WaterIF97_ph.density_Unique5
        (
        heater1.Heater.flowModel.states[i])*heater1.Heater.flowModel.vs[i]*
        heater1.Heater.flowModel.vs[i] else  -0.5*heater1.Heater.flowModel.Ks_ba
        [i]*Modelica.Media.Water.WaterIF97_ph.density_Unique5(
        heater1.Heater.flowModel.states[i+1])*heater1.Heater.flowModel.vs[i+1]*
        heater1.Heater.flowModel.vs[i+1])) for i in 1:heater1.Heater.flowModel.nFM);
      heater1.Heater.flowModel.firstOrder_dps_K[:].u = heater1.Heater.flowModel.dps_K;
    // extends TRANSFORM.Fluid.ClosureRelations.PressureLoss.Models.DistributedPipe_1D.PartialSinglePhase
    equation
      for i in (1:heater1.Heater.flowModel.nFM) loop
        heater1.Heater.flowModel.Res[i] = 0.5*((heater1.Heater.flowModel.dimensions
          [i]+heater1.Heater.flowModel.dimensions[i+1])*abs(heater1.Heater.flowModel.m_flows
          [i]))/(0.25*((heater1.Heater.flowModel.crossAreas[i]+heater1.Heater.flowModel.crossAreas
          [i+1])*(heater1.Heater.flowModel.mediaProps[i].mu+heater1.Heater.flowModel.mediaProps
          [i+1].mu)));
      end for;
    // extends TRANSFORM.Fluid.ClosureRelations.PressureLoss.Models.DistributedPipe_1D.SinglePhase_Developed_2Region_NumStable
    equation
      for i in (1:heater1.Heater.flowModel.nFM) loop
        heater1.Heater.flowModel.ds[i] = TRANSFORM.Math.spliceTanh(
          heater1.Heater.flowModel.ds_a[i], heater1.Heater.flowModel.ds_b[i], 
          heater1.Heater.flowModel.m_flows[i], heater1.Heater.flowModel.m_flow_small);
        heater1.Heater.flowModel.mus[i] = TRANSFORM.Math.spliceTanh(
          heater1.Heater.flowModel.mus_a[i], heater1.Heater.flowModel.mus_b[i], 
          heater1.Heater.flowModel.m_flows[i], heater1.Heater.flowModel.m_flow_small);
      end for;
      if (heater1.Heater.flowModel.continuousFlowReversal) then 
        if (heater1.Heater.flowModel.from_dp) then 
          heater1.Heater.flowModel.m_flows = homotopy(TRANSFORM.Fluid.ClosureRelations.PressureLoss.Functions.TubesAndConduits.SinglePhase.LaminarTurbulent_MSLDetailed.dp_MFLOW
            (
            heater1.Heater.flowModel.IN_con, 
            heater1.Heater.flowModel.IN_var, 
            heater1.Heater.flowModel.dps_fg-(array(heater1.Heater.flowModel.g_n*
              heater1.Heater.flowModel.dheights[i]*heater1.Heater.flowModel.ds_a
              [i] for i in 1:heater1.Heater.flowModel.nFM)), 
            heater1.Heater.flowModel.dp_small/heater1.Heater.flowModel.nFM), 
            heater1.Heater.flowModel.m_flow_nominal/heater1.Heater.flowModel.dp_nominal
            *(heater1.Heater.flowModel.dps_fg-heater1.Heater.flowModel.g_n*
            heater1.Heater.flowModel.dheights*heater1.Heater.flowModel.d_nominal));
        else
          heater1.Heater.flowModel.dps_fg = homotopy(TRANSFORM.Fluid.ClosureRelations.PressureLoss.Functions.TubesAndConduits.SinglePhase.LaminarTurbulent_MSLDetailed.dp_DP
            (
            heater1.Heater.flowModel.IN_con, 
            heater1.Heater.flowModel.IN_var, 
            heater1.Heater.flowModel.m_flows, 
            heater1.Heater.flowModel.m_flow_small)+(array(heater1.Heater.flowModel.g_n
            *heater1.Heater.flowModel.dheights[i]*heater1.Heater.flowModel.ds_a[
            i] for i in 1:heater1.Heater.flowModel.nFM)), heater1.Heater.flowModel.dp_nominal
            /heater1.Heater.flowModel.m_flow_nominal*heater1.Heater.flowModel.m_flows
            +heater1.Heater.flowModel.g_n*heater1.Heater.flowModel.dheights*
            heater1.Heater.flowModel.d_nominal);
        end if;
      else
        if (heater1.Heater.flowModel.from_dp) then 
          heater1.Heater.flowModel.m_flows = homotopy(TRANSFORM.Fluid.ClosureRelations.PressureLoss.Functions.TubesAndConduits.SinglePhase.LaminarTurbulent_MSLDetailed.dp_MFLOW_staticHead
            (
            heater1.Heater.flowModel.IN_con, 
            heater1.Heater.flowModel.IN_var, 
            heater1.Heater.flowModel.dps_fg, 
            heater1.Heater.flowModel.dp_small/heater1.Heater.flowModel.nFM, 
            heater1.Heater.flowModel.g_n*heater1.Heater.flowModel.dheights), 
            heater1.Heater.flowModel.m_flow_nominal/heater1.Heater.flowModel.dp_nominal
            *(heater1.Heater.flowModel.dps_fg-heater1.Heater.flowModel.g_n*
            heater1.Heater.flowModel.dheights*heater1.Heater.flowModel.d_nominal));
        else
          heater1.Heater.flowModel.dps_fg = homotopy(TRANSFORM.Fluid.ClosureRelations.PressureLoss.Functions.TubesAndConduits.SinglePhase.LaminarTurbulent_MSLDetailed.dp_DP_staticHead
            (
            heater1.Heater.flowModel.IN_con, 
            heater1.Heater.flowModel.IN_var, 
            heater1.Heater.flowModel.m_flows, 
            heater1.Heater.flowModel.m_flow_small, 
            heater1.Heater.flowModel.g_n*heater1.Heater.flowModel.dheights), 
            heater1.Heater.flowModel.dp_nominal/heater1.Heater.flowModel.m_flow_nominal
            *heater1.Heater.flowModel.m_flows+heater1.Heater.flowModel.g_n*
            heater1.Heater.flowModel.dheights*heater1.Heater.flowModel.d_nominal);
        end if;
      end if;
    // end of extends 

  // Component heater1.Heater.heatTransfer.mediums[1]
  // class TRANSFORM.Media.BaseProperties1Phase
  equation
    heater1.Heater.heatTransfer.mediums[1].h = Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_Unique25
      (
      heater1.Heater.heatTransfer.mediums[1].state);
    heater1.Heater.heatTransfer.mediums[1].d = Modelica.Media.Water.WaterIF97_ph.density_Unique5
      (
      heater1.Heater.heatTransfer.mediums[1].state);
    heater1.Heater.heatTransfer.mediums[1].T = Modelica.Media.Water.WaterIF97_ph.temperature_Unique28
      (
      heater1.Heater.heatTransfer.mediums[1].state);
    heater1.Heater.heatTransfer.mediums[1].p = Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
      (
      heater1.Heater.heatTransfer.mediums[1].state);
    heater1.Heater.heatTransfer.mediums[1].mu = Modelica.Media.Water.WaterIF97_ph.dynamicViscosity_Unique6
      (
      heater1.Heater.heatTransfer.mediums[1].state);
    heater1.Heater.heatTransfer.mediums[1].lambda = Modelica.Media.Water.WaterIF97_ph.thermalConductivity_Unique45
      (
      heater1.Heater.heatTransfer.mediums[1].state);
    heater1.Heater.heatTransfer.mediums[1].cp = Modelica.Media.Water.WaterIF97_ph.specificHeatCapacityCp_Unique46
      (
      heater1.Heater.heatTransfer.mediums[1].state);

  // Component heater1.Heater.heatTransfer
  // class TRANSFORM.Fluid.Pipes.GenericPipe_MultiTransferSurface.HeatTransfer
    // extends TRANSFORM.Fluid.ClosureRelations.HeatTransfer.Models.DistributedPipe_1D_MultiTransferSurface.PartialIdeal
    equation
      heater1.Heater.heatTransfer.m_flows = heater1.Heater.heatTransfer.vs.*
        heater1.Heater.heatTransfer.mediums.d.*heater1.Heater.heatTransfer.crossAreas;
      heater1.Heater.heatTransfer.Res = heater1.Heater.heatTransfer.mediums.d.*
        heater1.Heater.heatTransfer.dimensions.*abs(heater1.Heater.heatTransfer.vs)
        ./heater1.Heater.heatTransfer.mediums.mu;
      heater1.Heater.heatTransfer.Prs = heater1.Heater.heatTransfer.mediums.mu.*
        heater1.Heater.heatTransfer.mediums.cp./heater1.Heater.heatTransfer.mediums
        .lambda;
    // extends TRANSFORM.Fluid.ClosureRelations.HeatTransfer.Models.DistributedPipe_1D_MultiTransferSurface.Ideal
    equation
      for i in (1:heater1.Heater.heatTransfer.nHT) loop
        for j in (1:heater1.Heater.heatTransfer.nSurfaces) loop
          heater1.Heater.heatTransfer.Ts_wall[i, j] = heater1.Heater.heatTransfer.Ts_fluid
            [i];
          heater1.Heater.heatTransfer.alphas[i, j] = 1E+60;
          heater1.Heater.heatTransfer.Nus[i, j] = 1E+60;
        end for;
      end for;
    // end of extends 

  // Component heater1.Heater.internalHeatGen
  // class TRANSFORM.Fluid.Pipes.GenericPipe_MultiTransferSurface.InternalHeatGen
    // extends TRANSFORM.Fluid.ClosureRelations.InternalVolumeHeatGeneration.Models.DistributedVolume_1D.GenericHeatGeneration
    equation
      for i in (1:heater1.Heater.internalHeatGen.nV) loop
        heater1.Heater.internalHeatGen.Q_flows[i] = heater1.Heater.internalHeatGen.Q_gens
          [i];
      end for;
    // end of extends 

  // Component heater1.Heater.traceMassTransfer.diffusionCoeff[1]
  // class TRANSFORM.Fluid.ClosureRelations.MassTransfer.Models.DistributedPipe_TraceMass_1D_MultiTransferSurface.PartialMassTransfer_setC.DiffusionCoeff
    // extends TRANSFORM.Media.ClosureModels.MassDiffusionCoefficient.Models.GenericCoefficient
    equation
      heater1.Heater.traceMassTransfer.diffusionCoeff[1].D_abs = 
        heater1.Heater.traceMassTransfer.diffusionCoeff[1].D_abs0;
    // end of extends 

  // Component heater1.Heater.traceMassTransfer.mediums[1]
  // class TRANSFORM.Media.BaseProperties1Phase
  equation
    heater1.Heater.traceMassTransfer.mediums[1].h = Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_Unique25
      (
      heater1.Heater.traceMassTransfer.mediums[1].state);
    heater1.Heater.traceMassTransfer.mediums[1].d = Modelica.Media.Water.WaterIF97_ph.density_Unique5
      (
      heater1.Heater.traceMassTransfer.mediums[1].state);
    heater1.Heater.traceMassTransfer.mediums[1].T = Modelica.Media.Water.WaterIF97_ph.temperature_Unique28
      (
      heater1.Heater.traceMassTransfer.mediums[1].state);
    heater1.Heater.traceMassTransfer.mediums[1].p = Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
      (
      heater1.Heater.traceMassTransfer.mediums[1].state);
    heater1.Heater.traceMassTransfer.mediums[1].mu = Modelica.Media.Water.WaterIF97_ph.dynamicViscosity_Unique6
      (
      heater1.Heater.traceMassTransfer.mediums[1].state);
    heater1.Heater.traceMassTransfer.mediums[1].lambda = Modelica.Media.Water.WaterIF97_ph.thermalConductivity_Unique45
      (
      heater1.Heater.traceMassTransfer.mediums[1].state);
    heater1.Heater.traceMassTransfer.mediums[1].cp = Modelica.Media.Water.WaterIF97_ph.specificHeatCapacityCp_Unique46
      (
      heater1.Heater.traceMassTransfer.mediums[1].state);

  // Component heater1.Heater.traceMassTransfer
  // class TRANSFORM.Fluid.Pipes.GenericPipe_MultiTransferSurface.TraceMassTransfer
    // extends TRANSFORM.Fluid.ClosureRelations.MassTransfer.Models.DistributedPipe_TraceMass_1D_MultiTransferSurface.PartialMassTransfer_setC
    equation
      for i in (1:heater1.Heater.traceMassTransfer.nMT) loop
        for k in (1:heater1.Heater.traceMassTransfer.nC) loop
          heater1.Heater.traceMassTransfer.Cs_fluid[i, k] = heater1.Heater.traceMassTransfer.CsM_fluid
            [i, heater1.Heater.traceMassTransfer.iC[k]]*Modelica.Media.Water.WaterIF97_ph.density_Unique5
            (
            heater1.Heater.traceMassTransfer.states[i])*heater1.Heater.traceMassTransfer.toMole_unitConv
            /heater1.Heater.traceMassTransfer.MMs[k];
        end for;
      end for;
      for i in (1:heater1.Heater.traceMassTransfer.nMT) loop
        for j in (1:heater1.Heater.traceMassTransfer.nSurfaces) loop
          for k in (1:heater1.Heater.traceMassTransfer.nC) loop
            heater1.Heater.traceMassTransfer.mC_flows[i, j, heater1.Heater.traceMassTransfer.iC
              [k]] = heater1.Heater.traceMassTransfer.nC_flows[i, j, k]*
              heater1.Heater.traceMassTransfer.MMs[k]*heater1.Heater.traceMassTransfer.toMole_unitConv;
          end for;
          for k in (1:heater1.Heater.traceMassTransfer.nC_noT) loop
            heater1.Heater.traceMassTransfer.mC_flows[i, j, heater1.Heater.traceMassTransfer.iC_noT
              [k]] = 0;
          end for;
        end for;
      end for;
      for i in (1:heater1.Heater.traceMassTransfer.nMT) loop
        heater1.Heater.traceMassTransfer.xs[i] = noEvent((if heater1.Heater.traceMassTransfer.vs
          [i] >= 0 then (if i == 1 then 0.5*heater1.Heater.traceMassTransfer.dlengths
          [i] else sum(heater1.Heater.traceMassTransfer.dlengths[1:i-1])+0.5*
          heater1.Heater.traceMassTransfer.dlengths[i]) else (if i == 
          heater1.Heater.traceMassTransfer.nMT then 0.5*heater1.Heater.traceMassTransfer.dlengths
          [heater1.Heater.traceMassTransfer.nMT] else sum(heater1.Heater.traceMassTransfer.dlengths
          [i+1:heater1.Heater.traceMassTransfer.nMT])+0.5*heater1.Heater.traceMassTransfer.dlengths
          [i])));
      end for;
    // extends TRANSFORM.Fluid.ClosureRelations.MassTransfer.Models.DistributedPipe_TraceMass_1D_MultiTransferSurface.PartialIdeal
    equation
      for i in (1:heater1.Heater.traceMassTransfer.nMT) loop
        heater1.Heater.traceMassTransfer.m_flows[i] = heater1.Heater.traceMassTransfer.vs
          [i]*heater1.Heater.traceMassTransfer.mediums[i].d*heater1.Heater.traceMassTransfer.crossAreas
          [i];
        heater1.Heater.traceMassTransfer.Res[i] = heater1.Heater.traceMassTransfer.mediums
          [i].d*heater1.Heater.traceMassTransfer.dimensions[i]*abs(
          heater1.Heater.traceMassTransfer.vs[i])/heater1.Heater.traceMassTransfer.mediums
          [i].mu;
        heater1.Heater.traceMassTransfer.Scs[i, :] = heater1.Heater.traceMassTransfer.mediums
          [i].mu./(heater1.Heater.traceMassTransfer.mediums[i].d.*
          heater1.Heater.traceMassTransfer.diffusionCoeff[i].D_abs);
      end for;
    // extends TRANSFORM.Fluid.ClosureRelations.MassTransfer.Models.DistributedPipe_TraceMass_1D_MultiTransferSurface.Ideal
    equation
      for i in (1:heater1.Heater.traceMassTransfer.nMT) loop
        for j in (1:heater1.Heater.traceMassTransfer.nSurfaces) loop
          heater1.Heater.traceMassTransfer.Cs_wall[i, j, :] = heater1.Heater.traceMassTransfer.Cs_fluid
            [i, :];
          heater1.Heater.traceMassTransfer.alphasM[i, j, :] = 1E+60*ones(
            heater1.Heater.traceMassTransfer.nC);
          heater1.Heater.traceMassTransfer.Shs[i, j, :] = 1E+60*ones(
            heater1.Heater.traceMassTransfer.nC);
        end for;
      end for;
    // end of extends 

  // Component heater1.Heater.internalTraceGen
  // class TRANSFORM.Fluid.Pipes.GenericPipe_MultiTransferSurface.InternalTraceGen
    // extends TRANSFORM.Fluid.ClosureRelations.InternalTraceGeneration.Models.DistributedVolume_Trace_1D.GenericTraceGeneration
    equation
      for ic in (1:0) loop
        for i in (1:heater1.Heater.internalTraceGen.nV) loop
          heater1.Heater.internalTraceGen.mC_flows[i, ic] = heater1.Heater.internalTraceGen.mC_gens
            [i, ic];
        end for;
      end for;
    // end of extends 

  // Component heater1.Heater.mediums[1]
  // class Modelica.Media.Water.WaterIF97_base.BaseProperties
    // extends Modelica.Media.Interfaces.PartialMedium.BaseProperties_D1
    equation
      if (heater1.Heater.mediums[1].standardOrderComponents) then 
        heater1.Heater.mediums[1].Xi = heater1.Heater.mediums[1].X[1:0];
        heater1.Heater.mediums[1].X = {1.0};
        for i in (1:1) loop
          assert(heater1.Heater.mediums[1].X[i] >= -1E-05 and heater1.Heater.mediums[1].X
            [i] <= 1.00001, "Mass fraction X["+       String(i, true, 0)+"] = "+
                   String(heater1.Heater.mediums[1].X[i], true, 0)+
            "of substance "+({"water"})[i]+"\nof medium "+"WaterIF97"+
            " is not in the range 0..1");
        end for;
      end if;
      assert(heater1.Heater.mediums[1].p >= 0.0, "Pressure (= "+       String(
        heater1.Heater.mediums[1].p, true, 0)+" Pa) of medium \""+"WaterIF97"+
        "\" is negative\n(Temperature = "+       String(heater1.Heater.mediums[1].T,
         true, 0)+" K)");
    // end of extends 
  equation
    heater1.Heater.mediums[1].MM = _GlobalScope.Modelica.Media.Water.WaterIF97_ph.fluidConstants[1]
      .molarMass;
    heater1.Heater.mediums[1].phase = (if heater1.Heater.mediums[1].h < 
      Modelica.Media.Water.WaterIF97_ph.bubbleEnthalpy_Unique29(
      heater1.Heater.mediums[1].sat) or heater1.Heater.mediums[1].h > 
      Modelica.Media.Water.WaterIF97_ph.dewEnthalpy_Unique30(
      heater1.Heater.mediums[1].sat) or heater1.Heater.mediums[1].p > 
      _GlobalScope.Modelica.Media.Water.WaterIF97_ph.fluidConstants[1].
      criticalPressure then 1 else 2);
    heater1.Heater.mediums[1].d = Modelica.Media.Water.WaterIF97_ph.density_ph_Unique3
      (heater1.Heater.mediums[1].p, heater1.Heater.mediums[1].h, 
      heater1.Heater.mediums[1].phase, 0);
    heater1.Heater.mediums[1].T = Modelica.Media.Water.WaterIF97_ph.temperature_ph_Unique4
      (heater1.Heater.mediums[1].p, heater1.Heater.mediums[1].h, 
      heater1.Heater.mediums[1].phase, 0);
    heater1.Heater.mediums[1].sat.Tsat = Modelica.Media.Water.WaterIF97_ph.saturationTemperature_Unique37
      (heater1.Heater.mediums[1].p);
    heater1.Heater.mediums[1].sat.psat = heater1.Heater.mediums[1].p;
    heater1.Heater.mediums[1].u = heater1.Heater.mediums[1].h-heater1.Heater.mediums[1].p
      /heater1.Heater.mediums[1].d;
    heater1.Heater.mediums[1].R_s = 8.31446261815324/_GlobalScope.Modelica.Media.Water.WaterIF97_ph.fluidConstants[1]
      .molarMass;
    heater1.Heater.mediums[1].h = heater1.Heater.mediums[1].state.h;
    heater1.Heater.mediums[1].p = heater1.Heater.mediums[1].state.p;
    heater1.Heater.mediums[1].T = heater1.Heater.mediums[1].state.T;
    heater1.Heater.mediums[1].d = heater1.Heater.mediums[1].state.d;
    heater1.Heater.mediums[1].phase = heater1.Heater.mediums[1].state.phase;

  // Component heater1.Heater
  // class TRANSFORM.Fluid.Pipes.GenericPipe_MultiTransferSurface
    // extends TRANSFORM.Fluid.Pipes.BaseClasses.PartialDistributedVolume
    equation
      assert( not (heater1.Heater.energyDynamics <> Modelica.Fluid.Types.Dynamics.
        SteadyState and heater1.Heater.massDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) or false, "Bad combination of dynamics options and Medium not conserving mass if fluidVolumes are fixed.");
      for i in (1:heater1.Heater.nV) loop
        heater1.Heater.ms[i] = heater1.Heater.Vs[i]*heater1.Heater.mediums[i].d;
        heater1.Heater.Us[i] = heater1.Heater.ms[i]*heater1.Heater.mediums[i].u;
        heater1.Heater.mXis[i, :] = heater1.Heater.ms[i]*heater1.Heater.mediums[
          i].Xi;
        heater1.Heater.mCs[i, :] = heater1.Heater.ms[i].*heater1.Heater.Cs[i, :];
      end for;
      if (heater1.Heater.massDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) then 
        for i in (1:heater1.Heater.nV) loop
          0 = heater1.Heater.mbs[i];
        end for;
      else
        for i in (1:heater1.Heater.nV) loop
          der(heater1.Heater.ms[i]) = heater1.Heater.mbs[i];
        end for;
      end if;
      if (heater1.Heater.energyDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) then 
        for i in (1:heater1.Heater.nV) loop
          0 = heater1.Heater.Ubs[i];
        end for;
      else
        for i in (1:heater1.Heater.nV) loop
          der(heater1.Heater.Us[i]) = heater1.Heater.Ubs[i];
        end for;
      end if;
      if (heater1.Heater.substanceDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) then 
        for i in (1:heater1.Heater.nV) loop
          zeros(0) = heater1.Heater.mXibs[i, :];
        end for;
      else
        for i in (1:heater1.Heater.nV) loop
          der(heater1.Heater.mXis[i, :]) = heater1.Heater.mXibs[i, :];
        end for;
      end if;
      if (heater1.Heater.traceDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) then 
        for i in (1:heater1.Heater.nV) loop
          zeros(0) = heater1.Heater.mCbs[i, :];
        end for;
      else
        for i in (1:heater1.Heater.nV) loop
          der(heater1.Heater.mCs_scaled[i, :]) = heater1.Heater.mCbs[i, :]./{};
          heater1.Heater.mCs[i, :] = heater1.Heater.mCs_scaled[i, :].*{};
        end for;
      end if;
    // end of extends 
  equation
    for i in (1:heater1.Heater.nV) loop
      heater1.Heater.mbs[i] = heater1.Heater.m_flows[i]-heater1.Heater.m_flows[i
        +1];
      heater1.Heater.Ubs[i] = heater1.Heater.Wb_flows[i]+heater1.Heater.H_flows[
        i]-heater1.Heater.H_flows[i+1]+sum(heater1.Heater.heatTransfer.Q_flows[i,
         :])+heater1.Heater.internalHeatGen.Q_flows[i]/heater1.Heater.nParallel;
      heater1.Heater.mXibs[i, :] = heater1.Heater.mXi_flows[i, :]-
        heater1.Heater.mXi_flows[i+1, :];
      heater1.Heater.mCbs[i, :] = heater1.Heater.mC_flows[i, :]-heater1.Heater.mC_flows
        [i+1, :]+heater1.Heater.mC_flows_traceMassTransferSum[i, :]+
        heater1.Heater.internalTraceGen.mC_flows[i, :]/heater1.Heater.nParallel;
    end for;
    if ( not heater1.Heater.use_HeatTransfer) then 
      for i in (1:heater1.Heater.geometry.nSurfaces) loop
        for j in (1:heater1.Heater.nV) loop
          heater1.Heater.Ts_wall[j, i] = heater1.Heater.mediums[j].T;
        end for;
      end for;
    else
      for i in (1:heater1.Heater.geometry.nSurfaces) loop
        for j in (1:heater1.Heater.nV) loop
          heater1.Heater.Ts_wall[j, i] = heater1.Heater.heatPorts_int[j, i].T;
        end for;
      end for;
    end if;
    heater1.Heater.port_a.m_flow/heater1.Heater.nParallel = heater1.Heater.m_flows
      [1];
    heater1.Heater.port_b.m_flow/heater1.Heater.nParallel =  -heater1.Heater.m_flows
      [heater1.Heater.nV+1];
    heater1.Heater.port_a.h_outflow = heater1.Heater.mediums[1].h;
    heater1.Heater.port_b.h_outflow = heater1.Heater.mediums[heater1.Heater.nV].
      h;
    heater1.Heater.port_a.Xi_outflow = heater1.Heater.mediums[1].Xi;
    heater1.Heater.port_b.Xi_outflow = heater1.Heater.mediums[heater1.Heater.nV]
      .Xi;
    heater1.Heater.port_a.C_outflow = heater1.Heater.Cs[1, :];
    heater1.Heater.port_b.C_outflow = heater1.Heater.Cs[heater1.Heater.nV, :];
    if (heater1.Heater.useInnerPortProperties and heater1.Heater.nV > 0) then 
      heater1.Heater.state_a = Modelica.Media.Water.WaterIF97_ph.setState_phX_Unique1
        (heater1.Heater.port_a.p, heater1.Heater.mediums[1].h, heater1.Heater.mediums
        [1].Xi, 0, 0);
      heater1.Heater.state_b = Modelica.Media.Water.WaterIF97_ph.setState_phX_Unique1
        (heater1.Heater.port_b.p, heater1.Heater.mediums[heater1.Heater.nV].h, 
        heater1.Heater.mediums[heater1.Heater.nV].Xi, 0, 0);
    else
      heater1.Heater.state_a = Modelica.Media.Water.WaterIF97_ph.setState_phX_Unique1
        (heater1.Heater.port_a.p, inStream(heater1.Heater.port_a.h_outflow), 
        inStream(heater1.Heater.port_a.Xi_outflow), 0, 0);
      heater1.Heater.state_b = Modelica.Media.Water.WaterIF97_ph.setState_phX_Unique1
        (heater1.Heater.port_b.p, inStream(heater1.Heater.port_b.h_outflow), 
        inStream(heater1.Heater.port_b.Xi_outflow), 0, 0);
    end if;
    heater1.Heater.H_flows[1] = semiLinear(heater1.Heater.port_a.m_flow, 
      inStream(heater1.Heater.port_a.h_outflow), heater1.Heater.mediums[1].h)/
      heater1.Heater.nParallel;
    heater1.Heater.mXi_flows[1, :] = semiLinear(heater1.Heater.port_a.m_flow, 
      inStream(heater1.Heater.port_a.Xi_outflow), heater1.Heater.mediums[1].Xi)/
      heater1.Heater.nParallel;
    heater1.Heater.mC_flows[1, :] = semiLinear(heater1.Heater.port_a.m_flow, 
      inStream(heater1.Heater.port_a.C_outflow), heater1.Heater.Cs[1, :])/
      heater1.Heater.nParallel;
    for i in (2:heater1.Heater.nV) loop
      heater1.Heater.H_flows[i] = semiLinear(heater1.Heater.m_flows[i], 
        heater1.Heater.mediums[i-1].h, heater1.Heater.mediums[i].h);
      heater1.Heater.mXi_flows[i, :] = semiLinear(heater1.Heater.m_flows[i], 
        heater1.Heater.mediums[i-1].Xi, heater1.Heater.mediums[i].Xi);
      heater1.Heater.mC_flows[i, :] = semiLinear(heater1.Heater.m_flows[i], 
        heater1.Heater.Cs[i-1, :], heater1.Heater.Cs[i, :]);
    end for;
    heater1.Heater.H_flows[heater1.Heater.nV+1] =  -semiLinear(heater1.Heater.port_b.m_flow,
       inStream(heater1.Heater.port_b.h_outflow), heater1.Heater.mediums[
      heater1.Heater.nV].h)/heater1.Heater.nParallel;
    heater1.Heater.mXi_flows[heater1.Heater.nV+1, :] =  -semiLinear(
      heater1.Heater.port_b.m_flow, inStream(heater1.Heater.port_b.Xi_outflow), 
      heater1.Heater.mediums[heater1.Heater.nV].Xi)/heater1.Heater.nParallel;
    heater1.Heater.mC_flows[heater1.Heater.nV+1, :] =  -semiLinear(
      heater1.Heater.port_b.m_flow, inStream(heater1.Heater.port_b.C_outflow), 
      heater1.Heater.Cs[heater1.Heater.nV, :])/heater1.Heater.nParallel;
    if (heater1.Heater.calc_Wb) then 
      if (heater1.Heater.nV == 1 or heater1.Heater.useLumpedPressure) then 
        heater1.Heater.Wb_flows = heater1.Heater.geometry.dxs*(heater1.Heater.vs
          *heater1.Heater.geometry.dxs*(heater1.Heater.geometry.crossAreas*
          heater1.Heater.geometry.dxs)*(heater1.Heater.port_b.p-heater1.Heater.port_a.p
          +sum(heater1.Heater.flowModel.dps_fg)-heater1.Heater.g_n*(
          heater1.Heater.geometry.dheights*heater1.Heater.mediums.d)));
      else
        if (heater1.Heater.exposeState_a and heater1.Heater.exposeState_b or 
          heater1.Heater.exposeState_a and  not heater1.Heater.exposeState_b)
           then 
          heater1.Heater.Wb_flows[2:heater1.Heater.nV-1] = array(
            heater1.Heater.vs[i]*heater1.Heater.geometry.crossAreas[i]*((
            heater1.Heater.mediums[i+1].p-heater1.Heater.mediums[i-1].p)/2+(
            heater1.Heater.flowModel.dps_fg[i-1]+heater1.Heater.flowModel.dps_fg
            [i])/2-heater1.Heater.g_n*heater1.Heater.geometry.dheights[i]*
            heater1.Heater.mediums[i].d) for i in 2:heater1.Heater.nV-1);
        else
          heater1.Heater.Wb_flows[2:heater1.Heater.nV-1] = array(
            heater1.Heater.vs[i]*heater1.Heater.geometry.crossAreas[i]*((
            heater1.Heater.mediums[i+1].p-heater1.Heater.mediums[i-1].p)/2+(
            heater1.Heater.flowModel.dps_fg[i]+heater1.Heater.flowModel.dps_fg[i
            +1])/2-heater1.Heater.g_n*heater1.Heater.geometry.dheights[i]*
            heater1.Heater.mediums[i].d) for i in 2:heater1.Heater.nV-1);
        end if;
        if (heater1.Heater.exposeState_a and heater1.Heater.exposeState_b) then 
          heater1.Heater.Wb_flows[1] = heater1.Heater.vs[1]*heater1.Heater.geometry.crossAreas
            [1]*((heater1.Heater.mediums[2].p-heater1.Heater.mediums[1].p)/2+
            heater1.Heater.flowModel.dps_fg[1]/2-heater1.Heater.g_n*
            heater1.Heater.geometry.dheights[1]*heater1.Heater.mediums[1].d);
          heater1.Heater.Wb_flows[heater1.Heater.nV] = heater1.Heater.vs[
            heater1.Heater.nV]*heater1.Heater.geometry.crossAreas[
            heater1.Heater.nV]*((heater1.Heater.mediums[heater1.Heater.nV].p-
            heater1.Heater.mediums[heater1.Heater.nV-1].p)/2+heater1.Heater.flowModel.dps_fg
            [heater1.Heater.nV-1]/2-heater1.Heater.g_n*heater1.Heater.geometry.dheights
            [heater1.Heater.nV]*heater1.Heater.mediums[heater1.Heater.nV].d);
        elseif (heater1.Heater.exposeState_a and  not heater1.Heater.exposeState_b)
           then 
          heater1.Heater.Wb_flows[1] = heater1.Heater.vs[1]*heater1.Heater.geometry.crossAreas
            [1]*((heater1.Heater.mediums[2].p-heater1.Heater.mediums[1].p)/2+
            heater1.Heater.flowModel.dps_fg[1]/2-heater1.Heater.g_n*
            heater1.Heater.geometry.dheights[1]*heater1.Heater.mediums[1].d);
          if (heater1.Heater.nV == 2) then 
            heater1.Heater.Wb_flows[heater1.Heater.nV] = heater1.Heater.vs[
              heater1.Heater.nV]*heater1.Heater.geometry.crossAreas[
              heater1.Heater.nV]*((heater1.Heater.port_b.p-heater1.Heater.mediums
              [heater1.Heater.nV-1].p)*5/8+heater1.Heater.flowModel.dps_fg[
              heater1.Heater.nV-1]/2+heater1.Heater.flowModel.dps_fg[
              heater1.Heater.nV]-heater1.Heater.g_n*heater1.Heater.geometry.dheights
              [heater1.Heater.nV]*heater1.Heater.mediums[heater1.Heater.nV].d);
          else
            heater1.Heater.Wb_flows[heater1.Heater.nV] = heater1.Heater.vs[
              heater1.Heater.nV]*heater1.Heater.geometry.crossAreas[
              heater1.Heater.nV]*((heater1.Heater.port_b.p-heater1.Heater.mediums
              [heater1.Heater.nV-1].p)/1.5+heater1.Heater.flowModel.dps_fg[
              heater1.Heater.nV-1]/2+heater1.Heater.flowModel.dps_fg[
              heater1.Heater.nV]-heater1.Heater.g_n*heater1.Heater.geometry.dheights
              [heater1.Heater.nV]*heater1.Heater.mediums[heater1.Heater.nV].d);
          end if;
        elseif ( not heater1.Heater.exposeState_a and heater1.Heater.exposeState_b)
           then 
          if (heater1.Heater.nV == 2) then 
            heater1.Heater.Wb_flows[1] = heater1.Heater.vs[1]*heater1.Heater.geometry.crossAreas
              [1]*((heater1.Heater.mediums[2].p-heater1.Heater.port_a.p)*5/8+
              heater1.Heater.flowModel.dps_fg[1]+heater1.Heater.flowModel.dps_fg
              [2]/2-heater1.Heater.g_n*heater1.Heater.geometry.dheights[1]*
              heater1.Heater.mediums[1].d);
          else
            heater1.Heater.Wb_flows[1] = heater1.Heater.vs[1]*heater1.Heater.geometry.crossAreas
              [1]*((heater1.Heater.mediums[2].p-heater1.Heater.port_a.p)/1.5+
              heater1.Heater.flowModel.dps_fg[1]+heater1.Heater.flowModel.dps_fg
              [2]/2-heater1.Heater.g_n*heater1.Heater.geometry.dheights[1]*
              heater1.Heater.mediums[1].d);
          end if;
          heater1.Heater.Wb_flows[heater1.Heater.nV] = heater1.Heater.vs[
            heater1.Heater.nV]*heater1.Heater.geometry.crossAreas[
            heater1.Heater.nV]*((heater1.Heater.mediums[heater1.Heater.nV].p-
            heater1.Heater.mediums[heater1.Heater.nV-1].p)/2+heater1.Heater.flowModel.dps_fg
            [heater1.Heater.nV]/2-heater1.Heater.g_n*heater1.Heater.geometry.dheights
            [heater1.Heater.nV]*heater1.Heater.mediums[heater1.Heater.nV].d);
        elseif ( not heater1.Heater.exposeState_a and  not heater1.Heater.exposeState_b)
           then 
          heater1.Heater.Wb_flows[1] = heater1.Heater.vs[1]*heater1.Heater.geometry.crossAreas
            [1]*((heater1.Heater.mediums[2].p-heater1.Heater.port_a.p)/1.5+
            heater1.Heater.flowModel.dps_fg[1]+heater1.Heater.flowModel.dps_fg[2]
            /2-heater1.Heater.g_n*heater1.Heater.geometry.dheights[1]*
            heater1.Heater.mediums[1].d);
          heater1.Heater.Wb_flows[heater1.Heater.nV] = heater1.Heater.vs[
            heater1.Heater.nV]*heater1.Heater.geometry.crossAreas[
            heater1.Heater.nV]*((heater1.Heater.port_b.p-heater1.Heater.mediums[
            heater1.Heater.nV-1].p)/1.5+heater1.Heater.flowModel.dps_fg[
            heater1.Heater.nV]/2+heater1.Heater.flowModel.dps_fg[
            heater1.Heater.nV+1]-heater1.Heater.g_n*heater1.Heater.geometry.dheights
            [heater1.Heater.nV]*heater1.Heater.mediums[heater1.Heater.nV].d);
        else
          assert(false, "Unknown model structure");
        end if;
      end if;
    else
      heater1.Heater.Wb_flows = zeros(heater1.Heater.nV);
    end if;
    if (heater1.Heater.exposeState_a and heater1.Heater.exposeState_b) then 
      assert(heater1.Heater.nV > 1, "nV must be > 1 if exposeState_a and exposeState_b = true");
    end if;
    if (heater1.Heater.useLumpedPressure) then 
      if ( not (heater1.Heater.exposeState_a and heater1.Heater.exposeState_b))
         then 
        if (heater1.Heater.lumpPressureAt == TRANSFORM.Fluid.Types.LumpedLocation.
          port_a) then 
          fill(heater1.Heater.mediums[1].p, heater1.Heater.nV-1) = 
            heater1.Heater.mediums[2:heater1.Heater.nV].p;
        elseif (heater1.Heater.lumpPressureAt == TRANSFORM.Fluid.Types.LumpedLocation.
          port_b) then 
          fill(heater1.Heater.mediums[heater1.Heater.nV].p, heater1.Heater.nV-1)
             = heater1.Heater.mediums[1:heater1.Heater.nV-1].p;
        else
          assert(false, "Unknown lumped pressure location");
        end if;
      elseif (heater1.Heater.nV > 2) then 
        fill(heater1.Heater.mediums[1].p, heater1.Heater.iLumped-2) = 
          heater1.Heater.mediums[2:heater1.Heater.iLumped-1].p;
        fill(heater1.Heater.mediums[heater1.Heater.nV].p, heater1.Heater.nV-
          heater1.Heater.iLumped) = heater1.Heater.mediums[heater1.Heater.iLumped
          :heater1.Heater.nV-1].p;
      end if;
      if (heater1.Heater.exposeState_a and heater1.Heater.exposeState_b) then 
        heater1.Heater.m_flows[heater1.Heater.iLumped] = heater1.Heater.flowModel.m_flows
          [1];
        heater1.Heater.port_a.p = heater1.Heater.mediums[1].p;
        heater1.Heater.port_b.p = heater1.Heater.mediums[heater1.Heater.nV].p;
        heater1.Heater.statesFM[1] = heater1.Heater.mediums[1].state;
        heater1.Heater.statesFM[2] = heater1.Heater.mediums[heater1.Heater.nV].
          state;
        heater1.Heater.vsFM[1] = heater1.Heater.vs[1:heater1.Heater.iLumped-1]*
          heater1.Heater.geometry.dlengths[1:heater1.Heater.iLumped-1]/sum(
          heater1.Heater.geometry.dlengths[1:heater1.Heater.iLumped-1]);
        heater1.Heater.vsFM[2] = heater1.Heater.vs[heater1.Heater.iLumped:
          heater1.Heater.nV]*heater1.Heater.geometry.dlengths[heater1.Heater.iLumped
          :heater1.Heater.nV]/sum(heater1.Heater.geometry.dlengths[
          heater1.Heater.iLumped:heater1.Heater.nV]);
        heater1.Heater.Ts_wallFM[1] = sum(heater1.Heater.Ts_wall[1, :])/
          heater1.Heater.geometry.nSurfaces;
        heater1.Heater.Ts_wallFM[2] = sum(heater1.Heater.Ts_wall[
          heater1.Heater.nV, :])/heater1.Heater.geometry.nSurfaces;
      elseif (heater1.Heater.exposeState_a and  not heater1.Heater.exposeState_b)
         then 
        heater1.Heater.m_flows[heater1.Heater.nV+1] = heater1.Heater.flowModel.m_flows
          [1];
        heater1.Heater.port_a.p = heater1.Heater.mediums[1].p;
        heater1.Heater.statesFM[1] = heater1.Heater.mediums[heater1.Heater.iLumped]
          .state;
        heater1.Heater.statesFM[2] = heater1.Heater.state_b;
        heater1.Heater.vsFM[1] = heater1.Heater.vs*heater1.Heater.geometry.dlengths
          /sum(heater1.Heater.geometry.dlengths);
        heater1.Heater.vsFM[2] = heater1.Heater.m_flows[heater1.Heater.nV+1]/
          Modelica.Media.Water.WaterIF97_ph.density_Unique5(
          heater1.Heater.state_b)/heater1.Heater.geometry.crossAreas[
          heater1.Heater.nV];
        heater1.Heater.Ts_wallFM[1] = sum(heater1.Heater.Ts_wall[
          heater1.Heater.iLumped, :])/heater1.Heater.geometry.nSurfaces;
        heater1.Heater.Ts_wallFM[2] = sum(heater1.Heater.Ts_wall[
          heater1.Heater.nV, :])/heater1.Heater.geometry.nSurfaces;
      elseif ( not heater1.Heater.exposeState_a and heater1.Heater.exposeState_b)
         then 
        heater1.Heater.m_flows[1] = heater1.Heater.flowModel.m_flows[1];
        heater1.Heater.port_b.p = heater1.Heater.mediums[heater1.Heater.nV].p;
        heater1.Heater.statesFM[1] = heater1.Heater.state_a;
        heater1.Heater.statesFM[2] = heater1.Heater.mediums[heater1.Heater.iLumped]
          .state;
        heater1.Heater.vsFM[1] = heater1.Heater.m_flows[1]/Modelica.Media.Water.WaterIF97_ph.density_Unique5
          (
          heater1.Heater.state_a)/heater1.Heater.geometry.crossAreas[1];
        heater1.Heater.vsFM[2] = heater1.Heater.vs*heater1.Heater.geometry.dlengths
          /sum(heater1.Heater.geometry.dlengths);
        heater1.Heater.Ts_wallFM[1] = sum(heater1.Heater.Ts_wall[1, :])/
          heater1.Heater.geometry.nSurfaces;
        heater1.Heater.Ts_wallFM[2] = sum(heater1.Heater.Ts_wall[
          heater1.Heater.iLumped, :])/heater1.Heater.geometry.nSurfaces;
      elseif ( not heater1.Heater.exposeState_a and  not heater1.Heater.exposeState_b)
         then 
        heater1.Heater.m_flows[1] = heater1.Heater.flowModel.m_flows[1];
        heater1.Heater.m_flows[heater1.Heater.nV+1] = heater1.Heater.flowModel.m_flows
          [2];
        heater1.Heater.statesFM[1] = heater1.Heater.state_a;
        heater1.Heater.statesFM[2] = heater1.Heater.mediums[heater1.Heater.iLumped]
          .state;
        heater1.Heater.statesFM[3] = heater1.Heater.state_b;
        heater1.Heater.vsFM[1] = heater1.Heater.m_flows[1]/Modelica.Media.Water.WaterIF97_ph.density_Unique5
          (
          heater1.Heater.state_a)/heater1.Heater.geometry.crossAreas[1];
        heater1.Heater.vsFM[2] = heater1.Heater.vs*heater1.Heater.geometry.dlengths
          /sum(heater1.Heater.geometry.dlengths);
        heater1.Heater.vsFM[3] = heater1.Heater.m_flows[heater1.Heater.nV+1]/
          Modelica.Media.Water.WaterIF97_ph.density_Unique5(
          heater1.Heater.state_b)/heater1.Heater.geometry.crossAreas[
          heater1.Heater.nV];
        heater1.Heater.Ts_wallFM[1] = sum(heater1.Heater.Ts_wall[1, :])/
          heater1.Heater.geometry.nSurfaces;
        heater1.Heater.Ts_wallFM[2] = sum(heater1.Heater.Ts_wall[
          heater1.Heater.iLumped, :])/heater1.Heater.geometry.nSurfaces;
        heater1.Heater.Ts_wallFM[3] = sum(heater1.Heater.Ts_wall[
          heater1.Heater.nV, :])/heater1.Heater.geometry.nSurfaces;
      else
        assert(false, "Unknown model structure");
      end if;
      if ( not ( not heater1.Heater.exposeState_a and  not heater1.Heater.exposeState_b))
         then 
        heater1.Heater.dlengthsFM[1] = sum(heater1.Heater.geometry.dlengths);
        heater1.Heater.dheightsFM[1] = sum(heater1.Heater.geometry.dheights);
        if (heater1.Heater.nV == 1) then 
          heater1.Heater.dimensionsFM[1:2] = {heater1.Heater.geometry.dimensions
            [1], heater1.Heater.geometry.dimensions[1]};
          heater1.Heater.crossAreasFM[1:2] = {heater1.Heater.geometry.crossAreas
            [1], heater1.Heater.geometry.crossAreas[1]};
          heater1.Heater.perimetersFM[1:2] = {heater1.Heater.geometry.perimeters
            [1], heater1.Heater.geometry.perimeters[1]};
          heater1.Heater.roughnessesFM[1:2] = {heater1.Heater.geometry.roughnesses
            [1], heater1.Heater.geometry.roughnesses[1]};
        else
          heater1.Heater.dimensionsFM[1:2] = {sum(heater1.Heater.geometry.dimensions
            [1:heater1.Heater.iLumped-1])/(heater1.Heater.iLumped-1), sum(
            heater1.Heater.geometry.dimensions[heater1.Heater.iLumped:
            heater1.Heater.nV])/(heater1.Heater.nV-heater1.Heater.iLumped+1)};
          heater1.Heater.crossAreasFM[1:2] = {sum(heater1.Heater.geometry.crossAreas
            [1:heater1.Heater.iLumped-1])/(heater1.Heater.iLumped-1), sum(
            heater1.Heater.geometry.crossAreas[heater1.Heater.iLumped:
            heater1.Heater.nV])/(heater1.Heater.nV-heater1.Heater.iLumped+1)};
          heater1.Heater.perimetersFM[1:2] = {sum(heater1.Heater.geometry.perimeters
            [1:heater1.Heater.iLumped-1])/(heater1.Heater.iLumped-1), sum(
            heater1.Heater.geometry.perimeters[heater1.Heater.iLumped:
            heater1.Heater.nV])/(heater1.Heater.nV-heater1.Heater.iLumped+1)};
          heater1.Heater.roughnessesFM[1:2] = {sum(heater1.Heater.geometry.roughnesses
            [1:heater1.Heater.iLumped-1])/(heater1.Heater.iLumped-1), sum(
            heater1.Heater.geometry.roughnesses[heater1.Heater.iLumped:
            heater1.Heater.nV])/(heater1.Heater.nV-heater1.Heater.iLumped+1)};
        end if;
      else
        if (heater1.Heater.nV == 1) then 
          heater1.Heater.dlengthsFM[1:2] = {heater1.Heater.geometry.dlengths[1]/2,
             heater1.Heater.geometry.dlengths[1]/2};
          heater1.Heater.dheightsFM[1:2] = {heater1.Heater.geometry.dheights[1]/2,
             heater1.Heater.geometry.dheights[1]/2};
          heater1.Heater.dimensionsFM[1:3] = {heater1.Heater.geometry.dimensions
            [1], heater1.Heater.geometry.dimensions[1], heater1.Heater.geometry.dimensions
            [1]};
          heater1.Heater.crossAreasFM[1:3] = {heater1.Heater.geometry.crossAreas
            [1], heater1.Heater.geometry.crossAreas[1], heater1.Heater.geometry.crossAreas
            [1]};
          heater1.Heater.perimetersFM[1:3] = {heater1.Heater.geometry.perimeters
            [1], heater1.Heater.geometry.perimeters[1], heater1.Heater.geometry.perimeters
            [1]};
          heater1.Heater.roughnessesFM[1:3] = {heater1.Heater.geometry.roughnesses
            [1], heater1.Heater.geometry.roughnesses[1], heater1.Heater.geometry.roughnesses
            [1]};
        else
          heater1.Heater.dlengthsFM[1:2] = {sum(heater1.Heater.geometry.dlengths
            [1:heater1.Heater.iLumped-1]), sum(heater1.Heater.geometry.dlengths[
            heater1.Heater.iLumped:heater1.Heater.nV])};
          heater1.Heater.dheightsFM[1:2] = {sum(heater1.Heater.geometry.dheights
            [1:heater1.Heater.iLumped-1]), sum(heater1.Heater.geometry.dheights[
            heater1.Heater.iLumped:heater1.Heater.nV])};
          heater1.Heater.dimensionsFM[1:3] = {sum(heater1.Heater.geometry.dimensions
            [1:heater1.Heater.iLumped-1])/(heater1.Heater.iLumped-1), sum(
            heater1.Heater.geometry.dimensions)/heater1.Heater.nV, sum(
            heater1.Heater.geometry.dimensions[heater1.Heater.iLumped:
            heater1.Heater.nV])/(heater1.Heater.nV-heater1.Heater.iLumped+1)};
          heater1.Heater.crossAreasFM[1:3] = {sum(heater1.Heater.geometry.crossAreas
            [1:heater1.Heater.iLumped-1])/(heater1.Heater.iLumped-1), sum(
            heater1.Heater.geometry.crossAreas)/heater1.Heater.nV, sum(
            heater1.Heater.geometry.crossAreas[heater1.Heater.iLumped:
            heater1.Heater.nV])/(heater1.Heater.nV-heater1.Heater.iLumped+1)};
          heater1.Heater.perimetersFM[1:3] = {sum(heater1.Heater.geometry.perimeters
            [1:heater1.Heater.iLumped-1])/(heater1.Heater.iLumped-1), sum(
