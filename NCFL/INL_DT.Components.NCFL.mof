    heater3.Heater.heatTransfer.mediums[1].mu = Modelica.Media.Water.WaterIF97_ph.dynamicViscosity_Unique6
      (
      heater3.Heater.heatTransfer.mediums[1].state);
    heater3.Heater.heatTransfer.mediums[1].lambda = Modelica.Media.Water.WaterIF97_ph.thermalConductivity_Unique45
      (
      heater3.Heater.heatTransfer.mediums[1].state);
    heater3.Heater.heatTransfer.mediums[1].cp = Modelica.Media.Water.WaterIF97_ph.specificHeatCapacityCp_Unique46
      (
      heater3.Heater.heatTransfer.mediums[1].state);

  // Component heater3.Heater.heatTransfer
  // class TRANSFORM.Fluid.Pipes.GenericPipe_MultiTransferSurface.HeatTransfer
    // extends TRANSFORM.Fluid.ClosureRelations.HeatTransfer.Models.DistributedPipe_1D_MultiTransferSurface.PartialIdeal
    equation
      heater3.Heater.heatTransfer.m_flows = heater3.Heater.heatTransfer.vs.*
        heater3.Heater.heatTransfer.mediums.d.*heater3.Heater.heatTransfer.crossAreas;
      heater3.Heater.heatTransfer.Res = heater3.Heater.heatTransfer.mediums.d.*
        heater3.Heater.heatTransfer.dimensions.*abs(heater3.Heater.heatTransfer.vs)
        ./heater3.Heater.heatTransfer.mediums.mu;
      heater3.Heater.heatTransfer.Prs = heater3.Heater.heatTransfer.mediums.mu.*
        heater3.Heater.heatTransfer.mediums.cp./heater3.Heater.heatTransfer.mediums
        .lambda;
    // extends TRANSFORM.Fluid.ClosureRelations.HeatTransfer.Models.DistributedPipe_1D_MultiTransferSurface.Ideal
    equation
      for i in (1:heater3.Heater.heatTransfer.nHT) loop
        for j in (1:heater3.Heater.heatTransfer.nSurfaces) loop
          heater3.Heater.heatTransfer.Ts_wall[i, j] = heater3.Heater.heatTransfer.Ts_fluid
            [i];
          heater3.Heater.heatTransfer.alphas[i, j] = 1E+60;
          heater3.Heater.heatTransfer.Nus[i, j] = 1E+60;
        end for;
      end for;
    // end of extends 

  // Component heater3.Heater.internalHeatGen
  // class TRANSFORM.Fluid.Pipes.GenericPipe_MultiTransferSurface.InternalHeatGen
    // extends TRANSFORM.Fluid.ClosureRelations.InternalVolumeHeatGeneration.Models.DistributedVolume_1D.GenericHeatGeneration
    equation
      for i in (1:heater3.Heater.internalHeatGen.nV) loop
        heater3.Heater.internalHeatGen.Q_flows[i] = heater3.Heater.internalHeatGen.Q_gens
          [i];
      end for;
    // end of extends 

  // Component heater3.Heater.traceMassTransfer.diffusionCoeff[1]
  // class TRANSFORM.Fluid.ClosureRelations.MassTransfer.Models.DistributedPipe_TraceMass_1D_MultiTransferSurface.PartialMassTransfer_setC.DiffusionCoeff
    // extends TRANSFORM.Media.ClosureModels.MassDiffusionCoefficient.Models.GenericCoefficient
    equation
      heater3.Heater.traceMassTransfer.diffusionCoeff[1].D_abs = 
        heater3.Heater.traceMassTransfer.diffusionCoeff[1].D_abs0;
    // end of extends 

  // Component heater3.Heater.traceMassTransfer.mediums[1]
  // class TRANSFORM.Media.BaseProperties1Phase
  equation
    heater3.Heater.traceMassTransfer.mediums[1].h = Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_Unique25
      (
      heater3.Heater.traceMassTransfer.mediums[1].state);
    heater3.Heater.traceMassTransfer.mediums[1].d = Modelica.Media.Water.WaterIF97_ph.density_Unique5
      (
      heater3.Heater.traceMassTransfer.mediums[1].state);
    heater3.Heater.traceMassTransfer.mediums[1].T = Modelica.Media.Water.WaterIF97_ph.temperature_Unique28
      (
      heater3.Heater.traceMassTransfer.mediums[1].state);
    heater3.Heater.traceMassTransfer.mediums[1].p = Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
      (
      heater3.Heater.traceMassTransfer.mediums[1].state);
    heater3.Heater.traceMassTransfer.mediums[1].mu = Modelica.Media.Water.WaterIF97_ph.dynamicViscosity_Unique6
      (
      heater3.Heater.traceMassTransfer.mediums[1].state);
    heater3.Heater.traceMassTransfer.mediums[1].lambda = Modelica.Media.Water.WaterIF97_ph.thermalConductivity_Unique45
      (
      heater3.Heater.traceMassTransfer.mediums[1].state);
    heater3.Heater.traceMassTransfer.mediums[1].cp = Modelica.Media.Water.WaterIF97_ph.specificHeatCapacityCp_Unique46
      (
      heater3.Heater.traceMassTransfer.mediums[1].state);

  // Component heater3.Heater.traceMassTransfer
  // class TRANSFORM.Fluid.Pipes.GenericPipe_MultiTransferSurface.TraceMassTransfer
    // extends TRANSFORM.Fluid.ClosureRelations.MassTransfer.Models.DistributedPipe_TraceMass_1D_MultiTransferSurface.PartialMassTransfer_setC
    equation
      for i in (1:heater3.Heater.traceMassTransfer.nMT) loop
        for k in (1:heater3.Heater.traceMassTransfer.nC) loop
          heater3.Heater.traceMassTransfer.Cs_fluid[i, k] = heater3.Heater.traceMassTransfer.CsM_fluid
            [i, heater3.Heater.traceMassTransfer.iC[k]]*Modelica.Media.Water.WaterIF97_ph.density_Unique5
            (
            heater3.Heater.traceMassTransfer.states[i])*heater3.Heater.traceMassTransfer.toMole_unitConv
            /heater3.Heater.traceMassTransfer.MMs[k];
        end for;
      end for;
      for i in (1:heater3.Heater.traceMassTransfer.nMT) loop
        for j in (1:heater3.Heater.traceMassTransfer.nSurfaces) loop
          for k in (1:heater3.Heater.traceMassTransfer.nC) loop
            heater3.Heater.traceMassTransfer.mC_flows[i, j, heater3.Heater.traceMassTransfer.iC
              [k]] = heater3.Heater.traceMassTransfer.nC_flows[i, j, k]*
              heater3.Heater.traceMassTransfer.MMs[k]*heater3.Heater.traceMassTransfer.toMole_unitConv;
          end for;
          for k in (1:heater3.Heater.traceMassTransfer.nC_noT) loop
            heater3.Heater.traceMassTransfer.mC_flows[i, j, heater3.Heater.traceMassTransfer.iC_noT
              [k]] = 0;
          end for;
        end for;
      end for;
      for i in (1:heater3.Heater.traceMassTransfer.nMT) loop
        heater3.Heater.traceMassTransfer.xs[i] = noEvent((if heater3.Heater.traceMassTransfer.vs
          [i] >= 0 then (if i == 1 then 0.5*heater3.Heater.traceMassTransfer.dlengths
          [i] else sum(heater3.Heater.traceMassTransfer.dlengths[1:i-1])+0.5*
          heater3.Heater.traceMassTransfer.dlengths[i]) else (if i == 
          heater3.Heater.traceMassTransfer.nMT then 0.5*heater3.Heater.traceMassTransfer.dlengths
          [heater3.Heater.traceMassTransfer.nMT] else sum(heater3.Heater.traceMassTransfer.dlengths
          [i+1:heater3.Heater.traceMassTransfer.nMT])+0.5*heater3.Heater.traceMassTransfer.dlengths
          [i])));
      end for;
    // extends TRANSFORM.Fluid.ClosureRelations.MassTransfer.Models.DistributedPipe_TraceMass_1D_MultiTransferSurface.PartialIdeal
    equation
      for i in (1:heater3.Heater.traceMassTransfer.nMT) loop
        heater3.Heater.traceMassTransfer.m_flows[i] = heater3.Heater.traceMassTransfer.vs
          [i]*heater3.Heater.traceMassTransfer.mediums[i].d*heater3.Heater.traceMassTransfer.crossAreas
          [i];
        heater3.Heater.traceMassTransfer.Res[i] = heater3.Heater.traceMassTransfer.mediums
          [i].d*heater3.Heater.traceMassTransfer.dimensions[i]*abs(
          heater3.Heater.traceMassTransfer.vs[i])/heater3.Heater.traceMassTransfer.mediums
          [i].mu;
        heater3.Heater.traceMassTransfer.Scs[i, :] = heater3.Heater.traceMassTransfer.mediums
          [i].mu./(heater3.Heater.traceMassTransfer.mediums[i].d.*
          heater3.Heater.traceMassTransfer.diffusionCoeff[i].D_abs);
      end for;
    // extends TRANSFORM.Fluid.ClosureRelations.MassTransfer.Models.DistributedPipe_TraceMass_1D_MultiTransferSurface.Ideal
    equation
      for i in (1:heater3.Heater.traceMassTransfer.nMT) loop
        for j in (1:heater3.Heater.traceMassTransfer.nSurfaces) loop
          heater3.Heater.traceMassTransfer.Cs_wall[i, j, :] = heater3.Heater.traceMassTransfer.Cs_fluid
            [i, :];
          heater3.Heater.traceMassTransfer.alphasM[i, j, :] = 1E+60*ones(
            heater3.Heater.traceMassTransfer.nC);
          heater3.Heater.traceMassTransfer.Shs[i, j, :] = 1E+60*ones(
            heater3.Heater.traceMassTransfer.nC);
        end for;
      end for;
    // end of extends 

  // Component heater3.Heater.internalTraceGen
  // class TRANSFORM.Fluid.Pipes.GenericPipe_MultiTransferSurface.InternalTraceGen
    // extends TRANSFORM.Fluid.ClosureRelations.InternalTraceGeneration.Models.DistributedVolume_Trace_1D.GenericTraceGeneration
    equation
      for ic in (1:0) loop
        for i in (1:heater3.Heater.internalTraceGen.nV) loop
          heater3.Heater.internalTraceGen.mC_flows[i, ic] = heater3.Heater.internalTraceGen.mC_gens
            [i, ic];
        end for;
      end for;
    // end of extends 

  // Component heater3.Heater.mediums[1]
  // class Modelica.Media.Water.WaterIF97_base.BaseProperties
    // extends Modelica.Media.Interfaces.PartialMedium.BaseProperties_D1
    equation
      if (heater3.Heater.mediums[1].standardOrderComponents) then 
        heater3.Heater.mediums[1].Xi = heater3.Heater.mediums[1].X[1:0];
        heater3.Heater.mediums[1].X = {1.0};
        for i in (1:1) loop
          assert(heater3.Heater.mediums[1].X[i] >= -1E-05 and heater3.Heater.mediums[1].X
            [i] <= 1.00001, "Mass fraction X["+       String(i, true, 0)+"] = "+
                   String(heater3.Heater.mediums[1].X[i], true, 0)+
            "of substance "+({"water"})[i]+"\nof medium "+"WaterIF97"+
            " is not in the range 0..1");
        end for;
      end if;
      assert(heater3.Heater.mediums[1].p >= 0.0, "Pressure (= "+       String(
        heater3.Heater.mediums[1].p, true, 0)+" Pa) of medium \""+"WaterIF97"+
        "\" is negative\n(Temperature = "+       String(heater3.Heater.mediums[1].T,
         true, 0)+" K)");
    // end of extends 
  equation
    heater3.Heater.mediums[1].MM = _GlobalScope.Modelica.Media.Water.WaterIF97_ph.fluidConstants[1]
      .molarMass;
    heater3.Heater.mediums[1].phase = (if heater3.Heater.mediums[1].h < 
      Modelica.Media.Water.WaterIF97_ph.bubbleEnthalpy_Unique29(
      heater3.Heater.mediums[1].sat) or heater3.Heater.mediums[1].h > 
      Modelica.Media.Water.WaterIF97_ph.dewEnthalpy_Unique30(
      heater3.Heater.mediums[1].sat) or heater3.Heater.mediums[1].p > 
      _GlobalScope.Modelica.Media.Water.WaterIF97_ph.fluidConstants[1].
      criticalPressure then 1 else 2);
    heater3.Heater.mediums[1].d = Modelica.Media.Water.WaterIF97_ph.density_ph_Unique3
      (heater3.Heater.mediums[1].p, heater3.Heater.mediums[1].h, 
      heater3.Heater.mediums[1].phase, 0);
    heater3.Heater.mediums[1].T = Modelica.Media.Water.WaterIF97_ph.temperature_ph_Unique4
      (heater3.Heater.mediums[1].p, heater3.Heater.mediums[1].h, 
      heater3.Heater.mediums[1].phase, 0);
    heater3.Heater.mediums[1].sat.Tsat = Modelica.Media.Water.WaterIF97_ph.saturationTemperature_Unique37
      (heater3.Heater.mediums[1].p);
    heater3.Heater.mediums[1].sat.psat = heater3.Heater.mediums[1].p;
    heater3.Heater.mediums[1].u = heater3.Heater.mediums[1].h-heater3.Heater.mediums[1].p
      /heater3.Heater.mediums[1].d;
    heater3.Heater.mediums[1].R_s = 8.31446261815324/_GlobalScope.Modelica.Media.Water.WaterIF97_ph.fluidConstants[1]
      .molarMass;
    heater3.Heater.mediums[1].h = heater3.Heater.mediums[1].state.h;
    heater3.Heater.mediums[1].p = heater3.Heater.mediums[1].state.p;
    heater3.Heater.mediums[1].T = heater3.Heater.mediums[1].state.T;
    heater3.Heater.mediums[1].d = heater3.Heater.mediums[1].state.d;
    heater3.Heater.mediums[1].phase = heater3.Heater.mediums[1].state.phase;

  // Component heater3.Heater
  // class TRANSFORM.Fluid.Pipes.GenericPipe_MultiTransferSurface
    // extends TRANSFORM.Fluid.Pipes.BaseClasses.PartialDistributedVolume
    equation
      assert( not (heater3.Heater.energyDynamics <> Modelica.Fluid.Types.Dynamics.
        SteadyState and heater3.Heater.massDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) or false, "Bad combination of dynamics options and Medium not conserving mass if fluidVolumes are fixed.");
      for i in (1:heater3.Heater.nV) loop
        heater3.Heater.ms[i] = heater3.Heater.Vs[i]*heater3.Heater.mediums[i].d;
        heater3.Heater.Us[i] = heater3.Heater.ms[i]*heater3.Heater.mediums[i].u;
        heater3.Heater.mXis[i, :] = heater3.Heater.ms[i]*heater3.Heater.mediums[
          i].Xi;
        heater3.Heater.mCs[i, :] = heater3.Heater.ms[i].*heater3.Heater.Cs[i, :];
      end for;
      if (heater3.Heater.massDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) then 
        for i in (1:heater3.Heater.nV) loop
          0 = heater3.Heater.mbs[i];
        end for;
      else
        for i in (1:heater3.Heater.nV) loop
          der(heater3.Heater.ms[i]) = heater3.Heater.mbs[i];
        end for;
      end if;
      if (heater3.Heater.energyDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) then 
        for i in (1:heater3.Heater.nV) loop
          0 = heater3.Heater.Ubs[i];
        end for;
      else
        for i in (1:heater3.Heater.nV) loop
          der(heater3.Heater.Us[i]) = heater3.Heater.Ubs[i];
        end for;
      end if;
      if (heater3.Heater.substanceDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) then 
        for i in (1:heater3.Heater.nV) loop
          zeros(0) = heater3.Heater.mXibs[i, :];
        end for;
      else
        for i in (1:heater3.Heater.nV) loop
          der(heater3.Heater.mXis[i, :]) = heater3.Heater.mXibs[i, :];
        end for;
      end if;
      if (heater3.Heater.traceDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) then 
        for i in (1:heater3.Heater.nV) loop
          zeros(0) = heater3.Heater.mCbs[i, :];
        end for;
      else
        for i in (1:heater3.Heater.nV) loop
          der(heater3.Heater.mCs_scaled[i, :]) = heater3.Heater.mCbs[i, :]./{};
          heater3.Heater.mCs[i, :] = heater3.Heater.mCs_scaled[i, :].*{};
        end for;
      end if;
    // end of extends 
  equation
    for i in (1:heater3.Heater.nV) loop
      heater3.Heater.mbs[i] = heater3.Heater.m_flows[i]-heater3.Heater.m_flows[i
        +1];
      heater3.Heater.Ubs[i] = heater3.Heater.Wb_flows[i]+heater3.Heater.H_flows[
        i]-heater3.Heater.H_flows[i+1]+sum(heater3.Heater.heatTransfer.Q_flows[i,
         :])+heater3.Heater.internalHeatGen.Q_flows[i]/heater3.Heater.nParallel;
      heater3.Heater.mXibs[i, :] = heater3.Heater.mXi_flows[i, :]-
        heater3.Heater.mXi_flows[i+1, :];
      heater3.Heater.mCbs[i, :] = heater3.Heater.mC_flows[i, :]-heater3.Heater.mC_flows
        [i+1, :]+heater3.Heater.mC_flows_traceMassTransferSum[i, :]+
        heater3.Heater.internalTraceGen.mC_flows[i, :]/heater3.Heater.nParallel;
    end for;
    if ( not heater3.Heater.use_HeatTransfer) then 
      for i in (1:heater3.Heater.geometry.nSurfaces) loop
        for j in (1:heater3.Heater.nV) loop
          heater3.Heater.Ts_wall[j, i] = heater3.Heater.mediums[j].T;
        end for;
      end for;
    else
      for i in (1:heater3.Heater.geometry.nSurfaces) loop
        for j in (1:heater3.Heater.nV) loop
          heater3.Heater.Ts_wall[j, i] = heater3.Heater.heatPorts_int[j, i].T;
        end for;
      end for;
    end if;
    heater3.Heater.port_a.m_flow/heater3.Heater.nParallel = heater3.Heater.m_flows
      [1];
    heater3.Heater.port_b.m_flow/heater3.Heater.nParallel =  -heater3.Heater.m_flows
      [heater3.Heater.nV+1];
    heater3.Heater.port_a.h_outflow = heater3.Heater.mediums[1].h;
    heater3.Heater.port_b.h_outflow = heater3.Heater.mediums[heater3.Heater.nV].
      h;
    heater3.Heater.port_a.Xi_outflow = heater3.Heater.mediums[1].Xi;
    heater3.Heater.port_b.Xi_outflow = heater3.Heater.mediums[heater3.Heater.nV]
      .Xi;
    heater3.Heater.port_a.C_outflow = heater3.Heater.Cs[1, :];
    heater3.Heater.port_b.C_outflow = heater3.Heater.Cs[heater3.Heater.nV, :];
    if (heater3.Heater.useInnerPortProperties and heater3.Heater.nV > 0) then 
      heater3.Heater.state_a = Modelica.Media.Water.WaterIF97_ph.setState_phX_Unique1
        (heater3.Heater.port_a.p, heater3.Heater.mediums[1].h, heater3.Heater.mediums
        [1].Xi, 0, 0);
      heater3.Heater.state_b = Modelica.Media.Water.WaterIF97_ph.setState_phX_Unique1
        (heater3.Heater.port_b.p, heater3.Heater.mediums[heater3.Heater.nV].h, 
        heater3.Heater.mediums[heater3.Heater.nV].Xi, 0, 0);
    else
      heater3.Heater.state_a = Modelica.Media.Water.WaterIF97_ph.setState_phX_Unique1
        (heater3.Heater.port_a.p, inStream(heater3.Heater.port_a.h_outflow), 
        inStream(heater3.Heater.port_a.Xi_outflow), 0, 0);
      heater3.Heater.state_b = Modelica.Media.Water.WaterIF97_ph.setState_phX_Unique1
        (heater3.Heater.port_b.p, inStream(heater3.Heater.port_b.h_outflow), 
        inStream(heater3.Heater.port_b.Xi_outflow), 0, 0);
    end if;
    heater3.Heater.H_flows[1] = semiLinear(heater3.Heater.port_a.m_flow, 
      inStream(heater3.Heater.port_a.h_outflow), heater3.Heater.mediums[1].h)/
      heater3.Heater.nParallel;
    heater3.Heater.mXi_flows[1, :] = semiLinear(heater3.Heater.port_a.m_flow, 
      inStream(heater3.Heater.port_a.Xi_outflow), heater3.Heater.mediums[1].Xi)/
      heater3.Heater.nParallel;
    heater3.Heater.mC_flows[1, :] = semiLinear(heater3.Heater.port_a.m_flow, 
      inStream(heater3.Heater.port_a.C_outflow), heater3.Heater.Cs[1, :])/
      heater3.Heater.nParallel;
    for i in (2:heater3.Heater.nV) loop
      heater3.Heater.H_flows[i] = semiLinear(heater3.Heater.m_flows[i], 
        heater3.Heater.mediums[i-1].h, heater3.Heater.mediums[i].h);
      heater3.Heater.mXi_flows[i, :] = semiLinear(heater3.Heater.m_flows[i], 
        heater3.Heater.mediums[i-1].Xi, heater3.Heater.mediums[i].Xi);
      heater3.Heater.mC_flows[i, :] = semiLinear(heater3.Heater.m_flows[i], 
        heater3.Heater.Cs[i-1, :], heater3.Heater.Cs[i, :]);
    end for;
    heater3.Heater.H_flows[heater3.Heater.nV+1] =  -semiLinear(heater3.Heater.port_b.m_flow,
       inStream(heater3.Heater.port_b.h_outflow), heater3.Heater.mediums[
      heater3.Heater.nV].h)/heater3.Heater.nParallel;
    heater3.Heater.mXi_flows[heater3.Heater.nV+1, :] =  -semiLinear(
      heater3.Heater.port_b.m_flow, inStream(heater3.Heater.port_b.Xi_outflow), 
      heater3.Heater.mediums[heater3.Heater.nV].Xi)/heater3.Heater.nParallel;
    heater3.Heater.mC_flows[heater3.Heater.nV+1, :] =  -semiLinear(
      heater3.Heater.port_b.m_flow, inStream(heater3.Heater.port_b.C_outflow), 
      heater3.Heater.Cs[heater3.Heater.nV, :])/heater3.Heater.nParallel;
    if (heater3.Heater.calc_Wb) then 
      if (heater3.Heater.nV == 1 or heater3.Heater.useLumpedPressure) then 
        heater3.Heater.Wb_flows = heater3.Heater.geometry.dxs*(heater3.Heater.vs
          *heater3.Heater.geometry.dxs*(heater3.Heater.geometry.crossAreas*
          heater3.Heater.geometry.dxs)*(heater3.Heater.port_b.p-heater3.Heater.port_a.p
          +sum(heater3.Heater.flowModel.dps_fg)-heater3.Heater.g_n*(
          heater3.Heater.geometry.dheights*heater3.Heater.mediums.d)));
      else
        if (heater3.Heater.exposeState_a and heater3.Heater.exposeState_b or 
          heater3.Heater.exposeState_a and  not heater3.Heater.exposeState_b)
           then 
          heater3.Heater.Wb_flows[2:heater3.Heater.nV-1] = array(
            heater3.Heater.vs[i]*heater3.Heater.geometry.crossAreas[i]*((
            heater3.Heater.mediums[i+1].p-heater3.Heater.mediums[i-1].p)/2+(
            heater3.Heater.flowModel.dps_fg[i-1]+heater3.Heater.flowModel.dps_fg
            [i])/2-heater3.Heater.g_n*heater3.Heater.geometry.dheights[i]*
            heater3.Heater.mediums[i].d) for i in 2:heater3.Heater.nV-1);
        else
          heater3.Heater.Wb_flows[2:heater3.Heater.nV-1] = array(
            heater3.Heater.vs[i]*heater3.Heater.geometry.crossAreas[i]*((
            heater3.Heater.mediums[i+1].p-heater3.Heater.mediums[i-1].p)/2+(
            heater3.Heater.flowModel.dps_fg[i]+heater3.Heater.flowModel.dps_fg[i
            +1])/2-heater3.Heater.g_n*heater3.Heater.geometry.dheights[i]*
            heater3.Heater.mediums[i].d) for i in 2:heater3.Heater.nV-1);
        end if;
        if (heater3.Heater.exposeState_a and heater3.Heater.exposeState_b) then 
          heater3.Heater.Wb_flows[1] = heater3.Heater.vs[1]*heater3.Heater.geometry.crossAreas
            [1]*((heater3.Heater.mediums[2].p-heater3.Heater.mediums[1].p)/2+
            heater3.Heater.flowModel.dps_fg[1]/2-heater3.Heater.g_n*
            heater3.Heater.geometry.dheights[1]*heater3.Heater.mediums[1].d);
          heater3.Heater.Wb_flows[heater3.Heater.nV] = heater3.Heater.vs[
            heater3.Heater.nV]*heater3.Heater.geometry.crossAreas[
            heater3.Heater.nV]*((heater3.Heater.mediums[heater3.Heater.nV].p-
            heater3.Heater.mediums[heater3.Heater.nV-1].p)/2+heater3.Heater.flowModel.dps_fg
            [heater3.Heater.nV-1]/2-heater3.Heater.g_n*heater3.Heater.geometry.dheights
            [heater3.Heater.nV]*heater3.Heater.mediums[heater3.Heater.nV].d);
        elseif (heater3.Heater.exposeState_a and  not heater3.Heater.exposeState_b)
           then 
          heater3.Heater.Wb_flows[1] = heater3.Heater.vs[1]*heater3.Heater.geometry.crossAreas
            [1]*((heater3.Heater.mediums[2].p-heater3.Heater.mediums[1].p)/2+
            heater3.Heater.flowModel.dps_fg[1]/2-heater3.Heater.g_n*
            heater3.Heater.geometry.dheights[1]*heater3.Heater.mediums[1].d);
          if (heater3.Heater.nV == 2) then 
            heater3.Heater.Wb_flows[heater3.Heater.nV] = heater3.Heater.vs[
              heater3.Heater.nV]*heater3.Heater.geometry.crossAreas[
              heater3.Heater.nV]*((heater3.Heater.port_b.p-heater3.Heater.mediums
              [heater3.Heater.nV-1].p)*5/8+heater3.Heater.flowModel.dps_fg[
              heater3.Heater.nV-1]/2+heater3.Heater.flowModel.dps_fg[
              heater3.Heater.nV]-heater3.Heater.g_n*heater3.Heater.geometry.dheights
              [heater3.Heater.nV]*heater3.Heater.mediums[heater3.Heater.nV].d);
          else
            heater3.Heater.Wb_flows[heater3.Heater.nV] = heater3.Heater.vs[
              heater3.Heater.nV]*heater3.Heater.geometry.crossAreas[
              heater3.Heater.nV]*((heater3.Heater.port_b.p-heater3.Heater.mediums
              [heater3.Heater.nV-1].p)/1.5+heater3.Heater.flowModel.dps_fg[
              heater3.Heater.nV-1]/2+heater3.Heater.flowModel.dps_fg[
              heater3.Heater.nV]-heater3.Heater.g_n*heater3.Heater.geometry.dheights
              [heater3.Heater.nV]*heater3.Heater.mediums[heater3.Heater.nV].d);
          end if;
        elseif ( not heater3.Heater.exposeState_a and heater3.Heater.exposeState_b)
           then 
          if (heater3.Heater.nV == 2) then 
            heater3.Heater.Wb_flows[1] = heater3.Heater.vs[1]*heater3.Heater.geometry.crossAreas
              [1]*((heater3.Heater.mediums[2].p-heater3.Heater.port_a.p)*5/8+
              heater3.Heater.flowModel.dps_fg[1]+heater3.Heater.flowModel.dps_fg
              [2]/2-heater3.Heater.g_n*heater3.Heater.geometry.dheights[1]*
              heater3.Heater.mediums[1].d);
          else
            heater3.Heater.Wb_flows[1] = heater3.Heater.vs[1]*heater3.Heater.geometry.crossAreas
              [1]*((heater3.Heater.mediums[2].p-heater3.Heater.port_a.p)/1.5+
              heater3.Heater.flowModel.dps_fg[1]+heater3.Heater.flowModel.dps_fg
              [2]/2-heater3.Heater.g_n*heater3.Heater.geometry.dheights[1]*
              heater3.Heater.mediums[1].d);
          end if;
          heater3.Heater.Wb_flows[heater3.Heater.nV] = heater3.Heater.vs[
            heater3.Heater.nV]*heater3.Heater.geometry.crossAreas[
            heater3.Heater.nV]*((heater3.Heater.mediums[heater3.Heater.nV].p-
            heater3.Heater.mediums[heater3.Heater.nV-1].p)/2+heater3.Heater.flowModel.dps_fg
            [heater3.Heater.nV]/2-heater3.Heater.g_n*heater3.Heater.geometry.dheights
            [heater3.Heater.nV]*heater3.Heater.mediums[heater3.Heater.nV].d);
        elseif ( not heater3.Heater.exposeState_a and  not heater3.Heater.exposeState_b)
           then 
          heater3.Heater.Wb_flows[1] = heater3.Heater.vs[1]*heater3.Heater.geometry.crossAreas
            [1]*((heater3.Heater.mediums[2].p-heater3.Heater.port_a.p)/1.5+
            heater3.Heater.flowModel.dps_fg[1]+heater3.Heater.flowModel.dps_fg[2]
            /2-heater3.Heater.g_n*heater3.Heater.geometry.dheights[1]*
            heater3.Heater.mediums[1].d);
          heater3.Heater.Wb_flows[heater3.Heater.nV] = heater3.Heater.vs[
            heater3.Heater.nV]*heater3.Heater.geometry.crossAreas[
            heater3.Heater.nV]*((heater3.Heater.port_b.p-heater3.Heater.mediums[
            heater3.Heater.nV-1].p)/1.5+heater3.Heater.flowModel.dps_fg[
            heater3.Heater.nV]/2+heater3.Heater.flowModel.dps_fg[
            heater3.Heater.nV+1]-heater3.Heater.g_n*heater3.Heater.geometry.dheights
            [heater3.Heater.nV]*heater3.Heater.mediums[heater3.Heater.nV].d);
        else
          assert(false, "Unknown model structure");
        end if;
      end if;
    else
      heater3.Heater.Wb_flows = zeros(heater3.Heater.nV);
    end if;
    if (heater3.Heater.exposeState_a and heater3.Heater.exposeState_b) then 
      assert(heater3.Heater.nV > 1, "nV must be > 1 if exposeState_a and exposeState_b = true");
    end if;
    if (heater3.Heater.useLumpedPressure) then 
      if ( not (heater3.Heater.exposeState_a and heater3.Heater.exposeState_b))
         then 
        if (heater3.Heater.lumpPressureAt == TRANSFORM.Fluid.Types.LumpedLocation.
          port_a) then 
          fill(heater3.Heater.mediums[1].p, heater3.Heater.nV-1) = 
            heater3.Heater.mediums[2:heater3.Heater.nV].p;
        elseif (heater3.Heater.lumpPressureAt == TRANSFORM.Fluid.Types.LumpedLocation.
          port_b) then 
          fill(heater3.Heater.mediums[heater3.Heater.nV].p, heater3.Heater.nV-1)
             = heater3.Heater.mediums[1:heater3.Heater.nV-1].p;
        else
          assert(false, "Unknown lumped pressure location");
        end if;
      elseif (heater3.Heater.nV > 2) then 
        fill(heater3.Heater.mediums[1].p, heater3.Heater.iLumped-2) = 
          heater3.Heater.mediums[2:heater3.Heater.iLumped-1].p;
        fill(heater3.Heater.mediums[heater3.Heater.nV].p, heater3.Heater.nV-
          heater3.Heater.iLumped) = heater3.Heater.mediums[heater3.Heater.iLumped
          :heater3.Heater.nV-1].p;
      end if;
      if (heater3.Heater.exposeState_a and heater3.Heater.exposeState_b) then 
        heater3.Heater.m_flows[heater3.Heater.iLumped] = heater3.Heater.flowModel.m_flows
          [1];
        heater3.Heater.port_a.p = heater3.Heater.mediums[1].p;
        heater3.Heater.port_b.p = heater3.Heater.mediums[heater3.Heater.nV].p;
        heater3.Heater.statesFM[1] = heater3.Heater.mediums[1].state;
        heater3.Heater.statesFM[2] = heater3.Heater.mediums[heater3.Heater.nV].
          state;
        heater3.Heater.vsFM[1] = heater3.Heater.vs[1:heater3.Heater.iLumped-1]*
          heater3.Heater.geometry.dlengths[1:heater3.Heater.iLumped-1]/sum(
          heater3.Heater.geometry.dlengths[1:heater3.Heater.iLumped-1]);
        heater3.Heater.vsFM[2] = heater3.Heater.vs[heater3.Heater.iLumped:
          heater3.Heater.nV]*heater3.Heater.geometry.dlengths[heater3.Heater.iLumped
          :heater3.Heater.nV]/sum(heater3.Heater.geometry.dlengths[
          heater3.Heater.iLumped:heater3.Heater.nV]);
        heater3.Heater.Ts_wallFM[1] = sum(heater3.Heater.Ts_wall[1, :])/
          heater3.Heater.geometry.nSurfaces;
        heater3.Heater.Ts_wallFM[2] = sum(heater3.Heater.Ts_wall[
          heater3.Heater.nV, :])/heater3.Heater.geometry.nSurfaces;
      elseif (heater3.Heater.exposeState_a and  not heater3.Heater.exposeState_b)
         then 
        heater3.Heater.m_flows[heater3.Heater.nV+1] = heater3.Heater.flowModel.m_flows
          [1];
        heater3.Heater.port_a.p = heater3.Heater.mediums[1].p;
        heater3.Heater.statesFM[1] = heater3.Heater.mediums[heater3.Heater.iLumped]
          .state;
        heater3.Heater.statesFM[2] = heater3.Heater.state_b;
        heater3.Heater.vsFM[1] = heater3.Heater.vs*heater3.Heater.geometry.dlengths
          /sum(heater3.Heater.geometry.dlengths);
        heater3.Heater.vsFM[2] = heater3.Heater.m_flows[heater3.Heater.nV+1]/
          Modelica.Media.Water.WaterIF97_ph.density_Unique5(
          heater3.Heater.state_b)/heater3.Heater.geometry.crossAreas[
          heater3.Heater.nV];
        heater3.Heater.Ts_wallFM[1] = sum(heater3.Heater.Ts_wall[
          heater3.Heater.iLumped, :])/heater3.Heater.geometry.nSurfaces;
        heater3.Heater.Ts_wallFM[2] = sum(heater3.Heater.Ts_wall[
          heater3.Heater.nV, :])/heater3.Heater.geometry.nSurfaces;
      elseif ( not heater3.Heater.exposeState_a and heater3.Heater.exposeState_b)
         then 
        heater3.Heater.m_flows[1] = heater3.Heater.flowModel.m_flows[1];
        heater3.Heater.port_b.p = heater3.Heater.mediums[heater3.Heater.nV].p;
        heater3.Heater.statesFM[1] = heater3.Heater.state_a;
        heater3.Heater.statesFM[2] = heater3.Heater.mediums[heater3.Heater.iLumped]
          .state;
        heater3.Heater.vsFM[1] = heater3.Heater.m_flows[1]/Modelica.Media.Water.WaterIF97_ph.density_Unique5
          (
          heater3.Heater.state_a)/heater3.Heater.geometry.crossAreas[1];
        heater3.Heater.vsFM[2] = heater3.Heater.vs*heater3.Heater.geometry.dlengths
          /sum(heater3.Heater.geometry.dlengths);
        heater3.Heater.Ts_wallFM[1] = sum(heater3.Heater.Ts_wall[1, :])/
          heater3.Heater.geometry.nSurfaces;
        heater3.Heater.Ts_wallFM[2] = sum(heater3.Heater.Ts_wall[
          heater3.Heater.iLumped, :])/heater3.Heater.geometry.nSurfaces;
      elseif ( not heater3.Heater.exposeState_a and  not heater3.Heater.exposeState_b)
         then 
        heater3.Heater.m_flows[1] = heater3.Heater.flowModel.m_flows[1];
        heater3.Heater.m_flows[heater3.Heater.nV+1] = heater3.Heater.flowModel.m_flows
          [2];
        heater3.Heater.statesFM[1] = heater3.Heater.state_a;
        heater3.Heater.statesFM[2] = heater3.Heater.mediums[heater3.Heater.iLumped]
          .state;
        heater3.Heater.statesFM[3] = heater3.Heater.state_b;
        heater3.Heater.vsFM[1] = heater3.Heater.m_flows[1]/Modelica.Media.Water.WaterIF97_ph.density_Unique5
          (
          heater3.Heater.state_a)/heater3.Heater.geometry.crossAreas[1];
        heater3.Heater.vsFM[2] = heater3.Heater.vs*heater3.Heater.geometry.dlengths
          /sum(heater3.Heater.geometry.dlengths);
        heater3.Heater.vsFM[3] = heater3.Heater.m_flows[heater3.Heater.nV+1]/
          Modelica.Media.Water.WaterIF97_ph.density_Unique5(
          heater3.Heater.state_b)/heater3.Heater.geometry.crossAreas[
          heater3.Heater.nV];
        heater3.Heater.Ts_wallFM[1] = sum(heater3.Heater.Ts_wall[1, :])/
          heater3.Heater.geometry.nSurfaces;
        heater3.Heater.Ts_wallFM[2] = sum(heater3.Heater.Ts_wall[
          heater3.Heater.iLumped, :])/heater3.Heater.geometry.nSurfaces;
        heater3.Heater.Ts_wallFM[3] = sum(heater3.Heater.Ts_wall[
          heater3.Heater.nV, :])/heater3.Heater.geometry.nSurfaces;
      else
        assert(false, "Unknown model structure");
      end if;
      if ( not ( not heater3.Heater.exposeState_a and  not heater3.Heater.exposeState_b))
         then 
        heater3.Heater.dlengthsFM[1] = sum(heater3.Heater.geometry.dlengths);
        heater3.Heater.dheightsFM[1] = sum(heater3.Heater.geometry.dheights);
        if (heater3.Heater.nV == 1) then 
          heater3.Heater.dimensionsFM[1:2] = {heater3.Heater.geometry.dimensions
            [1], heater3.Heater.geometry.dimensions[1]};
          heater3.Heater.crossAreasFM[1:2] = {heater3.Heater.geometry.crossAreas
            [1], heater3.Heater.geometry.crossAreas[1]};
          heater3.Heater.perimetersFM[1:2] = {heater3.Heater.geometry.perimeters
            [1], heater3.Heater.geometry.perimeters[1]};
          heater3.Heater.roughnessesFM[1:2] = {heater3.Heater.geometry.roughnesses
            [1], heater3.Heater.geometry.roughnesses[1]};
        else
          heater3.Heater.dimensionsFM[1:2] = {sum(heater3.Heater.geometry.dimensions
            [1:heater3.Heater.iLumped-1])/(heater3.Heater.iLumped-1), sum(
            heater3.Heater.geometry.dimensions[heater3.Heater.iLumped:
            heater3.Heater.nV])/(heater3.Heater.nV-heater3.Heater.iLumped+1)};
          heater3.Heater.crossAreasFM[1:2] = {sum(heater3.Heater.geometry.crossAreas
            [1:heater3.Heater.iLumped-1])/(heater3.Heater.iLumped-1), sum(
            heater3.Heater.geometry.crossAreas[heater3.Heater.iLumped:
            heater3.Heater.nV])/(heater3.Heater.nV-heater3.Heater.iLumped+1)};
          heater3.Heater.perimetersFM[1:2] = {sum(heater3.Heater.geometry.perimeters
            [1:heater3.Heater.iLumped-1])/(heater3.Heater.iLumped-1), sum(
            heater3.Heater.geometry.perimeters[heater3.Heater.iLumped:
            heater3.Heater.nV])/(heater3.Heater.nV-heater3.Heater.iLumped+1)};
          heater3.Heater.roughnessesFM[1:2] = {sum(heater3.Heater.geometry.roughnesses
            [1:heater3.Heater.iLumped-1])/(heater3.Heater.iLumped-1), sum(
            heater3.Heater.geometry.roughnesses[heater3.Heater.iLumped:
            heater3.Heater.nV])/(heater3.Heater.nV-heater3.Heater.iLumped+1)};
        end if;
      else
        if (heater3.Heater.nV == 1) then 
          heater3.Heater.dlengthsFM[1:2] = {heater3.Heater.geometry.dlengths[1]/2,
             heater3.Heater.geometry.dlengths[1]/2};
          heater3.Heater.dheightsFM[1:2] = {heater3.Heater.geometry.dheights[1]/2,
             heater3.Heater.geometry.dheights[1]/2};
          heater3.Heater.dimensionsFM[1:3] = {heater3.Heater.geometry.dimensions
            [1], heater3.Heater.geometry.dimensions[1], heater3.Heater.geometry.dimensions
            [1]};
          heater3.Heater.crossAreasFM[1:3] = {heater3.Heater.geometry.crossAreas
            [1], heater3.Heater.geometry.crossAreas[1], heater3.Heater.geometry.crossAreas
            [1]};
          heater3.Heater.perimetersFM[1:3] = {heater3.Heater.geometry.perimeters
            [1], heater3.Heater.geometry.perimeters[1], heater3.Heater.geometry.perimeters
            [1]};
          heater3.Heater.roughnessesFM[1:3] = {heater3.Heater.geometry.roughnesses
            [1], heater3.Heater.geometry.roughnesses[1], heater3.Heater.geometry.roughnesses
            [1]};
        else
          heater3.Heater.dlengthsFM[1:2] = {sum(heater3.Heater.geometry.dlengths
            [1:heater3.Heater.iLumped-1]), sum(heater3.Heater.geometry.dlengths[
            heater3.Heater.iLumped:heater3.Heater.nV])};
          heater3.Heater.dheightsFM[1:2] = {sum(heater3.Heater.geometry.dheights
            [1:heater3.Heater.iLumped-1]), sum(heater3.Heater.geometry.dheights[
            heater3.Heater.iLumped:heater3.Heater.nV])};
          heater3.Heater.dimensionsFM[1:3] = {sum(heater3.Heater.geometry.dimensions
            [1:heater3.Heater.iLumped-1])/(heater3.Heater.iLumped-1), sum(
            heater3.Heater.geometry.dimensions)/heater3.Heater.nV, sum(
            heater3.Heater.geometry.dimensions[heater3.Heater.iLumped:
            heater3.Heater.nV])/(heater3.Heater.nV-heater3.Heater.iLumped+1)};
          heater3.Heater.crossAreasFM[1:3] = {sum(heater3.Heater.geometry.crossAreas
            [1:heater3.Heater.iLumped-1])/(heater3.Heater.iLumped-1), sum(
            heater3.Heater.geometry.crossAreas)/heater3.Heater.nV, sum(
            heater3.Heater.geometry.crossAreas[heater3.Heater.iLumped:
            heater3.Heater.nV])/(heater3.Heater.nV-heater3.Heater.iLumped+1)};
          heater3.Heater.perimetersFM[1:3] = {sum(heater3.Heater.geometry.perimeters
            [1:heater3.Heater.iLumped-1])/(heater3.Heater.iLumped-1), sum(
            heater3.Heater.geometry.perimeters)/heater3.Heater.nV, sum(
            heater3.Heater.geometry.perimeters[heater3.Heater.iLumped:
            heater3.Heater.nV])/(heater3.Heater.nV-heater3.Heater.iLumped+1)};
          heater3.Heater.roughnessesFM[1:3] = {sum(heater3.Heater.geometry.roughnesses
            [1:heater3.Heater.iLumped-1])/(heater3.Heater.iLumped-1), sum(
            heater3.Heater.geometry.roughnesses)/heater3.Heater.nV, sum(
