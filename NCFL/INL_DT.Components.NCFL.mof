model NCFL
  parameter Modelica.Units.SI.Length data.Slant = 0.3302;
  parameter Modelica.Units.SI.Length data.Height = 7.1628;
  parameter Modelica.Units.SI.Length data.Width = 0.6223;
  parameter Modelica.Units.SI.Length data.Pipe_D = 0.0508;
  parameter Modelica.Units.SI.Length data.Slant_Pipe_L = sqrt(data.Width^2+
    data.Slant^2);
  parameter Modelica.Units.SI.Length data.JetPump_D = 0.0254;
  parameter Modelica.Units.SI.Length data.JetPump_L = 0.365125;
  parameter Modelica.Units.SI.Pressure data.Init_P = 101325;
  parameter Modelica.Units.SI.Temperature data.Init_T = 294.15;
  parameter Modelica.Units.SI.Power data.Heater_Power = 5500.0;
  parameter Modelica.Units.SI.Length data.Heater_Length = 0.5148791666666667;
  parameter Modelica.Units.SI.Length data.Heater_radius = 0.0508;
  parameter Modelica.Units.SI.MassFlowRate data.Pump_Mflow = 20;
  parameter Modelica.Units.SI.Length data.HX_L = 0.4699;
  parameter Modelica.Units.SI.Length data.HX_radius = 0.0381;
  parameter Modelica.Units.SI.Power data.HX_Transfer = 0;
  parameter Real data.Thermal_Cond = 35;
  parameter Modelica.Units.SI.Temperature data.sec_T = 288.15;
  parameter Modelica.Units.SI.MassFlowRate data.sec_Mflow = 0;
  parameter Modelica.Units.SI.AbsolutePressure Slant.system.p_ambient = 101325 
    "Default ambient pressure";
  parameter Modelica.Units.SI.Temperature Slant.system.T_ambient = 293.15 
    "Default ambient temperature";
  parameter Modelica.Units.SI.Acceleration Slant.system.g = 9.80665 
    "Constant gravity acceleration";
  constant Boolean Slant.system.allowFlowReversal = true "= false to restrict to design flow direction (port_a -> port_b)";
  parameter Modelica.Fluid.Types.Dynamics Slant.system.energyDynamics = 
    Modelica.Fluid.Types.Dynamics.DynamicFreeInitial "Default formulation of energy balances";
  parameter Modelica.Fluid.Types.Dynamics Slant.system.massDynamics = 
    Slant.system.energyDynamics "Default formulation of mass balances";
  parameter Modelica.Fluid.Types.Dynamics Slant.system.substanceDynamics = 
    Slant.system.massDynamics "Default formulation of substance balances";
  parameter Modelica.Fluid.Types.Dynamics Slant.system.traceDynamics = 
    Slant.system.massDynamics "Default formulation of trace substance balances";
  parameter Modelica.Fluid.Types.Dynamics Slant.system.momentumDynamics = 
    Modelica.Fluid.Types.Dynamics.SteadyState "Default formulation of momentum balances, if options available";
  parameter Modelica.Units.SI.MassFlowRate Slant.system.m_flow_start = 0 
    "Default start value for mass flow rates";
  parameter Modelica.Units.SI.AbsolutePressure Slant.system.p_start = 
    Slant.system.p_ambient "Default start value for pressures";
  parameter Modelica.Units.SI.Temperature Slant.system.T_start = 
    Slant.system.T_ambient "Default start value for temperatures";
  parameter Boolean Slant.system.use_eps_Re = false "= true to determine turbulent region automatically using Reynolds number";
  parameter Modelica.Units.SI.MassFlowRate Slant.system.m_flow_nominal = (if 
    Slant.system.use_eps_Re then 1 else 100.0*Slant.system.m_flow_small) 
    "Default nominal mass flow rate";
  parameter Real Slant.system.eps_m_flow(min = 0.0) = 0.0001 "Regularization of zero flow for |m_flow| < eps_m_flow*m_flow_nominal";
  parameter Modelica.Units.SI.AbsolutePressure Slant.system.dp_small = 1 
    "Default small pressure drop for regularization of laminar and zero flow";
  parameter Modelica.Units.SI.MassFlowRate Slant.system.m_flow_small(min = 0.0)
     = 0.01 "Default small mass flow rate for regularization of laminar and zero flow";
  constant Boolean Slant.allowFlowReversal = true "= true to allow flow reversal, false restricts to design direction (port_a -> port_b)";
  parameter Boolean Slant.port_a_exposesState = false "= true if port_a exposes the state of a fluid volume";
  parameter Boolean Slant.port_b_exposesState = false "= true if port_b.p exposes the state of a fluid volume";
  parameter Boolean Slant.showDesignFlowDirection = true "= false to hide the arrow in the model icon";
  parameter Real Slant.nParallel(min = 1.0) = 1 "Number of identical parallel pipes";
  parameter Modelica.Units.SI.Length Slant.length = data.Slant_Pipe_L "Length";
  parameter Boolean Slant.isCircular = true "= true, if cross sectional area is circular";
  parameter Modelica.Units.SI.Diameter Slant.diameter = data.Pipe_D 
    "Diameter of circular pipe";
  parameter Modelica.Units.SI.Area Slant.crossArea = 3.141592653589793*
    Slant.diameter*Slant.diameter/4 "Inner cross section area";
  parameter Modelica.Units.SI.Length Slant.perimeter(min = 0.0) = 
    3.141592653589793*Slant.diameter "Inner perimeter";
  parameter Modelica.Fluid.Types.Roughness Slant.roughness = 2.5E-05 
    "Average height of surface asperities (default: smooth steel pipe)";
  parameter Modelica.Units.SI.Volume Slant.V = Slant.crossArea*Slant.length*
    Slant.nParallel "Volume size";
  parameter Modelica.Units.SI.Length Slant.height_ab = data.Slant 
    "Height(port_b) - Height(port_a)";
  parameter Modelica.Media.Interfaces.Types.AbsolutePressure Slant.p_a_start(
    start = 5000000.0, nominal = 1000000.0, min = 611.657) = data.Init_P 
    "Start value of pressure at port a";
  parameter Modelica.Media.Interfaces.Types.AbsolutePressure Slant.p_b_start(
    start = 5000000.0, nominal = 1000000.0, min = 611.657) = Slant.p_a_start 
    "Start value of pressure at port b";
  parameter Modelica.Media.Interfaces.PartialMedium.MassFlowRate 
    Slant.m_flow_start = 0.01 "Start value for mass flow rate";
  parameter Boolean Slant.flowModel.from_dp = Slant.flowModel.momentumDynamics
     >= Modelica.Fluid.Types.Dynamics.SteadyStateInitial "= true, use m_flow = f(dp), otherwise dp = f(m_flow)";
  constant Integer Slant.flowModel.n = 2 "Number of discrete flow volumes";
  parameter Real Slant.flowModel.nParallel = Slant.nParallel "Number of identical parallel flow devices";
  parameter Modelica.Units.SI.Acceleration Slant.flowModel.g = Slant.system.g 
    "Constant gravity acceleration";
  constant Boolean Slant.flowModel.allowFlowReversal = true "= true, if flow reversal is enabled, otherwise restrict flow to design direction (states[1] -> states[n+1])";
  constant Modelica.Fluid.Types.Dynamics Slant.flowModel.momentumDynamics = 
    Modelica.Fluid.Types.Dynamics.SteadyState "Formulation of momentum balance";
  parameter Modelica.Media.Interfaces.PartialMedium.MassFlowRate 
    Slant.flowModel.m_flow_start = Slant.m_flow_start "Start value of mass flow rates";
  parameter Modelica.Media.Interfaces.Types.AbsolutePressure Slant.flowModel.p_a_start
    (start = 5000000.0, nominal = 1000000.0, min = 611.657) = Slant.p_a_start 
    "Start value for p[1] at design inflow";
  parameter Modelica.Media.Interfaces.Types.AbsolutePressure Slant.flowModel.p_b_start
    (start = 5000000.0, nominal = 1000000.0, min = 611.657) = Slant.p_b_start 
    "Start value for p[n+1] at design outflow";
  parameter Modelica.Units.SI.AbsolutePressure Slant.flowModel.system.p_ambient
     = 101325 "Default ambient pressure";
  parameter Modelica.Units.SI.Temperature Slant.flowModel.system.T_ambient = 
    293.15 "Default ambient temperature";
  parameter Modelica.Units.SI.Acceleration Slant.flowModel.system.g = 9.80665 
    "Constant gravity acceleration";
  parameter Boolean Slant.flowModel.system.allowFlowReversal = true 
    "= false to restrict to design flow direction (port_a -> port_b)";
  parameter Modelica.Fluid.Types.Dynamics Slant.flowModel.system.energyDynamics
     = Modelica.Fluid.Types.Dynamics.DynamicFreeInitial "Default formulation of energy balances";
  parameter Modelica.Fluid.Types.Dynamics Slant.flowModel.system.massDynamics = 
    Slant.flowModel.system.energyDynamics "Default formulation of mass balances";
  parameter Modelica.Fluid.Types.Dynamics Slant.flowModel.system.substanceDynamics
     = Slant.flowModel.system.massDynamics "Default formulation of substance balances";
  parameter Modelica.Fluid.Types.Dynamics Slant.flowModel.system.traceDynamics
     = Slant.flowModel.system.massDynamics "Default formulation of trace substance balances";
  parameter Modelica.Fluid.Types.Dynamics Slant.flowModel.system.momentumDynamics
     = Modelica.Fluid.Types.Dynamics.SteadyState "Default formulation of momentum balances, if options available";
  parameter Modelica.Units.SI.MassFlowRate Slant.flowModel.system.m_flow_start
     = 0 "Default start value for mass flow rates";
  parameter Modelica.Units.SI.AbsolutePressure Slant.flowModel.system.p_start = 
    Slant.flowModel.system.p_ambient "Default start value for pressures";
  parameter Modelica.Units.SI.Temperature Slant.flowModel.system.T_start = 
    Slant.flowModel.system.T_ambient "Default start value for temperatures";
  parameter Boolean Slant.flowModel.system.use_eps_Re = false "= true to determine turbulent region automatically using Reynolds number";
  parameter Modelica.Units.SI.MassFlowRate Slant.flowModel.system.m_flow_nominal
     = (if Slant.flowModel.system.use_eps_Re then 1 else 100.0*Slant.flowModel.system.m_flow_small)
     "Default nominal mass flow rate";
  parameter Real Slant.flowModel.system.eps_m_flow(min = 0.0) = 0.0001 
    "Regularization of zero flow for |m_flow| < eps_m_flow*m_flow_nominal";
  parameter Modelica.Units.SI.AbsolutePressure Slant.flowModel.system.dp_small
     = 1 "Default small pressure drop for regularization of laminar and zero flow";
  parameter Modelica.Units.SI.MassFlowRate Slant.flowModel.system.m_flow_small(
    min = 0.0) = 0.01 "Default small mass flow rate for regularization of laminar and zero flow";
  parameter Integer Slant.flowModel.m = Slant.flowModel.n-1 "Number of flow segments";
  parameter Boolean Slant.flowModel.useUpstreamScheme = true "= false to average upstream and downstream properties across flow segments";
  parameter Boolean Slant.flowModel.use_Ib_flows = Slant.flowModel.momentumDynamics
     <> Modelica.Fluid.Types.Dynamics.SteadyState "= true to consider differences in flow of momentum through boundaries";
  parameter Modelica.Units.SI.ReynoldsNumber Slant.flowModel.Re_turbulent = 4000
     "Start of turbulent regime, depending on type of flow device";
  constant Boolean Slant.flowModel.show_Res = false "= true, if Reynolds numbers are included for plotting";
  parameter Boolean Slant.flowModel.use_rho_nominal = false "= true, if rho_nominal is used, otherwise computed from medium";
  parameter Modelica.Units.SI.Density Slant.flowModel.rho_nominal = 
    Modelica.Media.Water.WaterIF97_ph.density_pTX_Unique7(101325, 293.15, {1.0})
     "Nominal density (e.g., rho_liquidWater = 995, rho_air = 1.2)";
  parameter Boolean Slant.flowModel.use_mu_nominal = false "= true, if mu_nominal is used, otherwise computed from medium";
  parameter Modelica.Units.SI.DynamicViscosity Slant.flowModel.mu_nominal = 
    Modelica.Media.Water.WaterIF97_ph.dynamicViscosity_Unique6(
    Modelica.Media.Water.WaterIF97_ph.setState_pTX_Unique8(101325, 293.15, {1.0},
       0, 0)) "Nominal dynamic viscosity (e.g., mu_liquidWater = 1e-3, mu_air = 1.8e-5)";
  parameter Modelica.Units.SI.AbsolutePressure Slant.flowModel.dp_nominal(
    fixed = false) = 1 "Nominal pressure loss (only for nominal models)";
  parameter Modelica.Units.SI.MassFlowRate Slant.flowModel.m_flow_nominal = (if 
    Slant.flowModel.system.use_eps_Re then Slant.flowModel.system.m_flow_nominal
     else 100.0*Slant.flowModel.m_flow_small) "Nominal mass flow rate";
  parameter Modelica.Units.SI.MassFlowRate Slant.flowModel.m_flow_small = (if 
    Slant.flowModel.system.use_eps_Re then Slant.flowModel.system.eps_m_flow*
    Slant.flowModel.m_flow_nominal else Slant.flowModel.system.m_flow_small) 
    "Within regularization if |m_flows| < m_flow_small (may be wider for large discontinuities in static head)";
  parameter Modelica.Units.SI.AbsolutePressure Slant.flowModel.dp_small(fixed = 
    false) = 1 "Within regularization if |dp| < dp_small (may be wider for large discontinuities in static head)";
  parameter Boolean Slant.flowModel.constantPressureLossCoefficient = 
    Slant.flowModel.use_rho_nominal and (Slant.flowModel.use_mu_nominal or false)
     "= true, if the pressure loss does not depend on fluid states";
  parameter Boolean Slant.flowModel.continuousFlowReversal =  not 
    Slant.flowModel.useUpstreamScheme or Slant.flowModel.constantPressureLossCoefficient
     or  not Slant.flowModel.allowFlowReversal "= true, if the pressure loss is continuous around zero flow";
  parameter Modelica.Units.SI.AbsolutePressure Distance2Heaters.system.p_ambient
     = 101325 "Default ambient pressure";
  parameter Modelica.Units.SI.Temperature Distance2Heaters.system.T_ambient = 
    293.15 "Default ambient temperature";
  parameter Modelica.Units.SI.Acceleration Distance2Heaters.system.g = 9.80665 
    "Constant gravity acceleration";
  constant Boolean Distance2Heaters.system.allowFlowReversal = true 
    "= false to restrict to design flow direction (port_a -> port_b)";
  parameter Modelica.Fluid.Types.Dynamics Distance2Heaters.system.energyDynamics
     = Modelica.Fluid.Types.Dynamics.DynamicFreeInitial "Default formulation of energy balances";
  parameter Modelica.Fluid.Types.Dynamics Distance2Heaters.system.massDynamics
     = Distance2Heaters.system.energyDynamics "Default formulation of mass balances";
  parameter Modelica.Fluid.Types.Dynamics Distance2Heaters.system.substanceDynamics
     = Distance2Heaters.system.massDynamics "Default formulation of substance balances";
  parameter Modelica.Fluid.Types.Dynamics Distance2Heaters.system.traceDynamics
     = Distance2Heaters.system.massDynamics "Default formulation of trace substance balances";
  parameter Modelica.Fluid.Types.Dynamics Distance2Heaters.system.momentumDynamics
     = Modelica.Fluid.Types.Dynamics.SteadyState "Default formulation of momentum balances, if options available";
  parameter Modelica.Units.SI.MassFlowRate Distance2Heaters.system.m_flow_start
     = 0 "Default start value for mass flow rates";
  parameter Modelica.Units.SI.AbsolutePressure Distance2Heaters.system.p_start
     = Distance2Heaters.system.p_ambient "Default start value for pressures";
  parameter Modelica.Units.SI.Temperature Distance2Heaters.system.T_start = 
    Distance2Heaters.system.T_ambient "Default start value for temperatures";
  parameter Boolean Distance2Heaters.system.use_eps_Re = false "= true to determine turbulent region automatically using Reynolds number";
  parameter Modelica.Units.SI.MassFlowRate Distance2Heaters.system.m_flow_nominal
     = (if Distance2Heaters.system.use_eps_Re then 1 else 100.0*Distance2Heaters.system.m_flow_small)
     "Default nominal mass flow rate";
  parameter Real Distance2Heaters.system.eps_m_flow(min = 0.0) = 0.0001 
    "Regularization of zero flow for |m_flow| < eps_m_flow*m_flow_nominal";
  parameter Modelica.Units.SI.AbsolutePressure Distance2Heaters.system.dp_small
     = 1 "Default small pressure drop for regularization of laminar and zero flow";
  parameter Modelica.Units.SI.MassFlowRate Distance2Heaters.system.m_flow_small(
    min = 0.0) = 0.01 "Default small mass flow rate for regularization of laminar and zero flow";
  constant Boolean Distance2Heaters.allowFlowReversal = true "= true to allow flow reversal, false restricts to design direction (port_a -> port_b)";
  parameter Boolean Distance2Heaters.port_a_exposesState = false 
    "= true if port_a exposes the state of a fluid volume";
  parameter Boolean Distance2Heaters.port_b_exposesState = false 
    "= true if port_b.p exposes the state of a fluid volume";
  parameter Boolean Distance2Heaters.showDesignFlowDirection = true 
    "= false to hide the arrow in the model icon";
  parameter Real Distance2Heaters.nParallel(min = 1.0) = 1 "Number of identical parallel pipes";
  parameter Modelica.Units.SI.Length Distance2Heaters.length = 0.6016625 
    "Length";
  parameter Boolean Distance2Heaters.isCircular = true "= true, if cross sectional area is circular";
  parameter Modelica.Units.SI.Diameter Distance2Heaters.diameter = data.Pipe_D 
    "Diameter of circular pipe";
  parameter Modelica.Units.SI.Area Distance2Heaters.crossArea = 3.141592653589793
    *Distance2Heaters.diameter*Distance2Heaters.diameter/4 "Inner cross section area";
  parameter Modelica.Units.SI.Length Distance2Heaters.perimeter(min = 0.0) = 
    3.141592653589793*Distance2Heaters.diameter "Inner perimeter";
  parameter Modelica.Fluid.Types.Roughness Distance2Heaters.roughness = 2.5E-05 
    "Average height of surface asperities (default: smooth steel pipe)";
  parameter Modelica.Units.SI.Volume Distance2Heaters.V = Distance2Heaters.crossArea
    *Distance2Heaters.length*Distance2Heaters.nParallel "Volume size";
  parameter Modelica.Units.SI.Length Distance2Heaters.height_ab = 0.6016625 
    "Height(port_b) - Height(port_a)";
  parameter Modelica.Media.Interfaces.Types.AbsolutePressure Distance2Heaters.p_a_start
    (start = 5000000.0, nominal = 1000000.0, min = 611.657) = data.Init_P 
    "Start value of pressure at port a";
  parameter Modelica.Media.Interfaces.Types.AbsolutePressure Distance2Heaters.p_b_start
    (start = 5000000.0, nominal = 1000000.0, min = 611.657) = Distance2Heaters.p_a_start
     "Start value of pressure at port b";
  parameter Modelica.Media.Interfaces.PartialMedium.MassFlowRate 
    Distance2Heaters.m_flow_start = 0.01 "Start value for mass flow rate";
  parameter Boolean Distance2Heaters.flowModel.from_dp = Distance2Heaters.flowModel.momentumDynamics
     >= Modelica.Fluid.Types.Dynamics.SteadyStateInitial "= true, use m_flow = f(dp), otherwise dp = f(m_flow)";
  constant Integer Distance2Heaters.flowModel.n = 2 "Number of discrete flow volumes";
  parameter Real Distance2Heaters.flowModel.nParallel = Distance2Heaters.nParallel
     "Number of identical parallel flow devices";
  parameter Modelica.Units.SI.Acceleration Distance2Heaters.flowModel.g = 
    Distance2Heaters.system.g "Constant gravity acceleration";
  constant Boolean Distance2Heaters.flowModel.allowFlowReversal = true 
    "= true, if flow reversal is enabled, otherwise restrict flow to design direction (states[1] -> states[n+1])";
  constant Modelica.Fluid.Types.Dynamics Distance2Heaters.flowModel.momentumDynamics
     = Modelica.Fluid.Types.Dynamics.SteadyState "Formulation of momentum balance";
  parameter Modelica.Media.Interfaces.PartialMedium.MassFlowRate 
    Distance2Heaters.flowModel.m_flow_start = Distance2Heaters.m_flow_start 
    "Start value of mass flow rates";
  parameter Modelica.Media.Interfaces.Types.AbsolutePressure Distance2Heaters.flowModel.p_a_start
    (start = 5000000.0, nominal = 1000000.0, min = 611.657) = Distance2Heaters.p_a_start
     "Start value for p[1] at design inflow";
  parameter Modelica.Media.Interfaces.Types.AbsolutePressure Distance2Heaters.flowModel.p_b_start
    (start = 5000000.0, nominal = 1000000.0, min = 611.657) = Distance2Heaters.p_b_start
     "Start value for p[n+1] at design outflow";
  parameter Modelica.Units.SI.AbsolutePressure Distance2Heaters.flowModel.system.p_ambient
     = 101325 "Default ambient pressure";
  parameter Modelica.Units.SI.Temperature Distance2Heaters.flowModel.system.T_ambient
     = 293.15 "Default ambient temperature";
  parameter Modelica.Units.SI.Acceleration Distance2Heaters.flowModel.system.g
     = 9.80665 "Constant gravity acceleration";
  parameter Boolean Distance2Heaters.flowModel.system.allowFlowReversal = true 
    "= false to restrict to design flow direction (port_a -> port_b)";
  parameter Modelica.Fluid.Types.Dynamics Distance2Heaters.flowModel.system.energyDynamics
     = Modelica.Fluid.Types.Dynamics.DynamicFreeInitial "Default formulation of energy balances";
  parameter Modelica.Fluid.Types.Dynamics Distance2Heaters.flowModel.system.massDynamics
     = Distance2Heaters.flowModel.system.energyDynamics "Default formulation of mass balances";
  parameter Modelica.Fluid.Types.Dynamics Distance2Heaters.flowModel.system.substanceDynamics
     = Distance2Heaters.flowModel.system.massDynamics "Default formulation of substance balances";
  parameter Modelica.Fluid.Types.Dynamics Distance2Heaters.flowModel.system.traceDynamics
     = Distance2Heaters.flowModel.system.massDynamics "Default formulation of trace substance balances";
  parameter Modelica.Fluid.Types.Dynamics Distance2Heaters.flowModel.system.momentumDynamics
     = Modelica.Fluid.Types.Dynamics.SteadyState "Default formulation of momentum balances, if options available";
  parameter Modelica.Units.SI.MassFlowRate Distance2Heaters.flowModel.system.m_flow_start
     = 0 "Default start value for mass flow rates";
  parameter Modelica.Units.SI.AbsolutePressure Distance2Heaters.flowModel.system.p_start
     = Distance2Heaters.flowModel.system.p_ambient "Default start value for pressures";
  parameter Modelica.Units.SI.Temperature Distance2Heaters.flowModel.system.T_start
     = Distance2Heaters.flowModel.system.T_ambient "Default start value for temperatures";
  parameter Boolean Distance2Heaters.flowModel.system.use_eps_Re = false 
    "= true to determine turbulent region automatically using Reynolds number";
  parameter Modelica.Units.SI.MassFlowRate Distance2Heaters.flowModel.system.m_flow_nominal
     = (if Distance2Heaters.flowModel.system.use_eps_Re then 1 else 100.0*
