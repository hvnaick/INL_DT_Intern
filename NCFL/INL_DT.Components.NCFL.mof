    else
      heater2.Heater.Wb_flows = zeros(heater2.Heater.nV);
    end if;
    if (heater2.Heater.exposeState_a and heater2.Heater.exposeState_b) then 
      assert(heater2.Heater.nV > 1, "nV must be > 1 if exposeState_a and exposeState_b = true");
    end if;
    if (heater2.Heater.useLumpedPressure) then 
      if ( not (heater2.Heater.exposeState_a and heater2.Heater.exposeState_b))
         then 
        if (heater2.Heater.lumpPressureAt == TRANSFORM.Fluid.Types.LumpedLocation.
          port_a) then 
          fill(heater2.Heater.mediums[1].p, heater2.Heater.nV-1) = 
