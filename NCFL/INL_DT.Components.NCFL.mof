  parameter Integer Distance2Heaters.flowModel.m = Distance2Heaters.flowModel.n-1
     "Number of flow segments";
  parameter Boolean Distance2Heaters.flowModel.useUpstreamScheme = true 
    "= false to average upstream and downstream properties across flow segments";
  parameter Boolean Distance2Heaters.flowModel.use_Ib_flows = Distance2Heaters.flowModel.momentumDynamics
     <> Modelica.Fluid.Types.Dynamics.SteadyState "= true to consider differences in flow of momentum through boundaries";
  parameter Modelica.Units.SI.ReynoldsNumber Distance2Heaters.flowModel.Re_turbulent
