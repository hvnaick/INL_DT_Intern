    // extends Modelica.Fluid.Interfaces.PartialDistributedFlow
    equation
      DistanceAfterHeaters.flowModel.Is = array(DistanceAfterHeaters.flowModel.m_flows
        [i]*DistanceAfterHeaters.flowModel.pathLengths[i] for i in 1:
        DistanceAfterHeaters.flowModel.m);
      if (DistanceAfterHeaters.flowModel.momentumDynamics == Modelica.Fluid.Types.Dynamics.
