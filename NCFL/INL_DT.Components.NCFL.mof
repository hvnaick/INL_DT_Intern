        heater3.Heater.vsFM[1] = heater3.Heater.m_flows[1]/Modelica.Media.Water.WaterIF97_ph.density_Unique5
          (
          heater3.Heater.state_a)/heater3.Heater.geometry.crossAreas[1];
        heater3.Heater.Ts_wallFM[1] = sum(heater3.Heater.Ts_wall[1, :])/
          heater3.Heater.geometry.nSurfaces;
        for i in (2:heater3.Heater.nFM+1) loop
          heater3.Heater.statesFM[i] = heater3.Heater.mediums[i-1].state;
          heater3.Heater.vsFM[i] = heater3.Heater.vs[i-1];
          heater3.Heater.Ts_wallFM[i] = sum(heater3.Heater.Ts_wall[i-1, :])/
            heater3.Heater.geometry.nSurfaces;
        end for;
        heater3.Heater.crossAreasFM[1] = heater3.Heater.geometry.crossAreas[1];
        heater3.Heater.dimensionsFM[1] = heater3.Heater.geometry.dimensions[1];
        heater3.Heater.perimetersFM[1] = heater3.Heater.geometry.perimeters[1];
        heater3.Heater.roughnessesFM[1] = heater3.Heater.geometry.roughnesses[1];
        for i in (2:heater3.Heater.nFM+1) loop
          heater3.Heater.crossAreasFM[i] = heater3.Heater.geometry.crossAreas[i-1];
          heater3.Heater.dimensionsFM[i] = heater3.Heater.geometry.dimensions[i-1];
          heater3.Heater.perimetersFM[i] = heater3.Heater.geometry.perimeters[i-1];
          heater3.Heater.roughnessesFM[i] = heater3.Heater.geometry.roughnesses[
            i-1];
        end for;
        if (heater3.Heater.nFM == 1) then 
          heater3.Heater.dlengthsFM[1] = heater3.Heater.geometry.dlengths[1];
          heater3.Heater.dheightsFM[1] = heater3.Heater.geometry.dheights[1];
        else
          heater3.Heater.dlengthsFM[1] = 0.5*heater3.Heater.geometry.dlengths[1];
          heater3.Heater.dheightsFM[1] = 0.5*heater3.Heater.geometry.dheights[1];
          for i in (2:heater3.Heater.nFM-1) loop
            heater3.Heater.dlengthsFM[i] = 0.5*(heater3.Heater.geometry.dlengths
              [i-1]+heater3.Heater.geometry.dlengths[i]);
            heater3.Heater.dheightsFM[i] = 0.5*(heater3.Heater.geometry.dheights
              [i-1]+heater3.Heater.geometry.dheights[i]);
          end for;
          heater3.Heater.dlengthsFM[heater3.Heater.nFM] = 0.5*heater3.Heater.geometry.dlengths
            [heater3.Heater.nFM-1]+heater3.Heater.geometry.dlengths[
            heater3.Heater.nFM];
          heater3.Heater.dheightsFM[heater3.Heater.nFM] = 0.5*heater3.Heater.geometry.dheights
            [heater3.Heater.nFM-1]+heater3.Heater.geometry.dheights[
            heater3.Heater.nFM];
        end if;
      elseif ( not heater3.Heater.exposeState_a and  not heater3.Heater.exposeState_b)
         then 
        heater3.Heater.m_flows[1:heater3.Heater.nV+1] = heater3.Heater.flowModel.m_flows
          [1:heater3.Heater.nV+1];
        heater3.Heater.statesFM[1] = heater3.Heater.state_a;
        heater3.Heater.vsFM[1] = heater3.Heater.m_flows[1]/Modelica.Media.Water.WaterIF97_ph.density_Unique5
          (
          heater3.Heater.state_a)/heater3.Heater.geometry.crossAreas[1];
        heater3.Heater.Ts_wallFM[1] = sum(heater3.Heater.Ts_wall[1, :])/
          heater3.Heater.geometry.nSurfaces;
        for i in (2:heater3.Heater.nFM) loop
          heater3.Heater.statesFM[i] = heater3.Heater.mediums[i-1].state;
          heater3.Heater.vsFM[i] = heater3.Heater.vs[i-1];
          heater3.Heater.Ts_wallFM[i] = sum(heater3.Heater.Ts_wall[i-1, :])/
            heater3.Heater.geometry.nSurfaces;
        end for;
        heater3.Heater.statesFM[heater3.Heater.nFM+1] = heater3.Heater.state_b;
        heater3.Heater.vsFM[heater3.Heater.nFM+1] = heater3.Heater.m_flows[
          heater3.Heater.nFM]/Modelica.Media.Water.WaterIF97_ph.density_Unique5(
          heater3.Heater.state_b)/heater3.Heater.geometry.crossAreas[
          heater3.Heater.nV];
        heater3.Heater.Ts_wallFM[heater3.Heater.nFM+1] = sum(heater3.Heater.Ts_wall
          [heater3.Heater.nV, :])/heater3.Heater.geometry.nSurfaces;
        heater3.Heater.crossAreasFM[1] = heater3.Heater.geometry.crossAreas[1];
        heater3.Heater.dimensionsFM[1] = heater3.Heater.geometry.dimensions[1];
        heater3.Heater.perimetersFM[1] = heater3.Heater.geometry.perimeters[1];
        heater3.Heater.roughnessesFM[1] = heater3.Heater.geometry.roughnesses[1];
        for i in (2:heater3.Heater.nFM) loop
          heater3.Heater.crossAreasFM[i] = heater3.Heater.geometry.crossAreas[i-1];
          heater3.Heater.dimensionsFM[i] = heater3.Heater.geometry.dimensions[i-1];
          heater3.Heater.perimetersFM[i] = heater3.Heater.geometry.perimeters[i-1];
          heater3.Heater.roughnessesFM[i] = heater3.Heater.geometry.roughnesses[
            i-1];
        end for;
        heater3.Heater.crossAreasFM[heater3.Heater.nFM+1] = heater3.Heater.geometry.crossAreas
          [heater3.Heater.nV];
        heater3.Heater.dimensionsFM[heater3.Heater.nFM+1] = heater3.Heater.geometry.dimensions
          [heater3.Heater.nV];
        heater3.Heater.perimetersFM[heater3.Heater.nFM+1] = heater3.Heater.geometry.perimeters
          [heater3.Heater.nV];
        heater3.Heater.roughnessesFM[heater3.Heater.nFM+1] = heater3.Heater.geometry.roughnesses
          [heater3.Heater.nV];
        heater3.Heater.dlengthsFM[1] = 0.5*heater3.Heater.geometry.dlengths[1];
        heater3.Heater.dheightsFM[1] = 0.5*heater3.Heater.geometry.dheights[1];
        for i in (2:heater3.Heater.nFM-1) loop
          heater3.Heater.dlengthsFM[i] = 0.5*(heater3.Heater.geometry.dlengths[i
            -1]+heater3.Heater.geometry.dlengths[i]);
          heater3.Heater.dheightsFM[i] = 0.5*(heater3.Heater.geometry.dheights[i
            -1]+heater3.Heater.geometry.dheights[i]);
        end for;
        heater3.Heater.dlengthsFM[heater3.Heater.nFM] = 0.5*heater3.Heater.geometry.dlengths
          [heater3.Heater.nFM-1];
        heater3.Heater.dheightsFM[heater3.Heater.nFM] = 0.5*heater3.Heater.geometry.dheights
          [heater3.Heater.nFM-1];
      else
        assert(false, "Unknown model structure");
      end if;
    end if;
    heater3.Heater.heatPorts[1, 1].Q_flow+heater3.Heater.heatPorts_int[1, 1].Q_flow
      -heater3.Heater.heatTransfer.heatPorts[1, 1].Q_flow = 0.0;
    heater3.Heater.heatPorts_int[1, 1].T = heater3.Heater.heatPorts[1, 1].T;
    heater3.Heater.heatTransfer.heatPorts[1, 1].T = heater3.Heater.heatPorts[1, 1].T;
     -heater3.Heater.traceMassTransfer.massPorts[1, 1].n_flow = 0.0*
      heater3.Heater.traceMassTransfer.massPorts[1, 1].n_flow;

  // Component heater3.HeatSRC
  // class TRANSFORM.HeatAndMassTransfer.BoundaryConditions.Heat.HeatFlow
  equation
    if ( not heater3.HeatSRC.use_port) then 
      heater3.HeatSRC.Q_flow_int = heater3.HeatSRC.Q_flow;
    end if;
    heater3.HeatSRC.port.Q_flow =  -heater3.HeatSRC.Q_flow_int;

  // Component heater3.HeaterPipe.flowModel
  // class Modelica.Fluid.Pipes.BaseClasses.PartialStraightPipe.FlowModel
    // extends Modelica.Fluid.Interfaces.PartialDistributedFlow
    equation
      heater3.HeaterPipe.flowModel.Is = array(heater3.HeaterPipe.flowModel.m_flows
        [i]*heater3.HeaterPipe.flowModel.pathLengths[i] for i in 1:
        heater3.HeaterPipe.flowModel.m);
      if (heater3.HeaterPipe.flowModel.momentumDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) then 
        zeros(heater3.HeaterPipe.flowModel.m) = heater3.HeaterPipe.flowModel.Ib_flows
          -heater3.HeaterPipe.flowModel.Fs_p-heater3.HeaterPipe.flowModel.Fs_fg;
      else
        der(heater3.HeaterPipe.flowModel.Is) = heater3.HeaterPipe.flowModel.Ib_flows
          -heater3.HeaterPipe.flowModel.Fs_p-heater3.HeaterPipe.flowModel.Fs_fg;
      end if;
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialStaggeredFlowModel
    equation
      if ( not heater3.HeaterPipe.flowModel.allowFlowReversal) then 
        heater3.HeaterPipe.flowModel.rhos_act = heater3.HeaterPipe.flowModel.rhos
          [1:heater3.HeaterPipe.flowModel.n-1];
        heater3.HeaterPipe.flowModel.mus_act = heater3.HeaterPipe.flowModel.mus[1
          :heater3.HeaterPipe.flowModel.n-1];
      elseif ( not heater3.HeaterPipe.flowModel.useUpstreamScheme) then 
        heater3.HeaterPipe.flowModel.rhos_act = 0.5*(heater3.HeaterPipe.flowModel.rhos
          [1:heater3.HeaterPipe.flowModel.n-1]+heater3.HeaterPipe.flowModel.rhos
          [2:heater3.HeaterPipe.flowModel.n]);
        heater3.HeaterPipe.flowModel.mus_act = 0.5*(heater3.HeaterPipe.flowModel.mus
          [1:heater3.HeaterPipe.flowModel.n-1]+heater3.HeaterPipe.flowModel.mus[2
          :heater3.HeaterPipe.flowModel.n]);
      else
        for i in (1:heater3.HeaterPipe.flowModel.n-1) loop
          heater3.HeaterPipe.flowModel.rhos_act[i] = noEvent((if 
            heater3.HeaterPipe.flowModel.m_flows[i] > 0 then heater3.HeaterPipe.flowModel.rhos
            [i] else heater3.HeaterPipe.flowModel.rhos[i+1]));
          heater3.HeaterPipe.flowModel.mus_act[i] = noEvent((if heater3.HeaterPipe.flowModel.m_flows
            [i] > 0 then heater3.HeaterPipe.flowModel.mus[i] else 
            heater3.HeaterPipe.flowModel.mus[i+1]));
        end for;
      end if;
      if (heater3.HeaterPipe.flowModel.use_Ib_flows) then 
        heater3.HeaterPipe.flowModel.Ib_flows = heater3.HeaterPipe.flowModel.nParallel
          *(array(heater3.HeaterPipe.flowModel.rhos[i]*heater3.HeaterPipe.flowModel.vs
          [i]*heater3.HeaterPipe.flowModel.vs[i]*heater3.HeaterPipe.flowModel.crossAreas
          [i]-heater3.HeaterPipe.flowModel.rhos[i+1]*heater3.HeaterPipe.flowModel.vs
          [i+1]*heater3.HeaterPipe.flowModel.vs[i+1]*heater3.HeaterPipe.flowModel.crossAreas
          [i+1] for i in 1:heater3.HeaterPipe.flowModel.n-1));
      else
        heater3.HeaterPipe.flowModel.Ib_flows = zeros(heater3.HeaterPipe.flowModel.n
          -1);
      end if;
      heater3.HeaterPipe.flowModel.Fs_p = heater3.HeaterPipe.flowModel.nParallel
        *(array(0.5*(heater3.HeaterPipe.flowModel.crossAreas[i]+heater3.HeaterPipe.flowModel.crossAreas
        [i+1])*(Modelica.Media.Water.WaterIF97_ph.pressure_Unique11(
        heater3.HeaterPipe.flowModel.states[i+1])-Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
        (
        heater3.HeaterPipe.flowModel.states[i])) for i in 1:heater3.HeaterPipe.flowModel.n
        -1));
      heater3.HeaterPipe.flowModel.dps_fg = array(heater3.HeaterPipe.flowModel.Fs_fg
        [i]/heater3.HeaterPipe.flowModel.nParallel*2/(heater3.HeaterPipe.flowModel.crossAreas
        [i]+heater3.HeaterPipe.flowModel.crossAreas[i+1]) for i in 1:
        heater3.HeaterPipe.flowModel.n-1);
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialGenericPipeFlow
    equation
      for i in (1:heater3.HeaterPipe.flowModel.n-1) loop
        assert(heater3.HeaterPipe.flowModel.m_flows[i] >  -heater3.HeaterPipe.flowModel.m_flow_small
           or heater3.HeaterPipe.flowModel.allowFlowReversal, "Reversing flow occurs even though allowFlowReversal is false");
      end for;
      if (heater3.HeaterPipe.flowModel.continuousFlowReversal) then 
        if (heater3.HeaterPipe.flowModel.from_dp and true) then 
          heater3.HeaterPipe.flowModel.m_flows = homotopy(massFlowRate_dp_Unique14
            (heater3.HeaterPipe.flowModel.dps_fg-(array(heater3.HeaterPipe.flowModel.g
            *heater3.HeaterPipe.flowModel.dheights[i]*heater3.HeaterPipe.flowModel.rhos_act
            [i] for i in 1:heater3.HeaterPipe.flowModel.n-1)), heater3.HeaterPipe.flowModel.rhos_act,
             heater3.HeaterPipe.flowModel.rhos_act, heater3.HeaterPipe.flowModel.mus_act,
             heater3.HeaterPipe.flowModel.mus_act, heater3.HeaterPipe.flowModel.pathLengths_internal,
             heater3.HeaterPipe.flowModel.diameters, (heater3.HeaterPipe.flowModel.crossAreas
            [1:heater3.HeaterPipe.flowModel.n-1]+heater3.HeaterPipe.flowModel.crossAreas
            [2:heater3.HeaterPipe.flowModel.n])/2, (heater3.HeaterPipe.flowModel.roughnesses
            [1:heater3.HeaterPipe.flowModel.n-1]+heater3.HeaterPipe.flowModel.roughnesses
            [2:heater3.HeaterPipe.flowModel.n])/2, heater3.HeaterPipe.flowModel.dp_small
            /(heater3.HeaterPipe.flowModel.n-1), heater3.HeaterPipe.flowModel.Res_turbulent_internal)
            *heater3.HeaterPipe.flowModel.nParallel, heater3.HeaterPipe.flowModel.m_flow_nominal
            /heater3.HeaterPipe.flowModel.dp_nominal*(heater3.HeaterPipe.flowModel.dps_fg
            -heater3.HeaterPipe.flowModel.g*heater3.HeaterPipe.flowModel.dheights
            *heater3.HeaterPipe.flowModel.rho_nominal));
        else
          heater3.HeaterPipe.flowModel.dps_fg = homotopy(pressureLoss_m_flow_Unique12
            (heater3.HeaterPipe.flowModel.m_flows/heater3.HeaterPipe.flowModel.nParallel,
             heater3.HeaterPipe.flowModel.rhos_act, heater3.HeaterPipe.flowModel.rhos_act,
             heater3.HeaterPipe.flowModel.mus_act, heater3.HeaterPipe.flowModel.mus_act,
             heater3.HeaterPipe.flowModel.pathLengths_internal, heater3.HeaterPipe.flowModel.diameters,
             (heater3.HeaterPipe.flowModel.crossAreas[1:heater3.HeaterPipe.flowModel.n
            -1]+heater3.HeaterPipe.flowModel.crossAreas[2:heater3.HeaterPipe.flowModel.n])
            /2, (heater3.HeaterPipe.flowModel.roughnesses[1:heater3.HeaterPipe.flowModel.n
            -1]+heater3.HeaterPipe.flowModel.roughnesses[2:heater3.HeaterPipe.flowModel.n])
            /2, heater3.HeaterPipe.flowModel.m_flow_small/heater3.HeaterPipe.flowModel.nParallel,
             heater3.HeaterPipe.flowModel.Res_turbulent_internal)+(array(
            heater3.HeaterPipe.flowModel.g*heater3.HeaterPipe.flowModel.dheights
            [i]*heater3.HeaterPipe.flowModel.rhos_act[i] for i in 1:
            heater3.HeaterPipe.flowModel.n-1)), heater3.HeaterPipe.flowModel.dp_nominal
            /heater3.HeaterPipe.flowModel.m_flow_nominal*heater3.HeaterPipe.flowModel.m_flows
            +heater3.HeaterPipe.flowModel.g*heater3.HeaterPipe.flowModel.dheights
            *heater3.HeaterPipe.flowModel.rho_nominal);
        end if;
      else
        if (heater3.HeaterPipe.flowModel.from_dp and true) then 
          heater3.HeaterPipe.flowModel.m_flows = homotopy(massFlowRate_dp_staticHead_Unique16
            (heater3.HeaterPipe.flowModel.dps_fg, heater3.HeaterPipe.flowModel.rhos
            [1:heater3.HeaterPipe.flowModel.n-1], heater3.HeaterPipe.flowModel.rhos
            [2:heater3.HeaterPipe.flowModel.n], heater3.HeaterPipe.flowModel.mus
            [1:heater3.HeaterPipe.flowModel.n-1], heater3.HeaterPipe.flowModel.mus
            [2:heater3.HeaterPipe.flowModel.n], heater3.HeaterPipe.flowModel.pathLengths_internal,
             heater3.HeaterPipe.flowModel.diameters, heater3.HeaterPipe.flowModel.g
            *heater3.HeaterPipe.flowModel.dheights, (heater3.HeaterPipe.flowModel.crossAreas
            [1:heater3.HeaterPipe.flowModel.n-1]+heater3.HeaterPipe.flowModel.crossAreas
            [2:heater3.HeaterPipe.flowModel.n])/2, (heater3.HeaterPipe.flowModel.roughnesses
            [1:heater3.HeaterPipe.flowModel.n-1]+heater3.HeaterPipe.flowModel.roughnesses
            [2:heater3.HeaterPipe.flowModel.n])/2, heater3.HeaterPipe.flowModel.dp_small
            /(heater3.HeaterPipe.flowModel.n-1), heater3.HeaterPipe.flowModel.Res_turbulent_internal)
            *heater3.HeaterPipe.flowModel.nParallel, heater3.HeaterPipe.flowModel.m_flow_nominal
            /heater3.HeaterPipe.flowModel.dp_nominal*(heater3.HeaterPipe.flowModel.dps_fg
            -heater3.HeaterPipe.flowModel.g*heater3.HeaterPipe.flowModel.dheights
            *heater3.HeaterPipe.flowModel.rho_nominal));
        else
          heater3.HeaterPipe.flowModel.dps_fg = homotopy(pressureLoss_m_flow_staticHead_Unique17
            (heater3.HeaterPipe.flowModel.m_flows/heater3.HeaterPipe.flowModel.nParallel,
             heater3.HeaterPipe.flowModel.rhos[1:heater3.HeaterPipe.flowModel.n-1],
             heater3.HeaterPipe.flowModel.rhos[2:heater3.HeaterPipe.flowModel.n],
             heater3.HeaterPipe.flowModel.mus[1:heater3.HeaterPipe.flowModel.n-1],
             heater3.HeaterPipe.flowModel.mus[2:heater3.HeaterPipe.flowModel.n],
             heater3.HeaterPipe.flowModel.pathLengths_internal, heater3.HeaterPipe.flowModel.diameters,
             heater3.HeaterPipe.flowModel.g*heater3.HeaterPipe.flowModel.dheights,
             (heater3.HeaterPipe.flowModel.crossAreas[1:heater3.HeaterPipe.flowModel.n
            -1]+heater3.HeaterPipe.flowModel.crossAreas[2:heater3.HeaterPipe.flowModel.n])
            /2, (heater3.HeaterPipe.flowModel.roughnesses[1:heater3.HeaterPipe.flowModel.n
            -1]+heater3.HeaterPipe.flowModel.roughnesses[2:heater3.HeaterPipe.flowModel.n])
            /2, heater3.HeaterPipe.flowModel.m_flow_small/heater3.HeaterPipe.flowModel.nParallel,
             heater3.HeaterPipe.flowModel.Res_turbulent_internal), 
            heater3.HeaterPipe.flowModel.dp_nominal/heater3.HeaterPipe.flowModel.m_flow_nominal
            *heater3.HeaterPipe.flowModel.m_flows+heater3.HeaterPipe.flowModel.g
            *heater3.HeaterPipe.flowModel.dheights*heater3.HeaterPipe.flowModel.rho_nominal);
        end if;
      end if;
    // end of extends 

  // Component heater3.HeaterPipe
  // class Modelica.Fluid.Pipes.StaticPipe
    // extends Modelica.Fluid.Pipes.BaseClasses.PartialStraightPipe
    equation
      assert(heater3.HeaterPipe.length >= heater3.HeaterPipe.height_ab, 
        "Parameter length must be greater or equal height_ab.");
    // end of extends 
  equation
    heater3.HeaterPipe.port_a.m_flow = heater3.HeaterPipe.flowModel.m_flows[1];
    0 = heater3.HeaterPipe.port_a.m_flow+heater3.HeaterPipe.port_b.m_flow;
    heater3.HeaterPipe.port_a.Xi_outflow = inStream(heater3.HeaterPipe.port_b.Xi_outflow);
    heater3.HeaterPipe.port_b.Xi_outflow = inStream(heater3.HeaterPipe.port_a.Xi_outflow);
    heater3.HeaterPipe.port_a.C_outflow = inStream(heater3.HeaterPipe.port_b.C_outflow);
    heater3.HeaterPipe.port_b.C_outflow = inStream(heater3.HeaterPipe.port_a.C_outflow);
    heater3.HeaterPipe.port_b.h_outflow = inStream(heater3.HeaterPipe.port_a.h_outflow)
      -heater3.HeaterPipe.system.g*heater3.HeaterPipe.height_ab;
    heater3.HeaterPipe.port_a.h_outflow = inStream(heater3.HeaterPipe.port_b.h_outflow)
      +heater3.HeaterPipe.system.g*heater3.HeaterPipe.height_ab;

  // Component heater3
  // class INL_DT.Components.Heater
  equation
    heater3.HeatSRC.port.Q_flow+heater3.Heater.heatPorts[1, 1].Q_flow = 0.0;
    heater3.Heater.heatPorts[1, 1].T = heater3.HeatSRC.port.T;
    heater3.Heater.heatPorts_int[1, 1].Q_flow = 0.0;
    heater3.Heater.port_a.m_flow+heater3.HeaterPipe.port_b.m_flow = 0.0;
    heater3.HeaterPipe.port_b.p = heater3.Heater.port_a.p;
    heater3.port_b.m_flow-heater3.Heater.port_b.m_flow = 0.0;
    heater3.port_b.p = heater3.Heater.port_b.p;
    heater3.port_a.m_flow-heater3.HeaterPipe.port_a.m_flow = 0.0;
    heater3.port_a.p = heater3.HeaterPipe.port_a.p;

  // Component heater2.Heater.geometry
  // class INL_DT.Components.Heater.Geometry
    // extends TRANSFORM.Fluid.ClosureRelations.Geometry.Models.DistributedVolume_1D.GenericPipe
    equation
      for i in (1:heater2.Heater.geometry.nV) loop
        assert(heater2.Heater.geometry.dimensions[i] > 0, "Characteristic dimension must be > 0");
        assert(heater2.Heater.geometry.dlengths[i] >= abs(heater2.Heater.geometry.dheights
          [i]), "Geometry dlengths must be greater or equal to abs(dheights)");
      end for;
    // end of extends 

  // Component heater2.Heater.flowModel.firstOrder_dps_K[1]
  // class Modelica.Blocks.Continuous.FirstOrder
  equation
    der(heater2.Heater.flowModel.firstOrder_dps_K[1].y) = (heater2.Heater.flowModel.firstOrder_dps_K[1].k
      *heater2.Heater.flowModel.firstOrder_dps_K[1].u-heater2.Heater.flowModel.firstOrder_dps_K[1].y)
      /heater2.Heater.flowModel.firstOrder_dps_K[1].T;

  // Component heater2.Heater.flowModel.mediaProps[1]
  // class TRANSFORM.Media.BaseProperties1Phase
  equation
    heater2.Heater.flowModel.mediaProps[1].h = Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_Unique25
      (
      heater2.Heater.flowModel.mediaProps[1].state);
    heater2.Heater.flowModel.mediaProps[1].d = Modelica.Media.Water.WaterIF97_ph.density_Unique5
      (
      heater2.Heater.flowModel.mediaProps[1].state);
    heater2.Heater.flowModel.mediaProps[1].T = Modelica.Media.Water.WaterIF97_ph.temperature_Unique28
      (
      heater2.Heater.flowModel.mediaProps[1].state);
    heater2.Heater.flowModel.mediaProps[1].p = Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
      (
      heater2.Heater.flowModel.mediaProps[1].state);
    heater2.Heater.flowModel.mediaProps[1].mu = Modelica.Media.Water.WaterIF97_ph.dynamicViscosity_Unique6
      (
      heater2.Heater.flowModel.mediaProps[1].state);
    heater2.Heater.flowModel.mediaProps[1].lambda = Modelica.Media.Water.WaterIF97_ph.thermalConductivity_Unique45
      (
      heater2.Heater.flowModel.mediaProps[1].state);
    heater2.Heater.flowModel.mediaProps[1].cp = Modelica.Media.Water.WaterIF97_ph.specificHeatCapacityCp_Unique46
      (
      heater2.Heater.flowModel.mediaProps[1].state);

  // Component heater2.Heater.flowModel.mediaProps[2]
  // class TRANSFORM.Media.BaseProperties1Phase
  equation
    heater2.Heater.flowModel.mediaProps[2].h = Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_Unique25
      (
      heater2.Heater.flowModel.mediaProps[2].state);
    heater2.Heater.flowModel.mediaProps[2].d = Modelica.Media.Water.WaterIF97_ph.density_Unique5
      (
      heater2.Heater.flowModel.mediaProps[2].state);
    heater2.Heater.flowModel.mediaProps[2].T = Modelica.Media.Water.WaterIF97_ph.temperature_Unique28
      (
      heater2.Heater.flowModel.mediaProps[2].state);
    heater2.Heater.flowModel.mediaProps[2].p = Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
      (
      heater2.Heater.flowModel.mediaProps[2].state);
    heater2.Heater.flowModel.mediaProps[2].mu = Modelica.Media.Water.WaterIF97_ph.dynamicViscosity_Unique6
      (
      heater2.Heater.flowModel.mediaProps[2].state);
    heater2.Heater.flowModel.mediaProps[2].lambda = Modelica.Media.Water.WaterIF97_ph.thermalConductivity_Unique45
      (
      heater2.Heater.flowModel.mediaProps[2].state);
    heater2.Heater.flowModel.mediaProps[2].cp = Modelica.Media.Water.WaterIF97_ph.specificHeatCapacityCp_Unique46
      (
      heater2.Heater.flowModel.mediaProps[2].state);

  // Component heater2.Heater.flowModel
  // class INL_DT.Components.Heater.FlowModel
    // extends TRANSFORM.Fluid.ClosureRelations.PressureLoss.Models.DistributedPipe_1D.PartialDistributedStaggeredFlow
    equation
      for i in (1:heater2.Heater.flowModel.nFM) loop
        assert(heater2.Heater.flowModel.m_flows[i] >  -heater2.Heater.flowModel.m_flow_small
           or heater2.Heater.flowModel.allowFlowReversal, "Reverting flow occurs in flowModel even though allowFlowReversal is false");
      end for;
      heater2.Heater.flowModel.Is = array(heater2.Heater.flowModel.m_flows[i]*
        heater2.Heater.flowModel.dlengths[i] for i in 1:heater2.Heater.flowModel.nFM);
      if (heater2.Heater.flowModel.momentumDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) then 
        for i in (1:heater2.Heater.flowModel.nFM) loop
          0 = heater2.Heater.flowModel.Ibs[i];
        end for;
      else
        for i in (1:heater2.Heater.flowModel.nFM) loop
          der(heater2.Heater.flowModel.Is[i]) = heater2.Heater.flowModel.Ibs[i];
        end for;
      end if;
    // extends TRANSFORM.Fluid.ClosureRelations.PressureLoss.Models.DistributedPipe_1D.PartialMomentumBalance
    equation
      heater2.Heater.flowModel.Ibs = heater2.Heater.flowModel.I_flows-
        heater2.Heater.flowModel.Fs_p-heater2.Heater.flowModel.Fs_fg;
      if (heater2.Heater.flowModel.use_I_flows) then 
        heater2.Heater.flowModel.I_flows = array(heater2.Heater.flowModel.crossAreas
          [i]*Modelica.Media.Water.WaterIF97_ph.density_Unique5(
          heater2.Heater.flowModel.states[i])*heater2.Heater.flowModel.vs[i]*
          heater2.Heater.flowModel.vs[i]-heater2.Heater.flowModel.crossAreas[i+1]
          *Modelica.Media.Water.WaterIF97_ph.density_Unique5(
          heater2.Heater.flowModel.states[i+1])*heater2.Heater.flowModel.vs[i+1]
          *heater2.Heater.flowModel.vs[i+1] for i in 1:heater2.Heater.flowModel.nFM);
      else
        heater2.Heater.flowModel.I_flows = zeros(heater2.Heater.flowModel.nFM);
      end if;
      heater2.Heater.flowModel.Fs_p = array(0.5*(heater2.Heater.flowModel.crossAreas
        [i]+heater2.Heater.flowModel.crossAreas[i+1])*(Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
        (
        heater2.Heater.flowModel.states[i+1])-Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
        (
        heater2.Heater.flowModel.states[i])) for i in 1:heater2.Heater.flowModel.nFM);
      heater2.Heater.flowModel.Fs_fg = array((heater2.Heater.flowModel.dps_fg[i]
        +heater2.Heater.flowModel.firstOrder_dps_K[i].y)*0.5*(heater2.Heater.flowModel.crossAreas
        [i]+heater2.Heater.flowModel.crossAreas[i+1]) for i in 1:
        heater2.Heater.flowModel.nFM);
      heater2.Heater.flowModel.dps_K = array(noEvent((if heater2.Heater.flowModel.m_flows
        [i] > 0 then 0.5*heater2.Heater.flowModel.Ks_ab[i]*Modelica.Media.Water.WaterIF97_ph.density_Unique5
        (
        heater2.Heater.flowModel.states[i])*heater2.Heater.flowModel.vs[i]*
        heater2.Heater.flowModel.vs[i] else  -0.5*heater2.Heater.flowModel.Ks_ba
        [i]*Modelica.Media.Water.WaterIF97_ph.density_Unique5(
        heater2.Heater.flowModel.states[i+1])*heater2.Heater.flowModel.vs[i+1]*
        heater2.Heater.flowModel.vs[i+1])) for i in 1:heater2.Heater.flowModel.nFM);
      heater2.Heater.flowModel.firstOrder_dps_K[:].u = heater2.Heater.flowModel.dps_K;
    // extends TRANSFORM.Fluid.ClosureRelations.PressureLoss.Models.DistributedPipe_1D.PartialSinglePhase
    equation
      for i in (1:heater2.Heater.flowModel.nFM) loop
        heater2.Heater.flowModel.Res[i] = 0.5*((heater2.Heater.flowModel.dimensions
          [i]+heater2.Heater.flowModel.dimensions[i+1])*abs(heater2.Heater.flowModel.m_flows
          [i]))/(0.25*((heater2.Heater.flowModel.crossAreas[i]+heater2.Heater.flowModel.crossAreas
          [i+1])*(heater2.Heater.flowModel.mediaProps[i].mu+heater2.Heater.flowModel.mediaProps
          [i+1].mu)));
      end for;
    // extends TRANSFORM.Fluid.ClosureRelations.PressureLoss.Models.DistributedPipe_1D.SinglePhase_Developed_2Region_NumStable
    equation
      for i in (1:heater2.Heater.flowModel.nFM) loop
        heater2.Heater.flowModel.ds[i] = TRANSFORM.Math.spliceTanh(
          heater2.Heater.flowModel.ds_a[i], heater2.Heater.flowModel.ds_b[i], 
          heater2.Heater.flowModel.m_flows[i], heater2.Heater.flowModel.m_flow_small);
        heater2.Heater.flowModel.mus[i] = TRANSFORM.Math.spliceTanh(
          heater2.Heater.flowModel.mus_a[i], heater2.Heater.flowModel.mus_b[i], 
          heater2.Heater.flowModel.m_flows[i], heater2.Heater.flowModel.m_flow_small);
      end for;
      if (heater2.Heater.flowModel.continuousFlowReversal) then 
        if (heater2.Heater.flowModel.from_dp) then 
          heater2.Heater.flowModel.m_flows = homotopy(TRANSFORM.Fluid.ClosureRelations.PressureLoss.Functions.TubesAndConduits.SinglePhase.LaminarTurbulent_MSLDetailed.dp_MFLOW
            (
            heater2.Heater.flowModel.IN_con, 
            heater2.Heater.flowModel.IN_var, 
            heater2.Heater.flowModel.dps_fg-(array(heater2.Heater.flowModel.g_n*
              heater2.Heater.flowModel.dheights[i]*heater2.Heater.flowModel.ds_a
              [i] for i in 1:heater2.Heater.flowModel.nFM)), 
            heater2.Heater.flowModel.dp_small/heater2.Heater.flowModel.nFM), 
            heater2.Heater.flowModel.m_flow_nominal/heater2.Heater.flowModel.dp_nominal
            *(heater2.Heater.flowModel.dps_fg-heater2.Heater.flowModel.g_n*
            heater2.Heater.flowModel.dheights*heater2.Heater.flowModel.d_nominal));
        else
          heater2.Heater.flowModel.dps_fg = homotopy(TRANSFORM.Fluid.ClosureRelations.PressureLoss.Functions.TubesAndConduits.SinglePhase.LaminarTurbulent_MSLDetailed.dp_DP
            (
            heater2.Heater.flowModel.IN_con, 
            heater2.Heater.flowModel.IN_var, 
            heater2.Heater.flowModel.m_flows, 
            heater2.Heater.flowModel.m_flow_small)+(array(heater2.Heater.flowModel.g_n
            *heater2.Heater.flowModel.dheights[i]*heater2.Heater.flowModel.ds_a[
            i] for i in 1:heater2.Heater.flowModel.nFM)), heater2.Heater.flowModel.dp_nominal
            /heater2.Heater.flowModel.m_flow_nominal*heater2.Heater.flowModel.m_flows
            +heater2.Heater.flowModel.g_n*heater2.Heater.flowModel.dheights*
            heater2.Heater.flowModel.d_nominal);
        end if;
      else
        if (heater2.Heater.flowModel.from_dp) then 
          heater2.Heater.flowModel.m_flows = homotopy(TRANSFORM.Fluid.ClosureRelations.PressureLoss.Functions.TubesAndConduits.SinglePhase.LaminarTurbulent_MSLDetailed.dp_MFLOW_staticHead
            (
            heater2.Heater.flowModel.IN_con, 
            heater2.Heater.flowModel.IN_var, 
            heater2.Heater.flowModel.dps_fg, 
            heater2.Heater.flowModel.dp_small/heater2.Heater.flowModel.nFM, 
            heater2.Heater.flowModel.g_n*heater2.Heater.flowModel.dheights), 
            heater2.Heater.flowModel.m_flow_nominal/heater2.Heater.flowModel.dp_nominal
            *(heater2.Heater.flowModel.dps_fg-heater2.Heater.flowModel.g_n*
            heater2.Heater.flowModel.dheights*heater2.Heater.flowModel.d_nominal));
        else
          heater2.Heater.flowModel.dps_fg = homotopy(TRANSFORM.Fluid.ClosureRelations.PressureLoss.Functions.TubesAndConduits.SinglePhase.LaminarTurbulent_MSLDetailed.dp_DP_staticHead
            (
            heater2.Heater.flowModel.IN_con, 
            heater2.Heater.flowModel.IN_var, 
            heater2.Heater.flowModel.m_flows, 
            heater2.Heater.flowModel.m_flow_small, 
            heater2.Heater.flowModel.g_n*heater2.Heater.flowModel.dheights), 
            heater2.Heater.flowModel.dp_nominal/heater2.Heater.flowModel.m_flow_nominal
            *heater2.Heater.flowModel.m_flows+heater2.Heater.flowModel.g_n*
            heater2.Heater.flowModel.dheights*heater2.Heater.flowModel.d_nominal);
        end if;
      end if;
    // end of extends 

  // Component heater2.Heater.heatTransfer.mediums[1]
  // class TRANSFORM.Media.BaseProperties1Phase
  equation
    heater2.Heater.heatTransfer.mediums[1].h = Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_Unique25
      (
      heater2.Heater.heatTransfer.mediums[1].state);
    heater2.Heater.heatTransfer.mediums[1].d = Modelica.Media.Water.WaterIF97_ph.density_Unique5
      (
      heater2.Heater.heatTransfer.mediums[1].state);
    heater2.Heater.heatTransfer.mediums[1].T = Modelica.Media.Water.WaterIF97_ph.temperature_Unique28
      (
      heater2.Heater.heatTransfer.mediums[1].state);
    heater2.Heater.heatTransfer.mediums[1].p = Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
      (
      heater2.Heater.heatTransfer.mediums[1].state);
    heater2.Heater.heatTransfer.mediums[1].mu = Modelica.Media.Water.WaterIF97_ph.dynamicViscosity_Unique6
      (
      heater2.Heater.heatTransfer.mediums[1].state);
    heater2.Heater.heatTransfer.mediums[1].lambda = Modelica.Media.Water.WaterIF97_ph.thermalConductivity_Unique45
      (
      heater2.Heater.heatTransfer.mediums[1].state);
    heater2.Heater.heatTransfer.mediums[1].cp = Modelica.Media.Water.WaterIF97_ph.specificHeatCapacityCp_Unique46
      (
      heater2.Heater.heatTransfer.mediums[1].state);

  // Component heater2.Heater.heatTransfer
  // class TRANSFORM.Fluid.Pipes.GenericPipe_MultiTransferSurface.HeatTransfer
    // extends TRANSFORM.Fluid.ClosureRelations.HeatTransfer.Models.DistributedPipe_1D_MultiTransferSurface.PartialIdeal
    equation
      heater2.Heater.heatTransfer.m_flows = heater2.Heater.heatTransfer.vs.*
        heater2.Heater.heatTransfer.mediums.d.*heater2.Heater.heatTransfer.crossAreas;
      heater2.Heater.heatTransfer.Res = heater2.Heater.heatTransfer.mediums.d.*
        heater2.Heater.heatTransfer.dimensions.*abs(heater2.Heater.heatTransfer.vs)
        ./heater2.Heater.heatTransfer.mediums.mu;
      heater2.Heater.heatTransfer.Prs = heater2.Heater.heatTransfer.mediums.mu.*
        heater2.Heater.heatTransfer.mediums.cp./heater2.Heater.heatTransfer.mediums
        .lambda;
    // extends TRANSFORM.Fluid.ClosureRelations.HeatTransfer.Models.DistributedPipe_1D_MultiTransferSurface.Ideal
    equation
      for i in (1:heater2.Heater.heatTransfer.nHT) loop
        for j in (1:heater2.Heater.heatTransfer.nSurfaces) loop
          heater2.Heater.heatTransfer.Ts_wall[i, j] = heater2.Heater.heatTransfer.Ts_fluid
            [i];
          heater2.Heater.heatTransfer.alphas[i, j] = 1E+60;
          heater2.Heater.heatTransfer.Nus[i, j] = 1E+60;
        end for;
      end for;
    // end of extends 

  // Component heater2.Heater.internalHeatGen
  // class TRANSFORM.Fluid.Pipes.GenericPipe_MultiTransferSurface.InternalHeatGen
    // extends TRANSFORM.Fluid.ClosureRelations.InternalVolumeHeatGeneration.Models.DistributedVolume_1D.GenericHeatGeneration
    equation
      for i in (1:heater2.Heater.internalHeatGen.nV) loop
        heater2.Heater.internalHeatGen.Q_flows[i] = heater2.Heater.internalHeatGen.Q_gens
          [i];
      end for;
    // end of extends 

  // Component heater2.Heater.traceMassTransfer.diffusionCoeff[1]
  // class TRANSFORM.Fluid.ClosureRelations.MassTransfer.Models.DistributedPipe_TraceMass_1D_MultiTransferSurface.PartialMassTransfer_setC.DiffusionCoeff
    // extends TRANSFORM.Media.ClosureModels.MassDiffusionCoefficient.Models.GenericCoefficient
    equation
      heater2.Heater.traceMassTransfer.diffusionCoeff[1].D_abs = 
        heater2.Heater.traceMassTransfer.diffusionCoeff[1].D_abs0;
    // end of extends 

  // Component heater2.Heater.traceMassTransfer.mediums[1]
  // class TRANSFORM.Media.BaseProperties1Phase
  equation
    heater2.Heater.traceMassTransfer.mediums[1].h = Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_Unique25
      (
      heater2.Heater.traceMassTransfer.mediums[1].state);
    heater2.Heater.traceMassTransfer.mediums[1].d = Modelica.Media.Water.WaterIF97_ph.density_Unique5
      (
      heater2.Heater.traceMassTransfer.mediums[1].state);
    heater2.Heater.traceMassTransfer.mediums[1].T = Modelica.Media.Water.WaterIF97_ph.temperature_Unique28
      (
      heater2.Heater.traceMassTransfer.mediums[1].state);
    heater2.Heater.traceMassTransfer.mediums[1].p = Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
      (
      heater2.Heater.traceMassTransfer.mediums[1].state);
    heater2.Heater.traceMassTransfer.mediums[1].mu = Modelica.Media.Water.WaterIF97_ph.dynamicViscosity_Unique6
      (
      heater2.Heater.traceMassTransfer.mediums[1].state);
    heater2.Heater.traceMassTransfer.mediums[1].lambda = Modelica.Media.Water.WaterIF97_ph.thermalConductivity_Unique45
      (
      heater2.Heater.traceMassTransfer.mediums[1].state);
    heater2.Heater.traceMassTransfer.mediums[1].cp = Modelica.Media.Water.WaterIF97_ph.specificHeatCapacityCp_Unique46
      (
      heater2.Heater.traceMassTransfer.mediums[1].state);

  // Component heater2.Heater.traceMassTransfer
  // class TRANSFORM.Fluid.Pipes.GenericPipe_MultiTransferSurface.TraceMassTransfer
    // extends TRANSFORM.Fluid.ClosureRelations.MassTransfer.Models.DistributedPipe_TraceMass_1D_MultiTransferSurface.PartialMassTransfer_setC
    equation
      for i in (1:heater2.Heater.traceMassTransfer.nMT) loop
        for k in (1:heater2.Heater.traceMassTransfer.nC) loop
          heater2.Heater.traceMassTransfer.Cs_fluid[i, k] = heater2.Heater.traceMassTransfer.CsM_fluid
            [i, heater2.Heater.traceMassTransfer.iC[k]]*Modelica.Media.Water.WaterIF97_ph.density_Unique5
            (
            heater2.Heater.traceMassTransfer.states[i])*heater2.Heater.traceMassTransfer.toMole_unitConv
            /heater2.Heater.traceMassTransfer.MMs[k];
        end for;
      end for;
      for i in (1:heater2.Heater.traceMassTransfer.nMT) loop
        for j in (1:heater2.Heater.traceMassTransfer.nSurfaces) loop
          for k in (1:heater2.Heater.traceMassTransfer.nC) loop
            heater2.Heater.traceMassTransfer.mC_flows[i, j, heater2.Heater.traceMassTransfer.iC
              [k]] = heater2.Heater.traceMassTransfer.nC_flows[i, j, k]*
              heater2.Heater.traceMassTransfer.MMs[k]*heater2.Heater.traceMassTransfer.toMole_unitConv;
          end for;
          for k in (1:heater2.Heater.traceMassTransfer.nC_noT) loop
            heater2.Heater.traceMassTransfer.mC_flows[i, j, heater2.Heater.traceMassTransfer.iC_noT
              [k]] = 0;
          end for;
        end for;
      end for;
      for i in (1:heater2.Heater.traceMassTransfer.nMT) loop
        heater2.Heater.traceMassTransfer.xs[i] = noEvent((if heater2.Heater.traceMassTransfer.vs
          [i] >= 0 then (if i == 1 then 0.5*heater2.Heater.traceMassTransfer.dlengths
          [i] else sum(heater2.Heater.traceMassTransfer.dlengths[1:i-1])+0.5*
          heater2.Heater.traceMassTransfer.dlengths[i]) else (if i == 
          heater2.Heater.traceMassTransfer.nMT then 0.5*heater2.Heater.traceMassTransfer.dlengths
          [heater2.Heater.traceMassTransfer.nMT] else sum(heater2.Heater.traceMassTransfer.dlengths
          [i+1:heater2.Heater.traceMassTransfer.nMT])+0.5*heater2.Heater.traceMassTransfer.dlengths
          [i])));
      end for;
    // extends TRANSFORM.Fluid.ClosureRelations.MassTransfer.Models.DistributedPipe_TraceMass_1D_MultiTransferSurface.PartialIdeal
    equation
      for i in (1:heater2.Heater.traceMassTransfer.nMT) loop
        heater2.Heater.traceMassTransfer.m_flows[i] = heater2.Heater.traceMassTransfer.vs
          [i]*heater2.Heater.traceMassTransfer.mediums[i].d*heater2.Heater.traceMassTransfer.crossAreas
          [i];
        heater2.Heater.traceMassTransfer.Res[i] = heater2.Heater.traceMassTransfer.mediums
          [i].d*heater2.Heater.traceMassTransfer.dimensions[i]*abs(
          heater2.Heater.traceMassTransfer.vs[i])/heater2.Heater.traceMassTransfer.mediums
          [i].mu;
        heater2.Heater.traceMassTransfer.Scs[i, :] = heater2.Heater.traceMassTransfer.mediums
          [i].mu./(heater2.Heater.traceMassTransfer.mediums[i].d.*
          heater2.Heater.traceMassTransfer.diffusionCoeff[i].D_abs);
      end for;
    // extends TRANSFORM.Fluid.ClosureRelations.MassTransfer.Models.DistributedPipe_TraceMass_1D_MultiTransferSurface.Ideal
    equation
      for i in (1:heater2.Heater.traceMassTransfer.nMT) loop
        for j in (1:heater2.Heater.traceMassTransfer.nSurfaces) loop
          heater2.Heater.traceMassTransfer.Cs_wall[i, j, :] = heater2.Heater.traceMassTransfer.Cs_fluid
            [i, :];
          heater2.Heater.traceMassTransfer.alphasM[i, j, :] = 1E+60*ones(
            heater2.Heater.traceMassTransfer.nC);
          heater2.Heater.traceMassTransfer.Shs[i, j, :] = 1E+60*ones(
            heater2.Heater.traceMassTransfer.nC);
        end for;
      end for;
    // end of extends 

  // Component heater2.Heater.internalTraceGen
  // class TRANSFORM.Fluid.Pipes.GenericPipe_MultiTransferSurface.InternalTraceGen
    // extends TRANSFORM.Fluid.ClosureRelations.InternalTraceGeneration.Models.DistributedVolume_Trace_1D.GenericTraceGeneration
    equation
      for ic in (1:0) loop
        for i in (1:heater2.Heater.internalTraceGen.nV) loop
          heater2.Heater.internalTraceGen.mC_flows[i, ic] = heater2.Heater.internalTraceGen.mC_gens
            [i, ic];
        end for;
      end for;
    // end of extends 

  // Component heater2.Heater.mediums[1]
  // class Modelica.Media.Water.WaterIF97_base.BaseProperties
    // extends Modelica.Media.Interfaces.PartialMedium.BaseProperties_D1
    equation
      if (heater2.Heater.mediums[1].standardOrderComponents) then 
        heater2.Heater.mediums[1].Xi = heater2.Heater.mediums[1].X[1:0];
        heater2.Heater.mediums[1].X = {1.0};
        for i in (1:1) loop
          assert(heater2.Heater.mediums[1].X[i] >= -1E-05 and heater2.Heater.mediums[1].X
            [i] <= 1.00001, "Mass fraction X["+       String(i, true, 0)+"] = "+
                   String(heater2.Heater.mediums[1].X[i], true, 0)+
            "of substance "+({"water"})[i]+"\nof medium "+"WaterIF97"+
            " is not in the range 0..1");
        end for;
      end if;
      assert(heater2.Heater.mediums[1].p >= 0.0, "Pressure (= "+       String(
        heater2.Heater.mediums[1].p, true, 0)+" Pa) of medium \""+"WaterIF97"+
        "\" is negative\n(Temperature = "+       String(heater2.Heater.mediums[1].T,
         true, 0)+" K)");
    // end of extends 
  equation
    heater2.Heater.mediums[1].MM = _GlobalScope.Modelica.Media.Water.WaterIF97_ph.fluidConstants[1]
      .molarMass;
    heater2.Heater.mediums[1].phase = (if heater2.Heater.mediums[1].h < 
      Modelica.Media.Water.WaterIF97_ph.bubbleEnthalpy_Unique29(
      heater2.Heater.mediums[1].sat) or heater2.Heater.mediums[1].h > 
      Modelica.Media.Water.WaterIF97_ph.dewEnthalpy_Unique30(
      heater2.Heater.mediums[1].sat) or heater2.Heater.mediums[1].p > 
      _GlobalScope.Modelica.Media.Water.WaterIF97_ph.fluidConstants[1].
      criticalPressure then 1 else 2);
    heater2.Heater.mediums[1].d = Modelica.Media.Water.WaterIF97_ph.density_ph_Unique3
      (heater2.Heater.mediums[1].p, heater2.Heater.mediums[1].h, 
      heater2.Heater.mediums[1].phase, 0);
    heater2.Heater.mediums[1].T = Modelica.Media.Water.WaterIF97_ph.temperature_ph_Unique4
      (heater2.Heater.mediums[1].p, heater2.Heater.mediums[1].h, 
      heater2.Heater.mediums[1].phase, 0);
    heater2.Heater.mediums[1].sat.Tsat = Modelica.Media.Water.WaterIF97_ph.saturationTemperature_Unique37
      (heater2.Heater.mediums[1].p);
    heater2.Heater.mediums[1].sat.psat = heater2.Heater.mediums[1].p;
    heater2.Heater.mediums[1].u = heater2.Heater.mediums[1].h-heater2.Heater.mediums[1].p
      /heater2.Heater.mediums[1].d;
    heater2.Heater.mediums[1].R_s = 8.31446261815324/_GlobalScope.Modelica.Media.Water.WaterIF97_ph.fluidConstants[1]
      .molarMass;
    heater2.Heater.mediums[1].h = heater2.Heater.mediums[1].state.h;
    heater2.Heater.mediums[1].p = heater2.Heater.mediums[1].state.p;
    heater2.Heater.mediums[1].T = heater2.Heater.mediums[1].state.T;
    heater2.Heater.mediums[1].d = heater2.Heater.mediums[1].state.d;
    heater2.Heater.mediums[1].phase = heater2.Heater.mediums[1].state.phase;

  // Component heater2.Heater
  // class TRANSFORM.Fluid.Pipes.GenericPipe_MultiTransferSurface
    // extends TRANSFORM.Fluid.Pipes.BaseClasses.PartialDistributedVolume
    equation
      assert( not (heater2.Heater.energyDynamics <> Modelica.Fluid.Types.Dynamics.
        SteadyState and heater2.Heater.massDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) or false, "Bad combination of dynamics options and Medium not conserving mass if fluidVolumes are fixed.");
      for i in (1:heater2.Heater.nV) loop
        heater2.Heater.ms[i] = heater2.Heater.Vs[i]*heater2.Heater.mediums[i].d;
        heater2.Heater.Us[i] = heater2.Heater.ms[i]*heater2.Heater.mediums[i].u;
        heater2.Heater.mXis[i, :] = heater2.Heater.ms[i]*heater2.Heater.mediums[
          i].Xi;
        heater2.Heater.mCs[i, :] = heater2.Heater.ms[i].*heater2.Heater.Cs[i, :];
      end for;
      if (heater2.Heater.massDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) then 
        for i in (1:heater2.Heater.nV) loop
          0 = heater2.Heater.mbs[i];
        end for;
      else
        for i in (1:heater2.Heater.nV) loop
          der(heater2.Heater.ms[i]) = heater2.Heater.mbs[i];
        end for;
      end if;
      if (heater2.Heater.energyDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) then 
        for i in (1:heater2.Heater.nV) loop
          0 = heater2.Heater.Ubs[i];
        end for;
      else
        for i in (1:heater2.Heater.nV) loop
          der(heater2.Heater.Us[i]) = heater2.Heater.Ubs[i];
        end for;
      end if;
      if (heater2.Heater.substanceDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) then 
        for i in (1:heater2.Heater.nV) loop
          zeros(0) = heater2.Heater.mXibs[i, :];
        end for;
      else
        for i in (1:heater2.Heater.nV) loop
          der(heater2.Heater.mXis[i, :]) = heater2.Heater.mXibs[i, :];
        end for;
      end if;
      if (heater2.Heater.traceDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) then 
        for i in (1:heater2.Heater.nV) loop
          zeros(0) = heater2.Heater.mCbs[i, :];
        end for;
      else
        for i in (1:heater2.Heater.nV) loop
          der(heater2.Heater.mCs_scaled[i, :]) = heater2.Heater.mCbs[i, :]./{};
          heater2.Heater.mCs[i, :] = heater2.Heater.mCs_scaled[i, :].*{};
        end for;
      end if;
    // end of extends 
  equation
    for i in (1:heater2.Heater.nV) loop
