    else
      if (heater3.Heater.exposeState_a and heater3.Heater.exposeState_b) then 
        heater3.Heater.m_flows[2:heater3.Heater.nV] = heater3.Heater.flowModel.m_flows
          [1:heater3.Heater.nV-1];
        heater3.Heater.port_a.p = heater3.Heater.mediums[1].p;
        heater3.Heater.port_b.p = heater3.Heater.mediums[heater3.Heater.nV].p;
        for i in (1:heater3.Heater.nFM+1) loop
          heater3.Heater.statesFM[i] = heater3.Heater.mediums[i].state;
          heater3.Heater.vsFM[i] = heater3.Heater.vs[i];
          heater3.Heater.Ts_wallFM[i] = sum(heater3.Heater.Ts_wall[i, :])/
            heater3.Heater.geometry.nSurfaces;
        end for;
        for i in (1:heater3.Heater.nFM+1) loop
          heater3.Heater.crossAreasFM[i] = heater3.Heater.geometry.crossAreas[i];
          heater3.Heater.dimensionsFM[i] = heater3.Heater.geometry.dimensions[i];
          heater3.Heater.perimetersFM[i] = heater3.Heater.geometry.perimeters[i];
          heater3.Heater.roughnessesFM[i] = heater3.Heater.geometry.roughnesses[
            i];
        end for;
        if (heater3.Heater.nFM == 1) then 
          heater3.Heater.dlengthsFM[1] = heater3.Heater.geometry.dlengths[1]+
            heater3.Heater.geometry.dlengths[2];
          heater3.Heater.dheightsFM[1] = heater3.Heater.geometry.dheights[1]+
            heater3.Heater.geometry.dheights[2];
        else
          heater3.Heater.dlengthsFM[1] = heater3.Heater.geometry.dlengths[1]+0.5
            *heater3.Heater.geometry.dlengths[2];
          heater3.Heater.dheightsFM[1] = heater3.Heater.geometry.dheights[1]+0.5
            *heater3.Heater.geometry.dheights[2];
          for i in (2:heater3.Heater.nFM-1) loop
            heater3.Heater.dlengthsFM[i] = 0.5*(heater3.Heater.geometry.dlengths
              [i]+heater3.Heater.geometry.dlengths[i+1]);
            heater3.Heater.dheightsFM[i] = 0.5*(heater3.Heater.geometry.dheights
              [i]+heater3.Heater.geometry.dheights[i+1]);
          end for;
          heater3.Heater.dlengthsFM[heater3.Heater.nFM] = 0.5*heater3.Heater.geometry.dlengths
            [heater3.Heater.nFM]+heater3.Heater.geometry.dlengths[
            heater3.Heater.nFM+1];
          heater3.Heater.dheightsFM[heater3.Heater.nFM] = 0.5*heater3.Heater.geometry.dheights
            [heater3.Heater.nFM]+heater3.Heater.geometry.dheights[
            heater3.Heater.nFM+1];
        end if;
      elseif (heater3.Heater.exposeState_a and  not heater3.Heater.exposeState_b)
         then 
        heater3.Heater.m_flows[2:heater3.Heater.nV+1] = heater3.Heater.flowModel.m_flows
          [1:heater3.Heater.nV];
        heater3.Heater.port_a.p = heater3.Heater.mediums[1].p;
        for i in (1:heater3.Heater.nFM) loop
          heater3.Heater.statesFM[i] = heater3.Heater.mediums[i].state;
          heater3.Heater.vsFM[i] = heater3.Heater.vs[i];
          heater3.Heater.Ts_wallFM[i] = sum(heater3.Heater.Ts_wall[i, :])/
            heater3.Heater.geometry.nSurfaces;
        end for;
        heater3.Heater.statesFM[heater3.Heater.nFM+1] = heater3.Heater.state_b;
        heater3.Heater.vsFM[heater3.Heater.nFM+1] = heater3.Heater.m_flows[
          heater3.Heater.nFM+1]/Modelica.Media.Water.WaterIF97_ph.density_Unique5
          (
          heater3.Heater.state_b)/heater3.Heater.geometry.crossAreas[
          heater3.Heater.nV];
        heater3.Heater.Ts_wallFM[heater3.Heater.nFM+1] = sum(heater3.Heater.Ts_wall
          [heater3.Heater.nV, :])/heater3.Heater.geometry.nSurfaces;
        for i in (1:heater3.Heater.nFM) loop
          heater3.Heater.crossAreasFM[i] = heater3.Heater.geometry.crossAreas[i];
          heater3.Heater.dimensionsFM[i] = heater3.Heater.geometry.dimensions[i];
          heater3.Heater.perimetersFM[i] = heater3.Heater.geometry.perimeters[i];
          heater3.Heater.roughnessesFM[i] = heater3.Heater.geometry.roughnesses[
            i];
        end for;
        heater3.Heater.crossAreasFM[heater3.Heater.nFM+1] = heater3.Heater.geometry.crossAreas
          [heater3.Heater.nV];
        heater3.Heater.dimensionsFM[heater3.Heater.nFM+1] = heater3.Heater.geometry.dimensions
          [heater3.Heater.nV];
        heater3.Heater.perimetersFM[heater3.Heater.nFM+1] = heater3.Heater.geometry.perimeters
          [heater3.Heater.nV];
        heater3.Heater.roughnessesFM[heater3.Heater.nFM+1] = heater3.Heater.geometry.roughnesses
          [heater3.Heater.nV];
        if (heater3.Heater.nFM == 1) then 
          heater3.Heater.dlengthsFM[1] = heater3.Heater.geometry.dlengths[1];
          heater3.Heater.dheightsFM[1] = heater3.Heater.geometry.dheights[1];
        else
          heater3.Heater.dlengthsFM[1] = heater3.Heater.geometry.dlengths[1]+0.5
            *heater3.Heater.geometry.dlengths[2];
          heater3.Heater.dheightsFM[1] = heater3.Heater.geometry.dheights[1]+0.5
            *heater3.Heater.geometry.dheights[2];
          for i in (2:heater3.Heater.nFM-1) loop
            heater3.Heater.dlengthsFM[i] = 0.5*(heater3.Heater.geometry.dlengths
              [i]+heater3.Heater.geometry.dlengths[i+1]);
            heater3.Heater.dheightsFM[i] = 0.5*(heater3.Heater.geometry.dheights
              [i]+heater3.Heater.geometry.dheights[i+1]);
          end for;
          heater3.Heater.dlengthsFM[heater3.Heater.nFM] = 0.5*heater3.Heater.geometry.dlengths
            [heater3.Heater.nFM];
          heater3.Heater.dheightsFM[heater3.Heater.nFM] = 0.5*heater3.Heater.geometry.dheights
            [heater3.Heater.nFM];
