  // Component HX.T_diff
  // class Modelica.Blocks.Math.Add
  equation
    HX.T_diff.y = HX.T_diff.k1*HX.T_diff.u1+HX.T_diff.k2*HX.T_diff.u2;

  // Component HX
  // class INL_DT.Components.HX_Isolated
  equation
    HX.port_a.m_flow-(HX.HXPipe.port_a.m_flow+HX.InletS_Shell.port.m_flow) = 0.0;
    HX.InletS_Shell.port.p = HX.HXPipe.port_a.p;
    HX.port_a.p = HX.HXPipe.port_a.p;
    HX.HXPipe.port_b.m_flow+HX.Shell.port_a.m_flow = 0.0;
    HX.Shell.port_a.p = HX.HXPipe.port_b.p;
    HX.HXTube.port_a.m_flow+HX.Tube.port_b.m_flow = 0.0;
    HX.Tube.port_b.p = HX.HXTube.port_a.p;
    HX.port_b1.m_flow-(HX.HXTube.port_b.m_flow+HX.OutletS_Tube.port.m_flow) = 
      0.0;
    HX.OutletS_Tube.port.p = HX.HXTube.port_b.p;
    HX.port_b1.p = HX.HXTube.port_b.p;
    HX.port_a1.m_flow-(HX.InletS_Tube.port.m_flow+HX.Tube.port_a.m_flow) = 0.0;
    HX.Tube.port_a.p = HX.InletS_Tube.port.p;
    HX.port_a1.p = HX.InletS_Tube.port.p;
    HX.port_b.m_flow-(HX.OutletS_Shell.port.m_flow+HX.Shell.port_b.m_flow) = 0.0;
    HX.Shell.port_b.p = HX.OutletS_Shell.port.p;
    HX.port_b.p = HX.OutletS_Shell.port.p;
    HX.Shell.heatPorts[1, 1].Q_flow+HX.cylinder.port_a.Q_flow = 0.0;
    HX.cylinder.port_a.T = HX.Shell.heatPorts[1, 1].T;
    HX.Shell.heatPorts_int[1, 1].Q_flow = 0.0;
    HX.realExpression.y = HX.T_diff.u1;
    HX.realExpression1.y = HX.T_diff.u2;
    HX.Tube.heatPorts[1, 1].Q_flow+HX.cylinder.port_b.Q_flow = 0.0;
    HX.cylinder.port_b.T = HX.Tube.heatPorts[1, 1].T;
    HX.Tube.heatPorts_int[1, 1].Q_flow = 0.0;

  // Component T_diff1
  // class Modelica.Blocks.Math.Add
  equation
    T_diff1.y = T_diff1.k1*T_diff1.u1+T_diff1.k2*T_diff1.u2;

  // Component cS_Dummy.const
  // class Modelica.Blocks.Sources.Constant
  equation
    cS_Dummy.const.y = cS_Dummy.const.k;

  // Component cS_Dummy
  // class INL_DT.ControlSystems.CS_Dummy
  equation
    cS_Dummy.actuatorBus.TopValve = cS_Dummy.actuatorBus.BotValve;
    cS_Dummy.const.y = cS_Dummy.actuatorBus.BotValve;

  // This model
  // class INL_DT.Components.NCFL
  equation
    Distance2Heaters.port_a.m_flow+s1.port_b.m_flow = 0.0;
    s1.port_b.p = Distance2Heaters.port_a.p;
    Distance2Heaters.port_b.m_flow+heater1.port_a.m_flow = 0.0;
    heater1.port_a.p = Distance2Heaters.port_b.p;
    DistanceAfterHX.port_a.m_flow+HX.port_b.m_flow = 0.0;
    HX.port_b.p = DistanceAfterHX.port_a.p;
    DistanceAfterHX.port_b.m_flow+volume.port_a[1].m_flow = 0.0;
    volume.port_a[1].p = DistanceAfterHX.port_b.p;
    DistanceAfterHeaters.port_a.m_flow+heater3.port_b.m_flow = 0.0;
    heater3.port_b.p = DistanceAfterHeaters.port_a.p;
    DistanceAfterHeaters.port_b.m_flow+s2.port_a.m_flow = 0.0;
    s2.port_a.p = DistanceAfterHeaters.port_b.p;
    HX.port_a.m_flow+s3.port_b.m_flow = 0.0;
    s3.port_b.p = HX.port_a.p;
    port_dch_a.m_flow-HX.port_a1.m_flow = 0.0;
    port_dch_a.p = HX.port_a1.p;
    port_dch_b.m_flow-HX.port_b1.m_flow = 0.0;
    port_dch_b.p = HX.port_b1.p;
    JetInlet.port_a.m_flow+ValveOutlet.port_b.m_flow = 0.0;
    ValveOutlet.port_b.p = JetInlet.port_a.p;
    JetInlet.port_b.m_flow+JetPump.port_a.m_flow+JetSuction.port_b.m_flow = 0.0;
    JetPump.port_a.p = JetInlet.port_b.p;
    JetSuction.port_b.p = JetInlet.port_b.p;
    JetPump.port_b.m_flow+s1.port_a.m_flow = 0.0;
    s1.port_a.p = JetPump.port_b.p;
    JetSuction.port_a.m_flow+V_top.port_b.m_flow = 0.0;
    V_top.port_b.p = JetSuction.port_a.p;
    PumpPipe.port_a.m_flow+V1_Inlet.port_a.m_flow+s4.port_b.m_flow = 0.0;
    V1_Inlet.port_a.p = PumpPipe.port_a.p;
    s4.port_b.p = PumpPipe.port_a.p;
    PumpPipe.port_b.m_flow+pump.port_a.m_flow = 0.0;
    pump.port_a.p = PumpPipe.port_b.p;
    Slant.port_a.m_flow+s2.port_b.m_flow = 0.0;
    s2.port_b.p = Slant.port_a.p;
    Slant.port_b.m_flow+s3.port_a.m_flow = 0.0;
    s3.port_a.p = Slant.port_b.p;
    realExpression.y = T_diff.u1;
    realExpression1.y = T_diff.u2;
    realExpression2.y = T_diff1.u1;
    realExpression3.y = T_diff1.u2;
    V1_Inlet.port_b.m_flow+V_top.port_a.m_flow = 0.0;
    V_top.port_a.p = V1_Inlet.port_b.p;
    actuatorBus.BotValve = V_bot.opening;
    cS_Dummy.actuatorBus.BotValve = V_bot.opening;
    V_bot.port_a.m_flow+pump.port_b.m_flow = 0.0;
    pump.port_b.p = V_bot.port_a.p;
    V_bot.port_b.m_flow+ValveOutlet.port_a.m_flow = 0.0;
    ValveOutlet.port_a.p = V_bot.port_b.p;
    actuatorBus.TopValve = V_top.opening;
    cS_Dummy.actuatorBus.TopValve = V_top.opening;
    heater1.port_b.m_flow+heater2.port_a.m_flow = 0.0;
    heater2.port_a.p = heater1.port_b.p;
    heater2.port_b.m_flow+heater3.port_a.m_flow = 0.0;
    heater3.port_a.p = heater2.port_b.p;
    stateDisplay.statePort.T = s1.statePort.T;
    stateDisplay.statePort.h_out = s1.statePort.h_out;
    stateDisplay.statePort.m_flow = s1.statePort.m_flow;
    stateDisplay.statePort.p = s1.statePort.p;
    stateDisplay1.statePort.T = s2.statePort.T;
    stateDisplay1.statePort.h_out = s2.statePort.h_out;
    stateDisplay1.statePort.m_flow = s2.statePort.m_flow;
    stateDisplay1.statePort.p = s2.statePort.p;
    stateDisplay2.statePort.T = s3.statePort.T;
    stateDisplay2.statePort.h_out = s3.statePort.h_out;
    stateDisplay2.statePort.m_flow = s3.statePort.m_flow;
    stateDisplay2.statePort.p = s3.statePort.p;
    s4.port_a.m_flow+volume.port_b[1].m_flow = 0.0;
    volume.port_b[1].p = s4.port_a.p;
    stateDisplay3.statePort.T = s4.statePort.T;
    stateDisplay3.statePort.h_out = s4.statePort.h_out;
    stateDisplay3.statePort.m_flow = s4.statePort.m_flow;
    stateDisplay3.statePort.p = s4.statePort.p;

// Fictive Equations for flow variables in top-level flow connectors: 
  port_dch_a.m_flow = function_of(port_dch_a.p, port_dch_a.h_outflow, 
    port_dch_a.Xi_outflow, port_dch_a.C_outflow, port_dch_b.p, port_dch_b.h_outflow,
     port_dch_b.Xi_outflow, port_dch_b.C_outflow);
  port_dch_b.m_flow = function_of(port_dch_a.p, port_dch_a.h_outflow, 
    port_dch_a.Xi_outflow, port_dch_a.C_outflow, port_dch_b.p, port_dch_b.h_outflow,
     port_dch_b.Xi_outflow, port_dch_b.C_outflow);
            
// Initial equations and algorithms

  // Component Slant.flowModel
  // class INL_DT.Components.NCFL.FlowModel
    // extends Modelica.Fluid.Interfaces.PartialDistributedFlow
    initial equation
      if (Slant.flowModel.momentumDynamics == Modelica.Fluid.Types.Dynamics.
        FixedInitial) then 
        Slant.flowModel.m_flows = fill(Slant.flowModel.m_flow_start, 
          Slant.flowModel.m);
      elseif (Slant.flowModel.momentumDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyStateInitial) then 
        der(Slant.flowModel.m_flows) = zeros(Slant.flowModel.m);
      end if;
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialGenericPipeFlow
    initial equation
      if (Slant.flowModel.system.use_eps_Re) then 
        Slant.flowModel.dp_small = Slant.flowModel.dp_fric_nominal/
          Slant.flowModel.m_flow_nominal*Slant.flowModel.m_flow_small;
      else
        Slant.flowModel.dp_small = Slant.flowModel.system.dp_small;
      end if;
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.DetailedPipeFlow
    initial equation
      if (Slant.flowModel.system.use_eps_Re) then 
        Slant.flowModel.dp_nominal = Slant.flowModel.dp_fric_nominal+
          Slant.flowModel.g*sum(Slant.flowModel.dheights)*Slant.flowModel.rho_nominal;
      else
        Slant.flowModel.dp_nominal = 1000.0*Slant.flowModel.dp_small;
      end if;
    // end of extends 

  // Component Distance2Heaters.flowModel
  // class Modelica.Fluid.Pipes.BaseClasses.PartialStraightPipe.FlowModel
    // extends Modelica.Fluid.Interfaces.PartialDistributedFlow
    initial equation
      if (Distance2Heaters.flowModel.momentumDynamics == Modelica.Fluid.Types.Dynamics.
        FixedInitial) then 
        Distance2Heaters.flowModel.m_flows = fill(Distance2Heaters.flowModel.m_flow_start,
           Distance2Heaters.flowModel.m);
      elseif (Distance2Heaters.flowModel.momentumDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyStateInitial) then 
        der(Distance2Heaters.flowModel.m_flows) = zeros(Distance2Heaters.flowModel.m);
      end if;
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialGenericPipeFlow
    initial equation
      if (Distance2Heaters.flowModel.system.use_eps_Re) then 
        Distance2Heaters.flowModel.dp_small = Distance2Heaters.flowModel.dp_fric_nominal
          /Distance2Heaters.flowModel.m_flow_nominal*Distance2Heaters.flowModel.m_flow_small;
      else
        Distance2Heaters.flowModel.dp_small = Distance2Heaters.flowModel.system.dp_small;
      end if;
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.DetailedPipeFlow
    initial equation
      if (Distance2Heaters.flowModel.system.use_eps_Re) then 
        Distance2Heaters.flowModel.dp_nominal = Distance2Heaters.flowModel.dp_fric_nominal
          +Distance2Heaters.flowModel.g*sum(Distance2Heaters.flowModel.dheights)
          *Distance2Heaters.flowModel.rho_nominal;
      else
        Distance2Heaters.flowModel.dp_nominal = 1000.0*Distance2Heaters.flowModel.dp_small;
      end if;
    // end of extends 

  // Component PumpPipe.flowModel
  // class INL_DT.Components.NCFL.FlowModel
    // extends Modelica.Fluid.Interfaces.PartialDistributedFlow
    initial equation
      if (PumpPipe.flowModel.momentumDynamics == Modelica.Fluid.Types.Dynamics.
        FixedInitial) then 
        PumpPipe.flowModel.m_flows = fill(PumpPipe.flowModel.m_flow_start, 
          PumpPipe.flowModel.m);
      elseif (PumpPipe.flowModel.momentumDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyStateInitial) then 
        der(PumpPipe.flowModel.m_flows) = zeros(PumpPipe.flowModel.m);
      end if;
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialGenericPipeFlow
    initial equation
      if (PumpPipe.flowModel.system.use_eps_Re) then 
        PumpPipe.flowModel.dp_small = PumpPipe.flowModel.dp_fric_nominal/
          PumpPipe.flowModel.m_flow_nominal*PumpPipe.flowModel.m_flow_small;
      else
        PumpPipe.flowModel.dp_small = PumpPipe.flowModel.system.dp_small;
      end if;
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.DetailedPipeFlow
    initial equation
      if (PumpPipe.flowModel.system.use_eps_Re) then 
        PumpPipe.flowModel.dp_nominal = PumpPipe.flowModel.dp_fric_nominal+
          PumpPipe.flowModel.g*sum(PumpPipe.flowModel.dheights)*PumpPipe.flowModel.rho_nominal;
      else
        PumpPipe.flowModel.dp_nominal = 1000.0*PumpPipe.flowModel.dp_small;
      end if;
    // end of extends 

  // Component DistanceAfterHX.flowModel
  // class INL_DT.Components.NCFL.FlowModel
    // extends Modelica.Fluid.Interfaces.PartialDistributedFlow
    initial equation
      if (DistanceAfterHX.flowModel.momentumDynamics == Modelica.Fluid.Types.Dynamics.
        FixedInitial) then 
        DistanceAfterHX.flowModel.m_flows = fill(DistanceAfterHX.flowModel.m_flow_start,
           DistanceAfterHX.flowModel.m);
      elseif (DistanceAfterHX.flowModel.momentumDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyStateInitial) then 
        der(DistanceAfterHX.flowModel.m_flows) = zeros(DistanceAfterHX.flowModel.m);
      end if;
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialGenericPipeFlow
    initial equation
      if (DistanceAfterHX.flowModel.system.use_eps_Re) then 
        DistanceAfterHX.flowModel.dp_small = DistanceAfterHX.flowModel.dp_fric_nominal
          /DistanceAfterHX.flowModel.m_flow_nominal*DistanceAfterHX.flowModel.m_flow_small;
      else
        DistanceAfterHX.flowModel.dp_small = DistanceAfterHX.flowModel.system.dp_small;
      end if;
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.DetailedPipeFlow
    initial equation
      if (DistanceAfterHX.flowModel.system.use_eps_Re) then 
        DistanceAfterHX.flowModel.dp_nominal = DistanceAfterHX.flowModel.dp_fric_nominal
          +DistanceAfterHX.flowModel.g*sum(DistanceAfterHX.flowModel.dheights)*
          DistanceAfterHX.flowModel.rho_nominal;
      else
        DistanceAfterHX.flowModel.dp_nominal = 1000.0*DistanceAfterHX.flowModel.dp_small;
      end if;
    // end of extends 

  // Component volume
  // class TRANSFORM.Fluid.Volumes.MixingVolume
    // extends TRANSFORM.Fluid.Volumes.BaseClasses.PartialVolume
    initial equation
      if (volume.massDynamics == Modelica.Fluid.Types.Dynamics.FixedInitial)
         then 
        if (volume.initialize_p) then 
          volume.medium.p = volume.p_start;
        end if;
      elseif (volume.massDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyStateInitial) then 
        if (volume.initialize_p) then 
          der(volume.medium.p) = 0;
        end if;
      end if;
      if (volume.energyDynamics == Modelica.Fluid.Types.Dynamics.FixedInitial)
         then 
        volume.medium.h = volume.h_start;
      elseif (volume.energyDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyStateInitial) then 
        der(volume.medium.h) = 0;
      end if;
      if (volume.substanceDynamics == Modelica.Fluid.Types.Dynamics.FixedInitial)
         then 
        volume.medium.Xi = volume.X_start[1:0];
      elseif (volume.substanceDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyStateInitial) then 
        der(volume.medium.Xi) = zeros(0);
      end if;
      if (volume.traceDynamics == Modelica.Fluid.Types.Dynamics.FixedInitial)
         then 
        volume.C = volume.C_start;
      elseif (volume.traceDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyStateInitial) then 
        der(volume.mC) = zeros(0);
      end if;
    // end of extends 

  // Component V1_Inlet.flowModel
  // class INL_DT.Components.NCFL.FlowModel
    // extends Modelica.Fluid.Interfaces.PartialDistributedFlow
    initial equation
      if (V1_Inlet.flowModel.momentumDynamics == Modelica.Fluid.Types.Dynamics.
        FixedInitial) then 
