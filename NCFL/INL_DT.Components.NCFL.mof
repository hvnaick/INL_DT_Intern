    "Mass flow rate at port_a";
  parameter Modelica.Units.SI.MassFlowRate HX.Tube.m_flow_b_start =  -
    HX.Tube.m_flow_a_start "Mass flow rate at port_b";
  parameter Modelica.Units.SI.MassFlowRate HX.Tube.m_flows_start[HX.Tube.nV+1]
     = linspace(HX.Tube.m_flow_a_start,  -HX.Tube.m_flow_b_start, HX.Tube.nV+1) 
    "Mass flow rates";
  constant Integer HX.Tube.geometry.figure = 1 "Index for Icon figure";
  constant Integer HX.Tube.geometry.nV(min = 1.0) = 1 "Number of volume nodes";
  constant Integer HX.Tube.geometry.nSurfaces = 1 "Number of transfer (heat/mass) surfaces";
  constant Integer HX.Tube.flowModel.nFM(min = 1.0) = 1 "Number of discrete flow models";
  constant Modelica.Fluid.Types.Dynamics HX.Tube.flowModel.momentumDynamics = 
    Modelica.Fluid.Types.Dynamics.SteadyState "Formulation of momentum balance";
  parameter Modelica.Units.SI.PressureDifference HX.Tube.flowModel.dps_start[
    HX.Tube.flowModel.nFM] = HX.Tube.dps_start "Pressure changes {p[2]-p[1],...,p[n+1]-p[n]}";
  parameter Modelica.Units.SI.MassFlowRate HX.Tube.flowModel.m_flows_start[
    HX.Tube.flowModel.nFM] = HX.Tube.m_flowsFM_start "Mass flow rates";
  constant Boolean HX.Tube.flowModel.allowFlowReversal = false "= true to allow flow reversal, false restricts to design direction (m_flows >= zeros(m))";
  constant Modelica.Units.SI.ReynoldsNumber HX.Tube.flowModel.Re_lam(max = 
    4000.0) = 2300 "Laminar transition Reynolds number";
  constant Modelica.Units.SI.ReynoldsNumber HX.Tube.flowModel.Re_turb(min = 
    2300.0) = 4000 "Turbulent transition Reynolds number";
  parameter Boolean HX.Tube.flowModel.from_dp = HX.Tube.flowModel.momentumDynamics
     >= Modelica.Fluid.Types.Dynamics.SteadyStateInitial "= true, use m_flow = f(dp), otherwise dp = f(m_flow)";
  parameter Modelica.Units.SI.MassFlowRate HX.Tube.flowModel.m_flow_small = 
    0.001 "Within regularization if |m_flows| < m_flow_small (may be wider for large discontinuities in static head)";
  parameter Modelica.Units.SI.AbsolutePressure HX.Tube.flowModel.dp_small = 1 
    "Within regularization if |dp| < dp_small (may be wider for large discontinuities in static head)";
  parameter Modelica.Units.SI.ReynoldsNumber HX.Tube.flowModel.Re_center = 0.5*(
    HX.Tube.flowModel.Re_lam+HX.Tube.flowModel.Re_turb) "Re smoothing transition center";
  parameter Modelica.Units.SI.ReynoldsNumber HX.Tube.flowModel.Re_width = 
    HX.Tube.flowModel.Re_turb-HX.Tube.flowModel.Re_center "Re smoothing transition width";
  parameter Boolean HX.Tube.flowModel.use_I_flows = HX.Tube.flowModel.momentumDynamics
     <> Modelica.Fluid.Types.Dynamics.SteadyState "= true to consider differences in flow of momentum through boundaries";
  parameter Modelica.Units.SI.Time HX.Tube.flowModel.taus[2] = {0.01, 0.01} 
    "Time Constant for first order delay of {dps_K,dps_add}";
  parameter Modelica.Units.SI.AbsolutePressure HX.Tube.flowModel.dp_nominal(
    fixed = false) = 1 "Nominal pressure loss (only for nominal models)";
  parameter Modelica.Units.SI.MassFlowRate HX.Tube.flowModel.m_flow_nominal = 
    100.0*HX.Tube.flowModel.m_flow_small "Nominal mass flow rate";
  parameter Boolean HX.Tube.flowModel.use_d_nominal = false "= true, if d_nominal is used, otherwise computed from medium";
  parameter Modelica.Units.SI.Density HX.Tube.flowModel.d_nominal = 
    Modelica.Media.Water.WaterIF97_ph.density_phX_Unique26(101325, 
    84013.0581525969, {1.0}, 0) "Nominal density (e.g., rho_liquidWater = 995, rho_air = 1.2)";
  parameter Boolean HX.Tube.flowModel.use_mu_nominal = false "= true, if mu_nominal is used, otherwise computed from medium";
  parameter Modelica.Units.SI.DynamicViscosity HX.Tube.flowModel.mu_nominal = 
    Modelica.Media.Water.WaterIF97_ph.dynamicViscosity_Unique6(
    Modelica.Media.Water.WaterIF97_ph.setState_phX_Unique1(101325, 
      84013.0581525969, {1.0}, 0, 0)) "Nominal dynamic viscosity (e.g., mu_liquidWater = 1e-3, mu_air = 1.8e-5)";
  parameter Boolean HX.Tube.flowModel.continuousFlowReversal = (if 
    HX.Tube.flowModel.use_d_nominal and HX.Tube.flowModel.use_mu_nominal then 
    true else false) "= true if the pressure loss is continuous around zero flow";
  parameter Real HX.Tube.flowModel.firstOrder_dps_K[1].k(unit = "1") = 1 "Gain";
  parameter Modelica.Units.SI.Time HX.Tube.flowModel.firstOrder_dps_K[1].T(
    start = 1) = HX.Tube.flowModel.taus[1] "Time Constant";
  parameter Modelica.Blocks.Types.Init HX.Tube.flowModel.firstOrder_dps_K[1].initType
     = Modelica.Blocks.Types.Init.InitialOutput "Type of initialization (1: no init, 2: steady state, 3/4: initial output)";
  parameter Real HX.Tube.flowModel.firstOrder_dps_K[1].y_start = 0 
    "Initial or guess value of output (= state)";
  constant Boolean HX.Tube.use_HeatTransfer = true "= true to use the HeatTransfer model";
  parameter Real HX.Tube.heatTransfer.nParallel = HX.Tube.nParallel 
    "Number of parallel components";
  constant Integer HX.Tube.heatTransfer.nHT = 1 "Number of heat transfer segments";
  constant Integer HX.Tube.heatTransfer.nSurfaces = 1 "Number of heat transfer surfaces";
  parameter Integer HX.Tube.heatTransfer.flagIdeal = 1 "Flag for models to handle ideal boundary";
  parameter Modelica.Units.SI.Temperature HX.Tube.heatTransfer.Ts_start[
    HX.Tube.heatTransfer.nHT](start = fill(288.15, size(HX.Tube.heatTransfer.Ts_start,
     1))) = HX.Tube.Ts_start;
  constant Modelica.Units.SI.ReynoldsNumber HX.Tube.heatTransfer.Re_lam(max = 
    4000.0) = 2300 "Laminar transition Reynolds number";
  constant Modelica.Units.SI.ReynoldsNumber HX.Tube.heatTransfer.Re_turb(min = 
    2300.0) = 4000 "Turbulent transition Reynolds number";
  parameter Modelica.Units.SI.ReynoldsNumber HX.Tube.heatTransfer.Re_center = 
    0.5*(HX.Tube.heatTransfer.Re_lam+HX.Tube.heatTransfer.Re_turb) 
    "Re smoothing transition center";
  parameter Modelica.Units.SI.ReynoldsNumber HX.Tube.heatTransfer.Re_width = 
    HX.Tube.heatTransfer.Re_turb-HX.Tube.heatTransfer.Re_center "Re smoothing transition width";
  constant Integer HX.Tube.internalHeatGen.nV(min = 1.0) = 1 "Number of discrete volumes";
  constant Boolean HX.Tube.use_TraceMassTransfer = false "= true to use the TraceMassTransfer model";
  parameter Real HX.Tube.traceMassTransfer.nParallel = HX.Tube.nParallel 
    "Number of parallel components";
  constant Integer HX.Tube.traceMassTransfer.nMT = 1 "Number of mass transfer segments";
  constant Integer HX.Tube.traceMassTransfer.nSurfaces = 1 "Number of mass transfer surfaces";
  parameter Integer HX.Tube.traceMassTransfer.flagIdeal = 1 "Flag for models to handle ideal boundary";
  parameter TRANSFORM.Units.ExtraProperty HX.Tube.traceMassTransfer.CsM_start[
    HX.Tube.traceMassTransfer.nMT, 0] = HX.Tube.Cs_start "Initial Trace substance mass-specific value";
  parameter Integer HX.Tube.traceMassTransfer.iC[:] = array(i for i in 1:0) 
    "Fluid index of transfered substances from fluid to massPort. This sets nC in traceMassTransfer.";
  parameter Integer HX.Tube.traceMassTransfer.nC = size(HX.Tube.traceMassTransfer.iC,
     1);
  parameter Real HX.Tube.traceMassTransfer.MMs[HX.Tube.traceMassTransfer.nC] = 
    fill(1, HX.Tube.traceMassTransfer.nC) "Conversion from fluid mass-specific value to moles (e.g., molar mass [kg/mol] or Avogadro's number [atoms/mol])";
  parameter Integer HX.Tube.traceMassTransfer.diffusionCoeff[1].nC = 
    HX.Tube.traceMassTransfer.nC "Number of substances";
  constant Modelica.Units.SI.ReynoldsNumber HX.Tube.traceMassTransfer.Re_lam(
    max = 4000.0) = 2300 "Laminar transition Reynolds number";
  constant Modelica.Units.SI.ReynoldsNumber HX.Tube.traceMassTransfer.Re_turb(
    min = 2300.0) = 4000 "Turbulent transition Reynolds number";
  parameter Integer HX.Tube.traceMassTransfer.massPorts[1, 1].nC = 
    HX.Tube.traceMassTransfer.nC "Number of substances";
  constant TRANSFORM.Units.Mole HX.Tube.traceMassTransfer.toMole_unitConv = 1;
  parameter Modelica.Units.SI.ReynoldsNumber HX.Tube.traceMassTransfer.Re_center
     = 0.5*(HX.Tube.traceMassTransfer.Re_lam+HX.Tube.traceMassTransfer.Re_turb) 
    "Re smoothing transition center";
  parameter Modelica.Units.SI.ReynoldsNumber HX.Tube.traceMassTransfer.Re_width
     = HX.Tube.traceMassTransfer.Re_turb-HX.Tube.traceMassTransfer.Re_center 
    "Re smoothing transition width";
  parameter Integer HX.Tube.traceMassTransfer.iC_fluid[0] = array(i for i in 1:0);
  parameter Integer HX.Tube.traceMassTransfer.nC_noT = 0-HX.Tube.traceMassTransfer.nC
     "# of species not transfered from fluid";
  parameter Integer HX.Tube.traceMassTransfer.iC_noT[HX.Tube.traceMassTransfer.nC_noT]
     = (if HX.Tube.traceMassTransfer.nC_noT > 0 then TRANSFORM.Math.indexFilter(
    HX.Tube.traceMassTransfer.iC_fluid, HX.Tube.traceMassTransfer.iC, false)
     else fill(0, HX.Tube.traceMassTransfer.nC_noT)) "Index of species not transfered from fluid";
  constant Integer HX.Tube.internalTraceGen.nV(min = 1.0) = 1 "Number of discrete volumes";
  constant Boolean HX.Tube.exposeState_a = true "=true, p is calculated at port_a else m_flow";
  constant Boolean HX.Tube.exposeState_b = false "=true, p is calculated at port_b else m_flow";
  constant Modelica.Fluid.Types.Dynamics HX.Tube.momentumDynamics = 
    Modelica.Fluid.Types.Dynamics.SteadyState "Formulation of momentum balances";
  parameter Boolean HX.Tube.useInnerPortProperties = false "=true to take port properties for flow models from internal control volumes";
  constant Boolean HX.Tube.useLumpedPressure = false "=true to lump pressure states together";
  parameter TRANSFORM.Fluid.Types.LumpedLocation HX.Tube.lumpPressureAt = 
    TRANSFORM.Fluid.Types.LumpedLocation.port_a "Location of pressure for flow calculations";
  constant Integer HX.Tube.nFM = 1 "number of flow models in flowModel";
  constant Integer HX.Tube.nFMDistributed = 1;
  parameter Integer HX.Tube.nFMLumped = (if  not HX.Tube.exposeState_a and  not 
    HX.Tube.exposeState_b then 2 else 1);
  parameter Integer HX.Tube.iLumped = integer(HX.Tube.nV/2)+1 "Index of control volume with representative state if useLumpedPressure";
  parameter Modelica.Units.SI.PressureDifference HX.Tube.dp_start = 
    HX.Tube.p_a_start-HX.Tube.p_b_start;
  parameter Modelica.Units.SI.PressureDifference HX.Tube.dps_start[HX.Tube.nFM]
     = (if HX.Tube.useLumpedPressure then (if  not HX.Tube.exposeState_a and 
     not HX.Tube.exposeState_b then cat(1, {HX.Tube.dp_start/2}, {
    HX.Tube.dp_start/2}) else {HX.Tube.dp_start}) else (if  not HX.Tube.exposeState_a
     and  not HX.Tube.exposeState_b then (if HX.Tube.nV == 1 then cat(1, {
    HX.Tube.dp_start/2}, {HX.Tube.dp_start/2}) else cat(1, {HX.Tube.dp_start/(
    HX.Tube.nV+1)}, array(HX.Tube.ps_start[i]-HX.Tube.ps_start[i+1] for i in 1:
    HX.Tube.nV-1), {HX.Tube.dp_start/(HX.Tube.nV+1)})) else (if  not 
    HX.Tube.exposeState_a and HX.Tube.exposeState_b then (if HX.Tube.nV == 1
     then {HX.Tube.dp_start} else cat(1, {HX.Tube.dp_start/HX.Tube.nV}, array(
    HX.Tube.ps_start[i]-HX.Tube.ps_start[i+1] for i in 1:HX.Tube.nV-1))) else (
    if HX.Tube.exposeState_a and  not HX.Tube.exposeState_b then (if HX.Tube.nV
     == 1 then {HX.Tube.dp_start} else cat(1, array(HX.Tube.ps_start[i]-
    HX.Tube.ps_start[i+1] for i in 1:HX.Tube.nV-1), {HX.Tube.dp_start/HX.Tube.nV}))
     else array(HX.Tube.ps_start[i]-HX.Tube.ps_start[i+1] for i in 1:HX.Tube.nV-1)))));
  parameter Modelica.Units.SI.MassFlowRate HX.Tube.m_flowsFM_start[HX.Tube.nFM]
     = (if HX.Tube.useLumpedPressure then (if HX.Tube.lumpPressureAt == 
    TRANSFORM.Fluid.Types.LumpedLocation.port_a then (if  not HX.Tube.exposeState_a
     and  not HX.Tube.exposeState_b then cat(1, {HX.Tube.m_flows_start[1]}, {
    HX.Tube.m_flows_start[1]})/HX.Tube.nParallel else {HX.Tube.m_flows_start[1]}
    /HX.Tube.nParallel) else (if  not HX.Tube.exposeState_a and  not 
    HX.Tube.exposeState_b then cat(1, {HX.Tube.m_flows_start[HX.Tube.nV+1]}, {
    HX.Tube.m_flows_start[HX.Tube.nV+1]})/HX.Tube.nParallel else {
    HX.Tube.m_flows_start[HX.Tube.nV+1]}/HX.Tube.nParallel)) else (if  not 
    HX.Tube.exposeState_a and  not HX.Tube.exposeState_b then HX.Tube.m_flows_start
    /HX.Tube.nParallel else (if  not HX.Tube.exposeState_a and HX.Tube.exposeState_b
     then (array(HX.Tube.m_flows_start[i] for i in 1:HX.Tube.nV))/
    HX.Tube.nParallel else (if HX.Tube.exposeState_a and  not HX.Tube.exposeState_b
     then (array(HX.Tube.m_flows_start[i] for i in 2:HX.Tube.nV+1))/
    HX.Tube.nParallel else (array(HX.Tube.m_flows_start[i] for i in 2:HX.Tube.nV))
    /HX.Tube.nParallel))));
  parameter Modelica.Units.SI.Temperature HX.Tube.Ts_wallFM_start[HX.Tube.nFM+1]
    (start = fill(288.15, size(HX.Tube.Ts_wallFM_start, 1))) = (if 
    HX.Tube.useLumpedPressure then (if  not HX.Tube.exposeState_a and  not 
    HX.Tube.exposeState_b then cat(1, {HX.Tube.T_a_start}, {0.5*(
    HX.Tube.T_a_start+HX.Tube.T_b_start)}, {HX.Tube.T_b_start}) else cat(1, {
    HX.Tube.T_a_start}, {HX.Tube.T_b_start})) else (if  not HX.Tube.exposeState_a
     and  not HX.Tube.exposeState_b then (if HX.Tube.nV == 1 then cat(1, {
    HX.Tube.T_a_start}, {0.5*(HX.Tube.T_a_start+HX.Tube.T_b_start)}, {
    HX.Tube.T_b_start}) else cat(1, {HX.Tube.T_a_start}, array(HX.Tube.Ts_start[
    i] for i in 1:HX.Tube.nV), {HX.Tube.T_b_start})) else (if  not 
    HX.Tube.exposeState_a and HX.Tube.exposeState_b then (if HX.Tube.nV == 1
     then cat(1, {HX.Tube.T_a_start}, {HX.Tube.T_b_start}) else cat(1, {
    HX.Tube.T_a_start}, array(HX.Tube.Ts_start[i] for i in 1:HX.Tube.nV))) else 
    (if HX.Tube.exposeState_a and  not HX.Tube.exposeState_b then (if HX.Tube.nV
     == 1 then cat(1, {HX.Tube.T_a_start}, {HX.Tube.T_b_start}) else cat(1, 
    array(HX.Tube.Ts_start[i] for i in 1:HX.Tube.nV), {HX.Tube.T_b_start}))
     else array(HX.Tube.Ts_start[i] for i in 1:HX.Tube.nV)))));
  parameter Boolean HX.Tube.showName = true;
  parameter Boolean HX.Tube.showDesignFlowDirection = true;
  parameter Boolean HX.Tube.showColors = HX.Tube.systemTF.showColors 
    "Toggle dynamic color display";
  parameter Integer HX.Tube.n_colors = 64 "Number of colors in the colorMap, multiples of 4 is best";
  parameter Boolean HX.Tube.calc_Wb = true "= false to not calculate p*der(V) [Wb_flows] for energy equation";
  constant Boolean HX.Tube.mediums[1].preferredMediumStates = true 
    "= true if StateSelect.prefer shall be used for the independent property variables of the medium";
  parameter Boolean HX.Tube.mediums[1].standardOrderComponents = true 
    "If true, and reducedX = true, the last element of X will be computed from the other ones";
  parameter Modelica.Units.SI.AbsolutePressure HX.HXTube.system.p_ambient = 101325
     "Default ambient pressure";
  parameter Modelica.Units.SI.Temperature HX.HXTube.system.T_ambient = 293.15 
    "Default ambient temperature";
  parameter Modelica.Units.SI.Acceleration HX.HXTube.system.g = 9.80665 
    "Constant gravity acceleration";
  constant Boolean HX.HXTube.system.allowFlowReversal = true "= false to restrict to design flow direction (port_a -> port_b)";
  parameter Modelica.Fluid.Types.Dynamics HX.HXTube.system.energyDynamics = 
    Modelica.Fluid.Types.Dynamics.DynamicFreeInitial "Default formulation of energy balances";
  parameter Modelica.Fluid.Types.Dynamics HX.HXTube.system.massDynamics = 
    HX.HXTube.system.energyDynamics "Default formulation of mass balances";
  parameter Modelica.Fluid.Types.Dynamics HX.HXTube.system.substanceDynamics = 
    HX.HXTube.system.massDynamics "Default formulation of substance balances";
  parameter Modelica.Fluid.Types.Dynamics HX.HXTube.system.traceDynamics = 
    HX.HXTube.system.massDynamics "Default formulation of trace substance balances";
  parameter Modelica.Fluid.Types.Dynamics HX.HXTube.system.momentumDynamics = 
    Modelica.Fluid.Types.Dynamics.SteadyState "Default formulation of momentum balances, if options available";
  parameter Modelica.Units.SI.MassFlowRate HX.HXTube.system.m_flow_start = 0 
    "Default start value for mass flow rates";
  parameter Modelica.Units.SI.AbsolutePressure HX.HXTube.system.p_start = 
    HX.HXTube.system.p_ambient "Default start value for pressures";
  parameter Modelica.Units.SI.Temperature HX.HXTube.system.T_start = 
    HX.HXTube.system.T_ambient "Default start value for temperatures";
  parameter Boolean HX.HXTube.system.use_eps_Re = false "= true to determine turbulent region automatically using Reynolds number";
  parameter Modelica.Units.SI.MassFlowRate HX.HXTube.system.m_flow_nominal = (
    if HX.HXTube.system.use_eps_Re then 1 else 100.0*HX.HXTube.system.m_flow_small)
     "Default nominal mass flow rate";
  parameter Real HX.HXTube.system.eps_m_flow(min = 0.0) = 0.0001 
    "Regularization of zero flow for |m_flow| < eps_m_flow*m_flow_nominal";
  parameter Modelica.Units.SI.AbsolutePressure HX.HXTube.system.dp_small = 1 
    "Default small pressure drop for regularization of laminar and zero flow";
  parameter Modelica.Units.SI.MassFlowRate HX.HXTube.system.m_flow_small(min = 
    0.0) = 0.01 "Default small mass flow rate for regularization of laminar and zero flow";
  constant Boolean HX.HXTube.allowFlowReversal = true "= true to allow flow reversal, false restricts to design direction (port_a -> port_b)";
  parameter Boolean HX.HXTube.port_a_exposesState = false "= true if port_a exposes the state of a fluid volume";
  parameter Boolean HX.HXTube.port_b_exposesState = false "= true if port_b.p exposes the state of a fluid volume";
  parameter Boolean HX.HXTube.showDesignFlowDirection = true "= false to hide the arrow in the model icon";
  parameter Real HX.HXTube.nParallel(min = 1.0) = 1 "Number of identical parallel pipes";
  parameter Modelica.Units.SI.Length HX.HXTube.length = HX.HXLength "Length";
  parameter Boolean HX.HXTube.isCircular = true "= true, if cross sectional area is circular";
  parameter Modelica.Units.SI.Diameter HX.HXTube.diameter = HX.HXRadius*2 
    "Diameter of circular pipe";
  parameter Modelica.Units.SI.Area HX.HXTube.crossArea = 3.141592653589793*
    HX.HXTube.diameter*HX.HXTube.diameter/4 "Inner cross section area";
  parameter Modelica.Units.SI.Length HX.HXTube.perimeter(min = 0.0) = 
    3.141592653589793*HX.HXTube.diameter "Inner perimeter";
  parameter Modelica.Fluid.Types.Roughness HX.HXTube.roughness = 2.5E-05 
    "Average height of surface asperities (default: smooth steel pipe)";
  parameter Modelica.Units.SI.Volume HX.HXTube.V = HX.HXTube.crossArea*
    HX.HXTube.length*HX.HXTube.nParallel "Volume size";
  parameter Modelica.Units.SI.Length HX.HXTube.height_ab = 0 "Height(port_b) - Height(port_a)";
  parameter Modelica.Media.Interfaces.Types.AbsolutePressure HX.HXTube.p_a_start
