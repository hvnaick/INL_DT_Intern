     then (if  not heater1.Heater.exposeState_a and  not heater1.Heater.exposeState_b
     then cat(1, {heater1.Heater.m_flows_start[1]}, {heater1.Heater.m_flows_start
    [1]})/heater1.Heater.nParallel else {heater1.Heater.m_flows_start[1]}/
    heater1.Heater.nParallel) else (if  not heater1.Heater.exposeState_a and 
     not heater1.Heater.exposeState_b then cat(1, {heater1.Heater.m_flows_start[
    heater1.Heater.nV+1]}, {heater1.Heater.m_flows_start[heater1.Heater.nV+1]})/
    heater1.Heater.nParallel else {heater1.Heater.m_flows_start[heater1.Heater.nV
    +1]}/heater1.Heater.nParallel)) else (if  not heater1.Heater.exposeState_a
     and  not heater1.Heater.exposeState_b then heater1.Heater.m_flows_start/
    heater1.Heater.nParallel else (if  not heater1.Heater.exposeState_a and 
    heater1.Heater.exposeState_b then (array(heater1.Heater.m_flows_start[i]
     for i in 1:heater1.Heater.nV))/heater1.Heater.nParallel else (if 
    heater1.Heater.exposeState_a and  not heater1.Heater.exposeState_b then (
    array(heater1.Heater.m_flows_start[i] for i in 2:heater1.Heater.nV+1))/
    heater1.Heater.nParallel else (array(heater1.Heater.m_flows_start[i] for i
     in 2:heater1.Heater.nV))/heater1.Heater.nParallel))));
  parameter Modelica.Units.SI.Temperature heater1.Heater.Ts_wallFM_start[
