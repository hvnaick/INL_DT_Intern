  constant Boolean HX.HXPipe.allowFlowReversal = true "= true to allow flow reversal, false restricts to design direction (port_a -> port_b)";
  parameter Boolean HX.HXPipe.port_a_exposesState = false "= true if port_a exposes the state of a fluid volume";
  parameter Boolean HX.HXPipe.port_b_exposesState = false "= true if port_b.p exposes the state of a fluid volume";
  parameter Boolean HX.HXPipe.showDesignFlowDirection = true "= false to hide the arrow in the model icon";
  parameter Real HX.HXPipe.nParallel(min = 1.0) = 1 "Number of identical parallel pipes";
  parameter Modelica.Units.SI.Length HX.HXPipe.length = HX.HXLength "Length";
  parameter Boolean HX.HXPipe.isCircular = true "= true, if cross sectional area is circular";
