             (ValveOutlet.flowModel.crossAreas[1:ValveOutlet.flowModel.n-1]+
            ValveOutlet.flowModel.crossAreas[2:ValveOutlet.flowModel.n])/2, (
            ValveOutlet.flowModel.roughnesses[1:ValveOutlet.flowModel.n-1]+
            ValveOutlet.flowModel.roughnesses[2:ValveOutlet.flowModel.n])/2, 
            ValveOutlet.flowModel.m_flow_small/ValveOutlet.flowModel.nParallel, 
            ValveOutlet.flowModel.Res_turbulent_internal)+(array(
            ValveOutlet.flowModel.g*ValveOutlet.flowModel.dheights[i]*
            ValveOutlet.flowModel.rhos_act[i] for i in 1:ValveOutlet.flowModel.n
            -1)), ValveOutlet.flowModel.dp_nominal/ValveOutlet.flowModel.m_flow_nominal
            *ValveOutlet.flowModel.m_flows+ValveOutlet.flowModel.g*
            ValveOutlet.flowModel.dheights*ValveOutlet.flowModel.rho_nominal);
        end if;
      else
        if (ValveOutlet.flowModel.from_dp and true) then 
          ValveOutlet.flowModel.m_flows = homotopy(massFlowRate_dp_staticHead_Unique16
            (ValveOutlet.flowModel.dps_fg, ValveOutlet.flowModel.rhos[1:
            ValveOutlet.flowModel.n-1], ValveOutlet.flowModel.rhos[2:
            ValveOutlet.flowModel.n], ValveOutlet.flowModel.mus[1:
            ValveOutlet.flowModel.n-1], ValveOutlet.flowModel.mus[2:
            ValveOutlet.flowModel.n], ValveOutlet.flowModel.pathLengths_internal,
             ValveOutlet.flowModel.diameters, ValveOutlet.flowModel.g*
            ValveOutlet.flowModel.dheights, (ValveOutlet.flowModel.crossAreas[1:
            ValveOutlet.flowModel.n-1]+ValveOutlet.flowModel.crossAreas[2:
            ValveOutlet.flowModel.n])/2, (ValveOutlet.flowModel.roughnesses[1:
            ValveOutlet.flowModel.n-1]+ValveOutlet.flowModel.roughnesses[2:
            ValveOutlet.flowModel.n])/2, ValveOutlet.flowModel.dp_small/(
            ValveOutlet.flowModel.n-1), ValveOutlet.flowModel.Res_turbulent_internal)
            *ValveOutlet.flowModel.nParallel, ValveOutlet.flowModel.m_flow_nominal
            /ValveOutlet.flowModel.dp_nominal*(ValveOutlet.flowModel.dps_fg-
            ValveOutlet.flowModel.g*ValveOutlet.flowModel.dheights*
            ValveOutlet.flowModel.rho_nominal));
        else
          ValveOutlet.flowModel.dps_fg = homotopy(pressureLoss_m_flow_staticHead_Unique17
            (ValveOutlet.flowModel.m_flows/ValveOutlet.flowModel.nParallel, 
            ValveOutlet.flowModel.rhos[1:ValveOutlet.flowModel.n-1], 
            ValveOutlet.flowModel.rhos[2:ValveOutlet.flowModel.n], 
            ValveOutlet.flowModel.mus[1:ValveOutlet.flowModel.n-1], 
            ValveOutlet.flowModel.mus[2:ValveOutlet.flowModel.n], 
            ValveOutlet.flowModel.pathLengths_internal, ValveOutlet.flowModel.diameters,
             ValveOutlet.flowModel.g*ValveOutlet.flowModel.dheights, (
            ValveOutlet.flowModel.crossAreas[1:ValveOutlet.flowModel.n-1]+
            ValveOutlet.flowModel.crossAreas[2:ValveOutlet.flowModel.n])/2, (
            ValveOutlet.flowModel.roughnesses[1:ValveOutlet.flowModel.n-1]+
            ValveOutlet.flowModel.roughnesses[2:ValveOutlet.flowModel.n])/2, 
            ValveOutlet.flowModel.m_flow_small/ValveOutlet.flowModel.nParallel, 
            ValveOutlet.flowModel.Res_turbulent_internal), ValveOutlet.flowModel.dp_nominal
            /ValveOutlet.flowModel.m_flow_nominal*ValveOutlet.flowModel.m_flows+
            ValveOutlet.flowModel.g*ValveOutlet.flowModel.dheights*
            ValveOutlet.flowModel.rho_nominal);
        end if;
      end if;
    // end of extends 

  // Component ValveOutlet
  // class Modelica.Fluid.Pipes.StaticPipe
    // extends Modelica.Fluid.Pipes.BaseClasses.PartialStraightPipe
    equation
      assert(ValveOutlet.length >= ValveOutlet.height_ab, "Parameter length must be greater or equal height_ab.");
    // end of extends 
  equation
    ValveOutlet.port_a.m_flow = ValveOutlet.flowModel.m_flows[1];
    0 = ValveOutlet.port_a.m_flow+ValveOutlet.port_b.m_flow;
    ValveOutlet.port_a.Xi_outflow = inStream(ValveOutlet.port_b.Xi_outflow);
    ValveOutlet.port_b.Xi_outflow = inStream(ValveOutlet.port_a.Xi_outflow);
    ValveOutlet.port_a.C_outflow = inStream(ValveOutlet.port_b.C_outflow);
    ValveOutlet.port_b.C_outflow = inStream(ValveOutlet.port_a.C_outflow);
    ValveOutlet.port_b.h_outflow = inStream(ValveOutlet.port_a.h_outflow)-
      ValveOutlet.system.g*ValveOutlet.height_ab;
    ValveOutlet.port_a.h_outflow = inStream(ValveOutlet.port_b.h_outflow)+
      ValveOutlet.system.g*ValveOutlet.height_ab;

  // Component JetPump.flowModel
  // class Modelica.Fluid.Pipes.BaseClasses.PartialStraightPipe.FlowModel
    // extends Modelica.Fluid.Interfaces.PartialDistributedFlow
    equation
      JetPump.flowModel.Is = array(JetPump.flowModel.m_flows[i]*JetPump.flowModel.pathLengths
        [i] for i in 1:JetPump.flowModel.m);
      if (JetPump.flowModel.momentumDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) then 
        zeros(JetPump.flowModel.m) = JetPump.flowModel.Ib_flows-JetPump.flowModel.Fs_p
          -JetPump.flowModel.Fs_fg;
      else
        der(JetPump.flowModel.Is) = JetPump.flowModel.Ib_flows-JetPump.flowModel.Fs_p
          -JetPump.flowModel.Fs_fg;
      end if;
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialStaggeredFlowModel
    equation
      if ( not JetPump.flowModel.allowFlowReversal) then 
        JetPump.flowModel.rhos_act = JetPump.flowModel.rhos[1:JetPump.flowModel.n
          -1];
        JetPump.flowModel.mus_act = JetPump.flowModel.mus[1:JetPump.flowModel.n-1];
      elseif ( not JetPump.flowModel.useUpstreamScheme) then 
        JetPump.flowModel.rhos_act = 0.5*(JetPump.flowModel.rhos[1:
          JetPump.flowModel.n-1]+JetPump.flowModel.rhos[2:JetPump.flowModel.n]);
        JetPump.flowModel.mus_act = 0.5*(JetPump.flowModel.mus[1:
          JetPump.flowModel.n-1]+JetPump.flowModel.mus[2:JetPump.flowModel.n]);
      else
        for i in (1:JetPump.flowModel.n-1) loop
          JetPump.flowModel.rhos_act[i] = noEvent((if JetPump.flowModel.m_flows[
            i] > 0 then JetPump.flowModel.rhos[i] else JetPump.flowModel.rhos[i+1]));
          JetPump.flowModel.mus_act[i] = noEvent((if JetPump.flowModel.m_flows[i]
             > 0 then JetPump.flowModel.mus[i] else JetPump.flowModel.mus[i+1]));
        end for;
      end if;
      if (JetPump.flowModel.use_Ib_flows) then 
        JetPump.flowModel.Ib_flows = JetPump.flowModel.nParallel*(array(
          JetPump.flowModel.rhos[i]*JetPump.flowModel.vs[i]*JetPump.flowModel.vs
          [i]*JetPump.flowModel.crossAreas[i]-JetPump.flowModel.rhos[i+1]*
          JetPump.flowModel.vs[i+1]*JetPump.flowModel.vs[i+1]*JetPump.flowModel.crossAreas
          [i+1] for i in 1:JetPump.flowModel.n-1));
      else
        JetPump.flowModel.Ib_flows = zeros(JetPump.flowModel.n-1);
      end if;
      JetPump.flowModel.Fs_p = JetPump.flowModel.nParallel*(array(0.5*(
        JetPump.flowModel.crossAreas[i]+JetPump.flowModel.crossAreas[i+1])*(
        Modelica.Media.Water.WaterIF97_ph.pressure_Unique11(
        JetPump.flowModel.states[i+1])-Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
        (
        JetPump.flowModel.states[i])) for i in 1:JetPump.flowModel.n-1));
      JetPump.flowModel.dps_fg = array(JetPump.flowModel.Fs_fg[i]/
        JetPump.flowModel.nParallel*2/(JetPump.flowModel.crossAreas[i]+
        JetPump.flowModel.crossAreas[i+1]) for i in 1:JetPump.flowModel.n-1);
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialGenericPipeFlow
    equation
      for i in (1:JetPump.flowModel.n-1) loop
        assert(JetPump.flowModel.m_flows[i] >  -JetPump.flowModel.m_flow_small
           or JetPump.flowModel.allowFlowReversal, "Reversing flow occurs even though allowFlowReversal is false");
      end for;
      if (JetPump.flowModel.continuousFlowReversal) then 
        if (JetPump.flowModel.from_dp and true) then 
          JetPump.flowModel.m_flows = homotopy(massFlowRate_dp_Unique14(
            JetPump.flowModel.dps_fg-(array(JetPump.flowModel.g*JetPump.flowModel.dheights
            [i]*JetPump.flowModel.rhos_act[i] for i in 1:JetPump.flowModel.n-1)),
             JetPump.flowModel.rhos_act, JetPump.flowModel.rhos_act, 
            JetPump.flowModel.mus_act, JetPump.flowModel.mus_act, 
            JetPump.flowModel.pathLengths_internal, JetPump.flowModel.diameters,
             (JetPump.flowModel.crossAreas[1:JetPump.flowModel.n-1]+
            JetPump.flowModel.crossAreas[2:JetPump.flowModel.n])/2, (
            JetPump.flowModel.roughnesses[1:JetPump.flowModel.n-1]+
            JetPump.flowModel.roughnesses[2:JetPump.flowModel.n])/2, 
            JetPump.flowModel.dp_small/(JetPump.flowModel.n-1), JetPump.flowModel.Res_turbulent_internal)
            *JetPump.flowModel.nParallel, JetPump.flowModel.m_flow_nominal/
            JetPump.flowModel.dp_nominal*(JetPump.flowModel.dps_fg-
            JetPump.flowModel.g*JetPump.flowModel.dheights*JetPump.flowModel.rho_nominal));
        else
          JetPump.flowModel.dps_fg = homotopy(pressureLoss_m_flow_Unique12(
            JetPump.flowModel.m_flows/JetPump.flowModel.nParallel, 
            JetPump.flowModel.rhos_act, JetPump.flowModel.rhos_act, 
            JetPump.flowModel.mus_act, JetPump.flowModel.mus_act, 
            JetPump.flowModel.pathLengths_internal, JetPump.flowModel.diameters,
             (JetPump.flowModel.crossAreas[1:JetPump.flowModel.n-1]+
            JetPump.flowModel.crossAreas[2:JetPump.flowModel.n])/2, (
            JetPump.flowModel.roughnesses[1:JetPump.flowModel.n-1]+
            JetPump.flowModel.roughnesses[2:JetPump.flowModel.n])/2, 
            JetPump.flowModel.m_flow_small/JetPump.flowModel.nParallel, 
            JetPump.flowModel.Res_turbulent_internal)+(array(JetPump.flowModel.g
            *JetPump.flowModel.dheights[i]*JetPump.flowModel.rhos_act[i] for i
             in 1:JetPump.flowModel.n-1)), JetPump.flowModel.dp_nominal/
            JetPump.flowModel.m_flow_nominal*JetPump.flowModel.m_flows+
            JetPump.flowModel.g*JetPump.flowModel.dheights*JetPump.flowModel.rho_nominal);
        end if;
      else
        if (JetPump.flowModel.from_dp and true) then 
          JetPump.flowModel.m_flows = homotopy(massFlowRate_dp_staticHead_Unique16
            (JetPump.flowModel.dps_fg, JetPump.flowModel.rhos[1:JetPump.flowModel.n
            -1], JetPump.flowModel.rhos[2:JetPump.flowModel.n], JetPump.flowModel.mus
            [1:JetPump.flowModel.n-1], JetPump.flowModel.mus[2:JetPump.flowModel.n],
             JetPump.flowModel.pathLengths_internal, JetPump.flowModel.diameters,
             JetPump.flowModel.g*JetPump.flowModel.dheights, (JetPump.flowModel.crossAreas
            [1:JetPump.flowModel.n-1]+JetPump.flowModel.crossAreas[2:
            JetPump.flowModel.n])/2, (JetPump.flowModel.roughnesses[1:
            JetPump.flowModel.n-1]+JetPump.flowModel.roughnesses[2:
            JetPump.flowModel.n])/2, JetPump.flowModel.dp_small/(
            JetPump.flowModel.n-1), JetPump.flowModel.Res_turbulent_internal)*
            JetPump.flowModel.nParallel, JetPump.flowModel.m_flow_nominal/
            JetPump.flowModel.dp_nominal*(JetPump.flowModel.dps_fg-
            JetPump.flowModel.g*JetPump.flowModel.dheights*JetPump.flowModel.rho_nominal));
        else
          JetPump.flowModel.dps_fg = homotopy(pressureLoss_m_flow_staticHead_Unique17
            (JetPump.flowModel.m_flows/JetPump.flowModel.nParallel, 
            JetPump.flowModel.rhos[1:JetPump.flowModel.n-1], JetPump.flowModel.rhos
            [2:JetPump.flowModel.n], JetPump.flowModel.mus[1:JetPump.flowModel.n
            -1], JetPump.flowModel.mus[2:JetPump.flowModel.n], JetPump.flowModel.pathLengths_internal,
             JetPump.flowModel.diameters, JetPump.flowModel.g*JetPump.flowModel.dheights,
             (JetPump.flowModel.crossAreas[1:JetPump.flowModel.n-1]+
            JetPump.flowModel.crossAreas[2:JetPump.flowModel.n])/2, (
            JetPump.flowModel.roughnesses[1:JetPump.flowModel.n-1]+
            JetPump.flowModel.roughnesses[2:JetPump.flowModel.n])/2, 
            JetPump.flowModel.m_flow_small/JetPump.flowModel.nParallel, 
            JetPump.flowModel.Res_turbulent_internal), JetPump.flowModel.dp_nominal
            /JetPump.flowModel.m_flow_nominal*JetPump.flowModel.m_flows+
            JetPump.flowModel.g*JetPump.flowModel.dheights*JetPump.flowModel.rho_nominal);
        end if;
      end if;
    // end of extends 

  // Component JetPump
  // class Modelica.Fluid.Pipes.StaticPipe
    // extends Modelica.Fluid.Pipes.BaseClasses.PartialStraightPipe
    equation
      assert(JetPump.length >= JetPump.height_ab, "Parameter length must be greater or equal height_ab.");
    // end of extends 
  equation
    JetPump.port_a.m_flow = JetPump.flowModel.m_flows[1];
    0 = JetPump.port_a.m_flow+JetPump.port_b.m_flow;
    JetPump.port_a.Xi_outflow = inStream(JetPump.port_b.Xi_outflow);
    JetPump.port_b.Xi_outflow = inStream(JetPump.port_a.Xi_outflow);
    JetPump.port_a.C_outflow = inStream(JetPump.port_b.C_outflow);
    JetPump.port_b.C_outflow = inStream(JetPump.port_a.C_outflow);
    JetPump.port_b.h_outflow = inStream(JetPump.port_a.h_outflow)-
      JetPump.system.g*JetPump.height_ab;
    JetPump.port_a.h_outflow = inStream(JetPump.port_b.h_outflow)+
      JetPump.system.g*JetPump.height_ab;

  // Component HX.Shell.geometry
  // class INL_DT.Components.HX_Isolated.Geometry
    // extends TRANSFORM.Fluid.ClosureRelations.Geometry.Models.DistributedVolume_1D.GenericPipe
    equation
      for i in (1:HX.Shell.geometry.nV) loop
        assert(HX.Shell.geometry.dimensions[i] > 0, "Characteristic dimension must be > 0");
        assert(HX.Shell.geometry.dlengths[i] >= abs(HX.Shell.geometry.dheights[i]),
           "Geometry dlengths must be greater or equal to abs(dheights)");
      end for;
    // end of extends 

  // Component HX.Shell.flowModel.firstOrder_dps_K[1]
  // class Modelica.Blocks.Continuous.FirstOrder
  equation
    der(HX.Shell.flowModel.firstOrder_dps_K[1].y) = (HX.Shell.flowModel.firstOrder_dps_K[1].k
      *HX.Shell.flowModel.firstOrder_dps_K[1].u-HX.Shell.flowModel.firstOrder_dps_K[1].y)
      /HX.Shell.flowModel.firstOrder_dps_K[1].T;

  // Component HX.Shell.flowModel.mediaProps[1]
  // class TRANSFORM.Media.BaseProperties1Phase
  equation
    HX.Shell.flowModel.mediaProps[1].h = Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_Unique25
      (
      HX.Shell.flowModel.mediaProps[1].state);
    HX.Shell.flowModel.mediaProps[1].d = Modelica.Media.Water.WaterIF97_ph.density_Unique5
      (
      HX.Shell.flowModel.mediaProps[1].state);
    HX.Shell.flowModel.mediaProps[1].T = Modelica.Media.Water.WaterIF97_ph.temperature_Unique28
      (
      HX.Shell.flowModel.mediaProps[1].state);
    HX.Shell.flowModel.mediaProps[1].p = Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
      (
      HX.Shell.flowModel.mediaProps[1].state);
    HX.Shell.flowModel.mediaProps[1].mu = Modelica.Media.Water.WaterIF97_ph.dynamicViscosity_Unique6
      (
      HX.Shell.flowModel.mediaProps[1].state);
    HX.Shell.flowModel.mediaProps[1].lambda = Modelica.Media.Water.WaterIF97_ph.thermalConductivity_Unique45
      (
      HX.Shell.flowModel.mediaProps[1].state);
    HX.Shell.flowModel.mediaProps[1].cp = Modelica.Media.Water.WaterIF97_ph.specificHeatCapacityCp_Unique46
      (
      HX.Shell.flowModel.mediaProps[1].state);

  // Component HX.Shell.flowModel.mediaProps[2]
  // class TRANSFORM.Media.BaseProperties1Phase
  equation
    HX.Shell.flowModel.mediaProps[2].h = Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_Unique25
      (
      HX.Shell.flowModel.mediaProps[2].state);
    HX.Shell.flowModel.mediaProps[2].d = Modelica.Media.Water.WaterIF97_ph.density_Unique5
      (
      HX.Shell.flowModel.mediaProps[2].state);
    HX.Shell.flowModel.mediaProps[2].T = Modelica.Media.Water.WaterIF97_ph.temperature_Unique28
      (
      HX.Shell.flowModel.mediaProps[2].state);
    HX.Shell.flowModel.mediaProps[2].p = Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
      (
      HX.Shell.flowModel.mediaProps[2].state);
    HX.Shell.flowModel.mediaProps[2].mu = Modelica.Media.Water.WaterIF97_ph.dynamicViscosity_Unique6
      (
      HX.Shell.flowModel.mediaProps[2].state);
    HX.Shell.flowModel.mediaProps[2].lambda = Modelica.Media.Water.WaterIF97_ph.thermalConductivity_Unique45
      (
      HX.Shell.flowModel.mediaProps[2].state);
    HX.Shell.flowModel.mediaProps[2].cp = Modelica.Media.Water.WaterIF97_ph.specificHeatCapacityCp_Unique46
      (
      HX.Shell.flowModel.mediaProps[2].state);

  // Component HX.Shell.flowModel
  // class TRANSFORM.Fluid.Pipes.GenericPipe_MultiTransferSurface.FlowModel
    // extends TRANSFORM.Fluid.ClosureRelations.PressureLoss.Models.DistributedPipe_1D.PartialDistributedStaggeredFlow
    equation
      for i in (1:HX.Shell.flowModel.nFM) loop
        assert(HX.Shell.flowModel.m_flows[i] >  -HX.Shell.flowModel.m_flow_small
           or HX.Shell.flowModel.allowFlowReversal, "Reverting flow occurs in flowModel even though allowFlowReversal is false");
      end for;
      HX.Shell.flowModel.Is = array(HX.Shell.flowModel.m_flows[i]*
        HX.Shell.flowModel.dlengths[i] for i in 1:HX.Shell.flowModel.nFM);
      if (HX.Shell.flowModel.momentumDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) then 
        for i in (1:HX.Shell.flowModel.nFM) loop
          0 = HX.Shell.flowModel.Ibs[i];
        end for;
      else
        for i in (1:HX.Shell.flowModel.nFM) loop
          der(HX.Shell.flowModel.Is[i]) = HX.Shell.flowModel.Ibs[i];
        end for;
      end if;
    // extends TRANSFORM.Fluid.ClosureRelations.PressureLoss.Models.DistributedPipe_1D.PartialMomentumBalance
    equation
      HX.Shell.flowModel.Ibs = HX.Shell.flowModel.I_flows-HX.Shell.flowModel.Fs_p
        -HX.Shell.flowModel.Fs_fg;
      if (HX.Shell.flowModel.use_I_flows) then 
        HX.Shell.flowModel.I_flows = array(HX.Shell.flowModel.crossAreas[i]*
          Modelica.Media.Water.WaterIF97_ph.density_Unique5(
          HX.Shell.flowModel.states[i])*HX.Shell.flowModel.vs[i]*
          HX.Shell.flowModel.vs[i]-HX.Shell.flowModel.crossAreas[i+1]*
          Modelica.Media.Water.WaterIF97_ph.density_Unique5(
          HX.Shell.flowModel.states[i+1])*HX.Shell.flowModel.vs[i+1]*
          HX.Shell.flowModel.vs[i+1] for i in 1:HX.Shell.flowModel.nFM);
      else
        HX.Shell.flowModel.I_flows = zeros(HX.Shell.flowModel.nFM);
      end if;
      HX.Shell.flowModel.Fs_p = array(0.5*(HX.Shell.flowModel.crossAreas[i]+
        HX.Shell.flowModel.crossAreas[i+1])*(Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
        (
        HX.Shell.flowModel.states[i+1])-Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
        (
        HX.Shell.flowModel.states[i])) for i in 1:HX.Shell.flowModel.nFM);
      HX.Shell.flowModel.Fs_fg = array((HX.Shell.flowModel.dps_fg[i]+
        HX.Shell.flowModel.firstOrder_dps_K[i].y)*0.5*(HX.Shell.flowModel.crossAreas
        [i]+HX.Shell.flowModel.crossAreas[i+1]) for i in 1:HX.Shell.flowModel.nFM);
      HX.Shell.flowModel.dps_K = array(noEvent((if HX.Shell.flowModel.m_flows[i]
         > 0 then 0.5*HX.Shell.flowModel.Ks_ab[i]*Modelica.Media.Water.WaterIF97_ph.density_Unique5
        (
        HX.Shell.flowModel.states[i])*HX.Shell.flowModel.vs[i]*HX.Shell.flowModel.vs
        [i] else  -0.5*HX.Shell.flowModel.Ks_ba[i]*Modelica.Media.Water.WaterIF97_ph.density_Unique5
        (
        HX.Shell.flowModel.states[i+1])*HX.Shell.flowModel.vs[i+1]*
        HX.Shell.flowModel.vs[i+1])) for i in 1:HX.Shell.flowModel.nFM);
      HX.Shell.flowModel.firstOrder_dps_K[:].u = HX.Shell.flowModel.dps_K;
    // extends TRANSFORM.Fluid.ClosureRelations.PressureLoss.Models.DistributedPipe_1D.PartialSinglePhase
    equation
      for i in (1:HX.Shell.flowModel.nFM) loop
        HX.Shell.flowModel.Res[i] = 0.5*((HX.Shell.flowModel.dimensions[i]+
          HX.Shell.flowModel.dimensions[i+1])*abs(HX.Shell.flowModel.m_flows[i]))
          /(0.25*((HX.Shell.flowModel.crossAreas[i]+HX.Shell.flowModel.crossAreas
          [i+1])*(HX.Shell.flowModel.mediaProps[i].mu+HX.Shell.flowModel.mediaProps
          [i+1].mu)));
      end for;
    // extends TRANSFORM.Fluid.ClosureRelations.PressureLoss.Models.DistributedPipe_1D.SinglePhase_Developed_2Region_NumStable
    equation
      for i in (1:HX.Shell.flowModel.nFM) loop
        HX.Shell.flowModel.ds[i] = TRANSFORM.Math.spliceTanh(HX.Shell.flowModel.ds_a
          [i], HX.Shell.flowModel.ds_b[i], HX.Shell.flowModel.m_flows[i], 
          HX.Shell.flowModel.m_flow_small);
        HX.Shell.flowModel.mus[i] = TRANSFORM.Math.spliceTanh(HX.Shell.flowModel.mus_a
          [i], HX.Shell.flowModel.mus_b[i], HX.Shell.flowModel.m_flows[i], 
          HX.Shell.flowModel.m_flow_small);
      end for;
      if (HX.Shell.flowModel.continuousFlowReversal) then 
        if (HX.Shell.flowModel.from_dp) then 
          HX.Shell.flowModel.m_flows = homotopy(TRANSFORM.Fluid.ClosureRelations.PressureLoss.Functions.TubesAndConduits.SinglePhase.LaminarTurbulent_MSLDetailed.dp_MFLOW
            (
            HX.Shell.flowModel.IN_con, 
            HX.Shell.flowModel.IN_var, 
            HX.Shell.flowModel.dps_fg-(array(HX.Shell.flowModel.g_n*
              HX.Shell.flowModel.dheights[i]*HX.Shell.flowModel.ds_a[i] for i
               in 1:HX.Shell.flowModel.nFM)), 
            HX.Shell.flowModel.dp_small/HX.Shell.flowModel.nFM), 
            HX.Shell.flowModel.m_flow_nominal/HX.Shell.flowModel.dp_nominal*(
            HX.Shell.flowModel.dps_fg-HX.Shell.flowModel.g_n*HX.Shell.flowModel.dheights
            *HX.Shell.flowModel.d_nominal));
        else
          HX.Shell.flowModel.dps_fg = homotopy(TRANSFORM.Fluid.ClosureRelations.PressureLoss.Functions.TubesAndConduits.SinglePhase.LaminarTurbulent_MSLDetailed.dp_DP
            (
            HX.Shell.flowModel.IN_con, 
            HX.Shell.flowModel.IN_var, 
            HX.Shell.flowModel.m_flows, 
            HX.Shell.flowModel.m_flow_small)+(array(HX.Shell.flowModel.g_n*
            HX.Shell.flowModel.dheights[i]*HX.Shell.flowModel.ds_a[i] for i in 1
            :HX.Shell.flowModel.nFM)), HX.Shell.flowModel.dp_nominal/
            HX.Shell.flowModel.m_flow_nominal*HX.Shell.flowModel.m_flows+
            HX.Shell.flowModel.g_n*HX.Shell.flowModel.dheights*HX.Shell.flowModel.d_nominal);
        end if;
      else
        if (HX.Shell.flowModel.from_dp) then 
          HX.Shell.flowModel.m_flows = homotopy(TRANSFORM.Fluid.ClosureRelations.PressureLoss.Functions.TubesAndConduits.SinglePhase.LaminarTurbulent_MSLDetailed.dp_MFLOW_staticHead
            (
            HX.Shell.flowModel.IN_con, 
            HX.Shell.flowModel.IN_var, 
            HX.Shell.flowModel.dps_fg, 
            HX.Shell.flowModel.dp_small/HX.Shell.flowModel.nFM, 
            HX.Shell.flowModel.g_n*HX.Shell.flowModel.dheights), 
            HX.Shell.flowModel.m_flow_nominal/HX.Shell.flowModel.dp_nominal*(
            HX.Shell.flowModel.dps_fg-HX.Shell.flowModel.g_n*HX.Shell.flowModel.dheights
            *HX.Shell.flowModel.d_nominal));
        else
          HX.Shell.flowModel.dps_fg = homotopy(TRANSFORM.Fluid.ClosureRelations.PressureLoss.Functions.TubesAndConduits.SinglePhase.LaminarTurbulent_MSLDetailed.dp_DP_staticHead
            (
            HX.Shell.flowModel.IN_con, 
            HX.Shell.flowModel.IN_var, 
            HX.Shell.flowModel.m_flows, 
            HX.Shell.flowModel.m_flow_small, 
            HX.Shell.flowModel.g_n*HX.Shell.flowModel.dheights), 
            HX.Shell.flowModel.dp_nominal/HX.Shell.flowModel.m_flow_nominal*
            HX.Shell.flowModel.m_flows+HX.Shell.flowModel.g_n*HX.Shell.flowModel.dheights
            *HX.Shell.flowModel.d_nominal);
        end if;
      end if;
    // end of extends 

  // Component HX.Shell.heatTransfer.mediums[1]
  // class TRANSFORM.Media.BaseProperties1Phase
  equation
    HX.Shell.heatTransfer.mediums[1].h = Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_Unique25
      (
      HX.Shell.heatTransfer.mediums[1].state);
    HX.Shell.heatTransfer.mediums[1].d = Modelica.Media.Water.WaterIF97_ph.density_Unique5
      (
      HX.Shell.heatTransfer.mediums[1].state);
    HX.Shell.heatTransfer.mediums[1].T = Modelica.Media.Water.WaterIF97_ph.temperature_Unique28
      (
      HX.Shell.heatTransfer.mediums[1].state);
    HX.Shell.heatTransfer.mediums[1].p = Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
      (
      HX.Shell.heatTransfer.mediums[1].state);
    HX.Shell.heatTransfer.mediums[1].mu = Modelica.Media.Water.WaterIF97_ph.dynamicViscosity_Unique6
      (
      HX.Shell.heatTransfer.mediums[1].state);
    HX.Shell.heatTransfer.mediums[1].lambda = Modelica.Media.Water.WaterIF97_ph.thermalConductivity_Unique45
      (
      HX.Shell.heatTransfer.mediums[1].state);
    HX.Shell.heatTransfer.mediums[1].cp = Modelica.Media.Water.WaterIF97_ph.specificHeatCapacityCp_Unique46
      (
      HX.Shell.heatTransfer.mediums[1].state);

  // Component HX.Shell.heatTransfer
  // class INL_DT.Components.HX_Isolated.HeatTransfer
    // extends TRANSFORM.Fluid.ClosureRelations.HeatTransfer.Models.DistributedPipe_1D_MultiTransferSurface.PartialIdeal
    equation
      HX.Shell.heatTransfer.m_flows = HX.Shell.heatTransfer.vs.*HX.Shell.heatTransfer.mediums
        .d.*HX.Shell.heatTransfer.crossAreas;
      HX.Shell.heatTransfer.Res = HX.Shell.heatTransfer.mediums.d.*
        HX.Shell.heatTransfer.dimensions.*abs(HX.Shell.heatTransfer.vs)./
        HX.Shell.heatTransfer.mediums.mu;
      HX.Shell.heatTransfer.Prs = HX.Shell.heatTransfer.mediums.mu.*
        HX.Shell.heatTransfer.mediums.cp./HX.Shell.heatTransfer.mediums.lambda;
    // extends TRANSFORM.Fluid.ClosureRelations.HeatTransfer.Models.DistributedPipe_1D_MultiTransferSurface.Ideal
    equation
      for i in (1:HX.Shell.heatTransfer.nHT) loop
        for j in (1:HX.Shell.heatTransfer.nSurfaces) loop
          HX.Shell.heatTransfer.Ts_wall[i, j] = HX.Shell.heatTransfer.Ts_fluid[i];
          HX.Shell.heatTransfer.alphas[i, j] = 1E+60;
          HX.Shell.heatTransfer.Nus[i, j] = 1E+60;
        end for;
      end for;
    // end of extends 

  // Component HX.Shell.internalHeatGen
  // class INL_DT.Components.HX_Isolated.InternalHeatGen
    // extends TRANSFORM.Fluid.ClosureRelations.InternalVolumeHeatGeneration.Models.DistributedVolume_1D.GenericHeatGeneration
    equation
      for i in (1:HX.Shell.internalHeatGen.nV) loop
        HX.Shell.internalHeatGen.Q_flows[i] = HX.Shell.internalHeatGen.Q_gens[i];
      end for;
    // end of extends 

  // Component HX.Shell.traceMassTransfer.diffusionCoeff[1]
  // class TRANSFORM.Fluid.ClosureRelations.MassTransfer.Models.DistributedPipe_TraceMass_1D_MultiTransferSurface.PartialMassTransfer_setC.DiffusionCoeff
    // extends TRANSFORM.Media.ClosureModels.MassDiffusionCoefficient.Models.GenericCoefficient
    equation
      HX.Shell.traceMassTransfer.diffusionCoeff[1].D_abs = HX.Shell.traceMassTransfer.diffusionCoeff[1].D_abs0;
    // end of extends 

  // Component HX.Shell.traceMassTransfer.mediums[1]
  // class TRANSFORM.Media.BaseProperties1Phase
  equation
    HX.Shell.traceMassTransfer.mediums[1].h = Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_Unique25
      (
      HX.Shell.traceMassTransfer.mediums[1].state);
    HX.Shell.traceMassTransfer.mediums[1].d = Modelica.Media.Water.WaterIF97_ph.density_Unique5
      (
      HX.Shell.traceMassTransfer.mediums[1].state);
    HX.Shell.traceMassTransfer.mediums[1].T = Modelica.Media.Water.WaterIF97_ph.temperature_Unique28
      (
      HX.Shell.traceMassTransfer.mediums[1].state);
    HX.Shell.traceMassTransfer.mediums[1].p = Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
      (
      HX.Shell.traceMassTransfer.mediums[1].state);
    HX.Shell.traceMassTransfer.mediums[1].mu = Modelica.Media.Water.WaterIF97_ph.dynamicViscosity_Unique6
      (
      HX.Shell.traceMassTransfer.mediums[1].state);
    HX.Shell.traceMassTransfer.mediums[1].lambda = Modelica.Media.Water.WaterIF97_ph.thermalConductivity_Unique45
      (
      HX.Shell.traceMassTransfer.mediums[1].state);
    HX.Shell.traceMassTransfer.mediums[1].cp = Modelica.Media.Water.WaterIF97_ph.specificHeatCapacityCp_Unique46
      (
      HX.Shell.traceMassTransfer.mediums[1].state);

  // Component HX.Shell.traceMassTransfer
  // class TRANSFORM.Fluid.Pipes.GenericPipe_MultiTransferSurface.TraceMassTransfer
    // extends TRANSFORM.Fluid.ClosureRelations.MassTransfer.Models.DistributedPipe_TraceMass_1D_MultiTransferSurface.PartialMassTransfer_setC
    equation
      for i in (1:HX.Shell.traceMassTransfer.nMT) loop
        for k in (1:HX.Shell.traceMassTransfer.nC) loop
          HX.Shell.traceMassTransfer.Cs_fluid[i, k] = HX.Shell.traceMassTransfer.CsM_fluid
            [i, HX.Shell.traceMassTransfer.iC[k]]*Modelica.Media.Water.WaterIF97_ph.density_Unique5
            (
            HX.Shell.traceMassTransfer.states[i])*HX.Shell.traceMassTransfer.toMole_unitConv
            /HX.Shell.traceMassTransfer.MMs[k];
        end for;
      end for;
      for i in (1:HX.Shell.traceMassTransfer.nMT) loop
        for j in (1:HX.Shell.traceMassTransfer.nSurfaces) loop
          for k in (1:HX.Shell.traceMassTransfer.nC) loop
            HX.Shell.traceMassTransfer.mC_flows[i, j, HX.Shell.traceMassTransfer.iC
              [k]] = HX.Shell.traceMassTransfer.nC_flows[i, j, k]*
              HX.Shell.traceMassTransfer.MMs[k]*HX.Shell.traceMassTransfer.toMole_unitConv;
          end for;
          for k in (1:HX.Shell.traceMassTransfer.nC_noT) loop
            HX.Shell.traceMassTransfer.mC_flows[i, j, HX.Shell.traceMassTransfer.iC_noT
              [k]] = 0;
          end for;
        end for;
      end for;
      for i in (1:HX.Shell.traceMassTransfer.nMT) loop
        HX.Shell.traceMassTransfer.xs[i] = noEvent((if HX.Shell.traceMassTransfer.vs
          [i] >= 0 then (if i == 1 then 0.5*HX.Shell.traceMassTransfer.dlengths[
          i] else sum(HX.Shell.traceMassTransfer.dlengths[1:i-1])+0.5*
          HX.Shell.traceMassTransfer.dlengths[i]) else (if i == HX.Shell.traceMassTransfer.nMT
           then 0.5*HX.Shell.traceMassTransfer.dlengths[HX.Shell.traceMassTransfer.nMT]
           else sum(HX.Shell.traceMassTransfer.dlengths[i+1:HX.Shell.traceMassTransfer.nMT])
          +0.5*HX.Shell.traceMassTransfer.dlengths[i])));
      end for;
    // extends TRANSFORM.Fluid.ClosureRelations.MassTransfer.Models.DistributedPipe_TraceMass_1D_MultiTransferSurface.PartialIdeal
    equation
      for i in (1:HX.Shell.traceMassTransfer.nMT) loop
        HX.Shell.traceMassTransfer.m_flows[i] = HX.Shell.traceMassTransfer.vs[i]
          *HX.Shell.traceMassTransfer.mediums[i].d*HX.Shell.traceMassTransfer.crossAreas
          [i];
        HX.Shell.traceMassTransfer.Res[i] = HX.Shell.traceMassTransfer.mediums[i]
          .d*HX.Shell.traceMassTransfer.dimensions[i]*abs(HX.Shell.traceMassTransfer.vs
          [i])/HX.Shell.traceMassTransfer.mediums[i].mu;
        HX.Shell.traceMassTransfer.Scs[i, :] = HX.Shell.traceMassTransfer.mediums
          [i].mu./(HX.Shell.traceMassTransfer.mediums[i].d.*HX.Shell.traceMassTransfer.diffusionCoeff
          [i].D_abs);
      end for;
    // extends TRANSFORM.Fluid.ClosureRelations.MassTransfer.Models.DistributedPipe_TraceMass_1D_MultiTransferSurface.Ideal
    equation
      for i in (1:HX.Shell.traceMassTransfer.nMT) loop
        for j in (1:HX.Shell.traceMassTransfer.nSurfaces) loop
          HX.Shell.traceMassTransfer.Cs_wall[i, j, :] = HX.Shell.traceMassTransfer.Cs_fluid
            [i, :];
          HX.Shell.traceMassTransfer.alphasM[i, j, :] = 1E+60*ones(
            HX.Shell.traceMassTransfer.nC);
          HX.Shell.traceMassTransfer.Shs[i, j, :] = 1E+60*ones(HX.Shell.traceMassTransfer.nC);
        end for;
      end for;
    // end of extends 

  // Component HX.Shell.internalTraceGen
  // class TRANSFORM.Fluid.Pipes.GenericPipe_MultiTransferSurface.InternalTraceGen
    // extends TRANSFORM.Fluid.ClosureRelations.InternalTraceGeneration.Models.DistributedVolume_Trace_1D.GenericTraceGeneration
    equation
      for ic in (1:0) loop
        for i in (1:HX.Shell.internalTraceGen.nV) loop
          HX.Shell.internalTraceGen.mC_flows[i, ic] = HX.Shell.internalTraceGen.mC_gens
            [i, ic];
        end for;
      end for;
    // end of extends 

  // Component HX.Shell.mediums[1]
  // class Modelica.Media.Water.WaterIF97_base.BaseProperties
    // extends Modelica.Media.Interfaces.PartialMedium.BaseProperties_D1
    equation
      if (HX.Shell.mediums[1].standardOrderComponents) then 
        HX.Shell.mediums[1].Xi = HX.Shell.mediums[1].X[1:0];
        HX.Shell.mediums[1].X = {1.0};
        for i in (1:1) loop
          assert(HX.Shell.mediums[1].X[i] >= -1E-05 and HX.Shell.mediums[1].X[i]
             <= 1.00001, "Mass fraction X["+       String(i, true, 0)+"] = "+
                   String(HX.Shell.mediums[1].X[i], true, 0)+"of substance "+({
            "water"})[i]+"\nof medium "+"WaterIF97"+" is not in the range 0..1");
        end for;
      end if;
      assert(HX.Shell.mediums[1].p >= 0.0, "Pressure (= "+       String(
        HX.Shell.mediums[1].p, true, 0)+" Pa) of medium \""+"WaterIF97"+
        "\" is negative\n(Temperature = "+       String(HX.Shell.mediums[1].T, 
        true, 0)+" K)");
    // end of extends 
  equation
    HX.Shell.mediums[1].MM = _GlobalScope.Modelica.Media.Water.WaterIF97_ph.fluidConstants[1]
      .molarMass;
    HX.Shell.mediums[1].phase = (if HX.Shell.mediums[1].h < Modelica.Media.Water.WaterIF97_ph.bubbleEnthalpy_Unique29
      (
      HX.Shell.mediums[1].sat) or HX.Shell.mediums[1].h > Modelica.Media.Water.WaterIF97_ph.dewEnthalpy_Unique30
      (
      HX.Shell.mediums[1].sat) or HX.Shell.mediums[1].p > _GlobalScope.Modelica.Media.Water.WaterIF97_ph.fluidConstants[1]
      .criticalPressure then 1 else 2);
    HX.Shell.mediums[1].d = Modelica.Media.Water.WaterIF97_ph.density_ph_Unique3
      (HX.Shell.mediums[1].p, HX.Shell.mediums[1].h, HX.Shell.mediums[1].phase, 0);
    HX.Shell.mediums[1].T = Modelica.Media.Water.WaterIF97_ph.temperature_ph_Unique4
      (HX.Shell.mediums[1].p, HX.Shell.mediums[1].h, HX.Shell.mediums[1].phase, 0);
    HX.Shell.mediums[1].sat.Tsat = Modelica.Media.Water.WaterIF97_ph.saturationTemperature_Unique37
      (HX.Shell.mediums[1].p);
    HX.Shell.mediums[1].sat.psat = HX.Shell.mediums[1].p;
    HX.Shell.mediums[1].u = HX.Shell.mediums[1].h-HX.Shell.mediums[1].p/
      HX.Shell.mediums[1].d;
    HX.Shell.mediums[1].R_s = 8.31446261815324/_GlobalScope.Modelica.Media.Water.WaterIF97_ph.fluidConstants[1]
      .molarMass;
    HX.Shell.mediums[1].h = HX.Shell.mediums[1].state.h;
    HX.Shell.mediums[1].p = HX.Shell.mediums[1].state.p;
    HX.Shell.mediums[1].T = HX.Shell.mediums[1].state.T;
    HX.Shell.mediums[1].d = HX.Shell.mediums[1].state.d;
    HX.Shell.mediums[1].phase = HX.Shell.mediums[1].state.phase;

  // Component HX.Shell
  // class TRANSFORM.Fluid.Pipes.GenericPipe_MultiTransferSurface
    // extends TRANSFORM.Fluid.Pipes.BaseClasses.PartialDistributedVolume
    equation
      assert( not (HX.Shell.energyDynamics <> Modelica.Fluid.Types.Dynamics.
        SteadyState and HX.Shell.massDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) or false, "Bad combination of dynamics options and Medium not conserving mass if fluidVolumes are fixed.");
      for i in (1:HX.Shell.nV) loop
        HX.Shell.ms[i] = HX.Shell.Vs[i]*HX.Shell.mediums[i].d;
        HX.Shell.Us[i] = HX.Shell.ms[i]*HX.Shell.mediums[i].u;
        HX.Shell.mXis[i, :] = HX.Shell.ms[i]*HX.Shell.mediums[i].Xi;
        HX.Shell.mCs[i, :] = HX.Shell.ms[i].*HX.Shell.Cs[i, :];
      end for;
      if (HX.Shell.massDynamics == Modelica.Fluid.Types.Dynamics.SteadyState)
         then 
        for i in (1:HX.Shell.nV) loop
          0 = HX.Shell.mbs[i];
        end for;
      else
        for i in (1:HX.Shell.nV) loop
          der(HX.Shell.ms[i]) = HX.Shell.mbs[i];
        end for;
      end if;
      if (HX.Shell.energyDynamics == Modelica.Fluid.Types.Dynamics.SteadyState)
         then 
        for i in (1:HX.Shell.nV) loop
          0 = HX.Shell.Ubs[i];
        end for;
      else
        for i in (1:HX.Shell.nV) loop
          der(HX.Shell.Us[i]) = HX.Shell.Ubs[i];
        end for;
      end if;
      if (HX.Shell.substanceDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) then 
        for i in (1:HX.Shell.nV) loop
          zeros(0) = HX.Shell.mXibs[i, :];
        end for;
      else
        for i in (1:HX.Shell.nV) loop
          der(HX.Shell.mXis[i, :]) = HX.Shell.mXibs[i, :];
        end for;
      end if;
      if (HX.Shell.traceDynamics == Modelica.Fluid.Types.Dynamics.SteadyState)
         then 
        for i in (1:HX.Shell.nV) loop
          zeros(0) = HX.Shell.mCbs[i, :];
        end for;
      else
        for i in (1:HX.Shell.nV) loop
          der(HX.Shell.mCs_scaled[i, :]) = HX.Shell.mCbs[i, :]./{};
          HX.Shell.mCs[i, :] = HX.Shell.mCs_scaled[i, :].*{};
        end for;
      end if;
    // end of extends 
  equation
    for i in (1:HX.Shell.nV) loop
      HX.Shell.mbs[i] = HX.Shell.m_flows[i]-HX.Shell.m_flows[i+1];
      HX.Shell.Ubs[i] = HX.Shell.Wb_flows[i]+HX.Shell.H_flows[i]-
        HX.Shell.H_flows[i+1]+sum(HX.Shell.heatTransfer.Q_flows[i, :])+
        HX.Shell.internalHeatGen.Q_flows[i]/HX.Shell.nParallel;
      HX.Shell.mXibs[i, :] = HX.Shell.mXi_flows[i, :]-HX.Shell.mXi_flows[i+1, :];
      HX.Shell.mCbs[i, :] = HX.Shell.mC_flows[i, :]-HX.Shell.mC_flows[i+1, :]+
        HX.Shell.mC_flows_traceMassTransferSum[i, :]+HX.Shell.internalTraceGen.mC_flows
        [i, :]/HX.Shell.nParallel;
    end for;
    if ( not HX.Shell.use_HeatTransfer) then 
      for i in (1:HX.Shell.geometry.nSurfaces) loop
        for j in (1:HX.Shell.nV) loop
          HX.Shell.Ts_wall[j, i] = HX.Shell.mediums[j].T;
        end for;
      end for;
    else
      for i in (1:HX.Shell.geometry.nSurfaces) loop
        for j in (1:HX.Shell.nV) loop
          HX.Shell.Ts_wall[j, i] = HX.Shell.heatPorts_int[j, i].T;
        end for;
      end for;
    end if;
    HX.Shell.port_a.m_flow/HX.Shell.nParallel = HX.Shell.m_flows[1];
    HX.Shell.port_b.m_flow/HX.Shell.nParallel =  -HX.Shell.m_flows[HX.Shell.nV+1];
    HX.Shell.port_a.h_outflow = HX.Shell.mediums[1].h;
    HX.Shell.port_b.h_outflow = HX.Shell.mediums[HX.Shell.nV].h;
    HX.Shell.port_a.Xi_outflow = HX.Shell.mediums[1].Xi;
    HX.Shell.port_b.Xi_outflow = HX.Shell.mediums[HX.Shell.nV].Xi;
    HX.Shell.port_a.C_outflow = HX.Shell.Cs[1, :];
    HX.Shell.port_b.C_outflow = HX.Shell.Cs[HX.Shell.nV, :];
    if (HX.Shell.useInnerPortProperties and HX.Shell.nV > 0) then 
      HX.Shell.state_a = Modelica.Media.Water.WaterIF97_ph.setState_phX_Unique1(
        HX.Shell.port_a.p, HX.Shell.mediums[1].h, HX.Shell.mediums[1].Xi, 0, 0);
      HX.Shell.state_b = Modelica.Media.Water.WaterIF97_ph.setState_phX_Unique1(
        HX.Shell.port_b.p, HX.Shell.mediums[HX.Shell.nV].h, HX.Shell.mediums[
        HX.Shell.nV].Xi, 0, 0);
    else
      HX.Shell.state_a = Modelica.Media.Water.WaterIF97_ph.setState_phX_Unique1(
        HX.Shell.port_a.p, inStream(HX.Shell.port_a.h_outflow), inStream(
        HX.Shell.port_a.Xi_outflow), 0, 0);
      HX.Shell.state_b = Modelica.Media.Water.WaterIF97_ph.setState_phX_Unique1(
        HX.Shell.port_b.p, inStream(HX.Shell.port_b.h_outflow), inStream(
        HX.Shell.port_b.Xi_outflow), 0, 0);
    end if;
    HX.Shell.H_flows[1] = semiLinear(HX.Shell.port_a.m_flow, inStream(
      HX.Shell.port_a.h_outflow), HX.Shell.mediums[1].h)/HX.Shell.nParallel;
    HX.Shell.mXi_flows[1, :] = semiLinear(HX.Shell.port_a.m_flow, inStream(
      HX.Shell.port_a.Xi_outflow), HX.Shell.mediums[1].Xi)/HX.Shell.nParallel;
    HX.Shell.mC_flows[1, :] = semiLinear(HX.Shell.port_a.m_flow, inStream(
      HX.Shell.port_a.C_outflow), HX.Shell.Cs[1, :])/HX.Shell.nParallel;
    for i in (2:HX.Shell.nV) loop
      HX.Shell.H_flows[i] = semiLinear(HX.Shell.m_flows[i], HX.Shell.mediums[i-1]
        .h, HX.Shell.mediums[i].h);
      HX.Shell.mXi_flows[i, :] = semiLinear(HX.Shell.m_flows[i], 
        HX.Shell.mediums[i-1].Xi, HX.Shell.mediums[i].Xi);
      HX.Shell.mC_flows[i, :] = semiLinear(HX.Shell.m_flows[i], HX.Shell.Cs[i-1,
         :], HX.Shell.Cs[i, :]);
    end for;
    HX.Shell.H_flows[HX.Shell.nV+1] =  -semiLinear(HX.Shell.port_b.m_flow, 
      inStream(HX.Shell.port_b.h_outflow), HX.Shell.mediums[HX.Shell.nV].h)/
      HX.Shell.nParallel;
    HX.Shell.mXi_flows[HX.Shell.nV+1, :] =  -semiLinear(HX.Shell.port_b.m_flow, 
      inStream(HX.Shell.port_b.Xi_outflow), HX.Shell.mediums[HX.Shell.nV].Xi)/
      HX.Shell.nParallel;
    HX.Shell.mC_flows[HX.Shell.nV+1, :] =  -semiLinear(HX.Shell.port_b.m_flow, 
      inStream(HX.Shell.port_b.C_outflow), HX.Shell.Cs[HX.Shell.nV, :])/
      HX.Shell.nParallel;
    if (HX.Shell.calc_Wb) then 
      if (HX.Shell.nV == 1 or HX.Shell.useLumpedPressure) then 
        HX.Shell.Wb_flows = HX.Shell.geometry.dxs*(HX.Shell.vs*HX.Shell.geometry.dxs
          *(HX.Shell.geometry.crossAreas*HX.Shell.geometry.dxs)*(
          HX.Shell.port_b.p-HX.Shell.port_a.p+sum(HX.Shell.flowModel.dps_fg)-
          HX.Shell.g_n*(HX.Shell.geometry.dheights*HX.Shell.mediums.d)));
      else
        if (HX.Shell.exposeState_a and HX.Shell.exposeState_b or 
          HX.Shell.exposeState_a and  not HX.Shell.exposeState_b) then 
          HX.Shell.Wb_flows[2:HX.Shell.nV-1] = array(HX.Shell.vs[i]*
            HX.Shell.geometry.crossAreas[i]*((HX.Shell.mediums[i+1].p-
            HX.Shell.mediums[i-1].p)/2+(HX.Shell.flowModel.dps_fg[i-1]+
            HX.Shell.flowModel.dps_fg[i])/2-HX.Shell.g_n*HX.Shell.geometry.dheights
            [i]*HX.Shell.mediums[i].d) for i in 2:HX.Shell.nV-1);
        else
          HX.Shell.Wb_flows[2:HX.Shell.nV-1] = array(HX.Shell.vs[i]*
            HX.Shell.geometry.crossAreas[i]*((HX.Shell.mediums[i+1].p-
            HX.Shell.mediums[i-1].p)/2+(HX.Shell.flowModel.dps_fg[i]+
            HX.Shell.flowModel.dps_fg[i+1])/2-HX.Shell.g_n*HX.Shell.geometry.dheights
            [i]*HX.Shell.mediums[i].d) for i in 2:HX.Shell.nV-1);
        end if;
        if (HX.Shell.exposeState_a and HX.Shell.exposeState_b) then 
          HX.Shell.Wb_flows[1] = HX.Shell.vs[1]*HX.Shell.geometry.crossAreas[1]*
            ((HX.Shell.mediums[2].p-HX.Shell.mediums[1].p)/2+HX.Shell.flowModel.dps_fg
            [1]/2-HX.Shell.g_n*HX.Shell.geometry.dheights[1]*HX.Shell.mediums[1]
            .d);
          HX.Shell.Wb_flows[HX.Shell.nV] = HX.Shell.vs[HX.Shell.nV]*
            HX.Shell.geometry.crossAreas[HX.Shell.nV]*((HX.Shell.mediums[
            HX.Shell.nV].p-HX.Shell.mediums[HX.Shell.nV-1].p)/2+HX.Shell.flowModel.dps_fg
            [HX.Shell.nV-1]/2-HX.Shell.g_n*HX.Shell.geometry.dheights[
            HX.Shell.nV]*HX.Shell.mediums[HX.Shell.nV].d);
        elseif (HX.Shell.exposeState_a and  not HX.Shell.exposeState_b) then 
          HX.Shell.Wb_flows[1] = HX.Shell.vs[1]*HX.Shell.geometry.crossAreas[1]*
            ((HX.Shell.mediums[2].p-HX.Shell.mediums[1].p)/2+HX.Shell.flowModel.dps_fg
            [1]/2-HX.Shell.g_n*HX.Shell.geometry.dheights[1]*HX.Shell.mediums[1]
            .d);
          if (HX.Shell.nV == 2) then 
            HX.Shell.Wb_flows[HX.Shell.nV] = HX.Shell.vs[HX.Shell.nV]*
              HX.Shell.geometry.crossAreas[HX.Shell.nV]*((HX.Shell.port_b.p-
              HX.Shell.mediums[HX.Shell.nV-1].p)*5/8+HX.Shell.flowModel.dps_fg[
              HX.Shell.nV-1]/2+HX.Shell.flowModel.dps_fg[HX.Shell.nV]-
              HX.Shell.g_n*HX.Shell.geometry.dheights[HX.Shell.nV]*
              HX.Shell.mediums[HX.Shell.nV].d);
          else
            HX.Shell.Wb_flows[HX.Shell.nV] = HX.Shell.vs[HX.Shell.nV]*
              HX.Shell.geometry.crossAreas[HX.Shell.nV]*((HX.Shell.port_b.p-
              HX.Shell.mediums[HX.Shell.nV-1].p)/1.5+HX.Shell.flowModel.dps_fg[
              HX.Shell.nV-1]/2+HX.Shell.flowModel.dps_fg[HX.Shell.nV]-
              HX.Shell.g_n*HX.Shell.geometry.dheights[HX.Shell.nV]*
              HX.Shell.mediums[HX.Shell.nV].d);
          end if;
        elseif ( not HX.Shell.exposeState_a and HX.Shell.exposeState_b) then 
          if (HX.Shell.nV == 2) then 
            HX.Shell.Wb_flows[1] = HX.Shell.vs[1]*HX.Shell.geometry.crossAreas[1]
              *((HX.Shell.mediums[2].p-HX.Shell.port_a.p)*5/8+HX.Shell.flowModel.dps_fg
              [1]+HX.Shell.flowModel.dps_fg[2]/2-HX.Shell.g_n*HX.Shell.geometry.dheights
              [1]*HX.Shell.mediums[1].d);
          else
            HX.Shell.Wb_flows[1] = HX.Shell.vs[1]*HX.Shell.geometry.crossAreas[1]
              *((HX.Shell.mediums[2].p-HX.Shell.port_a.p)/1.5+HX.Shell.flowModel.dps_fg
              [1]+HX.Shell.flowModel.dps_fg[2]/2-HX.Shell.g_n*HX.Shell.geometry.dheights
              [1]*HX.Shell.mediums[1].d);
          end if;
          HX.Shell.Wb_flows[HX.Shell.nV] = HX.Shell.vs[HX.Shell.nV]*
            HX.Shell.geometry.crossAreas[HX.Shell.nV]*((HX.Shell.mediums[
            HX.Shell.nV].p-HX.Shell.mediums[HX.Shell.nV-1].p)/2+HX.Shell.flowModel.dps_fg
            [HX.Shell.nV]/2-HX.Shell.g_n*HX.Shell.geometry.dheights[HX.Shell.nV]
            *HX.Shell.mediums[HX.Shell.nV].d);
        elseif ( not HX.Shell.exposeState_a and  not HX.Shell.exposeState_b)
           then 
          HX.Shell.Wb_flows[1] = HX.Shell.vs[1]*HX.Shell.geometry.crossAreas[1]*
            ((HX.Shell.mediums[2].p-HX.Shell.port_a.p)/1.5+HX.Shell.flowModel.dps_fg
            [1]+HX.Shell.flowModel.dps_fg[2]/2-HX.Shell.g_n*HX.Shell.geometry.dheights
            [1]*HX.Shell.mediums[1].d);
          HX.Shell.Wb_flows[HX.Shell.nV] = HX.Shell.vs[HX.Shell.nV]*
            HX.Shell.geometry.crossAreas[HX.Shell.nV]*((HX.Shell.port_b.p-
            HX.Shell.mediums[HX.Shell.nV-1].p)/1.5+HX.Shell.flowModel.dps_fg[
            HX.Shell.nV]/2+HX.Shell.flowModel.dps_fg[HX.Shell.nV+1]-HX.Shell.g_n
            *HX.Shell.geometry.dheights[HX.Shell.nV]*HX.Shell.mediums[
            HX.Shell.nV].d);
        else
          assert(false, "Unknown model structure");
        end if;
      end if;
    else
      HX.Shell.Wb_flows = zeros(HX.Shell.nV);
    end if;
    if (HX.Shell.exposeState_a and HX.Shell.exposeState_b) then 
      assert(HX.Shell.nV > 1, "nV must be > 1 if exposeState_a and exposeState_b = true");
    end if;
    if (HX.Shell.useLumpedPressure) then 
      if ( not (HX.Shell.exposeState_a and HX.Shell.exposeState_b)) then 
        if (HX.Shell.lumpPressureAt == TRANSFORM.Fluid.Types.LumpedLocation.
          port_a) then 
          fill(HX.Shell.mediums[1].p, HX.Shell.nV-1) = HX.Shell.mediums[2:
            HX.Shell.nV].p;
        elseif (HX.Shell.lumpPressureAt == TRANSFORM.Fluid.Types.LumpedLocation.
          port_b) then 
          fill(HX.Shell.mediums[HX.Shell.nV].p, HX.Shell.nV-1) = 
            HX.Shell.mediums[1:HX.Shell.nV-1].p;
        else
          assert(false, "Unknown lumped pressure location");
        end if;
      elseif (HX.Shell.nV > 2) then 
        fill(HX.Shell.mediums[1].p, HX.Shell.iLumped-2) = HX.Shell.mediums[2:
          HX.Shell.iLumped-1].p;
        fill(HX.Shell.mediums[HX.Shell.nV].p, HX.Shell.nV-HX.Shell.iLumped) = 
          HX.Shell.mediums[HX.Shell.iLumped:HX.Shell.nV-1].p;
      end if;
      if (HX.Shell.exposeState_a and HX.Shell.exposeState_b) then 
        HX.Shell.m_flows[HX.Shell.iLumped] = HX.Shell.flowModel.m_flows[1];
        HX.Shell.port_a.p = HX.Shell.mediums[1].p;
        HX.Shell.port_b.p = HX.Shell.mediums[HX.Shell.nV].p;
        HX.Shell.statesFM[1] = HX.Shell.mediums[1].state;
        HX.Shell.statesFM[2] = HX.Shell.mediums[HX.Shell.nV].state;
        HX.Shell.vsFM[1] = HX.Shell.vs[1:HX.Shell.iLumped-1]*HX.Shell.geometry.dlengths
          [1:HX.Shell.iLumped-1]/sum(HX.Shell.geometry.dlengths[1:
          HX.Shell.iLumped-1]);
        HX.Shell.vsFM[2] = HX.Shell.vs[HX.Shell.iLumped:HX.Shell.nV]*
          HX.Shell.geometry.dlengths[HX.Shell.iLumped:HX.Shell.nV]/sum(
          HX.Shell.geometry.dlengths[HX.Shell.iLumped:HX.Shell.nV]);
        HX.Shell.Ts_wallFM[1] = sum(HX.Shell.Ts_wall[1, :])/HX.Shell.geometry.nSurfaces;
        HX.Shell.Ts_wallFM[2] = sum(HX.Shell.Ts_wall[HX.Shell.nV, :])/
          HX.Shell.geometry.nSurfaces;
      elseif (HX.Shell.exposeState_a and  not HX.Shell.exposeState_b) then 
        HX.Shell.m_flows[HX.Shell.nV+1] = HX.Shell.flowModel.m_flows[1];
        HX.Shell.port_a.p = HX.Shell.mediums[1].p;
        HX.Shell.statesFM[1] = HX.Shell.mediums[HX.Shell.iLumped].state;
        HX.Shell.statesFM[2] = HX.Shell.state_b;
        HX.Shell.vsFM[1] = HX.Shell.vs*HX.Shell.geometry.dlengths/sum(
          HX.Shell.geometry.dlengths);
        HX.Shell.vsFM[2] = HX.Shell.m_flows[HX.Shell.nV+1]/Modelica.Media.Water.WaterIF97_ph.density_Unique5
          (
          HX.Shell.state_b)/HX.Shell.geometry.crossAreas[HX.Shell.nV];
        HX.Shell.Ts_wallFM[1] = sum(HX.Shell.Ts_wall[HX.Shell.iLumped, :])/
          HX.Shell.geometry.nSurfaces;
        HX.Shell.Ts_wallFM[2] = sum(HX.Shell.Ts_wall[HX.Shell.nV, :])/
          HX.Shell.geometry.nSurfaces;
      elseif ( not HX.Shell.exposeState_a and HX.Shell.exposeState_b) then 
        HX.Shell.m_flows[1] = HX.Shell.flowModel.m_flows[1];
        HX.Shell.port_b.p = HX.Shell.mediums[HX.Shell.nV].p;
        HX.Shell.statesFM[1] = HX.Shell.state_a;
        HX.Shell.statesFM[2] = HX.Shell.mediums[HX.Shell.iLumped].state;
        HX.Shell.vsFM[1] = HX.Shell.m_flows[1]/Modelica.Media.Water.WaterIF97_ph.density_Unique5
          (
          HX.Shell.state_a)/HX.Shell.geometry.crossAreas[1];
        HX.Shell.vsFM[2] = HX.Shell.vs*HX.Shell.geometry.dlengths/sum(
          HX.Shell.geometry.dlengths);
        HX.Shell.Ts_wallFM[1] = sum(HX.Shell.Ts_wall[1, :])/HX.Shell.geometry.nSurfaces;
        HX.Shell.Ts_wallFM[2] = sum(HX.Shell.Ts_wall[HX.Shell.iLumped, :])/
          HX.Shell.geometry.nSurfaces;
      elseif ( not HX.Shell.exposeState_a and  not HX.Shell.exposeState_b) then 
        HX.Shell.m_flows[1] = HX.Shell.flowModel.m_flows[1];
        HX.Shell.m_flows[HX.Shell.nV+1] = HX.Shell.flowModel.m_flows[2];
        HX.Shell.statesFM[1] = HX.Shell.state_a;
        HX.Shell.statesFM[2] = HX.Shell.mediums[HX.Shell.iLumped].state;
        HX.Shell.statesFM[3] = HX.Shell.state_b;
        HX.Shell.vsFM[1] = HX.Shell.m_flows[1]/Modelica.Media.Water.WaterIF97_ph.density_Unique5
          (
          HX.Shell.state_a)/HX.Shell.geometry.crossAreas[1];
        HX.Shell.vsFM[2] = HX.Shell.vs*HX.Shell.geometry.dlengths/sum(
          HX.Shell.geometry.dlengths);
        HX.Shell.vsFM[3] = HX.Shell.m_flows[HX.Shell.nV+1]/Modelica.Media.Water.WaterIF97_ph.density_Unique5
          (
          HX.Shell.state_b)/HX.Shell.geometry.crossAreas[HX.Shell.nV];
        HX.Shell.Ts_wallFM[1] = sum(HX.Shell.Ts_wall[1, :])/HX.Shell.geometry.nSurfaces;
        HX.Shell.Ts_wallFM[2] = sum(HX.Shell.Ts_wall[HX.Shell.iLumped, :])/
          HX.Shell.geometry.nSurfaces;
        HX.Shell.Ts_wallFM[3] = sum(HX.Shell.Ts_wall[HX.Shell.nV, :])/
          HX.Shell.geometry.nSurfaces;
      else
        assert(false, "Unknown model structure");
      end if;
      if ( not ( not HX.Shell.exposeState_a and  not HX.Shell.exposeState_b))
         then 
        HX.Shell.dlengthsFM[1] = sum(HX.Shell.geometry.dlengths);
        HX.Shell.dheightsFM[1] = sum(HX.Shell.geometry.dheights);
        if (HX.Shell.nV == 1) then 
          HX.Shell.dimensionsFM[1:2] = {HX.Shell.geometry.dimensions[1], 
            HX.Shell.geometry.dimensions[1]};
          HX.Shell.crossAreasFM[1:2] = {HX.Shell.geometry.crossAreas[1], 
            HX.Shell.geometry.crossAreas[1]};
          HX.Shell.perimetersFM[1:2] = {HX.Shell.geometry.perimeters[1], 
            HX.Shell.geometry.perimeters[1]};
          HX.Shell.roughnessesFM[1:2] = {HX.Shell.geometry.roughnesses[1], 
            HX.Shell.geometry.roughnesses[1]};
        else
          HX.Shell.dimensionsFM[1:2] = {sum(HX.Shell.geometry.dimensions[1:
            HX.Shell.iLumped-1])/(HX.Shell.iLumped-1), sum(HX.Shell.geometry.dimensions
            [HX.Shell.iLumped:HX.Shell.nV])/(HX.Shell.nV-HX.Shell.iLumped+1)};
          HX.Shell.crossAreasFM[1:2] = {sum(HX.Shell.geometry.crossAreas[1:
            HX.Shell.iLumped-1])/(HX.Shell.iLumped-1), sum(HX.Shell.geometry.crossAreas
            [HX.Shell.iLumped:HX.Shell.nV])/(HX.Shell.nV-HX.Shell.iLumped+1)};
          HX.Shell.perimetersFM[1:2] = {sum(HX.Shell.geometry.perimeters[1:
            HX.Shell.iLumped-1])/(HX.Shell.iLumped-1), sum(HX.Shell.geometry.perimeters
            [HX.Shell.iLumped:HX.Shell.nV])/(HX.Shell.nV-HX.Shell.iLumped+1)};
          HX.Shell.roughnessesFM[1:2] = {sum(HX.Shell.geometry.roughnesses[1:
            HX.Shell.iLumped-1])/(HX.Shell.iLumped-1), sum(HX.Shell.geometry.roughnesses
            [HX.Shell.iLumped:HX.Shell.nV])/(HX.Shell.nV-HX.Shell.iLumped+1)};
        end if;
      else
        if (HX.Shell.nV == 1) then 
          HX.Shell.dlengthsFM[1:2] = {HX.Shell.geometry.dlengths[1]/2, 
            HX.Shell.geometry.dlengths[1]/2};
          HX.Shell.dheightsFM[1:2] = {HX.Shell.geometry.dheights[1]/2, 
            HX.Shell.geometry.dheights[1]/2};
          HX.Shell.dimensionsFM[1:3] = {HX.Shell.geometry.dimensions[1], 
            HX.Shell.geometry.dimensions[1], HX.Shell.geometry.dimensions[1]};
          HX.Shell.crossAreasFM[1:3] = {HX.Shell.geometry.crossAreas[1], 
            HX.Shell.geometry.crossAreas[1], HX.Shell.geometry.crossAreas[1]};
          HX.Shell.perimetersFM[1:3] = {HX.Shell.geometry.perimeters[1], 
            HX.Shell.geometry.perimeters[1], HX.Shell.geometry.perimeters[1]};
          HX.Shell.roughnessesFM[1:3] = {HX.Shell.geometry.roughnesses[1], 
            HX.Shell.geometry.roughnesses[1], HX.Shell.geometry.roughnesses[1]};
        else
          HX.Shell.dlengthsFM[1:2] = {sum(HX.Shell.geometry.dlengths[1:
            HX.Shell.iLumped-1]), sum(HX.Shell.geometry.dlengths[
            HX.Shell.iLumped:HX.Shell.nV])};
          HX.Shell.dheightsFM[1:2] = {sum(HX.Shell.geometry.dheights[1:
            HX.Shell.iLumped-1]), sum(HX.Shell.geometry.dheights[
            HX.Shell.iLumped:HX.Shell.nV])};
          HX.Shell.dimensionsFM[1:3] = {sum(HX.Shell.geometry.dimensions[1:
            HX.Shell.iLumped-1])/(HX.Shell.iLumped-1), sum(HX.Shell.geometry.dimensions)
            /HX.Shell.nV, sum(HX.Shell.geometry.dimensions[HX.Shell.iLumped:
            HX.Shell.nV])/(HX.Shell.nV-HX.Shell.iLumped+1)};
          HX.Shell.crossAreasFM[1:3] = {sum(HX.Shell.geometry.crossAreas[1:
            HX.Shell.iLumped-1])/(HX.Shell.iLumped-1), sum(HX.Shell.geometry.crossAreas)
            /HX.Shell.nV, sum(HX.Shell.geometry.crossAreas[HX.Shell.iLumped:
            HX.Shell.nV])/(HX.Shell.nV-HX.Shell.iLumped+1)};
          HX.Shell.perimetersFM[1:3] = {sum(HX.Shell.geometry.perimeters[1:
            HX.Shell.iLumped-1])/(HX.Shell.iLumped-1), sum(HX.Shell.geometry.perimeters)
            /HX.Shell.nV, sum(HX.Shell.geometry.perimeters[HX.Shell.iLumped:
            HX.Shell.nV])/(HX.Shell.nV-HX.Shell.iLumped+1)};
          HX.Shell.roughnessesFM[1:3] = {sum(HX.Shell.geometry.roughnesses[1:
            HX.Shell.iLumped-1])/(HX.Shell.iLumped-1), sum(HX.Shell.geometry.roughnesses)
            /HX.Shell.nV, sum(HX.Shell.geometry.roughnesses[HX.Shell.iLumped:
            HX.Shell.nV])/(HX.Shell.nV-HX.Shell.iLumped+1)};
        end if;
      end if;
    else
      if (HX.Shell.exposeState_a and HX.Shell.exposeState_b) then 
        HX.Shell.m_flows[2:HX.Shell.nV] = HX.Shell.flowModel.m_flows[1:
          HX.Shell.nV-1];
        HX.Shell.port_a.p = HX.Shell.mediums[1].p;
        HX.Shell.port_b.p = HX.Shell.mediums[HX.Shell.nV].p;
        for i in (1:HX.Shell.nFM+1) loop
          HX.Shell.statesFM[i] = HX.Shell.mediums[i].state;
          HX.Shell.vsFM[i] = HX.Shell.vs[i];
          HX.Shell.Ts_wallFM[i] = sum(HX.Shell.Ts_wall[i, :])/HX.Shell.geometry.nSurfaces;
        end for;
        for i in (1:HX.Shell.nFM+1) loop
          HX.Shell.crossAreasFM[i] = HX.Shell.geometry.crossAreas[i];
          HX.Shell.dimensionsFM[i] = HX.Shell.geometry.dimensions[i];
          HX.Shell.perimetersFM[i] = HX.Shell.geometry.perimeters[i];
          HX.Shell.roughnessesFM[i] = HX.Shell.geometry.roughnesses[i];
        end for;
        if (HX.Shell.nFM == 1) then 
          HX.Shell.dlengthsFM[1] = HX.Shell.geometry.dlengths[1]+
            HX.Shell.geometry.dlengths[2];
          HX.Shell.dheightsFM[1] = HX.Shell.geometry.dheights[1]+
            HX.Shell.geometry.dheights[2];
        else
          HX.Shell.dlengthsFM[1] = HX.Shell.geometry.dlengths[1]+0.5*
            HX.Shell.geometry.dlengths[2];
          HX.Shell.dheightsFM[1] = HX.Shell.geometry.dheights[1]+0.5*
            HX.Shell.geometry.dheights[2];
          for i in (2:HX.Shell.nFM-1) loop
            HX.Shell.dlengthsFM[i] = 0.5*(HX.Shell.geometry.dlengths[i]+
              HX.Shell.geometry.dlengths[i+1]);
            HX.Shell.dheightsFM[i] = 0.5*(HX.Shell.geometry.dheights[i]+
              HX.Shell.geometry.dheights[i+1]);
          end for;
          HX.Shell.dlengthsFM[HX.Shell.nFM] = 0.5*HX.Shell.geometry.dlengths[
            HX.Shell.nFM]+HX.Shell.geometry.dlengths[HX.Shell.nFM+1];
          HX.Shell.dheightsFM[HX.Shell.nFM] = 0.5*HX.Shell.geometry.dheights[
            HX.Shell.nFM]+HX.Shell.geometry.dheights[HX.Shell.nFM+1];
        end if;
      elseif (HX.Shell.exposeState_a and  not HX.Shell.exposeState_b) then 
        HX.Shell.m_flows[2:HX.Shell.nV+1] = HX.Shell.flowModel.m_flows[1:
          HX.Shell.nV];
        HX.Shell.port_a.p = HX.Shell.mediums[1].p;
        for i in (1:HX.Shell.nFM) loop
          HX.Shell.statesFM[i] = HX.Shell.mediums[i].state;
          HX.Shell.vsFM[i] = HX.Shell.vs[i];
          HX.Shell.Ts_wallFM[i] = sum(HX.Shell.Ts_wall[i, :])/HX.Shell.geometry.nSurfaces;
        end for;
        HX.Shell.statesFM[HX.Shell.nFM+1] = HX.Shell.state_b;
        HX.Shell.vsFM[HX.Shell.nFM+1] = HX.Shell.m_flows[HX.Shell.nFM+1]/
          Modelica.Media.Water.WaterIF97_ph.density_Unique5(
          HX.Shell.state_b)/HX.Shell.geometry.crossAreas[HX.Shell.nV];
        HX.Shell.Ts_wallFM[HX.Shell.nFM+1] = sum(HX.Shell.Ts_wall[HX.Shell.nV, :])
          /HX.Shell.geometry.nSurfaces;
        for i in (1:HX.Shell.nFM) loop
          HX.Shell.crossAreasFM[i] = HX.Shell.geometry.crossAreas[i];
          HX.Shell.dimensionsFM[i] = HX.Shell.geometry.dimensions[i];
          HX.Shell.perimetersFM[i] = HX.Shell.geometry.perimeters[i];
          HX.Shell.roughnessesFM[i] = HX.Shell.geometry.roughnesses[i];
        end for;
        HX.Shell.crossAreasFM[HX.Shell.nFM+1] = HX.Shell.geometry.crossAreas[
          HX.Shell.nV];
        HX.Shell.dimensionsFM[HX.Shell.nFM+1] = HX.Shell.geometry.dimensions[
          HX.Shell.nV];
        HX.Shell.perimetersFM[HX.Shell.nFM+1] = HX.Shell.geometry.perimeters[
          HX.Shell.nV];
        HX.Shell.roughnessesFM[HX.Shell.nFM+1] = HX.Shell.geometry.roughnesses[
          HX.Shell.nV];
        if (HX.Shell.nFM == 1) then 
          HX.Shell.dlengthsFM[1] = HX.Shell.geometry.dlengths[1];
          HX.Shell.dheightsFM[1] = HX.Shell.geometry.dheights[1];
        else
          HX.Shell.dlengthsFM[1] = HX.Shell.geometry.dlengths[1]+0.5*
            HX.Shell.geometry.dlengths[2];
          HX.Shell.dheightsFM[1] = HX.Shell.geometry.dheights[1]+0.5*
            HX.Shell.geometry.dheights[2];
          for i in (2:HX.Shell.nFM-1) loop
            HX.Shell.dlengthsFM[i] = 0.5*(HX.Shell.geometry.dlengths[i]+
              HX.Shell.geometry.dlengths[i+1]);
            HX.Shell.dheightsFM[i] = 0.5*(HX.Shell.geometry.dheights[i]+
              HX.Shell.geometry.dheights[i+1]);
          end for;
          HX.Shell.dlengthsFM[HX.Shell.nFM] = 0.5*HX.Shell.geometry.dlengths[
            HX.Shell.nFM];
          HX.Shell.dheightsFM[HX.Shell.nFM] = 0.5*HX.Shell.geometry.dheights[
            HX.Shell.nFM];
        end if;
      elseif ( not HX.Shell.exposeState_a and HX.Shell.exposeState_b) then 
        HX.Shell.m_flows[1:HX.Shell.nV] = HX.Shell.flowModel.m_flows[1:
          HX.Shell.nV];
        HX.Shell.port_b.p = HX.Shell.mediums[HX.Shell.nV].p;
        HX.Shell.statesFM[1] = HX.Shell.state_a;
        HX.Shell.vsFM[1] = HX.Shell.m_flows[1]/Modelica.Media.Water.WaterIF97_ph.density_Unique5
          (
          HX.Shell.state_a)/HX.Shell.geometry.crossAreas[1];
        HX.Shell.Ts_wallFM[1] = sum(HX.Shell.Ts_wall[1, :])/HX.Shell.geometry.nSurfaces;
        for i in (2:HX.Shell.nFM+1) loop
          HX.Shell.statesFM[i] = HX.Shell.mediums[i-1].state;
          HX.Shell.vsFM[i] = HX.Shell.vs[i-1];
          HX.Shell.Ts_wallFM[i] = sum(HX.Shell.Ts_wall[i-1, :])/HX.Shell.geometry.nSurfaces;
        end for;
        HX.Shell.crossAreasFM[1] = HX.Shell.geometry.crossAreas[1];
        HX.Shell.dimensionsFM[1] = HX.Shell.geometry.dimensions[1];
        HX.Shell.perimetersFM[1] = HX.Shell.geometry.perimeters[1];
        HX.Shell.roughnessesFM[1] = HX.Shell.geometry.roughnesses[1];
        for i in (2:HX.Shell.nFM+1) loop
          HX.Shell.crossAreasFM[i] = HX.Shell.geometry.crossAreas[i-1];
          HX.Shell.dimensionsFM[i] = HX.Shell.geometry.dimensions[i-1];
          HX.Shell.perimetersFM[i] = HX.Shell.geometry.perimeters[i-1];
          HX.Shell.roughnessesFM[i] = HX.Shell.geometry.roughnesses[i-1];
        end for;
        if (HX.Shell.nFM == 1) then 
          HX.Shell.dlengthsFM[1] = HX.Shell.geometry.dlengths[1];
          HX.Shell.dheightsFM[1] = HX.Shell.geometry.dheights[1];
        else
          HX.Shell.dlengthsFM[1] = 0.5*HX.Shell.geometry.dlengths[1];
          HX.Shell.dheightsFM[1] = 0.5*HX.Shell.geometry.dheights[1];
          for i in (2:HX.Shell.nFM-1) loop
            HX.Shell.dlengthsFM[i] = 0.5*(HX.Shell.geometry.dlengths[i-1]+
              HX.Shell.geometry.dlengths[i]);
            HX.Shell.dheightsFM[i] = 0.5*(HX.Shell.geometry.dheights[i-1]+
              HX.Shell.geometry.dheights[i]);
          end for;
          HX.Shell.dlengthsFM[HX.Shell.nFM] = 0.5*HX.Shell.geometry.dlengths[
            HX.Shell.nFM-1]+HX.Shell.geometry.dlengths[HX.Shell.nFM];
          HX.Shell.dheightsFM[HX.Shell.nFM] = 0.5*HX.Shell.geometry.dheights[
            HX.Shell.nFM-1]+HX.Shell.geometry.dheights[HX.Shell.nFM];
        end if;
      elseif ( not HX.Shell.exposeState_a and  not HX.Shell.exposeState_b) then 
        HX.Shell.m_flows[1:HX.Shell.nV+1] = HX.Shell.flowModel.m_flows[1:
          HX.Shell.nV+1];
        HX.Shell.statesFM[1] = HX.Shell.state_a;
        HX.Shell.vsFM[1] = HX.Shell.m_flows[1]/Modelica.Media.Water.WaterIF97_ph.density_Unique5
          (
          HX.Shell.state_a)/HX.Shell.geometry.crossAreas[1];
        HX.Shell.Ts_wallFM[1] = sum(HX.Shell.Ts_wall[1, :])/HX.Shell.geometry.nSurfaces;
        for i in (2:HX.Shell.nFM) loop
          HX.Shell.statesFM[i] = HX.Shell.mediums[i-1].state;
          HX.Shell.vsFM[i] = HX.Shell.vs[i-1];
          HX.Shell.Ts_wallFM[i] = sum(HX.Shell.Ts_wall[i-1, :])/HX.Shell.geometry.nSurfaces;
        end for;
        HX.Shell.statesFM[HX.Shell.nFM+1] = HX.Shell.state_b;
        HX.Shell.vsFM[HX.Shell.nFM+1] = HX.Shell.m_flows[HX.Shell.nFM]/
          Modelica.Media.Water.WaterIF97_ph.density_Unique5(
          HX.Shell.state_b)/HX.Shell.geometry.crossAreas[HX.Shell.nV];
        HX.Shell.Ts_wallFM[HX.Shell.nFM+1] = sum(HX.Shell.Ts_wall[HX.Shell.nV, :])
          /HX.Shell.geometry.nSurfaces;
        HX.Shell.crossAreasFM[1] = HX.Shell.geometry.crossAreas[1];
        HX.Shell.dimensionsFM[1] = HX.Shell.geometry.dimensions[1];
        HX.Shell.perimetersFM[1] = HX.Shell.geometry.perimeters[1];
        HX.Shell.roughnessesFM[1] = HX.Shell.geometry.roughnesses[1];
        for i in (2:HX.Shell.nFM) loop
          HX.Shell.crossAreasFM[i] = HX.Shell.geometry.crossAreas[i-1];
          HX.Shell.dimensionsFM[i] = HX.Shell.geometry.dimensions[i-1];
          HX.Shell.perimetersFM[i] = HX.Shell.geometry.perimeters[i-1];
          HX.Shell.roughnessesFM[i] = HX.Shell.geometry.roughnesses[i-1];
        end for;
        HX.Shell.crossAreasFM[HX.Shell.nFM+1] = HX.Shell.geometry.crossAreas[
          HX.Shell.nV];
        HX.Shell.dimensionsFM[HX.Shell.nFM+1] = HX.Shell.geometry.dimensions[
          HX.Shell.nV];
        HX.Shell.perimetersFM[HX.Shell.nFM+1] = HX.Shell.geometry.perimeters[
          HX.Shell.nV];
        HX.Shell.roughnessesFM[HX.Shell.nFM+1] = HX.Shell.geometry.roughnesses[
          HX.Shell.nV];
        HX.Shell.dlengthsFM[1] = 0.5*HX.Shell.geometry.dlengths[1];
        HX.Shell.dheightsFM[1] = 0.5*HX.Shell.geometry.dheights[1];
        for i in (2:HX.Shell.nFM-1) loop
          HX.Shell.dlengthsFM[i] = 0.5*(HX.Shell.geometry.dlengths[i-1]+
            HX.Shell.geometry.dlengths[i]);
          HX.Shell.dheightsFM[i] = 0.5*(HX.Shell.geometry.dheights[i-1]+
            HX.Shell.geometry.dheights[i]);
        end for;
        HX.Shell.dlengthsFM[HX.Shell.nFM] = 0.5*HX.Shell.geometry.dlengths[
          HX.Shell.nFM-1];
        HX.Shell.dheightsFM[HX.Shell.nFM] = 0.5*HX.Shell.geometry.dheights[
          HX.Shell.nFM-1];
      else
        assert(false, "Unknown model structure");
      end if;
    end if;
    HX.Shell.heatPorts[1, 1].Q_flow+HX.Shell.heatPorts_int[1, 1].Q_flow-
      HX.Shell.heatTransfer.heatPorts[1, 1].Q_flow = 0.0;
    HX.Shell.heatPorts_int[1, 1].T = HX.Shell.heatPorts[1, 1].T;
    HX.Shell.heatTransfer.heatPorts[1, 1].T = HX.Shell.heatPorts[1, 1].T;
     -HX.Shell.traceMassTransfer.massPorts[1, 1].n_flow = 0.0*HX.Shell.traceMassTransfer.massPorts[1, 1].n_flow;

  // Component HX.HXPipe.flowModel
  // class Modelica.Fluid.Pipes.BaseClasses.PartialStraightPipe.FlowModel
    // extends Modelica.Fluid.Interfaces.PartialDistributedFlow
    equation
      HX.HXPipe.flowModel.Is = array(HX.HXPipe.flowModel.m_flows[i]*
        HX.HXPipe.flowModel.pathLengths[i] for i in 1:HX.HXPipe.flowModel.m);
      if (HX.HXPipe.flowModel.momentumDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) then 
        zeros(HX.HXPipe.flowModel.m) = HX.HXPipe.flowModel.Ib_flows-
          HX.HXPipe.flowModel.Fs_p-HX.HXPipe.flowModel.Fs_fg;
      else
        der(HX.HXPipe.flowModel.Is) = HX.HXPipe.flowModel.Ib_flows-
          HX.HXPipe.flowModel.Fs_p-HX.HXPipe.flowModel.Fs_fg;
      end if;
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialStaggeredFlowModel
    equation
      if ( not HX.HXPipe.flowModel.allowFlowReversal) then 
        HX.HXPipe.flowModel.rhos_act = HX.HXPipe.flowModel.rhos[1:
          HX.HXPipe.flowModel.n-1];
        HX.HXPipe.flowModel.mus_act = HX.HXPipe.flowModel.mus[1:HX.HXPipe.flowModel.n
          -1];
      elseif ( not HX.HXPipe.flowModel.useUpstreamScheme) then 
        HX.HXPipe.flowModel.rhos_act = 0.5*(HX.HXPipe.flowModel.rhos[1:
          HX.HXPipe.flowModel.n-1]+HX.HXPipe.flowModel.rhos[2:HX.HXPipe.flowModel.n]);
        HX.HXPipe.flowModel.mus_act = 0.5*(HX.HXPipe.flowModel.mus[1:
          HX.HXPipe.flowModel.n-1]+HX.HXPipe.flowModel.mus[2:HX.HXPipe.flowModel.n]);
      else
        for i in (1:HX.HXPipe.flowModel.n-1) loop
          HX.HXPipe.flowModel.rhos_act[i] = noEvent((if HX.HXPipe.flowModel.m_flows
            [i] > 0 then HX.HXPipe.flowModel.rhos[i] else HX.HXPipe.flowModel.rhos
            [i+1]));
          HX.HXPipe.flowModel.mus_act[i] = noEvent((if HX.HXPipe.flowModel.m_flows
            [i] > 0 then HX.HXPipe.flowModel.mus[i] else HX.HXPipe.flowModel.mus
            [i+1]));
        end for;
      end if;
      if (HX.HXPipe.flowModel.use_Ib_flows) then 
        HX.HXPipe.flowModel.Ib_flows = HX.HXPipe.flowModel.nParallel*(array(
          HX.HXPipe.flowModel.rhos[i]*HX.HXPipe.flowModel.vs[i]*HX.HXPipe.flowModel.vs
          [i]*HX.HXPipe.flowModel.crossAreas[i]-HX.HXPipe.flowModel.rhos[i+1]*
          HX.HXPipe.flowModel.vs[i+1]*HX.HXPipe.flowModel.vs[i+1]*
          HX.HXPipe.flowModel.crossAreas[i+1] for i in 1:HX.HXPipe.flowModel.n-1));
      else
        HX.HXPipe.flowModel.Ib_flows = zeros(HX.HXPipe.flowModel.n-1);
      end if;
      HX.HXPipe.flowModel.Fs_p = HX.HXPipe.flowModel.nParallel*(array(0.5*(
        HX.HXPipe.flowModel.crossAreas[i]+HX.HXPipe.flowModel.crossAreas[i+1])*(
        Modelica.Media.Water.WaterIF97_ph.pressure_Unique11(
        HX.HXPipe.flowModel.states[i+1])-Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
        (
        HX.HXPipe.flowModel.states[i])) for i in 1:HX.HXPipe.flowModel.n-1));
      HX.HXPipe.flowModel.dps_fg = array(HX.HXPipe.flowModel.Fs_fg[i]/
        HX.HXPipe.flowModel.nParallel*2/(HX.HXPipe.flowModel.crossAreas[i]+
        HX.HXPipe.flowModel.crossAreas[i+1]) for i in 1:HX.HXPipe.flowModel.n-1);
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialGenericPipeFlow
    equation
      for i in (1:HX.HXPipe.flowModel.n-1) loop
        assert(HX.HXPipe.flowModel.m_flows[i] >  -HX.HXPipe.flowModel.m_flow_small
           or HX.HXPipe.flowModel.allowFlowReversal, "Reversing flow occurs even though allowFlowReversal is false");
      end for;
      if (HX.HXPipe.flowModel.continuousFlowReversal) then 
        if (HX.HXPipe.flowModel.from_dp and true) then 
          HX.HXPipe.flowModel.m_flows = homotopy(massFlowRate_dp_Unique14(
            HX.HXPipe.flowModel.dps_fg-(array(HX.HXPipe.flowModel.g*
            HX.HXPipe.flowModel.dheights[i]*HX.HXPipe.flowModel.rhos_act[i] for 
            i in 1:HX.HXPipe.flowModel.n-1)), HX.HXPipe.flowModel.rhos_act, 
            HX.HXPipe.flowModel.rhos_act, HX.HXPipe.flowModel.mus_act, 
            HX.HXPipe.flowModel.mus_act, HX.HXPipe.flowModel.pathLengths_internal,
             HX.HXPipe.flowModel.diameters, (HX.HXPipe.flowModel.crossAreas[1:
            HX.HXPipe.flowModel.n-1]+HX.HXPipe.flowModel.crossAreas[2:
            HX.HXPipe.flowModel.n])/2, (HX.HXPipe.flowModel.roughnesses[1:
            HX.HXPipe.flowModel.n-1]+HX.HXPipe.flowModel.roughnesses[2:
            HX.HXPipe.flowModel.n])/2, HX.HXPipe.flowModel.dp_small/(
            HX.HXPipe.flowModel.n-1), HX.HXPipe.flowModel.Res_turbulent_internal)
            *HX.HXPipe.flowModel.nParallel, HX.HXPipe.flowModel.m_flow_nominal/
            HX.HXPipe.flowModel.dp_nominal*(HX.HXPipe.flowModel.dps_fg-
            HX.HXPipe.flowModel.g*HX.HXPipe.flowModel.dheights*HX.HXPipe.flowModel.rho_nominal));
        else
          HX.HXPipe.flowModel.dps_fg = homotopy(pressureLoss_m_flow_Unique12(
            HX.HXPipe.flowModel.m_flows/HX.HXPipe.flowModel.nParallel, 
            HX.HXPipe.flowModel.rhos_act, HX.HXPipe.flowModel.rhos_act, 
            HX.HXPipe.flowModel.mus_act, HX.HXPipe.flowModel.mus_act, 
            HX.HXPipe.flowModel.pathLengths_internal, HX.HXPipe.flowModel.diameters,
             (HX.HXPipe.flowModel.crossAreas[1:HX.HXPipe.flowModel.n-1]+
            HX.HXPipe.flowModel.crossAreas[2:HX.HXPipe.flowModel.n])/2, (
            HX.HXPipe.flowModel.roughnesses[1:HX.HXPipe.flowModel.n-1]+
            HX.HXPipe.flowModel.roughnesses[2:HX.HXPipe.flowModel.n])/2, 
            HX.HXPipe.flowModel.m_flow_small/HX.HXPipe.flowModel.nParallel, 
            HX.HXPipe.flowModel.Res_turbulent_internal)+(array(HX.HXPipe.flowModel.g
            *HX.HXPipe.flowModel.dheights[i]*HX.HXPipe.flowModel.rhos_act[i]
             for i in 1:HX.HXPipe.flowModel.n-1)), HX.HXPipe.flowModel.dp_nominal
            /HX.HXPipe.flowModel.m_flow_nominal*HX.HXPipe.flowModel.m_flows+
            HX.HXPipe.flowModel.g*HX.HXPipe.flowModel.dheights*HX.HXPipe.flowModel.rho_nominal);
        end if;
      else
        if (HX.HXPipe.flowModel.from_dp and true) then 
          HX.HXPipe.flowModel.m_flows = homotopy(massFlowRate_dp_staticHead_Unique16
            (HX.HXPipe.flowModel.dps_fg, HX.HXPipe.flowModel.rhos[1:
            HX.HXPipe.flowModel.n-1], HX.HXPipe.flowModel.rhos[2:
            HX.HXPipe.flowModel.n], HX.HXPipe.flowModel.mus[1:HX.HXPipe.flowModel.n
            -1], HX.HXPipe.flowModel.mus[2:HX.HXPipe.flowModel.n], 
            HX.HXPipe.flowModel.pathLengths_internal, HX.HXPipe.flowModel.diameters,
             HX.HXPipe.flowModel.g*HX.HXPipe.flowModel.dheights, (
            HX.HXPipe.flowModel.crossAreas[1:HX.HXPipe.flowModel.n-1]+
            HX.HXPipe.flowModel.crossAreas[2:HX.HXPipe.flowModel.n])/2, (
            HX.HXPipe.flowModel.roughnesses[1:HX.HXPipe.flowModel.n-1]+
            HX.HXPipe.flowModel.roughnesses[2:HX.HXPipe.flowModel.n])/2, 
            HX.HXPipe.flowModel.dp_small/(HX.HXPipe.flowModel.n-1), 
            HX.HXPipe.flowModel.Res_turbulent_internal)*HX.HXPipe.flowModel.nParallel,
             HX.HXPipe.flowModel.m_flow_nominal/HX.HXPipe.flowModel.dp_nominal*(
            HX.HXPipe.flowModel.dps_fg-HX.HXPipe.flowModel.g*HX.HXPipe.flowModel.dheights
            *HX.HXPipe.flowModel.rho_nominal));
        else
          HX.HXPipe.flowModel.dps_fg = homotopy(pressureLoss_m_flow_staticHead_Unique17
            (HX.HXPipe.flowModel.m_flows/HX.HXPipe.flowModel.nParallel, 
            HX.HXPipe.flowModel.rhos[1:HX.HXPipe.flowModel.n-1], 
            HX.HXPipe.flowModel.rhos[2:HX.HXPipe.flowModel.n], HX.HXPipe.flowModel.mus
            [1:HX.HXPipe.flowModel.n-1], HX.HXPipe.flowModel.mus[2:
            HX.HXPipe.flowModel.n], HX.HXPipe.flowModel.pathLengths_internal, 
            HX.HXPipe.flowModel.diameters, HX.HXPipe.flowModel.g*
            HX.HXPipe.flowModel.dheights, (HX.HXPipe.flowModel.crossAreas[1:
            HX.HXPipe.flowModel.n-1]+HX.HXPipe.flowModel.crossAreas[2:
            HX.HXPipe.flowModel.n])/2, (HX.HXPipe.flowModel.roughnesses[1:
            HX.HXPipe.flowModel.n-1]+HX.HXPipe.flowModel.roughnesses[2:
            HX.HXPipe.flowModel.n])/2, HX.HXPipe.flowModel.m_flow_small/
            HX.HXPipe.flowModel.nParallel, HX.HXPipe.flowModel.Res_turbulent_internal),
             HX.HXPipe.flowModel.dp_nominal/HX.HXPipe.flowModel.m_flow_nominal*
            HX.HXPipe.flowModel.m_flows+HX.HXPipe.flowModel.g*HX.HXPipe.flowModel.dheights
            *HX.HXPipe.flowModel.rho_nominal);
        end if;
      end if;
    // end of extends 

  // Component HX.HXPipe
  // class Modelica.Fluid.Pipes.StaticPipe
    // extends Modelica.Fluid.Pipes.BaseClasses.PartialStraightPipe
    equation
      assert(HX.HXPipe.length >= HX.HXPipe.height_ab, "Parameter length must be greater or equal height_ab.");
    // end of extends 
  equation
    HX.HXPipe.port_a.m_flow = HX.HXPipe.flowModel.m_flows[1];
    0 = HX.HXPipe.port_a.m_flow+HX.HXPipe.port_b.m_flow;
    HX.HXPipe.port_a.Xi_outflow = inStream(HX.HXPipe.port_b.Xi_outflow);
    HX.HXPipe.port_b.Xi_outflow = inStream(HX.HXPipe.port_a.Xi_outflow);
    HX.HXPipe.port_a.C_outflow = inStream(HX.HXPipe.port_b.C_outflow);
    HX.HXPipe.port_b.C_outflow = inStream(HX.HXPipe.port_a.C_outflow);
    HX.HXPipe.port_b.h_outflow = inStream(HX.HXPipe.port_a.h_outflow)-
      HX.HXPipe.system.g*HX.HXPipe.height_ab;
    HX.HXPipe.port_a.h_outflow = inStream(HX.HXPipe.port_b.h_outflow)+
      HX.HXPipe.system.g*HX.HXPipe.height_ab;

  // Component HX.cylinder
  // class TRANSFORM.HeatAndMassTransfer.Resistances.Heat.Cylinder
    // extends TRANSFORM.HeatAndMassTransfer.Resistances.Heat.BaseClasses.PartialResistance
    equation
      HX.cylinder.port_a.Q_flow+HX.cylinder.port_b.Q_flow = 0;
      HX.cylinder.port_a.Q_flow = (HX.cylinder.port_a.T-HX.cylinder.port_b.T)/
        HX.cylinder.R;
    // end of extends 
  equation
    HX.cylinder.R = (if HX.cylinder.r_in > 0 then log(HX.cylinder.r_out/
      HX.cylinder.r_in)/(6.283185307179586*HX.cylinder.L*HX.cylinder.lambda)
       else 1/(12.566370614359172*HX.cylinder.L*HX.cylinder.lambda));

  // Component HX.Tube.geometry
  // class INL_DT.Components.HX_Isolated.Geometry
    // extends TRANSFORM.Fluid.ClosureRelations.Geometry.Models.DistributedVolume_1D.GenericPipe
    equation
      for i in (1:HX.Tube.geometry.nV) loop
        assert(HX.Tube.geometry.dimensions[i] > 0, "Characteristic dimension must be > 0");
        assert(HX.Tube.geometry.dlengths[i] >= abs(HX.Tube.geometry.dheights[i]),
           "Geometry dlengths must be greater or equal to abs(dheights)");
      end for;
    // end of extends 

  // Component HX.Tube.flowModel.firstOrder_dps_K[1]
  // class Modelica.Blocks.Continuous.FirstOrder
  equation
    der(HX.Tube.flowModel.firstOrder_dps_K[1].y) = (HX.Tube.flowModel.firstOrder_dps_K[1].k
      *HX.Tube.flowModel.firstOrder_dps_K[1].u-HX.Tube.flowModel.firstOrder_dps_K[1].y)
      /HX.Tube.flowModel.firstOrder_dps_K[1].T;

  // Component HX.Tube.flowModel.mediaProps[1]
  // class TRANSFORM.Media.BaseProperties1Phase
  equation
    HX.Tube.flowModel.mediaProps[1].h = Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_Unique25
      (
      HX.Tube.flowModel.mediaProps[1].state);
    HX.Tube.flowModel.mediaProps[1].d = Modelica.Media.Water.WaterIF97_ph.density_Unique5
      (
      HX.Tube.flowModel.mediaProps[1].state);
    HX.Tube.flowModel.mediaProps[1].T = Modelica.Media.Water.WaterIF97_ph.temperature_Unique28
      (
      HX.Tube.flowModel.mediaProps[1].state);
    HX.Tube.flowModel.mediaProps[1].p = Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
      (
      HX.Tube.flowModel.mediaProps[1].state);
    HX.Tube.flowModel.mediaProps[1].mu = Modelica.Media.Water.WaterIF97_ph.dynamicViscosity_Unique6
      (
      HX.Tube.flowModel.mediaProps[1].state);
    HX.Tube.flowModel.mediaProps[1].lambda = Modelica.Media.Water.WaterIF97_ph.thermalConductivity_Unique45
      (
      HX.Tube.flowModel.mediaProps[1].state);
    HX.Tube.flowModel.mediaProps[1].cp = Modelica.Media.Water.WaterIF97_ph.specificHeatCapacityCp_Unique46
      (
      HX.Tube.flowModel.mediaProps[1].state);

  // Component HX.Tube.flowModel.mediaProps[2]
  // class TRANSFORM.Media.BaseProperties1Phase
  equation
    HX.Tube.flowModel.mediaProps[2].h = Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_Unique25
      (
      HX.Tube.flowModel.mediaProps[2].state);
    HX.Tube.flowModel.mediaProps[2].d = Modelica.Media.Water.WaterIF97_ph.density_Unique5
      (
      HX.Tube.flowModel.mediaProps[2].state);
    HX.Tube.flowModel.mediaProps[2].T = Modelica.Media.Water.WaterIF97_ph.temperature_Unique28
      (
      HX.Tube.flowModel.mediaProps[2].state);
    HX.Tube.flowModel.mediaProps[2].p = Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
      (
      HX.Tube.flowModel.mediaProps[2].state);
    HX.Tube.flowModel.mediaProps[2].mu = Modelica.Media.Water.WaterIF97_ph.dynamicViscosity_Unique6
      (
      HX.Tube.flowModel.mediaProps[2].state);
    HX.Tube.flowModel.mediaProps[2].lambda = Modelica.Media.Water.WaterIF97_ph.thermalConductivity_Unique45
      (
      HX.Tube.flowModel.mediaProps[2].state);
    HX.Tube.flowModel.mediaProps[2].cp = Modelica.Media.Water.WaterIF97_ph.specificHeatCapacityCp_Unique46
      (
      HX.Tube.flowModel.mediaProps[2].state);

  // Component HX.Tube.flowModel
  // class TRANSFORM.Fluid.Pipes.GenericPipe_MultiTransferSurface.FlowModel
    // extends TRANSFORM.Fluid.ClosureRelations.PressureLoss.Models.DistributedPipe_1D.PartialDistributedStaggeredFlow
    equation
      for i in (1:HX.Tube.flowModel.nFM) loop
        assert(HX.Tube.flowModel.m_flows[i] >  -HX.Tube.flowModel.m_flow_small
           or HX.Tube.flowModel.allowFlowReversal, "Reverting flow occurs in flowModel even though allowFlowReversal is false");
      end for;
      HX.Tube.flowModel.Is = array(HX.Tube.flowModel.m_flows[i]*HX.Tube.flowModel.dlengths
        [i] for i in 1:HX.Tube.flowModel.nFM);
      if (HX.Tube.flowModel.momentumDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) then 
        for i in (1:HX.Tube.flowModel.nFM) loop
          0 = HX.Tube.flowModel.Ibs[i];
        end for;
      else
        for i in (1:HX.Tube.flowModel.nFM) loop
          der(HX.Tube.flowModel.Is[i]) = HX.Tube.flowModel.Ibs[i];
        end for;
      end if;
    // extends TRANSFORM.Fluid.ClosureRelations.PressureLoss.Models.DistributedPipe_1D.PartialMomentumBalance
    equation
      HX.Tube.flowModel.Ibs = HX.Tube.flowModel.I_flows-HX.Tube.flowModel.Fs_p-
        HX.Tube.flowModel.Fs_fg;
      if (HX.Tube.flowModel.use_I_flows) then 
        HX.Tube.flowModel.I_flows = array(HX.Tube.flowModel.crossAreas[i]*
          Modelica.Media.Water.WaterIF97_ph.density_Unique5(
          HX.Tube.flowModel.states[i])*HX.Tube.flowModel.vs[i]*HX.Tube.flowModel.vs
          [i]-HX.Tube.flowModel.crossAreas[i+1]*Modelica.Media.Water.WaterIF97_ph.density_Unique5
          (
          HX.Tube.flowModel.states[i+1])*HX.Tube.flowModel.vs[i+1]*
          HX.Tube.flowModel.vs[i+1] for i in 1:HX.Tube.flowModel.nFM);
      else
        HX.Tube.flowModel.I_flows = zeros(HX.Tube.flowModel.nFM);
      end if;
      HX.Tube.flowModel.Fs_p = array(0.5*(HX.Tube.flowModel.crossAreas[i]+
        HX.Tube.flowModel.crossAreas[i+1])*(Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
        (
        HX.Tube.flowModel.states[i+1])-Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
        (
        HX.Tube.flowModel.states[i])) for i in 1:HX.Tube.flowModel.nFM);
      HX.Tube.flowModel.Fs_fg = array((HX.Tube.flowModel.dps_fg[i]+
        HX.Tube.flowModel.firstOrder_dps_K[i].y)*0.5*(HX.Tube.flowModel.crossAreas
        [i]+HX.Tube.flowModel.crossAreas[i+1]) for i in 1:HX.Tube.flowModel.nFM);
      HX.Tube.flowModel.dps_K = array(noEvent((if HX.Tube.flowModel.m_flows[i]
         > 0 then 0.5*HX.Tube.flowModel.Ks_ab[i]*Modelica.Media.Water.WaterIF97_ph.density_Unique5
        (
        HX.Tube.flowModel.states[i])*HX.Tube.flowModel.vs[i]*HX.Tube.flowModel.vs
        [i] else  -0.5*HX.Tube.flowModel.Ks_ba[i]*Modelica.Media.Water.WaterIF97_ph.density_Unique5
        (
        HX.Tube.flowModel.states[i+1])*HX.Tube.flowModel.vs[i+1]*
        HX.Tube.flowModel.vs[i+1])) for i in 1:HX.Tube.flowModel.nFM);
      HX.Tube.flowModel.firstOrder_dps_K[:].u = HX.Tube.flowModel.dps_K;
    // extends TRANSFORM.Fluid.ClosureRelations.PressureLoss.Models.DistributedPipe_1D.PartialSinglePhase
    equation
      for i in (1:HX.Tube.flowModel.nFM) loop
        HX.Tube.flowModel.Res[i] = 0.5*((HX.Tube.flowModel.dimensions[i]+
          HX.Tube.flowModel.dimensions[i+1])*abs(HX.Tube.flowModel.m_flows[i]))/
          (0.25*((HX.Tube.flowModel.crossAreas[i]+HX.Tube.flowModel.crossAreas[i
          +1])*(HX.Tube.flowModel.mediaProps[i].mu+HX.Tube.flowModel.mediaProps[
          i+1].mu)));
      end for;
    // extends TRANSFORM.Fluid.ClosureRelations.PressureLoss.Models.DistributedPipe_1D.SinglePhase_Developed_2Region_NumStable
    equation
      for i in (1:HX.Tube.flowModel.nFM) loop
        HX.Tube.flowModel.ds[i] = TRANSFORM.Math.spliceTanh(HX.Tube.flowModel.ds_a
          [i], HX.Tube.flowModel.ds_b[i], HX.Tube.flowModel.m_flows[i], 
          HX.Tube.flowModel.m_flow_small);
        HX.Tube.flowModel.mus[i] = TRANSFORM.Math.spliceTanh(HX.Tube.flowModel.mus_a
          [i], HX.Tube.flowModel.mus_b[i], HX.Tube.flowModel.m_flows[i], 
          HX.Tube.flowModel.m_flow_small);
      end for;
      if (HX.Tube.flowModel.continuousFlowReversal) then 
        if (HX.Tube.flowModel.from_dp) then 
          HX.Tube.flowModel.m_flows = homotopy(TRANSFORM.Fluid.ClosureRelations.PressureLoss.Functions.TubesAndConduits.SinglePhase.LaminarTurbulent_MSLDetailed.dp_MFLOW
            (
            HX.Tube.flowModel.IN_con, 
            HX.Tube.flowModel.IN_var, 
            HX.Tube.flowModel.dps_fg-(array(HX.Tube.flowModel.g_n*
              HX.Tube.flowModel.dheights[i]*HX.Tube.flowModel.ds_a[i] for i in 1
              :HX.Tube.flowModel.nFM)), 
            HX.Tube.flowModel.dp_small/HX.Tube.flowModel.nFM), HX.Tube.flowModel.m_flow_nominal
            /HX.Tube.flowModel.dp_nominal*(HX.Tube.flowModel.dps_fg-
            HX.Tube.flowModel.g_n*HX.Tube.flowModel.dheights*HX.Tube.flowModel.d_nominal));
        else
          HX.Tube.flowModel.dps_fg = homotopy(TRANSFORM.Fluid.ClosureRelations.PressureLoss.Functions.TubesAndConduits.SinglePhase.LaminarTurbulent_MSLDetailed.dp_DP
            (
            HX.Tube.flowModel.IN_con, 
            HX.Tube.flowModel.IN_var, 
            HX.Tube.flowModel.m_flows, 
            HX.Tube.flowModel.m_flow_small)+(array(HX.Tube.flowModel.g_n*
            HX.Tube.flowModel.dheights[i]*HX.Tube.flowModel.ds_a[i] for i in 1:
            HX.Tube.flowModel.nFM)), HX.Tube.flowModel.dp_nominal/
            HX.Tube.flowModel.m_flow_nominal*HX.Tube.flowModel.m_flows+
            HX.Tube.flowModel.g_n*HX.Tube.flowModel.dheights*HX.Tube.flowModel.d_nominal);
        end if;
      else
        if (HX.Tube.flowModel.from_dp) then 
          HX.Tube.flowModel.m_flows = homotopy(TRANSFORM.Fluid.ClosureRelations.PressureLoss.Functions.TubesAndConduits.SinglePhase.LaminarTurbulent_MSLDetailed.dp_MFLOW_staticHead
            (
            HX.Tube.flowModel.IN_con, 
            HX.Tube.flowModel.IN_var, 
            HX.Tube.flowModel.dps_fg, 
            HX.Tube.flowModel.dp_small/HX.Tube.flowModel.nFM, 
            HX.Tube.flowModel.g_n*HX.Tube.flowModel.dheights), HX.Tube.flowModel.m_flow_nominal
            /HX.Tube.flowModel.dp_nominal*(HX.Tube.flowModel.dps_fg-
            HX.Tube.flowModel.g_n*HX.Tube.flowModel.dheights*HX.Tube.flowModel.d_nominal));
        else
          HX.Tube.flowModel.dps_fg = homotopy(TRANSFORM.Fluid.ClosureRelations.PressureLoss.Functions.TubesAndConduits.SinglePhase.LaminarTurbulent_MSLDetailed.dp_DP_staticHead
            (
            HX.Tube.flowModel.IN_con, 
            HX.Tube.flowModel.IN_var, 
            HX.Tube.flowModel.m_flows, 
            HX.Tube.flowModel.m_flow_small, 
            HX.Tube.flowModel.g_n*HX.Tube.flowModel.dheights), HX.Tube.flowModel.dp_nominal
            /HX.Tube.flowModel.m_flow_nominal*HX.Tube.flowModel.m_flows+
            HX.Tube.flowModel.g_n*HX.Tube.flowModel.dheights*HX.Tube.flowModel.d_nominal);
        end if;
      end if;
    // end of extends 

  // Component HX.Tube.heatTransfer.mediums[1]
  // class TRANSFORM.Media.BaseProperties1Phase
  equation
    HX.Tube.heatTransfer.mediums[1].h = Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_Unique25
      (
      HX.Tube.heatTransfer.mediums[1].state);
    HX.Tube.heatTransfer.mediums[1].d = Modelica.Media.Water.WaterIF97_ph.density_Unique5
      (
      HX.Tube.heatTransfer.mediums[1].state);
    HX.Tube.heatTransfer.mediums[1].T = Modelica.Media.Water.WaterIF97_ph.temperature_Unique28
      (
      HX.Tube.heatTransfer.mediums[1].state);
    HX.Tube.heatTransfer.mediums[1].p = Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
      (
      HX.Tube.heatTransfer.mediums[1].state);
    HX.Tube.heatTransfer.mediums[1].mu = Modelica.Media.Water.WaterIF97_ph.dynamicViscosity_Unique6
      (
      HX.Tube.heatTransfer.mediums[1].state);
    HX.Tube.heatTransfer.mediums[1].lambda = Modelica.Media.Water.WaterIF97_ph.thermalConductivity_Unique45
      (
      HX.Tube.heatTransfer.mediums[1].state);
    HX.Tube.heatTransfer.mediums[1].cp = Modelica.Media.Water.WaterIF97_ph.specificHeatCapacityCp_Unique46
      (
      HX.Tube.heatTransfer.mediums[1].state);

  // Component HX.Tube.heatTransfer
  // class INL_DT.Components.HX_Isolated.HeatTransfer
    // extends TRANSFORM.Fluid.ClosureRelations.HeatTransfer.Models.DistributedPipe_1D_MultiTransferSurface.PartialIdeal
    equation
      HX.Tube.heatTransfer.m_flows = HX.Tube.heatTransfer.vs.*HX.Tube.heatTransfer.mediums
        .d.*HX.Tube.heatTransfer.crossAreas;
      HX.Tube.heatTransfer.Res = HX.Tube.heatTransfer.mediums.d.*
        HX.Tube.heatTransfer.dimensions.*abs(HX.Tube.heatTransfer.vs)./
        HX.Tube.heatTransfer.mediums.mu;
      HX.Tube.heatTransfer.Prs = HX.Tube.heatTransfer.mediums.mu.*
        HX.Tube.heatTransfer.mediums.cp./HX.Tube.heatTransfer.mediums.lambda;
    // extends TRANSFORM.Fluid.ClosureRelations.HeatTransfer.Models.DistributedPipe_1D_MultiTransferSurface.Ideal
    equation
      for i in (1:HX.Tube.heatTransfer.nHT) loop
        for j in (1:HX.Tube.heatTransfer.nSurfaces) loop
          HX.Tube.heatTransfer.Ts_wall[i, j] = HX.Tube.heatTransfer.Ts_fluid[i];
          HX.Tube.heatTransfer.alphas[i, j] = 1E+60;
          HX.Tube.heatTransfer.Nus[i, j] = 1E+60;
        end for;
      end for;
    // end of extends 

  // Component HX.Tube.internalHeatGen
  // class INL_DT.Components.HX_Isolated.InternalHeatGen
    // extends TRANSFORM.Fluid.ClosureRelations.InternalVolumeHeatGeneration.Models.DistributedVolume_1D.GenericHeatGeneration
    equation
      for i in (1:HX.Tube.internalHeatGen.nV) loop
        HX.Tube.internalHeatGen.Q_flows[i] = HX.Tube.internalHeatGen.Q_gens[i];
      end for;
    // end of extends 

  // Component HX.Tube.traceMassTransfer.diffusionCoeff[1]
  // class TRANSFORM.Fluid.ClosureRelations.MassTransfer.Models.DistributedPipe_TraceMass_1D_MultiTransferSurface.PartialMassTransfer_setC.DiffusionCoeff
    // extends TRANSFORM.Media.ClosureModels.MassDiffusionCoefficient.Models.GenericCoefficient
    equation
      HX.Tube.traceMassTransfer.diffusionCoeff[1].D_abs = HX.Tube.traceMassTransfer.diffusionCoeff[1].D_abs0;
    // end of extends 

  // Component HX.Tube.traceMassTransfer.mediums[1]
  // class TRANSFORM.Media.BaseProperties1Phase
  equation
    HX.Tube.traceMassTransfer.mediums[1].h = Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_Unique25
      (
      HX.Tube.traceMassTransfer.mediums[1].state);
    HX.Tube.traceMassTransfer.mediums[1].d = Modelica.Media.Water.WaterIF97_ph.density_Unique5
      (
      HX.Tube.traceMassTransfer.mediums[1].state);
    HX.Tube.traceMassTransfer.mediums[1].T = Modelica.Media.Water.WaterIF97_ph.temperature_Unique28
      (
      HX.Tube.traceMassTransfer.mediums[1].state);
    HX.Tube.traceMassTransfer.mediums[1].p = Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
      (
      HX.Tube.traceMassTransfer.mediums[1].state);
    HX.Tube.traceMassTransfer.mediums[1].mu = Modelica.Media.Water.WaterIF97_ph.dynamicViscosity_Unique6
      (
      HX.Tube.traceMassTransfer.mediums[1].state);
    HX.Tube.traceMassTransfer.mediums[1].lambda = Modelica.Media.Water.WaterIF97_ph.thermalConductivity_Unique45
      (
      HX.Tube.traceMassTransfer.mediums[1].state);
    HX.Tube.traceMassTransfer.mediums[1].cp = Modelica.Media.Water.WaterIF97_ph.specificHeatCapacityCp_Unique46
      (
      HX.Tube.traceMassTransfer.mediums[1].state);

  // Component HX.Tube.traceMassTransfer
  // class TRANSFORM.Fluid.Pipes.GenericPipe_MultiTransferSurface.TraceMassTransfer
    // extends TRANSFORM.Fluid.ClosureRelations.MassTransfer.Models.DistributedPipe_TraceMass_1D_MultiTransferSurface.PartialMassTransfer_setC
    equation
      for i in (1:HX.Tube.traceMassTransfer.nMT) loop
        for k in (1:HX.Tube.traceMassTransfer.nC) loop
          HX.Tube.traceMassTransfer.Cs_fluid[i, k] = HX.Tube.traceMassTransfer.CsM_fluid
            [i, HX.Tube.traceMassTransfer.iC[k]]*Modelica.Media.Water.WaterIF97_ph.density_Unique5
            (
            HX.Tube.traceMassTransfer.states[i])*HX.Tube.traceMassTransfer.toMole_unitConv
            /HX.Tube.traceMassTransfer.MMs[k];
        end for;
      end for;
      for i in (1:HX.Tube.traceMassTransfer.nMT) loop
        for j in (1:HX.Tube.traceMassTransfer.nSurfaces) loop
          for k in (1:HX.Tube.traceMassTransfer.nC) loop
            HX.Tube.traceMassTransfer.mC_flows[i, j, HX.Tube.traceMassTransfer.iC
              [k]] = HX.Tube.traceMassTransfer.nC_flows[i, j, k]*
              HX.Tube.traceMassTransfer.MMs[k]*HX.Tube.traceMassTransfer.toMole_unitConv;
          end for;
          for k in (1:HX.Tube.traceMassTransfer.nC_noT) loop
            HX.Tube.traceMassTransfer.mC_flows[i, j, HX.Tube.traceMassTransfer.iC_noT
              [k]] = 0;
          end for;
        end for;
      end for;
      for i in (1:HX.Tube.traceMassTransfer.nMT) loop
        HX.Tube.traceMassTransfer.xs[i] = noEvent((if HX.Tube.traceMassTransfer.vs
          [i] >= 0 then (if i == 1 then 0.5*HX.Tube.traceMassTransfer.dlengths[i]
           else sum(HX.Tube.traceMassTransfer.dlengths[1:i-1])+0.5*
          HX.Tube.traceMassTransfer.dlengths[i]) else (if i == HX.Tube.traceMassTransfer.nMT
           then 0.5*HX.Tube.traceMassTransfer.dlengths[HX.Tube.traceMassTransfer.nMT]
           else sum(HX.Tube.traceMassTransfer.dlengths[i+1:HX.Tube.traceMassTransfer.nMT])
          +0.5*HX.Tube.traceMassTransfer.dlengths[i])));
      end for;
    // extends TRANSFORM.Fluid.ClosureRelations.MassTransfer.Models.DistributedPipe_TraceMass_1D_MultiTransferSurface.PartialIdeal
    equation
      for i in (1:HX.Tube.traceMassTransfer.nMT) loop
        HX.Tube.traceMassTransfer.m_flows[i] = HX.Tube.traceMassTransfer.vs[i]*
          HX.Tube.traceMassTransfer.mediums[i].d*HX.Tube.traceMassTransfer.crossAreas
          [i];
        HX.Tube.traceMassTransfer.Res[i] = HX.Tube.traceMassTransfer.mediums[i].
          d*HX.Tube.traceMassTransfer.dimensions[i]*abs(HX.Tube.traceMassTransfer.vs
          [i])/HX.Tube.traceMassTransfer.mediums[i].mu;
        HX.Tube.traceMassTransfer.Scs[i, :] = HX.Tube.traceMassTransfer.mediums[
          i].mu./(HX.Tube.traceMassTransfer.mediums[i].d.*HX.Tube.traceMassTransfer.diffusionCoeff
          [i].D_abs);
      end for;
    // extends TRANSFORM.Fluid.ClosureRelations.MassTransfer.Models.DistributedPipe_TraceMass_1D_MultiTransferSurface.Ideal
    equation
      for i in (1:HX.Tube.traceMassTransfer.nMT) loop
        for j in (1:HX.Tube.traceMassTransfer.nSurfaces) loop
          HX.Tube.traceMassTransfer.Cs_wall[i, j, :] = HX.Tube.traceMassTransfer.Cs_fluid
            [i, :];
          HX.Tube.traceMassTransfer.alphasM[i, j, :] = 1E+60*ones(
            HX.Tube.traceMassTransfer.nC);
          HX.Tube.traceMassTransfer.Shs[i, j, :] = 1E+60*ones(HX.Tube.traceMassTransfer.nC);
        end for;
      end for;
    // end of extends 

  // Component HX.Tube.internalTraceGen
  // class TRANSFORM.Fluid.Pipes.GenericPipe_MultiTransferSurface.InternalTraceGen
    // extends TRANSFORM.Fluid.ClosureRelations.InternalTraceGeneration.Models.DistributedVolume_Trace_1D.GenericTraceGeneration
    equation
      for ic in (1:0) loop
        for i in (1:HX.Tube.internalTraceGen.nV) loop
          HX.Tube.internalTraceGen.mC_flows[i, ic] = HX.Tube.internalTraceGen.mC_gens
            [i, ic];
        end for;
      end for;
    // end of extends 

  // Component HX.Tube.mediums[1]
  // class Modelica.Media.Water.WaterIF97_base.BaseProperties
    // extends Modelica.Media.Interfaces.PartialMedium.BaseProperties_D1
    equation
      if (HX.Tube.mediums[1].standardOrderComponents) then 
        HX.Tube.mediums[1].Xi = HX.Tube.mediums[1].X[1:0];
        HX.Tube.mediums[1].X = {1.0};
        for i in (1:1) loop
          assert(HX.Tube.mediums[1].X[i] >= -1E-05 and HX.Tube.mediums[1].X[i]
             <= 1.00001, "Mass fraction X["+       String(i, true, 0)+"] = "+
                   String(HX.Tube.mediums[1].X[i], true, 0)+"of substance "+({
            "water"})[i]+"\nof medium "+"WaterIF97"+" is not in the range 0..1");
        end for;
      end if;
      assert(HX.Tube.mediums[1].p >= 0.0, "Pressure (= "+       String(
        HX.Tube.mediums[1].p, true, 0)+" Pa) of medium \""+"WaterIF97"+
        "\" is negative\n(Temperature = "+       String(HX.Tube.mediums[1].T, 
        true, 0)+" K)");
    // end of extends 
  equation
    HX.Tube.mediums[1].MM = _GlobalScope.Modelica.Media.Water.WaterIF97_ph.fluidConstants[1]
      .molarMass;
    HX.Tube.mediums[1].phase = (if HX.Tube.mediums[1].h < Modelica.Media.Water.WaterIF97_ph.bubbleEnthalpy_Unique29
      (
      HX.Tube.mediums[1].sat) or HX.Tube.mediums[1].h > Modelica.Media.Water.WaterIF97_ph.dewEnthalpy_Unique30
      (
      HX.Tube.mediums[1].sat) or HX.Tube.mediums[1].p > _GlobalScope.Modelica.Media.Water.WaterIF97_ph.fluidConstants[1]
      .criticalPressure then 1 else 2);
    HX.Tube.mediums[1].d = Modelica.Media.Water.WaterIF97_ph.density_ph_Unique3(
      HX.Tube.mediums[1].p, HX.Tube.mediums[1].h, HX.Tube.mediums[1].phase, 0);
    HX.Tube.mediums[1].T = Modelica.Media.Water.WaterIF97_ph.temperature_ph_Unique4
      (HX.Tube.mediums[1].p, HX.Tube.mediums[1].h, HX.Tube.mediums[1].phase, 0);
    HX.Tube.mediums[1].sat.Tsat = Modelica.Media.Water.WaterIF97_ph.saturationTemperature_Unique37
      (HX.Tube.mediums[1].p);
    HX.Tube.mediums[1].sat.psat = HX.Tube.mediums[1].p;
    HX.Tube.mediums[1].u = HX.Tube.mediums[1].h-HX.Tube.mediums[1].p/
      HX.Tube.mediums[1].d;
    HX.Tube.mediums[1].R_s = 8.31446261815324/_GlobalScope.Modelica.Media.Water.WaterIF97_ph.fluidConstants[1]
      .molarMass;
    HX.Tube.mediums[1].h = HX.Tube.mediums[1].state.h;
    HX.Tube.mediums[1].p = HX.Tube.mediums[1].state.p;
    HX.Tube.mediums[1].T = HX.Tube.mediums[1].state.T;
    HX.Tube.mediums[1].d = HX.Tube.mediums[1].state.d;
    HX.Tube.mediums[1].phase = HX.Tube.mediums[1].state.phase;

  // Component HX.Tube
  // class TRANSFORM.Fluid.Pipes.GenericPipe_MultiTransferSurface
    // extends TRANSFORM.Fluid.Pipes.BaseClasses.PartialDistributedVolume
    equation
      assert( not (HX.Tube.energyDynamics <> Modelica.Fluid.Types.Dynamics.
        SteadyState and HX.Tube.massDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) or false, "Bad combination of dynamics options and Medium not conserving mass if fluidVolumes are fixed.");
      for i in (1:HX.Tube.nV) loop
        HX.Tube.ms[i] = HX.Tube.Vs[i]*HX.Tube.mediums[i].d;
        HX.Tube.Us[i] = HX.Tube.ms[i]*HX.Tube.mediums[i].u;
        HX.Tube.mXis[i, :] = HX.Tube.ms[i]*HX.Tube.mediums[i].Xi;
        HX.Tube.mCs[i, :] = HX.Tube.ms[i].*HX.Tube.Cs[i, :];
      end for;
      if (HX.Tube.massDynamics == Modelica.Fluid.Types.Dynamics.SteadyState)
         then 
        for i in (1:HX.Tube.nV) loop
          0 = HX.Tube.mbs[i];
        end for;
      else
        for i in (1:HX.Tube.nV) loop
          der(HX.Tube.ms[i]) = HX.Tube.mbs[i];
        end for;
      end if;
      if (HX.Tube.energyDynamics == Modelica.Fluid.Types.Dynamics.SteadyState)
         then 
        for i in (1:HX.Tube.nV) loop
          0 = HX.Tube.Ubs[i];
        end for;
      else
        for i in (1:HX.Tube.nV) loop
          der(HX.Tube.Us[i]) = HX.Tube.Ubs[i];
        end for;
      end if;
      if (HX.Tube.substanceDynamics == Modelica.Fluid.Types.Dynamics.SteadyState)
         then 
        for i in (1:HX.Tube.nV) loop
          zeros(0) = HX.Tube.mXibs[i, :];
        end for;
      else
        for i in (1:HX.Tube.nV) loop
          der(HX.Tube.mXis[i, :]) = HX.Tube.mXibs[i, :];
        end for;
      end if;
      if (HX.Tube.traceDynamics == Modelica.Fluid.Types.Dynamics.SteadyState)
         then 
        for i in (1:HX.Tube.nV) loop
          zeros(0) = HX.Tube.mCbs[i, :];
        end for;
      else
        for i in (1:HX.Tube.nV) loop
          der(HX.Tube.mCs_scaled[i, :]) = HX.Tube.mCbs[i, :]./{};
          HX.Tube.mCs[i, :] = HX.Tube.mCs_scaled[i, :].*{};
        end for;
      end if;
    // end of extends 
  equation
    for i in (1:HX.Tube.nV) loop
      HX.Tube.mbs[i] = HX.Tube.m_flows[i]-HX.Tube.m_flows[i+1];
      HX.Tube.Ubs[i] = HX.Tube.Wb_flows[i]+HX.Tube.H_flows[i]-HX.Tube.H_flows[i+1]
        +sum(HX.Tube.heatTransfer.Q_flows[i, :])+HX.Tube.internalHeatGen.Q_flows
        [i]/HX.Tube.nParallel;
      HX.Tube.mXibs[i, :] = HX.Tube.mXi_flows[i, :]-HX.Tube.mXi_flows[i+1, :];
      HX.Tube.mCbs[i, :] = HX.Tube.mC_flows[i, :]-HX.Tube.mC_flows[i+1, :]+
        HX.Tube.mC_flows_traceMassTransferSum[i, :]+HX.Tube.internalTraceGen.mC_flows
        [i, :]/HX.Tube.nParallel;
    end for;
    if ( not HX.Tube.use_HeatTransfer) then 
      for i in (1:HX.Tube.geometry.nSurfaces) loop
        for j in (1:HX.Tube.nV) loop
          HX.Tube.Ts_wall[j, i] = HX.Tube.mediums[j].T;
        end for;
      end for;
    else
      for i in (1:HX.Tube.geometry.nSurfaces) loop
        for j in (1:HX.Tube.nV) loop
          HX.Tube.Ts_wall[j, i] = HX.Tube.heatPorts_int[j, i].T;
        end for;
      end for;
    end if;
    HX.Tube.port_a.m_flow/HX.Tube.nParallel = HX.Tube.m_flows[1];
    HX.Tube.port_b.m_flow/HX.Tube.nParallel =  -HX.Tube.m_flows[HX.Tube.nV+1];
    HX.Tube.port_a.h_outflow = HX.Tube.mediums[1].h;
    HX.Tube.port_b.h_outflow = HX.Tube.mediums[HX.Tube.nV].h;
    HX.Tube.port_a.Xi_outflow = HX.Tube.mediums[1].Xi;
    HX.Tube.port_b.Xi_outflow = HX.Tube.mediums[HX.Tube.nV].Xi;
    HX.Tube.port_a.C_outflow = HX.Tube.Cs[1, :];
    HX.Tube.port_b.C_outflow = HX.Tube.Cs[HX.Tube.nV, :];
    if (HX.Tube.useInnerPortProperties and HX.Tube.nV > 0) then 
      HX.Tube.state_a = Modelica.Media.Water.WaterIF97_ph.setState_phX_Unique1(
        HX.Tube.port_a.p, HX.Tube.mediums[1].h, HX.Tube.mediums[1].Xi, 0, 0);
      HX.Tube.state_b = Modelica.Media.Water.WaterIF97_ph.setState_phX_Unique1(
        HX.Tube.port_b.p, HX.Tube.mediums[HX.Tube.nV].h, HX.Tube.mediums[
        HX.Tube.nV].Xi, 0, 0);
    else
      HX.Tube.state_a = Modelica.Media.Water.WaterIF97_ph.setState_phX_Unique1(
        HX.Tube.port_a.p, inStream(HX.Tube.port_a.h_outflow), inStream(
        HX.Tube.port_a.Xi_outflow), 0, 0);
      HX.Tube.state_b = Modelica.Media.Water.WaterIF97_ph.setState_phX_Unique1(
        HX.Tube.port_b.p, inStream(HX.Tube.port_b.h_outflow), inStream(
        HX.Tube.port_b.Xi_outflow), 0, 0);
    end if;
    HX.Tube.H_flows[1] = semiLinear(HX.Tube.port_a.m_flow, inStream(
      HX.Tube.port_a.h_outflow), HX.Tube.mediums[1].h)/HX.Tube.nParallel;
    HX.Tube.mXi_flows[1, :] = semiLinear(HX.Tube.port_a.m_flow, inStream(
      HX.Tube.port_a.Xi_outflow), HX.Tube.mediums[1].Xi)/HX.Tube.nParallel;
    HX.Tube.mC_flows[1, :] = semiLinear(HX.Tube.port_a.m_flow, inStream(
      HX.Tube.port_a.C_outflow), HX.Tube.Cs[1, :])/HX.Tube.nParallel;
    for i in (2:HX.Tube.nV) loop
      HX.Tube.H_flows[i] = semiLinear(HX.Tube.m_flows[i], HX.Tube.mediums[i-1].h,
         HX.Tube.mediums[i].h);
      HX.Tube.mXi_flows[i, :] = semiLinear(HX.Tube.m_flows[i], HX.Tube.mediums[i
        -1].Xi, HX.Tube.mediums[i].Xi);
      HX.Tube.mC_flows[i, :] = semiLinear(HX.Tube.m_flows[i], HX.Tube.Cs[i-1, :],
         HX.Tube.Cs[i, :]);
    end for;
    HX.Tube.H_flows[HX.Tube.nV+1] =  -semiLinear(HX.Tube.port_b.m_flow, inStream
      (HX.Tube.port_b.h_outflow), HX.Tube.mediums[HX.Tube.nV].h)/
      HX.Tube.nParallel;
    HX.Tube.mXi_flows[HX.Tube.nV+1, :] =  -semiLinear(HX.Tube.port_b.m_flow, 
      inStream(HX.Tube.port_b.Xi_outflow), HX.Tube.mediums[HX.Tube.nV].Xi)/
      HX.Tube.nParallel;
    HX.Tube.mC_flows[HX.Tube.nV+1, :] =  -semiLinear(HX.Tube.port_b.m_flow, 
      inStream(HX.Tube.port_b.C_outflow), HX.Tube.Cs[HX.Tube.nV, :])/
      HX.Tube.nParallel;
    if (HX.Tube.calc_Wb) then 
      if (HX.Tube.nV == 1 or HX.Tube.useLumpedPressure) then 
        HX.Tube.Wb_flows = HX.Tube.geometry.dxs*(HX.Tube.vs*HX.Tube.geometry.dxs
          *(HX.Tube.geometry.crossAreas*HX.Tube.geometry.dxs)*(HX.Tube.port_b.p-
          HX.Tube.port_a.p+sum(HX.Tube.flowModel.dps_fg)-HX.Tube.g_n*(
          HX.Tube.geometry.dheights*HX.Tube.mediums.d)));
      else
        if (HX.Tube.exposeState_a and HX.Tube.exposeState_b or HX.Tube.exposeState_a
           and  not HX.Tube.exposeState_b) then 
          HX.Tube.Wb_flows[2:HX.Tube.nV-1] = array(HX.Tube.vs[i]*
            HX.Tube.geometry.crossAreas[i]*((HX.Tube.mediums[i+1].p-
            HX.Tube.mediums[i-1].p)/2+(HX.Tube.flowModel.dps_fg[i-1]+
            HX.Tube.flowModel.dps_fg[i])/2-HX.Tube.g_n*HX.Tube.geometry.dheights
            [i]*HX.Tube.mediums[i].d) for i in 2:HX.Tube.nV-1);
        else
          HX.Tube.Wb_flows[2:HX.Tube.nV-1] = array(HX.Tube.vs[i]*
            HX.Tube.geometry.crossAreas[i]*((HX.Tube.mediums[i+1].p-
            HX.Tube.mediums[i-1].p)/2+(HX.Tube.flowModel.dps_fg[i]+
            HX.Tube.flowModel.dps_fg[i+1])/2-HX.Tube.g_n*HX.Tube.geometry.dheights
            [i]*HX.Tube.mediums[i].d) for i in 2:HX.Tube.nV-1);
        end if;
        if (HX.Tube.exposeState_a and HX.Tube.exposeState_b) then 
          HX.Tube.Wb_flows[1] = HX.Tube.vs[1]*HX.Tube.geometry.crossAreas[1]*((
            HX.Tube.mediums[2].p-HX.Tube.mediums[1].p)/2+HX.Tube.flowModel.dps_fg
            [1]/2-HX.Tube.g_n*HX.Tube.geometry.dheights[1]*HX.Tube.mediums[1].d);
          HX.Tube.Wb_flows[HX.Tube.nV] = HX.Tube.vs[HX.Tube.nV]*HX.Tube.geometry.crossAreas
            [HX.Tube.nV]*((HX.Tube.mediums[HX.Tube.nV].p-HX.Tube.mediums[
            HX.Tube.nV-1].p)/2+HX.Tube.flowModel.dps_fg[HX.Tube.nV-1]/2-
            HX.Tube.g_n*HX.Tube.geometry.dheights[HX.Tube.nV]*HX.Tube.mediums[
            HX.Tube.nV].d);
        elseif (HX.Tube.exposeState_a and  not HX.Tube.exposeState_b) then 
          HX.Tube.Wb_flows[1] = HX.Tube.vs[1]*HX.Tube.geometry.crossAreas[1]*((
            HX.Tube.mediums[2].p-HX.Tube.mediums[1].p)/2+HX.Tube.flowModel.dps_fg
            [1]/2-HX.Tube.g_n*HX.Tube.geometry.dheights[1]*HX.Tube.mediums[1].d);
          if (HX.Tube.nV == 2) then 
            HX.Tube.Wb_flows[HX.Tube.nV] = HX.Tube.vs[HX.Tube.nV]*
              HX.Tube.geometry.crossAreas[HX.Tube.nV]*((HX.Tube.port_b.p-
              HX.Tube.mediums[HX.Tube.nV-1].p)*5/8+HX.Tube.flowModel.dps_fg[
              HX.Tube.nV-1]/2+HX.Tube.flowModel.dps_fg[HX.Tube.nV]-HX.Tube.g_n*
              HX.Tube.geometry.dheights[HX.Tube.nV]*HX.Tube.mediums[HX.Tube.nV].
              d);
          else
            HX.Tube.Wb_flows[HX.Tube.nV] = HX.Tube.vs[HX.Tube.nV]*
              HX.Tube.geometry.crossAreas[HX.Tube.nV]*((HX.Tube.port_b.p-
              HX.Tube.mediums[HX.Tube.nV-1].p)/1.5+HX.Tube.flowModel.dps_fg[
              HX.Tube.nV-1]/2+HX.Tube.flowModel.dps_fg[HX.Tube.nV]-HX.Tube.g_n*
              HX.Tube.geometry.dheights[HX.Tube.nV]*HX.Tube.mediums[HX.Tube.nV].
              d);
          end if;
        elseif ( not HX.Tube.exposeState_a and HX.Tube.exposeState_b) then 
          if (HX.Tube.nV == 2) then 
            HX.Tube.Wb_flows[1] = HX.Tube.vs[1]*HX.Tube.geometry.crossAreas[1]*(
              (HX.Tube.mediums[2].p-HX.Tube.port_a.p)*5/8+HX.Tube.flowModel.dps_fg
              [1]+HX.Tube.flowModel.dps_fg[2]/2-HX.Tube.g_n*HX.Tube.geometry.dheights
              [1]*HX.Tube.mediums[1].d);
          else
            HX.Tube.Wb_flows[1] = HX.Tube.vs[1]*HX.Tube.geometry.crossAreas[1]*(
              (HX.Tube.mediums[2].p-HX.Tube.port_a.p)/1.5+HX.Tube.flowModel.dps_fg
              [1]+HX.Tube.flowModel.dps_fg[2]/2-HX.Tube.g_n*HX.Tube.geometry.dheights
              [1]*HX.Tube.mediums[1].d);
          end if;
          HX.Tube.Wb_flows[HX.Tube.nV] = HX.Tube.vs[HX.Tube.nV]*HX.Tube.geometry.crossAreas
            [HX.Tube.nV]*((HX.Tube.mediums[HX.Tube.nV].p-HX.Tube.mediums[
            HX.Tube.nV-1].p)/2+HX.Tube.flowModel.dps_fg[HX.Tube.nV]/2-
            HX.Tube.g_n*HX.Tube.geometry.dheights[HX.Tube.nV]*HX.Tube.mediums[
            HX.Tube.nV].d);
        elseif ( not HX.Tube.exposeState_a and  not HX.Tube.exposeState_b) then 
          HX.Tube.Wb_flows[1] = HX.Tube.vs[1]*HX.Tube.geometry.crossAreas[1]*((
            HX.Tube.mediums[2].p-HX.Tube.port_a.p)/1.5+HX.Tube.flowModel.dps_fg[1]
            +HX.Tube.flowModel.dps_fg[2]/2-HX.Tube.g_n*HX.Tube.geometry.dheights
            [1]*HX.Tube.mediums[1].d);
          HX.Tube.Wb_flows[HX.Tube.nV] = HX.Tube.vs[HX.Tube.nV]*HX.Tube.geometry.crossAreas
            [HX.Tube.nV]*((HX.Tube.port_b.p-HX.Tube.mediums[HX.Tube.nV-1].p)/1.5
            +HX.Tube.flowModel.dps_fg[HX.Tube.nV]/2+HX.Tube.flowModel.dps_fg[
            HX.Tube.nV+1]-HX.Tube.g_n*HX.Tube.geometry.dheights[HX.Tube.nV]*
            HX.Tube.mediums[HX.Tube.nV].d);
        else
          assert(false, "Unknown model structure");
        end if;
      end if;
    else
      HX.Tube.Wb_flows = zeros(HX.Tube.nV);
    end if;
    if (HX.Tube.exposeState_a and HX.Tube.exposeState_b) then 
      assert(HX.Tube.nV > 1, "nV must be > 1 if exposeState_a and exposeState_b = true");
    end if;
    if (HX.Tube.useLumpedPressure) then 
      if ( not (HX.Tube.exposeState_a and HX.Tube.exposeState_b)) then 
        if (HX.Tube.lumpPressureAt == TRANSFORM.Fluid.Types.LumpedLocation.
          port_a) then 
          fill(HX.Tube.mediums[1].p, HX.Tube.nV-1) = HX.Tube.mediums[2:
            HX.Tube.nV].p;
        elseif (HX.Tube.lumpPressureAt == TRANSFORM.Fluid.Types.LumpedLocation.
          port_b) then 
          fill(HX.Tube.mediums[HX.Tube.nV].p, HX.Tube.nV-1) = HX.Tube.mediums[1:
            HX.Tube.nV-1].p;
        else
          assert(false, "Unknown lumped pressure location");
        end if;
      elseif (HX.Tube.nV > 2) then 
        fill(HX.Tube.mediums[1].p, HX.Tube.iLumped-2) = HX.Tube.mediums[2:
          HX.Tube.iLumped-1].p;
        fill(HX.Tube.mediums[HX.Tube.nV].p, HX.Tube.nV-HX.Tube.iLumped) = 
          HX.Tube.mediums[HX.Tube.iLumped:HX.Tube.nV-1].p;
      end if;
      if (HX.Tube.exposeState_a and HX.Tube.exposeState_b) then 
        HX.Tube.m_flows[HX.Tube.iLumped] = HX.Tube.flowModel.m_flows[1];
        HX.Tube.port_a.p = HX.Tube.mediums[1].p;
        HX.Tube.port_b.p = HX.Tube.mediums[HX.Tube.nV].p;
        HX.Tube.statesFM[1] = HX.Tube.mediums[1].state;
        HX.Tube.statesFM[2] = HX.Tube.mediums[HX.Tube.nV].state;
        HX.Tube.vsFM[1] = HX.Tube.vs[1:HX.Tube.iLumped-1]*HX.Tube.geometry.dlengths
          [1:HX.Tube.iLumped-1]/sum(HX.Tube.geometry.dlengths[1:HX.Tube.iLumped-1]);
        HX.Tube.vsFM[2] = HX.Tube.vs[HX.Tube.iLumped:HX.Tube.nV]*
          HX.Tube.geometry.dlengths[HX.Tube.iLumped:HX.Tube.nV]/sum(
          HX.Tube.geometry.dlengths[HX.Tube.iLumped:HX.Tube.nV]);
        HX.Tube.Ts_wallFM[1] = sum(HX.Tube.Ts_wall[1, :])/HX.Tube.geometry.nSurfaces;
        HX.Tube.Ts_wallFM[2] = sum(HX.Tube.Ts_wall[HX.Tube.nV, :])/
          HX.Tube.geometry.nSurfaces;
      elseif (HX.Tube.exposeState_a and  not HX.Tube.exposeState_b) then 
        HX.Tube.m_flows[HX.Tube.nV+1] = HX.Tube.flowModel.m_flows[1];
        HX.Tube.port_a.p = HX.Tube.mediums[1].p;
        HX.Tube.statesFM[1] = HX.Tube.mediums[HX.Tube.iLumped].state;
        HX.Tube.statesFM[2] = HX.Tube.state_b;
        HX.Tube.vsFM[1] = HX.Tube.vs*HX.Tube.geometry.dlengths/sum(
          HX.Tube.geometry.dlengths);
        HX.Tube.vsFM[2] = HX.Tube.m_flows[HX.Tube.nV+1]/Modelica.Media.Water.WaterIF97_ph.density_Unique5
          (
          HX.Tube.state_b)/HX.Tube.geometry.crossAreas[HX.Tube.nV];
        HX.Tube.Ts_wallFM[1] = sum(HX.Tube.Ts_wall[HX.Tube.iLumped, :])/
          HX.Tube.geometry.nSurfaces;
        HX.Tube.Ts_wallFM[2] = sum(HX.Tube.Ts_wall[HX.Tube.nV, :])/
          HX.Tube.geometry.nSurfaces;
      elseif ( not HX.Tube.exposeState_a and HX.Tube.exposeState_b) then 
        HX.Tube.m_flows[1] = HX.Tube.flowModel.m_flows[1];
        HX.Tube.port_b.p = HX.Tube.mediums[HX.Tube.nV].p;
        HX.Tube.statesFM[1] = HX.Tube.state_a;
        HX.Tube.statesFM[2] = HX.Tube.mediums[HX.Tube.iLumped].state;
        HX.Tube.vsFM[1] = HX.Tube.m_flows[1]/Modelica.Media.Water.WaterIF97_ph.density_Unique5
          (
          HX.Tube.state_a)/HX.Tube.geometry.crossAreas[1];
        HX.Tube.vsFM[2] = HX.Tube.vs*HX.Tube.geometry.dlengths/sum(
          HX.Tube.geometry.dlengths);
        HX.Tube.Ts_wallFM[1] = sum(HX.Tube.Ts_wall[1, :])/HX.Tube.geometry.nSurfaces;
        HX.Tube.Ts_wallFM[2] = sum(HX.Tube.Ts_wall[HX.Tube.iLumped, :])/
          HX.Tube.geometry.nSurfaces;
      elseif ( not HX.Tube.exposeState_a and  not HX.Tube.exposeState_b) then 
        HX.Tube.m_flows[1] = HX.Tube.flowModel.m_flows[1];
        HX.Tube.m_flows[HX.Tube.nV+1] = HX.Tube.flowModel.m_flows[2];
        HX.Tube.statesFM[1] = HX.Tube.state_a;
        HX.Tube.statesFM[2] = HX.Tube.mediums[HX.Tube.iLumped].state;
        HX.Tube.statesFM[3] = HX.Tube.state_b;
        HX.Tube.vsFM[1] = HX.Tube.m_flows[1]/Modelica.Media.Water.WaterIF97_ph.density_Unique5
          (
          HX.Tube.state_a)/HX.Tube.geometry.crossAreas[1];
        HX.Tube.vsFM[2] = HX.Tube.vs*HX.Tube.geometry.dlengths/sum(
          HX.Tube.geometry.dlengths);
        HX.Tube.vsFM[3] = HX.Tube.m_flows[HX.Tube.nV+1]/Modelica.Media.Water.WaterIF97_ph.density_Unique5
          (
          HX.Tube.state_b)/HX.Tube.geometry.crossAreas[HX.Tube.nV];
        HX.Tube.Ts_wallFM[1] = sum(HX.Tube.Ts_wall[1, :])/HX.Tube.geometry.nSurfaces;
        HX.Tube.Ts_wallFM[2] = sum(HX.Tube.Ts_wall[HX.Tube.iLumped, :])/
          HX.Tube.geometry.nSurfaces;
        HX.Tube.Ts_wallFM[3] = sum(HX.Tube.Ts_wall[HX.Tube.nV, :])/
          HX.Tube.geometry.nSurfaces;
      else
        assert(false, "Unknown model structure");
      end if;
      if ( not ( not HX.Tube.exposeState_a and  not HX.Tube.exposeState_b))
         then 
        HX.Tube.dlengthsFM[1] = sum(HX.Tube.geometry.dlengths);
        HX.Tube.dheightsFM[1] = sum(HX.Tube.geometry.dheights);
        if (HX.Tube.nV == 1) then 
          HX.Tube.dimensionsFM[1:2] = {HX.Tube.geometry.dimensions[1], 
            HX.Tube.geometry.dimensions[1]};
          HX.Tube.crossAreasFM[1:2] = {HX.Tube.geometry.crossAreas[1], 
            HX.Tube.geometry.crossAreas[1]};
          HX.Tube.perimetersFM[1:2] = {HX.Tube.geometry.perimeters[1], 
            HX.Tube.geometry.perimeters[1]};
          HX.Tube.roughnessesFM[1:2] = {HX.Tube.geometry.roughnesses[1], 
            HX.Tube.geometry.roughnesses[1]};
        else
          HX.Tube.dimensionsFM[1:2] = {sum(HX.Tube.geometry.dimensions[1:
            HX.Tube.iLumped-1])/(HX.Tube.iLumped-1), sum(HX.Tube.geometry.dimensions
            [HX.Tube.iLumped:HX.Tube.nV])/(HX.Tube.nV-HX.Tube.iLumped+1)};
          HX.Tube.crossAreasFM[1:2] = {sum(HX.Tube.geometry.crossAreas[1:
            HX.Tube.iLumped-1])/(HX.Tube.iLumped-1), sum(HX.Tube.geometry.crossAreas
            [HX.Tube.iLumped:HX.Tube.nV])/(HX.Tube.nV-HX.Tube.iLumped+1)};
          HX.Tube.perimetersFM[1:2] = {sum(HX.Tube.geometry.perimeters[1:
            HX.Tube.iLumped-1])/(HX.Tube.iLumped-1), sum(HX.Tube.geometry.perimeters
            [HX.Tube.iLumped:HX.Tube.nV])/(HX.Tube.nV-HX.Tube.iLumped+1)};
          HX.Tube.roughnessesFM[1:2] = {sum(HX.Tube.geometry.roughnesses[1:
            HX.Tube.iLumped-1])/(HX.Tube.iLumped-1), sum(HX.Tube.geometry.roughnesses
            [HX.Tube.iLumped:HX.Tube.nV])/(HX.Tube.nV-HX.Tube.iLumped+1)};
        end if;
      else
        if (HX.Tube.nV == 1) then 
          HX.Tube.dlengthsFM[1:2] = {HX.Tube.geometry.dlengths[1]/2, 
            HX.Tube.geometry.dlengths[1]/2};
          HX.Tube.dheightsFM[1:2] = {HX.Tube.geometry.dheights[1]/2, 
            HX.Tube.geometry.dheights[1]/2};
          HX.Tube.dimensionsFM[1:3] = {HX.Tube.geometry.dimensions[1], 
            HX.Tube.geometry.dimensions[1], HX.Tube.geometry.dimensions[1]};
          HX.Tube.crossAreasFM[1:3] = {HX.Tube.geometry.crossAreas[1], 
            HX.Tube.geometry.crossAreas[1], HX.Tube.geometry.crossAreas[1]};
          HX.Tube.perimetersFM[1:3] = {HX.Tube.geometry.perimeters[1], 
            HX.Tube.geometry.perimeters[1], HX.Tube.geometry.perimeters[1]};
          HX.Tube.roughnessesFM[1:3] = {HX.Tube.geometry.roughnesses[1], 
            HX.Tube.geometry.roughnesses[1], HX.Tube.geometry.roughnesses[1]};
        else
          HX.Tube.dlengthsFM[1:2] = {sum(HX.Tube.geometry.dlengths[1:
            HX.Tube.iLumped-1]), sum(HX.Tube.geometry.dlengths[HX.Tube.iLumped:
            HX.Tube.nV])};
          HX.Tube.dheightsFM[1:2] = {sum(HX.Tube.geometry.dheights[1:
            HX.Tube.iLumped-1]), sum(HX.Tube.geometry.dheights[HX.Tube.iLumped:
            HX.Tube.nV])};
          HX.Tube.dimensionsFM[1:3] = {sum(HX.Tube.geometry.dimensions[1:
            HX.Tube.iLumped-1])/(HX.Tube.iLumped-1), sum(HX.Tube.geometry.dimensions)
            /HX.Tube.nV, sum(HX.Tube.geometry.dimensions[HX.Tube.iLumped:
            HX.Tube.nV])/(HX.Tube.nV-HX.Tube.iLumped+1)};
          HX.Tube.crossAreasFM[1:3] = {sum(HX.Tube.geometry.crossAreas[1:
            HX.Tube.iLumped-1])/(HX.Tube.iLumped-1), sum(HX.Tube.geometry.crossAreas)
            /HX.Tube.nV, sum(HX.Tube.geometry.crossAreas[HX.Tube.iLumped:
            HX.Tube.nV])/(HX.Tube.nV-HX.Tube.iLumped+1)};
          HX.Tube.perimetersFM[1:3] = {sum(HX.Tube.geometry.perimeters[1:
            HX.Tube.iLumped-1])/(HX.Tube.iLumped-1), sum(HX.Tube.geometry.perimeters)
            /HX.Tube.nV, sum(HX.Tube.geometry.perimeters[HX.Tube.iLumped:
            HX.Tube.nV])/(HX.Tube.nV-HX.Tube.iLumped+1)};
          HX.Tube.roughnessesFM[1:3] = {sum(HX.Tube.geometry.roughnesses[1:
            HX.Tube.iLumped-1])/(HX.Tube.iLumped-1), sum(HX.Tube.geometry.roughnesses)
            /HX.Tube.nV, sum(HX.Tube.geometry.roughnesses[HX.Tube.iLumped:
            HX.Tube.nV])/(HX.Tube.nV-HX.Tube.iLumped+1)};
        end if;
      end if;
    else
      if (HX.Tube.exposeState_a and HX.Tube.exposeState_b) then 
        HX.Tube.m_flows[2:HX.Tube.nV] = HX.Tube.flowModel.m_flows[1:HX.Tube.nV-1];
        HX.Tube.port_a.p = HX.Tube.mediums[1].p;
        HX.Tube.port_b.p = HX.Tube.mediums[HX.Tube.nV].p;
        for i in (1:HX.Tube.nFM+1) loop
          HX.Tube.statesFM[i] = HX.Tube.mediums[i].state;
          HX.Tube.vsFM[i] = HX.Tube.vs[i];
          HX.Tube.Ts_wallFM[i] = sum(HX.Tube.Ts_wall[i, :])/HX.Tube.geometry.nSurfaces;
        end for;
        for i in (1:HX.Tube.nFM+1) loop
          HX.Tube.crossAreasFM[i] = HX.Tube.geometry.crossAreas[i];
          HX.Tube.dimensionsFM[i] = HX.Tube.geometry.dimensions[i];
          HX.Tube.perimetersFM[i] = HX.Tube.geometry.perimeters[i];
          HX.Tube.roughnessesFM[i] = HX.Tube.geometry.roughnesses[i];
        end for;
        if (HX.Tube.nFM == 1) then 
          HX.Tube.dlengthsFM[1] = HX.Tube.geometry.dlengths[1]+HX.Tube.geometry.dlengths
            [2];
          HX.Tube.dheightsFM[1] = HX.Tube.geometry.dheights[1]+HX.Tube.geometry.dheights
            [2];
        else
          HX.Tube.dlengthsFM[1] = HX.Tube.geometry.dlengths[1]+0.5*
            HX.Tube.geometry.dlengths[2];
          HX.Tube.dheightsFM[1] = HX.Tube.geometry.dheights[1]+0.5*
            HX.Tube.geometry.dheights[2];
          for i in (2:HX.Tube.nFM-1) loop
            HX.Tube.dlengthsFM[i] = 0.5*(HX.Tube.geometry.dlengths[i]+
              HX.Tube.geometry.dlengths[i+1]);
            HX.Tube.dheightsFM[i] = 0.5*(HX.Tube.geometry.dheights[i]+
              HX.Tube.geometry.dheights[i+1]);
          end for;
          HX.Tube.dlengthsFM[HX.Tube.nFM] = 0.5*HX.Tube.geometry.dlengths[
            HX.Tube.nFM]+HX.Tube.geometry.dlengths[HX.Tube.nFM+1];
          HX.Tube.dheightsFM[HX.Tube.nFM] = 0.5*HX.Tube.geometry.dheights[
            HX.Tube.nFM]+HX.Tube.geometry.dheights[HX.Tube.nFM+1];
        end if;
      elseif (HX.Tube.exposeState_a and  not HX.Tube.exposeState_b) then 
        HX.Tube.m_flows[2:HX.Tube.nV+1] = HX.Tube.flowModel.m_flows[1:HX.Tube.nV];
        HX.Tube.port_a.p = HX.Tube.mediums[1].p;
        for i in (1:HX.Tube.nFM) loop
          HX.Tube.statesFM[i] = HX.Tube.mediums[i].state;
          HX.Tube.vsFM[i] = HX.Tube.vs[i];
          HX.Tube.Ts_wallFM[i] = sum(HX.Tube.Ts_wall[i, :])/HX.Tube.geometry.nSurfaces;
        end for;
        HX.Tube.statesFM[HX.Tube.nFM+1] = HX.Tube.state_b;
        HX.Tube.vsFM[HX.Tube.nFM+1] = HX.Tube.m_flows[HX.Tube.nFM+1]/
          Modelica.Media.Water.WaterIF97_ph.density_Unique5(
          HX.Tube.state_b)/HX.Tube.geometry.crossAreas[HX.Tube.nV];
        HX.Tube.Ts_wallFM[HX.Tube.nFM+1] = sum(HX.Tube.Ts_wall[HX.Tube.nV, :])/
          HX.Tube.geometry.nSurfaces;
        for i in (1:HX.Tube.nFM) loop
          HX.Tube.crossAreasFM[i] = HX.Tube.geometry.crossAreas[i];
          HX.Tube.dimensionsFM[i] = HX.Tube.geometry.dimensions[i];
          HX.Tube.perimetersFM[i] = HX.Tube.geometry.perimeters[i];
          HX.Tube.roughnessesFM[i] = HX.Tube.geometry.roughnesses[i];
        end for;
        HX.Tube.crossAreasFM[HX.Tube.nFM+1] = HX.Tube.geometry.crossAreas[
          HX.Tube.nV];
        HX.Tube.dimensionsFM[HX.Tube.nFM+1] = HX.Tube.geometry.dimensions[
          HX.Tube.nV];
        HX.Tube.perimetersFM[HX.Tube.nFM+1] = HX.Tube.geometry.perimeters[
          HX.Tube.nV];
        HX.Tube.roughnessesFM[HX.Tube.nFM+1] = HX.Tube.geometry.roughnesses[
          HX.Tube.nV];
        if (HX.Tube.nFM == 1) then 
          HX.Tube.dlengthsFM[1] = HX.Tube.geometry.dlengths[1];
          HX.Tube.dheightsFM[1] = HX.Tube.geometry.dheights[1];
        else
          HX.Tube.dlengthsFM[1] = HX.Tube.geometry.dlengths[1]+0.5*
            HX.Tube.geometry.dlengths[2];
          HX.Tube.dheightsFM[1] = HX.Tube.geometry.dheights[1]+0.5*
            HX.Tube.geometry.dheights[2];
          for i in (2:HX.Tube.nFM-1) loop
            HX.Tube.dlengthsFM[i] = 0.5*(HX.Tube.geometry.dlengths[i]+
              HX.Tube.geometry.dlengths[i+1]);
            HX.Tube.dheightsFM[i] = 0.5*(HX.Tube.geometry.dheights[i]+
              HX.Tube.geometry.dheights[i+1]);
          end for;
          HX.Tube.dlengthsFM[HX.Tube.nFM] = 0.5*HX.Tube.geometry.dlengths[
            HX.Tube.nFM];
          HX.Tube.dheightsFM[HX.Tube.nFM] = 0.5*HX.Tube.geometry.dheights[
            HX.Tube.nFM];
        end if;
      elseif ( not HX.Tube.exposeState_a and HX.Tube.exposeState_b) then 
        HX.Tube.m_flows[1:HX.Tube.nV] = HX.Tube.flowModel.m_flows[1:HX.Tube.nV];
        HX.Tube.port_b.p = HX.Tube.mediums[HX.Tube.nV].p;
        HX.Tube.statesFM[1] = HX.Tube.state_a;
        HX.Tube.vsFM[1] = HX.Tube.m_flows[1]/Modelica.Media.Water.WaterIF97_ph.density_Unique5
          (
          HX.Tube.state_a)/HX.Tube.geometry.crossAreas[1];
        HX.Tube.Ts_wallFM[1] = sum(HX.Tube.Ts_wall[1, :])/HX.Tube.geometry.nSurfaces;
        for i in (2:HX.Tube.nFM+1) loop
          HX.Tube.statesFM[i] = HX.Tube.mediums[i-1].state;
          HX.Tube.vsFM[i] = HX.Tube.vs[i-1];
          HX.Tube.Ts_wallFM[i] = sum(HX.Tube.Ts_wall[i-1, :])/HX.Tube.geometry.nSurfaces;
        end for;
        HX.Tube.crossAreasFM[1] = HX.Tube.geometry.crossAreas[1];
        HX.Tube.dimensionsFM[1] = HX.Tube.geometry.dimensions[1];
        HX.Tube.perimetersFM[1] = HX.Tube.geometry.perimeters[1];
        HX.Tube.roughnessesFM[1] = HX.Tube.geometry.roughnesses[1];
        for i in (2:HX.Tube.nFM+1) loop
          HX.Tube.crossAreasFM[i] = HX.Tube.geometry.crossAreas[i-1];
          HX.Tube.dimensionsFM[i] = HX.Tube.geometry.dimensions[i-1];
          HX.Tube.perimetersFM[i] = HX.Tube.geometry.perimeters[i-1];
          HX.Tube.roughnessesFM[i] = HX.Tube.geometry.roughnesses[i-1];
        end for;
        if (HX.Tube.nFM == 1) then 
          HX.Tube.dlengthsFM[1] = HX.Tube.geometry.dlengths[1];
          HX.Tube.dheightsFM[1] = HX.Tube.geometry.dheights[1];
        else
          HX.Tube.dlengthsFM[1] = 0.5*HX.Tube.geometry.dlengths[1];
          HX.Tube.dheightsFM[1] = 0.5*HX.Tube.geometry.dheights[1];
          for i in (2:HX.Tube.nFM-1) loop
            HX.Tube.dlengthsFM[i] = 0.5*(HX.Tube.geometry.dlengths[i-1]+
              HX.Tube.geometry.dlengths[i]);
            HX.Tube.dheightsFM[i] = 0.5*(HX.Tube.geometry.dheights[i-1]+
              HX.Tube.geometry.dheights[i]);
          end for;
          HX.Tube.dlengthsFM[HX.Tube.nFM] = 0.5*HX.Tube.geometry.dlengths[
            HX.Tube.nFM-1]+HX.Tube.geometry.dlengths[HX.Tube.nFM];
          HX.Tube.dheightsFM[HX.Tube.nFM] = 0.5*HX.Tube.geometry.dheights[
            HX.Tube.nFM-1]+HX.Tube.geometry.dheights[HX.Tube.nFM];
        end if;
      elseif ( not HX.Tube.exposeState_a and  not HX.Tube.exposeState_b) then 
        HX.Tube.m_flows[1:HX.Tube.nV+1] = HX.Tube.flowModel.m_flows[1:HX.Tube.nV
          +1];
        HX.Tube.statesFM[1] = HX.Tube.state_a;
        HX.Tube.vsFM[1] = HX.Tube.m_flows[1]/Modelica.Media.Water.WaterIF97_ph.density_Unique5
          (
          HX.Tube.state_a)/HX.Tube.geometry.crossAreas[1];
        HX.Tube.Ts_wallFM[1] = sum(HX.Tube.Ts_wall[1, :])/HX.Tube.geometry.nSurfaces;
        for i in (2:HX.Tube.nFM) loop
          HX.Tube.statesFM[i] = HX.Tube.mediums[i-1].state;
          HX.Tube.vsFM[i] = HX.Tube.vs[i-1];
          HX.Tube.Ts_wallFM[i] = sum(HX.Tube.Ts_wall[i-1, :])/HX.Tube.geometry.nSurfaces;
        end for;
        HX.Tube.statesFM[HX.Tube.nFM+1] = HX.Tube.state_b;
        HX.Tube.vsFM[HX.Tube.nFM+1] = HX.Tube.m_flows[HX.Tube.nFM]/
          Modelica.Media.Water.WaterIF97_ph.density_Unique5(
          HX.Tube.state_b)/HX.Tube.geometry.crossAreas[HX.Tube.nV];
        HX.Tube.Ts_wallFM[HX.Tube.nFM+1] = sum(HX.Tube.Ts_wall[HX.Tube.nV, :])/
          HX.Tube.geometry.nSurfaces;
        HX.Tube.crossAreasFM[1] = HX.Tube.geometry.crossAreas[1];
        HX.Tube.dimensionsFM[1] = HX.Tube.geometry.dimensions[1];
        HX.Tube.perimetersFM[1] = HX.Tube.geometry.perimeters[1];
        HX.Tube.roughnessesFM[1] = HX.Tube.geometry.roughnesses[1];
        for i in (2:HX.Tube.nFM) loop
          HX.Tube.crossAreasFM[i] = HX.Tube.geometry.crossAreas[i-1];
          HX.Tube.dimensionsFM[i] = HX.Tube.geometry.dimensions[i-1];
          HX.Tube.perimetersFM[i] = HX.Tube.geometry.perimeters[i-1];
          HX.Tube.roughnessesFM[i] = HX.Tube.geometry.roughnesses[i-1];
        end for;
        HX.Tube.crossAreasFM[HX.Tube.nFM+1] = HX.Tube.geometry.crossAreas[
          HX.Tube.nV];
        HX.Tube.dimensionsFM[HX.Tube.nFM+1] = HX.Tube.geometry.dimensions[
          HX.Tube.nV];
        HX.Tube.perimetersFM[HX.Tube.nFM+1] = HX.Tube.geometry.perimeters[
          HX.Tube.nV];
        HX.Tube.roughnessesFM[HX.Tube.nFM+1] = HX.Tube.geometry.roughnesses[
          HX.Tube.nV];
        HX.Tube.dlengthsFM[1] = 0.5*HX.Tube.geometry.dlengths[1];
        HX.Tube.dheightsFM[1] = 0.5*HX.Tube.geometry.dheights[1];
        for i in (2:HX.Tube.nFM-1) loop
          HX.Tube.dlengthsFM[i] = 0.5*(HX.Tube.geometry.dlengths[i-1]+
            HX.Tube.geometry.dlengths[i]);
          HX.Tube.dheightsFM[i] = 0.5*(HX.Tube.geometry.dheights[i-1]+
            HX.Tube.geometry.dheights[i]);
        end for;
        HX.Tube.dlengthsFM[HX.Tube.nFM] = 0.5*HX.Tube.geometry.dlengths[
          HX.Tube.nFM-1];
        HX.Tube.dheightsFM[HX.Tube.nFM] = 0.5*HX.Tube.geometry.dheights[
          HX.Tube.nFM-1];
      else
        assert(false, "Unknown model structure");
      end if;
    end if;
    HX.Tube.heatPorts[1, 1].Q_flow+HX.Tube.heatPorts_int[1, 1].Q_flow-
      HX.Tube.heatTransfer.heatPorts[1, 1].Q_flow = 0.0;
    HX.Tube.heatPorts_int[1, 1].T = HX.Tube.heatPorts[1, 1].T;
    HX.Tube.heatTransfer.heatPorts[1, 1].T = HX.Tube.heatPorts[1, 1].T;
     -HX.Tube.traceMassTransfer.massPorts[1, 1].n_flow = 0.0*HX.Tube.traceMassTransfer.massPorts[1, 1].n_flow;

  // Component HX.HXTube.flowModel
  // class Modelica.Fluid.Pipes.BaseClasses.PartialStraightPipe.FlowModel
    // extends Modelica.Fluid.Interfaces.PartialDistributedFlow
    equation
      HX.HXTube.flowModel.Is = array(HX.HXTube.flowModel.m_flows[i]*
        HX.HXTube.flowModel.pathLengths[i] for i in 1:HX.HXTube.flowModel.m);
      if (HX.HXTube.flowModel.momentumDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) then 
        zeros(HX.HXTube.flowModel.m) = HX.HXTube.flowModel.Ib_flows-
          HX.HXTube.flowModel.Fs_p-HX.HXTube.flowModel.Fs_fg;
      else
        der(HX.HXTube.flowModel.Is) = HX.HXTube.flowModel.Ib_flows-
          HX.HXTube.flowModel.Fs_p-HX.HXTube.flowModel.Fs_fg;
      end if;
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialStaggeredFlowModel
    equation
      if ( not HX.HXTube.flowModel.allowFlowReversal) then 
        HX.HXTube.flowModel.rhos_act = HX.HXTube.flowModel.rhos[1:
          HX.HXTube.flowModel.n-1];
        HX.HXTube.flowModel.mus_act = HX.HXTube.flowModel.mus[1:HX.HXTube.flowModel.n
          -1];
      elseif ( not HX.HXTube.flowModel.useUpstreamScheme) then 
        HX.HXTube.flowModel.rhos_act = 0.5*(HX.HXTube.flowModel.rhos[1:
          HX.HXTube.flowModel.n-1]+HX.HXTube.flowModel.rhos[2:HX.HXTube.flowModel.n]);
        HX.HXTube.flowModel.mus_act = 0.5*(HX.HXTube.flowModel.mus[1:
          HX.HXTube.flowModel.n-1]+HX.HXTube.flowModel.mus[2:HX.HXTube.flowModel.n]);
      else
        for i in (1:HX.HXTube.flowModel.n-1) loop
          HX.HXTube.flowModel.rhos_act[i] = noEvent((if HX.HXTube.flowModel.m_flows
            [i] > 0 then HX.HXTube.flowModel.rhos[i] else HX.HXTube.flowModel.rhos
            [i+1]));
          HX.HXTube.flowModel.mus_act[i] = noEvent((if HX.HXTube.flowModel.m_flows
            [i] > 0 then HX.HXTube.flowModel.mus[i] else HX.HXTube.flowModel.mus
            [i+1]));
        end for;
      end if;
      if (HX.HXTube.flowModel.use_Ib_flows) then 
        HX.HXTube.flowModel.Ib_flows = HX.HXTube.flowModel.nParallel*(array(
          HX.HXTube.flowModel.rhos[i]*HX.HXTube.flowModel.vs[i]*HX.HXTube.flowModel.vs
          [i]*HX.HXTube.flowModel.crossAreas[i]-HX.HXTube.flowModel.rhos[i+1]*
          HX.HXTube.flowModel.vs[i+1]*HX.HXTube.flowModel.vs[i+1]*
          HX.HXTube.flowModel.crossAreas[i+1] for i in 1:HX.HXTube.flowModel.n-1));
      else
        HX.HXTube.flowModel.Ib_flows = zeros(HX.HXTube.flowModel.n-1);
      end if;
      HX.HXTube.flowModel.Fs_p = HX.HXTube.flowModel.nParallel*(array(0.5*(
        HX.HXTube.flowModel.crossAreas[i]+HX.HXTube.flowModel.crossAreas[i+1])*(
        Modelica.Media.Water.WaterIF97_ph.pressure_Unique11(
        HX.HXTube.flowModel.states[i+1])-Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
        (
        HX.HXTube.flowModel.states[i])) for i in 1:HX.HXTube.flowModel.n-1));
      HX.HXTube.flowModel.dps_fg = array(HX.HXTube.flowModel.Fs_fg[i]/
        HX.HXTube.flowModel.nParallel*2/(HX.HXTube.flowModel.crossAreas[i]+
        HX.HXTube.flowModel.crossAreas[i+1]) for i in 1:HX.HXTube.flowModel.n-1);
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialGenericPipeFlow
    equation
      for i in (1:HX.HXTube.flowModel.n-1) loop
        assert(HX.HXTube.flowModel.m_flows[i] >  -HX.HXTube.flowModel.m_flow_small
           or HX.HXTube.flowModel.allowFlowReversal, "Reversing flow occurs even though allowFlowReversal is false");
      end for;
      if (HX.HXTube.flowModel.continuousFlowReversal) then 
        if (HX.HXTube.flowModel.from_dp and true) then 
          HX.HXTube.flowModel.m_flows = homotopy(massFlowRate_dp_Unique14(
            HX.HXTube.flowModel.dps_fg-(array(HX.HXTube.flowModel.g*
            HX.HXTube.flowModel.dheights[i]*HX.HXTube.flowModel.rhos_act[i] for 
            i in 1:HX.HXTube.flowModel.n-1)), HX.HXTube.flowModel.rhos_act, 
            HX.HXTube.flowModel.rhos_act, HX.HXTube.flowModel.mus_act, 
            HX.HXTube.flowModel.mus_act, HX.HXTube.flowModel.pathLengths_internal,
             HX.HXTube.flowModel.diameters, (HX.HXTube.flowModel.crossAreas[1:
            HX.HXTube.flowModel.n-1]+HX.HXTube.flowModel.crossAreas[2:
            HX.HXTube.flowModel.n])/2, (HX.HXTube.flowModel.roughnesses[1:
            HX.HXTube.flowModel.n-1]+HX.HXTube.flowModel.roughnesses[2:
            HX.HXTube.flowModel.n])/2, HX.HXTube.flowModel.dp_small/(
            HX.HXTube.flowModel.n-1), HX.HXTube.flowModel.Res_turbulent_internal)
            *HX.HXTube.flowModel.nParallel, HX.HXTube.flowModel.m_flow_nominal/
            HX.HXTube.flowModel.dp_nominal*(HX.HXTube.flowModel.dps_fg-
            HX.HXTube.flowModel.g*HX.HXTube.flowModel.dheights*HX.HXTube.flowModel.rho_nominal));
        else
          HX.HXTube.flowModel.dps_fg = homotopy(pressureLoss_m_flow_Unique12(
            HX.HXTube.flowModel.m_flows/HX.HXTube.flowModel.nParallel, 
            HX.HXTube.flowModel.rhos_act, HX.HXTube.flowModel.rhos_act, 
            HX.HXTube.flowModel.mus_act, HX.HXTube.flowModel.mus_act, 
            HX.HXTube.flowModel.pathLengths_internal, HX.HXTube.flowModel.diameters,
             (HX.HXTube.flowModel.crossAreas[1:HX.HXTube.flowModel.n-1]+
            HX.HXTube.flowModel.crossAreas[2:HX.HXTube.flowModel.n])/2, (
            HX.HXTube.flowModel.roughnesses[1:HX.HXTube.flowModel.n-1]+
            HX.HXTube.flowModel.roughnesses[2:HX.HXTube.flowModel.n])/2, 
            HX.HXTube.flowModel.m_flow_small/HX.HXTube.flowModel.nParallel, 
            HX.HXTube.flowModel.Res_turbulent_internal)+(array(HX.HXTube.flowModel.g
            *HX.HXTube.flowModel.dheights[i]*HX.HXTube.flowModel.rhos_act[i]
             for i in 1:HX.HXTube.flowModel.n-1)), HX.HXTube.flowModel.dp_nominal
            /HX.HXTube.flowModel.m_flow_nominal*HX.HXTube.flowModel.m_flows+
            HX.HXTube.flowModel.g*HX.HXTube.flowModel.dheights*HX.HXTube.flowModel.rho_nominal);
        end if;
      else
        if (HX.HXTube.flowModel.from_dp and true) then 
          HX.HXTube.flowModel.m_flows = homotopy(massFlowRate_dp_staticHead_Unique16
            (HX.HXTube.flowModel.dps_fg, HX.HXTube.flowModel.rhos[1:
            HX.HXTube.flowModel.n-1], HX.HXTube.flowModel.rhos[2:
            HX.HXTube.flowModel.n], HX.HXTube.flowModel.mus[1:HX.HXTube.flowModel.n
            -1], HX.HXTube.flowModel.mus[2:HX.HXTube.flowModel.n], 
            HX.HXTube.flowModel.pathLengths_internal, HX.HXTube.flowModel.diameters,
             HX.HXTube.flowModel.g*HX.HXTube.flowModel.dheights, (
            HX.HXTube.flowModel.crossAreas[1:HX.HXTube.flowModel.n-1]+
            HX.HXTube.flowModel.crossAreas[2:HX.HXTube.flowModel.n])/2, (
            HX.HXTube.flowModel.roughnesses[1:HX.HXTube.flowModel.n-1]+
            HX.HXTube.flowModel.roughnesses[2:HX.HXTube.flowModel.n])/2, 
            HX.HXTube.flowModel.dp_small/(HX.HXTube.flowModel.n-1), 
            HX.HXTube.flowModel.Res_turbulent_internal)*HX.HXTube.flowModel.nParallel,
             HX.HXTube.flowModel.m_flow_nominal/HX.HXTube.flowModel.dp_nominal*(
            HX.HXTube.flowModel.dps_fg-HX.HXTube.flowModel.g*HX.HXTube.flowModel.dheights
            *HX.HXTube.flowModel.rho_nominal));
        else
          HX.HXTube.flowModel.dps_fg = homotopy(pressureLoss_m_flow_staticHead_Unique17
            (HX.HXTube.flowModel.m_flows/HX.HXTube.flowModel.nParallel, 
            HX.HXTube.flowModel.rhos[1:HX.HXTube.flowModel.n-1], 
            HX.HXTube.flowModel.rhos[2:HX.HXTube.flowModel.n], HX.HXTube.flowModel.mus
            [1:HX.HXTube.flowModel.n-1], HX.HXTube.flowModel.mus[2:
            HX.HXTube.flowModel.n], HX.HXTube.flowModel.pathLengths_internal, 
            HX.HXTube.flowModel.diameters, HX.HXTube.flowModel.g*
            HX.HXTube.flowModel.dheights, (HX.HXTube.flowModel.crossAreas[1:
            HX.HXTube.flowModel.n-1]+HX.HXTube.flowModel.crossAreas[2:
            HX.HXTube.flowModel.n])/2, (HX.HXTube.flowModel.roughnesses[1:
            HX.HXTube.flowModel.n-1]+HX.HXTube.flowModel.roughnesses[2:
            HX.HXTube.flowModel.n])/2, HX.HXTube.flowModel.m_flow_small/
            HX.HXTube.flowModel.nParallel, HX.HXTube.flowModel.Res_turbulent_internal),
             HX.HXTube.flowModel.dp_nominal/HX.HXTube.flowModel.m_flow_nominal*
            HX.HXTube.flowModel.m_flows+HX.HXTube.flowModel.g*HX.HXTube.flowModel.dheights
            *HX.HXTube.flowModel.rho_nominal);
        end if;
      end if;
    // end of extends 

  // Component HX.HXTube
  // class Modelica.Fluid.Pipes.StaticPipe
    // extends Modelica.Fluid.Pipes.BaseClasses.PartialStraightPipe
    equation
      assert(HX.HXTube.length >= HX.HXTube.height_ab, "Parameter length must be greater or equal height_ab.");
    // end of extends 
  equation
    HX.HXTube.port_a.m_flow = HX.HXTube.flowModel.m_flows[1];
    0 = HX.HXTube.port_a.m_flow+HX.HXTube.port_b.m_flow;
    HX.HXTube.port_a.Xi_outflow = inStream(HX.HXTube.port_b.Xi_outflow);
    HX.HXTube.port_b.Xi_outflow = inStream(HX.HXTube.port_a.Xi_outflow);
    HX.HXTube.port_a.C_outflow = inStream(HX.HXTube.port_b.C_outflow);
    HX.HXTube.port_b.C_outflow = inStream(HX.HXTube.port_a.C_outflow);
    HX.HXTube.port_b.h_outflow = inStream(HX.HXTube.port_a.h_outflow)-
      HX.HXTube.system.g*HX.HXTube.height_ab;
    HX.HXTube.port_a.h_outflow = inStream(HX.HXTube.port_b.h_outflow)+
      HX.HXTube.system.g*HX.HXTube.height_ab;

  // Component HX.InletS_Shell
  // class TRANSFORM.Fluid.Sensors.Temperature
    // extends TRANSFORM.Fluid.Sensors.BaseClasses.PartialAbsoluteSensor
    equation
      HX.InletS_Shell.port.m_flow = 0;
      HX.InletS_Shell.port.h_outflow = 84013.0581525969;
      HX.InletS_Shell.port.Xi_outflow = {};
      HX.InletS_Shell.port.C_outflow = zeros(0);
    // end of extends 
  equation
    HX.InletS_Shell.T = Modelica.Media.Water.WaterIF97_ph.temperature_Unique39(
      Modelica.Media.Water.WaterIF97_ph.setState_phX_Unique40(HX.InletS_Shell.port.p,
         inStream(HX.InletS_Shell.port.h_outflow), inStream(HX.InletS_Shell.port.Xi_outflow),
         0, 0));

  // Component HX.OutletS_Shell
  // class TRANSFORM.Fluid.Sensors.Temperature
    // extends TRANSFORM.Fluid.Sensors.BaseClasses.PartialAbsoluteSensor
    equation
      HX.OutletS_Shell.port.m_flow = 0;
      HX.OutletS_Shell.port.h_outflow = 84013.0581525969;
      HX.OutletS_Shell.port.Xi_outflow = {};
      HX.OutletS_Shell.port.C_outflow = zeros(0);
    // end of extends 
  equation
    HX.OutletS_Shell.T = Modelica.Media.Water.WaterIF97_ph.temperature_Unique39(
      Modelica.Media.Water.WaterIF97_ph.setState_phX_Unique40(HX.OutletS_Shell.port.p,
         inStream(HX.OutletS_Shell.port.h_outflow), inStream(HX.OutletS_Shell.port.Xi_outflow),
         0, 0));

