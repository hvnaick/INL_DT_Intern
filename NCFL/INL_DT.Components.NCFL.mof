            -1]+heater1.HeaterPipe.flowModel.crossAreas[2:heater1.HeaterPipe.flowModel.n])
            /2, (heater1.HeaterPipe.flowModel.roughnesses[1:heater1.HeaterPipe.flowModel.n
            -1]+heater1.HeaterPipe.flowModel.roughnesses[2:heater1.HeaterPipe.flowModel.n])
            /2, heater1.HeaterPipe.flowModel.m_flow_small/heater1.HeaterPipe.flowModel.nParallel,
             heater1.HeaterPipe.flowModel.Res_turbulent_internal)+(array(
            heater1.HeaterPipe.flowModel.g*heater1.HeaterPipe.flowModel.dheights
            [i]*heater1.HeaterPipe.flowModel.rhos_act[i] for i in 1:
            heater1.HeaterPipe.flowModel.n-1)), heater1.HeaterPipe.flowModel.dp_nominal
            /heater1.HeaterPipe.flowModel.m_flow_nominal*heater1.HeaterPipe.flowModel.m_flows
            +heater1.HeaterPipe.flowModel.g*heater1.HeaterPipe.flowModel.dheights
            *heater1.HeaterPipe.flowModel.rho_nominal);
        end if;
      else
        if (heater1.HeaterPipe.flowModel.from_dp and true) then 
          heater1.HeaterPipe.flowModel.m_flows = homotopy(massFlowRate_dp_staticHead_Unique16
            (heater1.HeaterPipe.flowModel.dps_fg, heater1.HeaterPipe.flowModel.rhos
            [1:heater1.HeaterPipe.flowModel.n-1], heater1.HeaterPipe.flowModel.rhos
            [2:heater1.HeaterPipe.flowModel.n], heater1.HeaterPipe.flowModel.mus
            [1:heater1.HeaterPipe.flowModel.n-1], heater1.HeaterPipe.flowModel.mus
            [2:heater1.HeaterPipe.flowModel.n], heater1.HeaterPipe.flowModel.pathLengths_internal,
             heater1.HeaterPipe.flowModel.diameters, heater1.HeaterPipe.flowModel.g
            *heater1.HeaterPipe.flowModel.dheights, (heater1.HeaterPipe.flowModel.crossAreas
            [1:heater1.HeaterPipe.flowModel.n-1]+heater1.HeaterPipe.flowModel.crossAreas
            [2:heater1.HeaterPipe.flowModel.n])/2, (heater1.HeaterPipe.flowModel.roughnesses
            [1:heater1.HeaterPipe.flowModel.n-1]+heater1.HeaterPipe.flowModel.roughnesses
            [2:heater1.HeaterPipe.flowModel.n])/2, heater1.HeaterPipe.flowModel.dp_small
            /(heater1.HeaterPipe.flowModel.n-1), heater1.HeaterPipe.flowModel.Res_turbulent_internal)
            *heater1.HeaterPipe.flowModel.nParallel, heater1.HeaterPipe.flowModel.m_flow_nominal
            /heater1.HeaterPipe.flowModel.dp_nominal*(heater1.HeaterPipe.flowModel.dps_fg
            -heater1.HeaterPipe.flowModel.g*heater1.HeaterPipe.flowModel.dheights
            *heater1.HeaterPipe.flowModel.rho_nominal));
        else
          heater1.HeaterPipe.flowModel.dps_fg = homotopy(pressureLoss_m_flow_staticHead_Unique17
            (heater1.HeaterPipe.flowModel.m_flows/heater1.HeaterPipe.flowModel.nParallel,
             heater1.HeaterPipe.flowModel.rhos[1:heater1.HeaterPipe.flowModel.n-1],
             heater1.HeaterPipe.flowModel.rhos[2:heater1.HeaterPipe.flowModel.n],
             heater1.HeaterPipe.flowModel.mus[1:heater1.HeaterPipe.flowModel.n-1],
             heater1.HeaterPipe.flowModel.mus[2:heater1.HeaterPipe.flowModel.n],
             heater1.HeaterPipe.flowModel.pathLengths_internal, heater1.HeaterPipe.flowModel.diameters,
             heater1.HeaterPipe.flowModel.g*heater1.HeaterPipe.flowModel.dheights,
             (heater1.HeaterPipe.flowModel.crossAreas[1:heater1.HeaterPipe.flowModel.n
            -1]+heater1.HeaterPipe.flowModel.crossAreas[2:heater1.HeaterPipe.flowModel.n])
            /2, (heater1.HeaterPipe.flowModel.roughnesses[1:heater1.HeaterPipe.flowModel.n
            -1]+heater1.HeaterPipe.flowModel.roughnesses[2:heater1.HeaterPipe.flowModel.n])
            /2, heater1.HeaterPipe.flowModel.m_flow_small/heater1.HeaterPipe.flowModel.nParallel,
             heater1.HeaterPipe.flowModel.Res_turbulent_internal), 
            heater1.HeaterPipe.flowModel.dp_nominal/heater1.HeaterPipe.flowModel.m_flow_nominal
            *heater1.HeaterPipe.flowModel.m_flows+heater1.HeaterPipe.flowModel.g
            *heater1.HeaterPipe.flowModel.dheights*heater1.HeaterPipe.flowModel.rho_nominal);
        end if;
      end if;
    // end of extends 

  // Component heater1.HeaterPipe
  // class Modelica.Fluid.Pipes.StaticPipe
    // extends Modelica.Fluid.Pipes.BaseClasses.PartialStraightPipe
    equation
      assert(heater1.HeaterPipe.length >= heater1.HeaterPipe.height_ab, 
        "Parameter length must be greater or equal height_ab.");
    // end of extends 
  equation
    heater1.HeaterPipe.port_a.m_flow = heater1.HeaterPipe.flowModel.m_flows[1];
    0 = heater1.HeaterPipe.port_a.m_flow+heater1.HeaterPipe.port_b.m_flow;
    heater1.HeaterPipe.port_a.Xi_outflow = inStream(heater1.HeaterPipe.port_b.Xi_outflow);
    heater1.HeaterPipe.port_b.Xi_outflow = inStream(heater1.HeaterPipe.port_a.Xi_outflow);
    heater1.HeaterPipe.port_a.C_outflow = inStream(heater1.HeaterPipe.port_b.C_outflow);
    heater1.HeaterPipe.port_b.C_outflow = inStream(heater1.HeaterPipe.port_a.C_outflow);
    heater1.HeaterPipe.port_b.h_outflow = inStream(heater1.HeaterPipe.port_a.h_outflow)
      -heater1.HeaterPipe.system.g*heater1.HeaterPipe.height_ab;
    heater1.HeaterPipe.port_a.h_outflow = inStream(heater1.HeaterPipe.port_b.h_outflow)
      +heater1.HeaterPipe.system.g*heater1.HeaterPipe.height_ab;

  // Component heater1
  // class INL_DT.Components.Heater
  equation
    heater1.HeatSRC.port.Q_flow+heater1.Heater.heatPorts[1, 1].Q_flow = 0.0;
    heater1.Heater.heatPorts[1, 1].T = heater1.HeatSRC.port.T;
    heater1.Heater.heatPorts_int[1, 1].Q_flow = 0.0;
    heater1.Heater.port_a.m_flow+heater1.HeaterPipe.port_b.m_flow = 0.0;
    heater1.HeaterPipe.port_b.p = heater1.Heater.port_a.p;
    heater1.port_b.m_flow-heater1.Heater.port_b.m_flow = 0.0;
    heater1.port_b.p = heater1.Heater.port_b.p;
    heater1.port_a.m_flow-heater1.HeaterPipe.port_a.m_flow = 0.0;
    heater1.port_a.p = heater1.HeaterPipe.port_a.p;

  // Component JetSuction.flowModel
  // class INL_DT.Components.NCFL.FlowModel
    // extends Modelica.Fluid.Interfaces.PartialDistributedFlow
    equation
      JetSuction.flowModel.Is = array(JetSuction.flowModel.m_flows[i]*
        JetSuction.flowModel.pathLengths[i] for i in 1:JetSuction.flowModel.m);
      if (JetSuction.flowModel.momentumDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) then 
        zeros(JetSuction.flowModel.m) = JetSuction.flowModel.Ib_flows-
          JetSuction.flowModel.Fs_p-JetSuction.flowModel.Fs_fg;
      else
        der(JetSuction.flowModel.Is) = JetSuction.flowModel.Ib_flows-
          JetSuction.flowModel.Fs_p-JetSuction.flowModel.Fs_fg;
      end if;
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialStaggeredFlowModel
    equation
      if ( not JetSuction.flowModel.allowFlowReversal) then 
        JetSuction.flowModel.rhos_act = JetSuction.flowModel.rhos[1:
          JetSuction.flowModel.n-1];
        JetSuction.flowModel.mus_act = JetSuction.flowModel.mus[1:
          JetSuction.flowModel.n-1];
      elseif ( not JetSuction.flowModel.useUpstreamScheme) then 
        JetSuction.flowModel.rhos_act = 0.5*(JetSuction.flowModel.rhos[1:
          JetSuction.flowModel.n-1]+JetSuction.flowModel.rhos[2:JetSuction.flowModel.n]);
        JetSuction.flowModel.mus_act = 0.5*(JetSuction.flowModel.mus[1:
          JetSuction.flowModel.n-1]+JetSuction.flowModel.mus[2:JetSuction.flowModel.n]);
      else
        for i in (1:JetSuction.flowModel.n-1) loop
          JetSuction.flowModel.rhos_act[i] = noEvent((if JetSuction.flowModel.m_flows
            [i] > 0 then JetSuction.flowModel.rhos[i] else JetSuction.flowModel.rhos
            [i+1]));
          JetSuction.flowModel.mus_act[i] = noEvent((if JetSuction.flowModel.m_flows
            [i] > 0 then JetSuction.flowModel.mus[i] else JetSuction.flowModel.mus
            [i+1]));
        end for;
      end if;
      if (JetSuction.flowModel.use_Ib_flows) then 
        JetSuction.flowModel.Ib_flows = JetSuction.flowModel.nParallel*(array(
          JetSuction.flowModel.rhos[i]*JetSuction.flowModel.vs[i]*
          JetSuction.flowModel.vs[i]*JetSuction.flowModel.crossAreas[i]-
          JetSuction.flowModel.rhos[i+1]*JetSuction.flowModel.vs[i+1]*
          JetSuction.flowModel.vs[i+1]*JetSuction.flowModel.crossAreas[i+1] for 
          i in 1:JetSuction.flowModel.n-1));
      else
        JetSuction.flowModel.Ib_flows = zeros(JetSuction.flowModel.n-1);
      end if;
      JetSuction.flowModel.Fs_p = JetSuction.flowModel.nParallel*(array(0.5*(
        JetSuction.flowModel.crossAreas[i]+JetSuction.flowModel.crossAreas[i+1])
        *(Modelica.Media.Water.WaterIF97_ph.pressure_Unique11(
        JetSuction.flowModel.states[i+1])-Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
        (
        JetSuction.flowModel.states[i])) for i in 1:JetSuction.flowModel.n-1));
      JetSuction.flowModel.dps_fg = array(JetSuction.flowModel.Fs_fg[i]/
        JetSuction.flowModel.nParallel*2/(JetSuction.flowModel.crossAreas[i]+
        JetSuction.flowModel.crossAreas[i+1]) for i in 1:JetSuction.flowModel.n-1);
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialGenericPipeFlow
    equation
      for i in (1:JetSuction.flowModel.n-1) loop
        assert(JetSuction.flowModel.m_flows[i] >  -JetSuction.flowModel.m_flow_small
           or JetSuction.flowModel.allowFlowReversal, "Reversing flow occurs even though allowFlowReversal is false");
      end for;
      if (JetSuction.flowModel.continuousFlowReversal) then 
        if (JetSuction.flowModel.from_dp and true) then 
          JetSuction.flowModel.m_flows = homotopy(massFlowRate_dp_Unique14(
            JetSuction.flowModel.dps_fg-(array(JetSuction.flowModel.g*
            JetSuction.flowModel.dheights[i]*JetSuction.flowModel.rhos_act[i]
             for i in 1:JetSuction.flowModel.n-1)), JetSuction.flowModel.rhos_act,
             JetSuction.flowModel.rhos_act, JetSuction.flowModel.mus_act, 
            JetSuction.flowModel.mus_act, JetSuction.flowModel.pathLengths_internal,
             JetSuction.flowModel.diameters, (JetSuction.flowModel.crossAreas[1:
            JetSuction.flowModel.n-1]+JetSuction.flowModel.crossAreas[2:
            JetSuction.flowModel.n])/2, (JetSuction.flowModel.roughnesses[1:
            JetSuction.flowModel.n-1]+JetSuction.flowModel.roughnesses[2:
            JetSuction.flowModel.n])/2, JetSuction.flowModel.dp_small/(
            JetSuction.flowModel.n-1), JetSuction.flowModel.Res_turbulent_internal)
            *JetSuction.flowModel.nParallel, JetSuction.flowModel.m_flow_nominal
            /JetSuction.flowModel.dp_nominal*(JetSuction.flowModel.dps_fg-
            JetSuction.flowModel.g*JetSuction.flowModel.dheights*
            JetSuction.flowModel.rho_nominal));
        else
          JetSuction.flowModel.dps_fg = homotopy(pressureLoss_m_flow_Unique12(
            JetSuction.flowModel.m_flows/JetSuction.flowModel.nParallel, 
            JetSuction.flowModel.rhos_act, JetSuction.flowModel.rhos_act, 
            JetSuction.flowModel.mus_act, JetSuction.flowModel.mus_act, 
            JetSuction.flowModel.pathLengths_internal, JetSuction.flowModel.diameters,
             (JetSuction.flowModel.crossAreas[1:JetSuction.flowModel.n-1]+
            JetSuction.flowModel.crossAreas[2:JetSuction.flowModel.n])/2, (
            JetSuction.flowModel.roughnesses[1:JetSuction.flowModel.n-1]+
            JetSuction.flowModel.roughnesses[2:JetSuction.flowModel.n])/2, 
            JetSuction.flowModel.m_flow_small/JetSuction.flowModel.nParallel, 
            JetSuction.flowModel.Res_turbulent_internal)+(array(JetSuction.flowModel.g
            *JetSuction.flowModel.dheights[i]*JetSuction.flowModel.rhos_act[i]
             for i in 1:JetSuction.flowModel.n-1)), JetSuction.flowModel.dp_nominal
            /JetSuction.flowModel.m_flow_nominal*JetSuction.flowModel.m_flows+
            JetSuction.flowModel.g*JetSuction.flowModel.dheights*
            JetSuction.flowModel.rho_nominal);
        end if;
      else
        if (JetSuction.flowModel.from_dp and true) then 
          JetSuction.flowModel.m_flows = homotopy(massFlowRate_dp_staticHead_Unique16
            (JetSuction.flowModel.dps_fg, JetSuction.flowModel.rhos[1:
            JetSuction.flowModel.n-1], JetSuction.flowModel.rhos[2:
            JetSuction.flowModel.n], JetSuction.flowModel.mus[1:JetSuction.flowModel.n
            -1], JetSuction.flowModel.mus[2:JetSuction.flowModel.n], 
            JetSuction.flowModel.pathLengths_internal, JetSuction.flowModel.diameters,
             JetSuction.flowModel.g*JetSuction.flowModel.dheights, (
            JetSuction.flowModel.crossAreas[1:JetSuction.flowModel.n-1]+
            JetSuction.flowModel.crossAreas[2:JetSuction.flowModel.n])/2, (
            JetSuction.flowModel.roughnesses[1:JetSuction.flowModel.n-1]+
            JetSuction.flowModel.roughnesses[2:JetSuction.flowModel.n])/2, 
            JetSuction.flowModel.dp_small/(JetSuction.flowModel.n-1), 
            JetSuction.flowModel.Res_turbulent_internal)*JetSuction.flowModel.nParallel,
             JetSuction.flowModel.m_flow_nominal/JetSuction.flowModel.dp_nominal
            *(JetSuction.flowModel.dps_fg-JetSuction.flowModel.g*
            JetSuction.flowModel.dheights*JetSuction.flowModel.rho_nominal));
        else
          JetSuction.flowModel.dps_fg = homotopy(pressureLoss_m_flow_staticHead_Unique17
            (JetSuction.flowModel.m_flows/JetSuction.flowModel.nParallel, 
            JetSuction.flowModel.rhos[1:JetSuction.flowModel.n-1], 
            JetSuction.flowModel.rhos[2:JetSuction.flowModel.n], 
            JetSuction.flowModel.mus[1:JetSuction.flowModel.n-1], 
            JetSuction.flowModel.mus[2:JetSuction.flowModel.n], JetSuction.flowModel.pathLengths_internal,
             JetSuction.flowModel.diameters, JetSuction.flowModel.g*
            JetSuction.flowModel.dheights, (JetSuction.flowModel.crossAreas[1:
            JetSuction.flowModel.n-1]+JetSuction.flowModel.crossAreas[2:
            JetSuction.flowModel.n])/2, (JetSuction.flowModel.roughnesses[1:
            JetSuction.flowModel.n-1]+JetSuction.flowModel.roughnesses[2:
            JetSuction.flowModel.n])/2, JetSuction.flowModel.m_flow_small/
            JetSuction.flowModel.nParallel, JetSuction.flowModel.Res_turbulent_internal),
             JetSuction.flowModel.dp_nominal/JetSuction.flowModel.m_flow_nominal
            *JetSuction.flowModel.m_flows+JetSuction.flowModel.g*
            JetSuction.flowModel.dheights*JetSuction.flowModel.rho_nominal);
        end if;
      end if;
    // end of extends 

  // Component JetSuction
  // class Modelica.Fluid.Pipes.StaticPipe
    // extends Modelica.Fluid.Pipes.BaseClasses.PartialStraightPipe
    equation
      assert(JetSuction.length >= JetSuction.height_ab, "Parameter length must be greater or equal height_ab.");
    // end of extends 
  equation
    JetSuction.port_a.m_flow = JetSuction.flowModel.m_flows[1];
    0 = JetSuction.port_a.m_flow+JetSuction.port_b.m_flow;
    JetSuction.port_a.Xi_outflow = inStream(JetSuction.port_b.Xi_outflow);
    JetSuction.port_b.Xi_outflow = inStream(JetSuction.port_a.Xi_outflow);
    JetSuction.port_a.C_outflow = inStream(JetSuction.port_b.C_outflow);
    JetSuction.port_b.C_outflow = inStream(JetSuction.port_a.C_outflow);
    JetSuction.port_b.h_outflow = inStream(JetSuction.port_a.h_outflow)-
      JetSuction.system.g*JetSuction.height_ab;
    JetSuction.port_a.h_outflow = inStream(JetSuction.port_b.h_outflow)+
      JetSuction.system.g*JetSuction.height_ab;

