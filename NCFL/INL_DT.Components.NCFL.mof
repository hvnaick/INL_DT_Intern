  parameter Boolean HX.HXPipe.flowModel.use_mu_nominal = false "= true, if mu_nominal is used, otherwise computed from medium";
  parameter Modelica.Units.SI.DynamicViscosity HX.HXPipe.flowModel.mu_nominal = 
