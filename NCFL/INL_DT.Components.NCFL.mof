     and  not heater1.Heater.exposeState_b then cat(1, {heater1.Heater.T_a_start},
     {0.5*(heater1.Heater.T_a_start+heater1.Heater.T_b_start)}, {
    heater1.Heater.T_b_start}) else cat(1, {heater1.Heater.T_a_start}, {
    heater1.Heater.T_b_start})) else (if  not heater1.Heater.exposeState_a and 
     not heater1.Heater.exposeState_b then (if heater1.Heater.nV == 1 then cat(1,
     {heater1.Heater.T_a_start}, {0.5*(heater1.Heater.T_a_start+heater1.Heater.T_b_start)},
     {heater1.Heater.T_b_start}) else cat(1, {heater1.Heater.T_a_start}, array(
    heater1.Heater.Ts_start[i] for i in 1:heater1.Heater.nV), {heater1.Heater.T_b_start}))
     else (if  not heater1.Heater.exposeState_a and heater1.Heater.exposeState_b
     then (if heater1.Heater.nV == 1 then cat(1, {heater1.Heater.T_a_start}, {
    heater1.Heater.T_b_start}) else cat(1, {heater1.Heater.T_a_start}, array(
    heater1.Heater.Ts_start[i] for i in 1:heater1.Heater.nV))) else (if 
    heater1.Heater.exposeState_a and  not heater1.Heater.exposeState_b then (if 
    heater1.Heater.nV == 1 then cat(1, {heater1.Heater.T_a_start}, {
    heater1.Heater.T_b_start}) else cat(1, array(heater1.Heater.Ts_start[i] for 
    i in 1:heater1.Heater.nV), {heater1.Heater.T_b_start})) else array(
    heater1.Heater.Ts_start[i] for i in 1:heater1.Heater.nV)))));
