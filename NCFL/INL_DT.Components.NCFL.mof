  parameter Modelica.Units.SI.MassFlowRate HX.HXTube.flowModel.system.m_flow_start
     = 0 "Default start value for mass flow rates";
  parameter Modelica.Units.SI.AbsolutePressure HX.HXTube.flowModel.system.p_start
     = HX.HXTube.flowModel.system.p_ambient "Default start value for pressures";
  parameter Modelica.Units.SI.Temperature HX.HXTube.flowModel.system.T_start = 
    HX.HXTube.flowModel.system.T_ambient "Default start value for temperatures";
  parameter Boolean HX.HXTube.flowModel.system.use_eps_Re = false 
    "= true to determine turbulent region automatically using Reynolds number";
  parameter Modelica.Units.SI.MassFlowRate HX.HXTube.flowModel.system.m_flow_nominal
     = (if HX.HXTube.flowModel.system.use_eps_Re then 1 else 100.0*
    HX.HXTube.flowModel.system.m_flow_small) "Default nominal mass flow rate";
  parameter Real HX.HXTube.flowModel.system.eps_m_flow(min = 0.0) = 0.0001 
    "Regularization of zero flow for |m_flow| < eps_m_flow*m_flow_nominal";
  parameter Modelica.Units.SI.AbsolutePressure HX.HXTube.flowModel.system.dp_small
     = 1 "Default small pressure drop for regularization of laminar and zero flow";
  parameter Modelica.Units.SI.MassFlowRate HX.HXTube.flowModel.system.m_flow_small
    (min = 0.0) = 0.01 "Default small mass flow rate for regularization of laminar and zero flow";
  parameter Integer HX.HXTube.flowModel.m = HX.HXTube.flowModel.n-1 
    "Number of flow segments";
  parameter Boolean HX.HXTube.flowModel.useUpstreamScheme = true 
    "= false to average upstream and downstream properties across flow segments";
  parameter Boolean HX.HXTube.flowModel.use_Ib_flows = HX.HXTube.flowModel.momentumDynamics
     <> Modelica.Fluid.Types.Dynamics.SteadyState "= true to consider differences in flow of momentum through boundaries";
  parameter Modelica.Units.SI.ReynoldsNumber HX.HXTube.flowModel.Re_turbulent = 4000
     "Start of turbulent regime, depending on type of flow device";
  constant Boolean HX.HXTube.flowModel.show_Res = false "= true, if Reynolds numbers are included for plotting";
  parameter Boolean HX.HXTube.flowModel.use_rho_nominal = false "= true, if rho_nominal is used, otherwise computed from medium";
  parameter Modelica.Units.SI.Density HX.HXTube.flowModel.rho_nominal = 
    Modelica.Media.Water.WaterIF97_ph.density_pTX_Unique7(101325, 293.15, {1.0})
     "Nominal density (e.g., rho_liquidWater = 995, rho_air = 1.2)";
  parameter Boolean HX.HXTube.flowModel.use_mu_nominal = false "= true, if mu_nominal is used, otherwise computed from medium";
  parameter Modelica.Units.SI.DynamicViscosity HX.HXTube.flowModel.mu_nominal = 
    Modelica.Media.Water.WaterIF97_ph.dynamicViscosity_Unique6(
    Modelica.Media.Water.WaterIF97_ph.setState_pTX_Unique8(101325, 293.15, {1.0},
       0, 0)) "Nominal dynamic viscosity (e.g., mu_liquidWater = 1e-3, mu_air = 1.8e-5)";
  parameter Modelica.Units.SI.AbsolutePressure HX.HXTube.flowModel.dp_nominal(
    fixed = false) = 1 "Nominal pressure loss (only for nominal models)";
  parameter Modelica.Units.SI.MassFlowRate HX.HXTube.flowModel.m_flow_nominal = 
    (if HX.HXTube.flowModel.system.use_eps_Re then HX.HXTube.flowModel.system.m_flow_nominal
     else 100.0*HX.HXTube.flowModel.m_flow_small) "Nominal mass flow rate";
  parameter Modelica.Units.SI.MassFlowRate HX.HXTube.flowModel.m_flow_small = (
    if HX.HXTube.flowModel.system.use_eps_Re then HX.HXTube.flowModel.system.eps_m_flow
    *HX.HXTube.flowModel.m_flow_nominal else HX.HXTube.flowModel.system.m_flow_small)
     "Within regularization if |m_flows| < m_flow_small (may be wider for large discontinuities in static head)";
  parameter Modelica.Units.SI.AbsolutePressure HX.HXTube.flowModel.dp_small(
    fixed = false) = 1 "Within regularization if |dp| < dp_small (may be wider for large discontinuities in static head)";
  parameter Boolean HX.HXTube.flowModel.constantPressureLossCoefficient = 
    HX.HXTube.flowModel.use_rho_nominal and (HX.HXTube.flowModel.use_mu_nominal
     or false) "= true, if the pressure loss does not depend on fluid states";
  parameter Boolean HX.HXTube.flowModel.continuousFlowReversal =  not 
    HX.HXTube.flowModel.useUpstreamScheme or HX.HXTube.flowModel.constantPressureLossCoefficient
     or  not HX.HXTube.flowModel.allowFlowReversal "= true, if the pressure loss is continuous around zero flow";
  constant Boolean HX.InletS_Shell.allowFlowReversal = true "= true to allow flow reversal, false restricts to design direction (port_a -> port_b)";
  parameter Boolean HX.InletS_Shell.showName = true "= false to hide component name";
  parameter Integer HX.InletS_Shell.precision(min = 0.0) = 0 "Number of decimals displayed";
  constant Boolean HX.OutletS_Shell.allowFlowReversal = true "= true to allow flow reversal, false restricts to design direction (port_a -> port_b)";
  parameter Boolean HX.OutletS_Shell.showName = true "= false to hide component name";
