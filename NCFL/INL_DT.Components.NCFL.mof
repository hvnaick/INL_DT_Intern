  // Component V1_Inlet.flowModel
  // class INL_DT.Components.NCFL.FlowModel
    // extends Modelica.Fluid.Interfaces.PartialDistributedFlow
    equation
      V1_Inlet.flowModel.Is = array(V1_Inlet.flowModel.m_flows[i]*
        V1_Inlet.flowModel.pathLengths[i] for i in 1:V1_Inlet.flowModel.m);
      if (V1_Inlet.flowModel.momentumDynamics == Modelica.Fluid.Types.Dynamics.
        SteadyState) then 
        zeros(V1_Inlet.flowModel.m) = V1_Inlet.flowModel.Ib_flows-
          V1_Inlet.flowModel.Fs_p-V1_Inlet.flowModel.Fs_fg;
      else
        der(V1_Inlet.flowModel.Is) = V1_Inlet.flowModel.Ib_flows-
          V1_Inlet.flowModel.Fs_p-V1_Inlet.flowModel.Fs_fg;
      end if;
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialStaggeredFlowModel
    equation
      if ( not V1_Inlet.flowModel.allowFlowReversal) then 
        V1_Inlet.flowModel.rhos_act = V1_Inlet.flowModel.rhos[1:V1_Inlet.flowModel.n
          -1];
        V1_Inlet.flowModel.mus_act = V1_Inlet.flowModel.mus[1:V1_Inlet.flowModel.n
          -1];
      elseif ( not V1_Inlet.flowModel.useUpstreamScheme) then 
        V1_Inlet.flowModel.rhos_act = 0.5*(V1_Inlet.flowModel.rhos[1:
          V1_Inlet.flowModel.n-1]+V1_Inlet.flowModel.rhos[2:V1_Inlet.flowModel.n]);
        V1_Inlet.flowModel.mus_act = 0.5*(V1_Inlet.flowModel.mus[1:
          V1_Inlet.flowModel.n-1]+V1_Inlet.flowModel.mus[2:V1_Inlet.flowModel.n]);
      else
        for i in (1:V1_Inlet.flowModel.n-1) loop
          V1_Inlet.flowModel.rhos_act[i] = noEvent((if V1_Inlet.flowModel.m_flows
            [i] > 0 then V1_Inlet.flowModel.rhos[i] else V1_Inlet.flowModel.rhos
            [i+1]));
          V1_Inlet.flowModel.mus_act[i] = noEvent((if V1_Inlet.flowModel.m_flows
            [i] > 0 then V1_Inlet.flowModel.mus[i] else V1_Inlet.flowModel.mus[i
            +1]));
        end for;
      end if;
      if (V1_Inlet.flowModel.use_Ib_flows) then 
        V1_Inlet.flowModel.Ib_flows = V1_Inlet.flowModel.nParallel*(array(
          V1_Inlet.flowModel.rhos[i]*V1_Inlet.flowModel.vs[i]*V1_Inlet.flowModel.vs
          [i]*V1_Inlet.flowModel.crossAreas[i]-V1_Inlet.flowModel.rhos[i+1]*
          V1_Inlet.flowModel.vs[i+1]*V1_Inlet.flowModel.vs[i+1]*V1_Inlet.flowModel.crossAreas
          [i+1] for i in 1:V1_Inlet.flowModel.n-1));
      else
        V1_Inlet.flowModel.Ib_flows = zeros(V1_Inlet.flowModel.n-1);
      end if;
      V1_Inlet.flowModel.Fs_p = V1_Inlet.flowModel.nParallel*(array(0.5*(
        V1_Inlet.flowModel.crossAreas[i]+V1_Inlet.flowModel.crossAreas[i+1])*(
        Modelica.Media.Water.WaterIF97_ph.pressure_Unique11(
        V1_Inlet.flowModel.states[i+1])-Modelica.Media.Water.WaterIF97_ph.pressure_Unique11
        (
        V1_Inlet.flowModel.states[i])) for i in 1:V1_Inlet.flowModel.n-1));
      V1_Inlet.flowModel.dps_fg = array(V1_Inlet.flowModel.Fs_fg[i]/
        V1_Inlet.flowModel.nParallel*2/(V1_Inlet.flowModel.crossAreas[i]+
        V1_Inlet.flowModel.crossAreas[i+1]) for i in 1:V1_Inlet.flowModel.n-1);
    // extends Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialGenericPipeFlow
    equation
      for i in (1:V1_Inlet.flowModel.n-1) loop
        assert(V1_Inlet.flowModel.m_flows[i] >  -V1_Inlet.flowModel.m_flow_small
           or V1_Inlet.flowModel.allowFlowReversal, "Reversing flow occurs even though allowFlowReversal is false");
      end for;
      if (V1_Inlet.flowModel.continuousFlowReversal) then 
        if (V1_Inlet.flowModel.from_dp and true) then 
          V1_Inlet.flowModel.m_flows = homotopy(massFlowRate_dp_Unique14(
            V1_Inlet.flowModel.dps_fg-(array(V1_Inlet.flowModel.g*
            V1_Inlet.flowModel.dheights[i]*V1_Inlet.flowModel.rhos_act[i] for i
             in 1:V1_Inlet.flowModel.n-1)), V1_Inlet.flowModel.rhos_act, 
            V1_Inlet.flowModel.rhos_act, V1_Inlet.flowModel.mus_act, 
            V1_Inlet.flowModel.mus_act, V1_Inlet.flowModel.pathLengths_internal,
             V1_Inlet.flowModel.diameters, (V1_Inlet.flowModel.crossAreas[1:
            V1_Inlet.flowModel.n-1]+V1_Inlet.flowModel.crossAreas[2:
            V1_Inlet.flowModel.n])/2, (V1_Inlet.flowModel.roughnesses[1:
            V1_Inlet.flowModel.n-1]+V1_Inlet.flowModel.roughnesses[2:
            V1_Inlet.flowModel.n])/2, V1_Inlet.flowModel.dp_small/(
            V1_Inlet.flowModel.n-1), V1_Inlet.flowModel.Res_turbulent_internal)*
            V1_Inlet.flowModel.nParallel, V1_Inlet.flowModel.m_flow_nominal/
            V1_Inlet.flowModel.dp_nominal*(V1_Inlet.flowModel.dps_fg-
            V1_Inlet.flowModel.g*V1_Inlet.flowModel.dheights*V1_Inlet.flowModel.rho_nominal));
        else
          V1_Inlet.flowModel.dps_fg = homotopy(pressureLoss_m_flow_Unique12(
            V1_Inlet.flowModel.m_flows/V1_Inlet.flowModel.nParallel, 
            V1_Inlet.flowModel.rhos_act, V1_Inlet.flowModel.rhos_act, 
            V1_Inlet.flowModel.mus_act, V1_Inlet.flowModel.mus_act, 
            V1_Inlet.flowModel.pathLengths_internal, V1_Inlet.flowModel.diameters,
             (V1_Inlet.flowModel.crossAreas[1:V1_Inlet.flowModel.n-1]+
            V1_Inlet.flowModel.crossAreas[2:V1_Inlet.flowModel.n])/2, (
            V1_Inlet.flowModel.roughnesses[1:V1_Inlet.flowModel.n-1]+
            V1_Inlet.flowModel.roughnesses[2:V1_Inlet.flowModel.n])/2, 
            V1_Inlet.flowModel.m_flow_small/V1_Inlet.flowModel.nParallel, 
            V1_Inlet.flowModel.Res_turbulent_internal)+(array(V1_Inlet.flowModel.g
            *V1_Inlet.flowModel.dheights[i]*V1_Inlet.flowModel.rhos_act[i] for i
             in 1:V1_Inlet.flowModel.n-1)), V1_Inlet.flowModel.dp_nominal/
            V1_Inlet.flowModel.m_flow_nominal*V1_Inlet.flowModel.m_flows+
            V1_Inlet.flowModel.g*V1_Inlet.flowModel.dheights*V1_Inlet.flowModel.rho_nominal);
        end if;
      else
        if (V1_Inlet.flowModel.from_dp and true) then 
          V1_Inlet.flowModel.m_flows = homotopy(massFlowRate_dp_staticHead_Unique16
            (V1_Inlet.flowModel.dps_fg, V1_Inlet.flowModel.rhos[1:
            V1_Inlet.flowModel.n-1], V1_Inlet.flowModel.rhos[2:V1_Inlet.flowModel.n],
             V1_Inlet.flowModel.mus[1:V1_Inlet.flowModel.n-1], V1_Inlet.flowModel.mus
            [2:V1_Inlet.flowModel.n], V1_Inlet.flowModel.pathLengths_internal, 
            V1_Inlet.flowModel.diameters, V1_Inlet.flowModel.g*V1_Inlet.flowModel.dheights,
             (V1_Inlet.flowModel.crossAreas[1:V1_Inlet.flowModel.n-1]+
            V1_Inlet.flowModel.crossAreas[2:V1_Inlet.flowModel.n])/2, (
            V1_Inlet.flowModel.roughnesses[1:V1_Inlet.flowModel.n-1]+
            V1_Inlet.flowModel.roughnesses[2:V1_Inlet.flowModel.n])/2, 
            V1_Inlet.flowModel.dp_small/(V1_Inlet.flowModel.n-1), 
            V1_Inlet.flowModel.Res_turbulent_internal)*V1_Inlet.flowModel.nParallel,
             V1_Inlet.flowModel.m_flow_nominal/V1_Inlet.flowModel.dp_nominal*(
            V1_Inlet.flowModel.dps_fg-V1_Inlet.flowModel.g*V1_Inlet.flowModel.dheights
            *V1_Inlet.flowModel.rho_nominal));
        else
          V1_Inlet.flowModel.dps_fg = homotopy(pressureLoss_m_flow_staticHead_Unique17
            (V1_Inlet.flowModel.m_flows/V1_Inlet.flowModel.nParallel, 
            V1_Inlet.flowModel.rhos[1:V1_Inlet.flowModel.n-1], V1_Inlet.flowModel.rhos
            [2:V1_Inlet.flowModel.n], V1_Inlet.flowModel.mus[1:V1_Inlet.flowModel.n
            -1], V1_Inlet.flowModel.mus[2:V1_Inlet.flowModel.n], 
            V1_Inlet.flowModel.pathLengths_internal, V1_Inlet.flowModel.diameters,
             V1_Inlet.flowModel.g*V1_Inlet.flowModel.dheights, (V1_Inlet.flowModel.crossAreas
            [1:V1_Inlet.flowModel.n-1]+V1_Inlet.flowModel.crossAreas[2:
            V1_Inlet.flowModel.n])/2, (V1_Inlet.flowModel.roughnesses[1:
            V1_Inlet.flowModel.n-1]+V1_Inlet.flowModel.roughnesses[2:
            V1_Inlet.flowModel.n])/2, V1_Inlet.flowModel.m_flow_small/
            V1_Inlet.flowModel.nParallel, V1_Inlet.flowModel.Res_turbulent_internal),
             V1_Inlet.flowModel.dp_nominal/V1_Inlet.flowModel.m_flow_nominal*
            V1_Inlet.flowModel.m_flows+V1_Inlet.flowModel.g*V1_Inlet.flowModel.dheights
            *V1_Inlet.flowModel.rho_nominal);
        end if;
      end if;
    // end of extends 

  // Component V1_Inlet
  // class Modelica.Fluid.Pipes.StaticPipe
    // extends Modelica.Fluid.Pipes.BaseClasses.PartialStraightPipe
    equation
      assert(V1_Inlet.length >= V1_Inlet.height_ab, "Parameter length must be greater or equal height_ab.");
    // end of extends 
  equation
    V1_Inlet.port_a.m_flow = V1_Inlet.flowModel.m_flows[1];
    0 = V1_Inlet.port_a.m_flow+V1_Inlet.port_b.m_flow;
    V1_Inlet.port_a.Xi_outflow = inStream(V1_Inlet.port_b.Xi_outflow);
    V1_Inlet.port_b.Xi_outflow = inStream(V1_Inlet.port_a.Xi_outflow);
    V1_Inlet.port_a.C_outflow = inStream(V1_Inlet.port_b.C_outflow);
    V1_Inlet.port_b.C_outflow = inStream(V1_Inlet.port_a.C_outflow);
    V1_Inlet.port_b.h_outflow = inStream(V1_Inlet.port_a.h_outflow)-
      V1_Inlet.system.g*V1_Inlet.height_ab;
    V1_Inlet.port_a.h_outflow = inStream(V1_Inlet.port_b.h_outflow)+
      V1_Inlet.system.g*V1_Inlet.height_ab;

  // Component V_top.minLimiter
  // class Modelica.Fluid.Valves.BaseClasses.PartialValve.MinLimiter
  equation
    V_top.minLimiter.y = smooth(0, noEvent((if V_top.minLimiter.u < 
      V_top.minLimiter.uMin then V_top.minLimiter.uMin else V_top.minLimiter.u)));

  // Component V_top
  // class Modelica.Fluid.Valves.ValveIncompressible
    // extends Modelica.Fluid.Interfaces.PartialTwoPortTransport
    equation
      V_top.state_a = Modelica.Media.Water.WaterIF97_ph.setState_phX_Unique1(
        V_top.port_a.p, inStream(V_top.port_a.h_outflow), inStream(
        V_top.port_a.Xi_outflow), 0, 0);
      V_top.state_b = Modelica.Media.Water.WaterIF97_ph.setState_phX_Unique1(
        V_top.port_b.p, inStream(V_top.port_b.h_outflow), inStream(
        V_top.port_b.Xi_outflow), 0, 0);
      V_top.dp = V_top.port_a.p-V_top.port_b.p;
      V_top.m_flow = V_top.port_a.m_flow;
      assert(V_top.m_flow >  -V_top.m_flow_small or V_top.allowFlowReversal, 
        "Reversing flow occurs even though allowFlowReversal is false");
      V_top.port_a.m_flow+V_top.port_b.m_flow = 0;
      V_top.port_a.Xi_outflow = inStream(V_top.port_b.Xi_outflow);
      V_top.port_b.Xi_outflow = inStream(V_top.port_a.Xi_outflow);
      V_top.port_a.C_outflow = inStream(V_top.port_b.C_outflow);
      V_top.port_b.C_outflow = inStream(V_top.port_a.C_outflow);
    // extends Modelica.Fluid.Valves.BaseClasses.PartialValve
    equation
      V_top.port_a.h_outflow = inStream(V_top.port_b.h_outflow);
      V_top.port_b.h_outflow = inStream(V_top.port_a.h_outflow);
    // end of extends 
  equation
    V_top.relativeFlowCoefficient = V_top.valveCharacteristic_Unique43(
      V_top.opening_actual);
    if (V_top.checkValve) then 
      V_top.m_flow = homotopy(V_top.relativeFlowCoefficient*V_top.Av*sqrt(
        Modelica.Media.Water.WaterIF97_ph.density_Unique5(
        V_top.state_a))*Modelica.Fluid.Utilities.regRoot2(V_top.dp, 
        V_top.dp_turbulent, 1.0, 0.0, true, 0.0), V_top.relativeFlowCoefficient*
        V_top.m_flow_nominal*V_top.dp/V_top.dp_nominal);
    elseif ( not V_top.allowFlowReversal) then 
      V_top.m_flow = homotopy(V_top.relativeFlowCoefficient*V_top.Av*sqrt(
        Modelica.Media.Water.WaterIF97_ph.density_Unique5(
        V_top.state_a))*Modelica.Fluid.Utilities.regRoot(V_top.dp, 
        V_top.dp_turbulent), V_top.relativeFlowCoefficient*V_top.m_flow_nominal*
        V_top.dp/V_top.dp_nominal);
    else
      V_top.m_flow = homotopy(V_top.relativeFlowCoefficient*V_top.Av*
        Modelica.Fluid.Utilities.regRoot2(V_top.dp, V_top.dp_turbulent, 
        Modelica.Media.Water.WaterIF97_ph.density_Unique5(
        V_top.state_a), Modelica.Media.Water.WaterIF97_ph.density_Unique5(
        V_top.state_b), false, 1), V_top.relativeFlowCoefficient*
        V_top.m_flow_nominal*V_top.dp/V_top.dp_nominal);
    end if;
    V_top.opening = V_top.minLimiter.u;
    V_top.opening_actual = V_top.minLimiter.u;

  // Component V_bot.minLimiter
  // class Modelica.Fluid.Valves.BaseClasses.PartialValve.MinLimiter
  equation
    V_bot.minLimiter.y = smooth(0, noEvent((if V_bot.minLimiter.u < 
      V_bot.minLimiter.uMin then V_bot.minLimiter.uMin else V_bot.minLimiter.u)));

  // Component V_bot
  // class Modelica.Fluid.Valves.ValveIncompressible
    // extends Modelica.Fluid.Interfaces.PartialTwoPortTransport
    equation
      V_bot.state_a = Modelica.Media.Water.WaterIF97_ph.setState_phX_Unique1(
        V_bot.port_a.p, inStream(V_bot.port_a.h_outflow), inStream(
        V_bot.port_a.Xi_outflow), 0, 0);
      V_bot.state_b = Modelica.Media.Water.WaterIF97_ph.setState_phX_Unique1(
