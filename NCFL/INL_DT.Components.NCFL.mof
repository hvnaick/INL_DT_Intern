        +1];
      heater2.Heater.Ubs[i] = heater2.Heater.Wb_flows[i]+heater2.Heater.H_flows[
        i]-heater2.Heater.H_flows[i+1]+sum(heater2.Heater.heatTransfer.Q_flows[i,
         :])+heater2.Heater.internalHeatGen.Q_flows[i]/heater2.Heater.nParallel;
      heater2.Heater.mXibs[i, :] = heater2.Heater.mXi_flows[i, :]-
        heater2.Heater.mXi_flows[i+1, :];
      heater2.Heater.mCbs[i, :] = heater2.Heater.mC_flows[i, :]-heater2.Heater.mC_flows
        [i+1, :]+heater2.Heater.mC_flows_traceMassTransferSum[i, :]+
