  parameter Modelica.Fluid.Types.Dynamics HX.HXTube.flowModel.system.traceDynamics
     = HX.HXTube.flowModel.system.massDynamics "Default formulation of trace substance balances";
  parameter Modelica.Fluid.Types.Dynamics HX.HXTube.flowModel.system.momentumDynamics
