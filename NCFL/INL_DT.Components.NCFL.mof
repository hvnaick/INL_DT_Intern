  parameter Modelica.Units.SI.AbsolutePressure heater2.HeaterPipe.flowModel.system.p_ambient
     = 101325 "Default ambient pressure";
  parameter Modelica.Units.SI.Temperature heater2.HeaterPipe.flowModel.system.T_ambient
     = 293.15 "Default ambient temperature";
  parameter Modelica.Units.SI.Acceleration heater2.HeaterPipe.flowModel.system.g
     = 9.80665 "Constant gravity acceleration";
  parameter Boolean heater2.HeaterPipe.flowModel.system.allowFlowReversal = true
     "= false to restrict to design flow direction (port_a -> port_b)";
  parameter Modelica.Fluid.Types.Dynamics heater2.HeaterPipe.flowModel.system.energyDynamics
     = Modelica.Fluid.Types.Dynamics.DynamicFreeInitial "Default formulation of energy balances";
  parameter Modelica.Fluid.Types.Dynamics heater2.HeaterPipe.flowModel.system.massDynamics
     = heater2.HeaterPipe.flowModel.system.energyDynamics "Default formulation of mass balances";
  parameter Modelica.Fluid.Types.Dynamics heater2.HeaterPipe.flowModel.system.substanceDynamics
     = heater2.HeaterPipe.flowModel.system.massDynamics "Default formulation of substance balances";
  parameter Modelica.Fluid.Types.Dynamics heater2.HeaterPipe.flowModel.system.traceDynamics
     = heater2.HeaterPipe.flowModel.system.massDynamics "Default formulation of trace substance balances";
  parameter Modelica.Fluid.Types.Dynamics heater2.HeaterPipe.flowModel.system.momentumDynamics
     = Modelica.Fluid.Types.Dynamics.SteadyState "Default formulation of momentum balances, if options available";
  parameter Modelica.Units.SI.MassFlowRate heater2.HeaterPipe.flowModel.system.m_flow_start
     = 0 "Default start value for mass flow rates";
  parameter Modelica.Units.SI.AbsolutePressure heater2.HeaterPipe.flowModel.system.p_start
     = heater2.HeaterPipe.flowModel.system.p_ambient "Default start value for pressures";
  parameter Modelica.Units.SI.Temperature heater2.HeaterPipe.flowModel.system.T_start
     = heater2.HeaterPipe.flowModel.system.T_ambient "Default start value for temperatures";
  parameter Boolean heater2.HeaterPipe.flowModel.system.use_eps_Re = false 
    "= true to determine turbulent region automatically using Reynolds number";
  parameter Modelica.Units.SI.MassFlowRate heater2.HeaterPipe.flowModel.system.m_flow_nominal
     = (if heater2.HeaterPipe.flowModel.system.use_eps_Re then 1 else 100.0*
    heater2.HeaterPipe.flowModel.system.m_flow_small) "Default nominal mass flow rate";
  parameter Real heater2.HeaterPipe.flowModel.system.eps_m_flow(min = 0.0) = 
    0.0001 "Regularization of zero flow for |m_flow| < eps_m_flow*m_flow_nominal";
  parameter Modelica.Units.SI.AbsolutePressure heater2.HeaterPipe.flowModel.system.dp_small
     = 1 "Default small pressure drop for regularization of laminar and zero flow";
  parameter Modelica.Units.SI.MassFlowRate heater2.HeaterPipe.flowModel.system.m_flow_small
    (min = 0.0) = 0.01 "Default small mass flow rate for regularization of laminar and zero flow";
  parameter Integer heater2.HeaterPipe.flowModel.m = heater2.HeaterPipe.flowModel.n
    -1 "Number of flow segments";
  parameter Boolean heater2.HeaterPipe.flowModel.useUpstreamScheme = true 
    "= false to average upstream and downstream properties across flow segments";
  parameter Boolean heater2.HeaterPipe.flowModel.use_Ib_flows = heater2.HeaterPipe.flowModel.momentumDynamics
     <> Modelica.Fluid.Types.Dynamics.SteadyState "= true to consider differences in flow of momentum through boundaries";
  parameter Modelica.Units.SI.ReynoldsNumber heater2.HeaterPipe.flowModel.Re_turbulent
     = 4000 "Start of turbulent regime, depending on type of flow device";
  constant Boolean heater2.HeaterPipe.flowModel.show_Res = false 
    "= true, if Reynolds numbers are included for plotting";
  parameter Boolean heater2.HeaterPipe.flowModel.use_rho_nominal = false 
    "= true, if rho_nominal is used, otherwise computed from medium";
  parameter Modelica.Units.SI.Density heater2.HeaterPipe.flowModel.rho_nominal
     = Modelica.Media.Water.WaterIF97_ph.density_pTX_Unique7(101325, 293.15, {
    1.0}) "Nominal density (e.g., rho_liquidWater = 995, rho_air = 1.2)";
  parameter Boolean heater2.HeaterPipe.flowModel.use_mu_nominal = false 
    "= true, if mu_nominal is used, otherwise computed from medium";
  parameter Modelica.Units.SI.DynamicViscosity heater2.HeaterPipe.flowModel.mu_nominal
     = Modelica.Media.Water.WaterIF97_ph.dynamicViscosity_Unique6(
    Modelica.Media.Water.WaterIF97_ph.setState_pTX_Unique8(101325, 293.15, {1.0},
       0, 0)) "Nominal dynamic viscosity (e.g., mu_liquidWater = 1e-3, mu_air = 1.8e-5)";
  parameter Modelica.Units.SI.AbsolutePressure heater2.HeaterPipe.flowModel.dp_nominal
    (fixed = false) = 1 "Nominal pressure loss (only for nominal models)";
  parameter Modelica.Units.SI.MassFlowRate heater2.HeaterPipe.flowModel.m_flow_nominal
     = (if heater2.HeaterPipe.flowModel.system.use_eps_Re then heater2.HeaterPipe.flowModel.system.m_flow_nominal
     else 100.0*heater2.HeaterPipe.flowModel.m_flow_small) "Nominal mass flow rate";
  parameter Modelica.Units.SI.MassFlowRate heater2.HeaterPipe.flowModel.m_flow_small
     = (if heater2.HeaterPipe.flowModel.system.use_eps_Re then heater2.HeaterPipe.flowModel.system.eps_m_flow
    *heater2.HeaterPipe.flowModel.m_flow_nominal else heater2.HeaterPipe.flowModel.system.m_flow_small)
     "Within regularization if |m_flows| < m_flow_small (may be wider for large discontinuities in static head)";
  parameter Modelica.Units.SI.AbsolutePressure heater2.HeaterPipe.flowModel.dp_small
    (fixed = false) = 1 "Within regularization if |dp| < dp_small (may be wider for large discontinuities in static head)";
  parameter Boolean heater2.HeaterPipe.flowModel.constantPressureLossCoefficient
     = heater2.HeaterPipe.flowModel.use_rho_nominal and (heater2.HeaterPipe.flowModel.use_mu_nominal
     or false) "= true, if the pressure loss does not depend on fluid states";
  parameter Boolean heater2.HeaterPipe.flowModel.continuousFlowReversal =  not 
    heater2.HeaterPipe.flowModel.useUpstreamScheme or heater2.HeaterPipe.flowModel.constantPressureLossCoefficient
     or  not heater2.HeaterPipe.flowModel.allowFlowReversal "= true, if the pressure loss is continuous around zero flow";
  parameter Real heater1.bruh = 10;
  parameter Modelica.Units.SI.Length heater1.HeaterLength = data.Heater_Length;
  parameter Modelica.Units.SI.Length heater1.HeaterRadius = data.Heater_radius;
  parameter Modelica.Units.SI.Pressure heater1.Init_P = 101325;
  parameter Modelica.Units.SI.Power heater1.HeaterPower = data.Heater_Power;
  constant Boolean heater1.allowFlowReversal = false;
  parameter Modelica.Units.SI.AbsolutePressure heater1.Heater.systemTF.p_ambient
     = 101325 "Default ambient pressure";
  parameter Modelica.Units.SI.Temperature heater1.Heater.systemTF.T_ambient = 
    293.15 "Default ambient temperature";
  parameter Modelica.Units.SI.Acceleration heater1.Heater.systemTF.g = 9.80665 
    "Constant gravity acceleration";
  parameter Boolean heater1.Heater.systemTF.allowFlowReversal = true 
    "= true to allow flow reversal, false restricts to design direction (port_a -> port_b)";
  parameter TRANSFORM.Types.Dynamics heater1.Heater.systemTF.energyDynamics = 
    TRANSFORM.Types.Dynamics.DynamicFreeInitial "Formulation of energy balances";
  parameter TRANSFORM.Types.Dynamics heater1.Heater.systemTF.massDynamics = 
    heater1.Heater.systemTF.energyDynamics "Formulation of mass balances";
  parameter TRANSFORM.Types.Dynamics heater1.Heater.systemTF.substanceDynamics
     = heater1.Heater.systemTF.massDynamics "Formulation of substance balances";
  parameter TRANSFORM.Types.Dynamics heater1.Heater.systemTF.traceDynamics = 
    heater1.Heater.systemTF.massDynamics "Formulation of trace substance balances";
  parameter TRANSFORM.Types.Dynamics heater1.Heater.systemTF.momentumDynamics = 
    TRANSFORM.Types.Dynamics.SteadyState "Formulation of momentum balances";
  parameter Modelica.Units.SI.AbsolutePressure heater1.Heater.systemTF.p_start
     = 101325 "Pressure";
  parameter Boolean heater1.Heater.systemTF.use_T_start = true "Use T_start if true, otherwise h_start";
  parameter Modelica.Units.SI.Temperature heater1.Heater.systemTF.T_start = 
    293.15 "Temperature";
  parameter Modelica.Units.SI.SpecificEnthalpy heater1.Heater.systemTF.h_start
     = Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_pTX_Unique18(
    heater1.Heater.systemTF.p_start, heater1.Heater.systemTF.T_start, 
    heater1.Heater.systemTF.X_start, 0) "Specific enthalpy";
  parameter Modelica.Units.SI.MassFraction heater1.Heater.systemTF.X_start[1] = 
    {1.0} "Mass fraction";
  parameter TRANSFORM.Units.ExtraProperty heater1.Heater.systemTF.C_start[0] = 
    fill(0, 0) "Mass-Specific value";
  parameter Modelica.Units.SI.MassFlowRate heater1.Heater.systemTF.m_flow_start
     = 0 "Mass flow rate";
  parameter Boolean heater1.Heater.systemTF.showName = true;
  parameter Boolean heater1.Heater.systemTF.showDesignFlowDirection = true;
  parameter Boolean heater1.Heater.systemTF.showColors = false "Toggle dynamic color display";
  constant Boolean heater1.Heater.allowFlowReversal = false "= true to allow flow reversal, false restricts to design direction (port_a -> port_b)";
  parameter Real heater1.Heater.nParallel = 1 "Number of parallel components";
  constant Integer heater1.Heater.nV(min = 1.0) = 1 "Number of discrete volumes";
  parameter Modelica.Fluid.Types.Dynamics heater1.Heater.energyDynamics = 
    Modelica.Fluid.Types.Dynamics.DynamicFreeInitial "Formulation of energy balances";
  parameter Modelica.Fluid.Types.Dynamics heater1.Heater.massDynamics = 
    heater1.Heater.energyDynamics "Formulation of mass balances";
  parameter Modelica.Fluid.Types.Dynamics heater1.Heater.substanceDynamics = 
    heater1.Heater.massDynamics "Formulation of substance balances";
  parameter Modelica.Fluid.Types.Dynamics heater1.Heater.traceDynamics = 
    heater1.Heater.massDynamics "Formulation of trace substance balances";
  parameter Modelica.Units.SI.AbsolutePressure heater1.Heater.ps_start[
    heater1.Heater.nV] = TRANSFORM.Math.linspace_1D(heater1.Heater.p_a_start, 
    heater1.Heater.p_b_start, heater1.Heater.nV) "Pressure";
  parameter Boolean heater1.Heater.use_Ts_start = true "Use T_start if true, otherwise h_start";
  parameter Modelica.Units.SI.Temperature heater1.Heater.Ts_start[
    heater1.Heater.nV](start = fill(288.15, size(heater1.Heater.Ts_start, 1)))
     = TRANSFORM.Math.linspace_1D(heater1.Heater.T_a_start, heater1.Heater.T_b_start,
     heater1.Heater.nV) "Temperature";
  parameter Modelica.Units.SI.SpecificEnthalpy heater1.Heater.hs_start[
    heater1.Heater.nV] = (if  not heater1.Heater.use_Ts_start then 
    TRANSFORM.Math.linspace_1D(heater1.Heater.h_a_start, heater1.Heater.h_b_start,
     heater1.Heater.nV) else array(Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_pTX_Unique24
    (heater1.Heater.ps_start[i], heater1.Heater.Ts_start[i], heater1.Heater.Xs_start
    [i, 1:1], 0) for i in 1:heater1.Heater.nV)) "Specific enthalpy";
  parameter Modelica.Units.SI.MassFraction heater1.Heater.Xs_start[
    heater1.Heater.nV, 1] = TRANSFORM.Math.linspaceRepeat_1D(heater1.Heater.X_a_start,
     heater1.Heater.X_b_start, heater1.Heater.nV) "Mass fraction";
  parameter TRANSFORM.Units.ExtraProperty heater1.Heater.Cs_start[
    heater1.Heater.nV, 0] = TRANSFORM.Math.linspaceRepeat_1D(heater1.Heater.C_a_start,
     heater1.Heater.C_b_start, heater1.Heater.nV) "Mass-Specific value";
  parameter Boolean heater1.Heater.initialize_p = true "= true to set up initial equations for pressure";
  parameter Modelica.Units.SI.AbsolutePressure heater1.Heater.p_a_start = 101325
     "Pressure at port a";
  parameter Modelica.Units.SI.AbsolutePressure heater1.Heater.p_b_start = 
    heater1.Heater.p_a_start+(if heater1.Heater.m_flow_a_start > 0 then -1000.0
     else (if heater1.Heater.m_flow_a_start < 0 then 1000.0 else 0)) 
    "Pressure at port b";
  parameter Modelica.Units.SI.Temperature heater1.Heater.T_a_start = 293.15 
    "Temperature at port a";
  parameter Modelica.Units.SI.Temperature heater1.Heater.T_b_start = 
    heater1.Heater.T_a_start "Temperature at port b";
  parameter Modelica.Units.SI.SpecificEnthalpy heater1.Heater.h_a_start = 
    Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_pTX_Unique24(
    heater1.Heater.p_a_start, heater1.Heater.T_a_start, heater1.Heater.X_a_start,
     0) "Specific enthalpy at port a";
  parameter Modelica.Units.SI.SpecificEnthalpy heater1.Heater.h_b_start = 
    Modelica.Media.Water.WaterIF97_ph.specificEnthalpy_pTX_Unique24(
    heater1.Heater.p_b_start, heater1.Heater.T_b_start, heater1.Heater.X_b_start,
     0) "Specific enthalpy at port b";
  parameter Modelica.Units.SI.MassFraction heater1.Heater.X_a_start[1] = {1.0} 
    "Mass fraction at port a";
  parameter Modelica.Units.SI.MassFraction heater1.Heater.X_b_start[1] = 
    heater1.Heater.X_a_start "Mass fraction at port b";
  parameter TRANSFORM.Units.ExtraProperty heater1.Heater.C_a_start[0] = fill(0, 0)
     "Mass-Specific value at port a";
  parameter TRANSFORM.Units.ExtraProperty heater1.Heater.C_b_start[0] = 
    heater1.Heater.C_a_start "Mass-Specific value at port b";
  parameter Modelica.Units.SI.MassFlowRate heater1.Heater.m_flow_a_start = 20 
    "Mass flow rate at port_a";
  parameter Modelica.Units.SI.MassFlowRate heater1.Heater.m_flow_b_start =  -
    heater1.Heater.m_flow_a_start "Mass flow rate at port_b";
  parameter Modelica.Units.SI.MassFlowRate heater1.Heater.m_flows_start[
    heater1.Heater.nV+1] = linspace(heater1.Heater.m_flow_a_start,  -
    heater1.Heater.m_flow_b_start, heater1.Heater.nV+1) "Mass flow rates";
  constant Integer heater1.Heater.geometry.figure = 1 "Index for Icon figure";
  constant Integer heater1.Heater.geometry.nV(min = 1.0) = 1 "Number of volume nodes";
  constant Integer heater1.Heater.geometry.nSurfaces = 1 "Number of transfer (heat/mass) surfaces";
  constant Integer heater1.Heater.flowModel.nFM(min = 1.0) = 1 "Number of discrete flow models";
  constant Modelica.Fluid.Types.Dynamics heater1.Heater.flowModel.momentumDynamics
     = Modelica.Fluid.Types.Dynamics.SteadyState "Formulation of momentum balance";
  parameter Modelica.Units.SI.PressureDifference heater1.Heater.flowModel.dps_start
    [heater1.Heater.flowModel.nFM] = heater1.Heater.dps_start "Pressure changes {p[2]-p[1],...,p[n+1]-p[n]}";
  parameter Modelica.Units.SI.MassFlowRate heater1.Heater.flowModel.m_flows_start
    [heater1.Heater.flowModel.nFM] = heater1.Heater.m_flowsFM_start 
    "Mass flow rates";
  constant Boolean heater1.Heater.flowModel.allowFlowReversal = false 
    "= true to allow flow reversal, false restricts to design direction (m_flows >= zeros(m))";
  constant Modelica.Units.SI.ReynoldsNumber heater1.Heater.flowModel.Re_lam(
    max = 4000.0) = 2300 "Laminar transition Reynolds number";
  constant Modelica.Units.SI.ReynoldsNumber heater1.Heater.flowModel.Re_turb(
    min = 2300.0) = 4000 "Turbulent transition Reynolds number";
  parameter Boolean heater1.Heater.flowModel.from_dp = heater1.Heater.flowModel.momentumDynamics
     >= Modelica.Fluid.Types.Dynamics.SteadyStateInitial "= true, use m_flow = f(dp), otherwise dp = f(m_flow)";
  parameter Modelica.Units.SI.MassFlowRate heater1.Heater.flowModel.m_flow_small
     = 15 "Within regularization if |m_flows| < m_flow_small (may be wider for large discontinuities in static head)";
  parameter Modelica.Units.SI.AbsolutePressure heater1.Heater.flowModel.dp_small
     = 1 "Within regularization if |dp| < dp_small (may be wider for large discontinuities in static head)";
  parameter Modelica.Units.SI.ReynoldsNumber heater1.Heater.flowModel.Re_center
     = 0.5*(heater1.Heater.flowModel.Re_lam+heater1.Heater.flowModel.Re_turb) 
    "Re smoothing transition center";
  parameter Modelica.Units.SI.ReynoldsNumber heater1.Heater.flowModel.Re_width
     = heater1.Heater.flowModel.Re_turb-heater1.Heater.flowModel.Re_center 
    "Re smoothing transition width";
  parameter Boolean heater1.Heater.flowModel.use_I_flows = heater1.Heater.flowModel.momentumDynamics
     <> Modelica.Fluid.Types.Dynamics.SteadyState "= true to consider differences in flow of momentum through boundaries";
  parameter Modelica.Units.SI.Time heater1.Heater.flowModel.taus[2] = {0.01, 
    0.01} "Time Constant for first order delay of {dps_K,dps_add}";
  parameter Modelica.Units.SI.AbsolutePressure heater1.Heater.flowModel.dp_nominal
    (fixed = false) = 1 "Nominal pressure loss (only for nominal models)";
  parameter Modelica.Units.SI.MassFlowRate heater1.Heater.flowModel.m_flow_nominal
     = 100.0*heater1.Heater.flowModel.m_flow_small "Nominal mass flow rate";
  parameter Boolean heater1.Heater.flowModel.use_d_nominal = false 
    "= true, if d_nominal is used, otherwise computed from medium";
  parameter Modelica.Units.SI.Density heater1.Heater.flowModel.d_nominal = 
    Modelica.Media.Water.WaterIF97_ph.density_phX_Unique26(101325, 
    84013.0581525969, {1.0}, 0) "Nominal density (e.g., rho_liquidWater = 995, rho_air = 1.2)";
  parameter Boolean heater1.Heater.flowModel.use_mu_nominal = false 
    "= true, if mu_nominal is used, otherwise computed from medium";
  parameter Modelica.Units.SI.DynamicViscosity heater1.Heater.flowModel.mu_nominal
     = Modelica.Media.Water.WaterIF97_ph.dynamicViscosity_Unique6(
    Modelica.Media.Water.WaterIF97_ph.setState_phX_Unique1(101325, 
      84013.0581525969, {1.0}, 0, 0)) "Nominal dynamic viscosity (e.g., mu_liquidWater = 1e-3, mu_air = 1.8e-5)";
  parameter Boolean heater1.Heater.flowModel.continuousFlowReversal = (if 
    heater1.Heater.flowModel.use_d_nominal and heater1.Heater.flowModel.use_mu_nominal
     then true else false) "= true if the pressure loss is continuous around zero flow";
  parameter Real heater1.Heater.flowModel.firstOrder_dps_K[1].k(unit = "1") = 1 
    "Gain";
  parameter Modelica.Units.SI.Time heater1.Heater.flowModel.firstOrder_dps_K[1].T
    (start = 1) = heater1.Heater.flowModel.taus[1] "Time Constant";
  parameter Modelica.Blocks.Types.Init heater1.Heater.flowModel.firstOrder_dps_K[1].initType
     = Modelica.Blocks.Types.Init.InitialOutput "Type of initialization (1: no init, 2: steady state, 3/4: initial output)";
  parameter Real heater1.Heater.flowModel.firstOrder_dps_K[1].y_start = 0 
    "Initial or guess value of output (= state)";
  constant Boolean heater1.Heater.use_HeatTransfer = true "= true to use the HeatTransfer model";
  parameter Real heater1.Heater.heatTransfer.nParallel = heater1.Heater.nParallel
     "Number of parallel components";
  constant Integer heater1.Heater.heatTransfer.nHT = 1 "Number of heat transfer segments";
  constant Integer heater1.Heater.heatTransfer.nSurfaces = 1 "Number of heat transfer surfaces";
  parameter Integer heater1.Heater.heatTransfer.flagIdeal = 1 "Flag for models to handle ideal boundary";
  parameter Modelica.Units.SI.Temperature heater1.Heater.heatTransfer.Ts_start[
    heater1.Heater.heatTransfer.nHT](start = fill(288.15, size(heater1.Heater.heatTransfer.Ts_start,
     1))) = heater1.Heater.Ts_start;
  constant Modelica.Units.SI.ReynoldsNumber heater1.Heater.heatTransfer.Re_lam(
    max = 4000.0) = 2300 "Laminar transition Reynolds number";
  constant Modelica.Units.SI.ReynoldsNumber heater1.Heater.heatTransfer.Re_turb(
    min = 2300.0) = 4000 "Turbulent transition Reynolds number";
  parameter Modelica.Units.SI.ReynoldsNumber heater1.Heater.heatTransfer.Re_center
     = 0.5*(heater1.Heater.heatTransfer.Re_lam+heater1.Heater.heatTransfer.Re_turb)
     "Re smoothing transition center";
  parameter Modelica.Units.SI.ReynoldsNumber heater1.Heater.heatTransfer.Re_width
     = heater1.Heater.heatTransfer.Re_turb-heater1.Heater.heatTransfer.Re_center
     "Re smoothing transition width";
  constant Integer heater1.Heater.internalHeatGen.nV(min = 1.0) = 1 
    "Number of discrete volumes";
  constant Boolean heater1.Heater.use_TraceMassTransfer = false "= true to use the TraceMassTransfer model";
  parameter Real heater1.Heater.traceMassTransfer.nParallel = heater1.Heater.nParallel
     "Number of parallel components";
  constant Integer heater1.Heater.traceMassTransfer.nMT = 1 "Number of mass transfer segments";
  constant Integer heater1.Heater.traceMassTransfer.nSurfaces = 1 
    "Number of mass transfer surfaces";
  parameter Integer heater1.Heater.traceMassTransfer.flagIdeal = 1 
    "Flag for models to handle ideal boundary";
  parameter TRANSFORM.Units.ExtraProperty heater1.Heater.traceMassTransfer.CsM_start
    [heater1.Heater.traceMassTransfer.nMT, 0] = heater1.Heater.Cs_start 
    "Initial Trace substance mass-specific value";
  parameter Integer heater1.Heater.traceMassTransfer.iC[:] = array(i for i in 1:0)
     "Fluid index of transfered substances from fluid to massPort. This sets nC in traceMassTransfer.";
  parameter Integer heater1.Heater.traceMassTransfer.nC = size(heater1.Heater.traceMassTransfer.iC,
     1);
  parameter Real heater1.Heater.traceMassTransfer.MMs[heater1.Heater.traceMassTransfer.nC]
     = fill(1, heater1.Heater.traceMassTransfer.nC) "Conversion from fluid mass-specific value to moles (e.g., molar mass [kg/mol] or Avogadro's number [atoms/mol])";
  parameter Integer heater1.Heater.traceMassTransfer.diffusionCoeff[1].nC = 
    heater1.Heater.traceMassTransfer.nC "Number of substances";
  constant Modelica.Units.SI.ReynoldsNumber heater1.Heater.traceMassTransfer.Re_lam
    (max = 4000.0) = 2300 "Laminar transition Reynolds number";
  constant Modelica.Units.SI.ReynoldsNumber heater1.Heater.traceMassTransfer.Re_turb
    (min = 2300.0) = 4000 "Turbulent transition Reynolds number";
  parameter Integer heater1.Heater.traceMassTransfer.massPorts[1, 1].nC = 
    heater1.Heater.traceMassTransfer.nC "Number of substances";
  constant TRANSFORM.Units.Mole heater1.Heater.traceMassTransfer.toMole_unitConv
     = 1;
  parameter Modelica.Units.SI.ReynoldsNumber heater1.Heater.traceMassTransfer.Re_center
     = 0.5*(heater1.Heater.traceMassTransfer.Re_lam+heater1.Heater.traceMassTransfer.Re_turb)
     "Re smoothing transition center";
  parameter Modelica.Units.SI.ReynoldsNumber heater1.Heater.traceMassTransfer.Re_width
     = heater1.Heater.traceMassTransfer.Re_turb-heater1.Heater.traceMassTransfer.Re_center
     "Re smoothing transition width";
  parameter Integer heater1.Heater.traceMassTransfer.iC_fluid[0] = array(i for i
     in 1:0);
  parameter Integer heater1.Heater.traceMassTransfer.nC_noT = 0-heater1.Heater.traceMassTransfer.nC
     "# of species not transfered from fluid";
  parameter Integer heater1.Heater.traceMassTransfer.iC_noT[heater1.Heater.traceMassTransfer.nC_noT]
     = (if heater1.Heater.traceMassTransfer.nC_noT > 0 then TRANSFORM.Math.indexFilter
    (heater1.Heater.traceMassTransfer.iC_fluid, heater1.Heater.traceMassTransfer.iC,
     false) else fill(0, heater1.Heater.traceMassTransfer.nC_noT)) 
    "Index of species not transfered from fluid";
  constant Integer heater1.Heater.internalTraceGen.nV(min = 1.0) = 1 
    "Number of discrete volumes";
  constant Boolean heater1.Heater.exposeState_a = true "=true, p is calculated at port_a else m_flow";
  constant Boolean heater1.Heater.exposeState_b = false "=true, p is calculated at port_b else m_flow";
  constant Modelica.Fluid.Types.Dynamics heater1.Heater.momentumDynamics = 
    Modelica.Fluid.Types.Dynamics.SteadyState "Formulation of momentum balances";
  parameter Boolean heater1.Heater.useInnerPortProperties = false 
    "=true to take port properties for flow models from internal control volumes";
  constant Boolean heater1.Heater.useLumpedPressure = false "=true to lump pressure states together";
  parameter TRANSFORM.Fluid.Types.LumpedLocation heater1.Heater.lumpPressureAt
